# .ui-jury/.env.example — copy to .ui-jury/.env and fill in the password.
#
#   cp .ui-jury/.env.example .ui-jury/.env
#   # then edit .ui-jury/.env
#
# .ui-jury/.env is gitignored — DO NOT commit it.
#
# Variables read by .ui-jury/scripts/render-routes.sh:
#
#   HQ_TEST_PASSWORD — password for the test account named in
#                      .ui-jury/routes.template.yaml's top-level setup block
#                      (currently jamal@yumyums.kitchen). Substituted into the
#                      ${HQ_TEST_PASSWORD} placeholder at render time.

HQ_TEST_PASSWORD=
