task: [test:targets] echo "── Taskfile test cluster ────────────────────────────────"
echo "  host:port   localhost:5434"
echo "  role        hqtest"
echo "  container   yumyums-test-pg  (docker-compose.test.yml, project yumyums-test)"
echo "  DB_TEST_URL postgres://hqtest:hqtest@localhost:5434/hq_test_go?sslmode=disable"
echo ""
echo "── Playwright e2e (scripts/reset-e2e-db.js, resolved) ───"
node -e 'const{resolveE2eDb}=require("./scripts/reset-e2e-db");const d=resolveE2eDb({});console.log("  adminUrl    "+d.adminUrl);console.log("  testUrl     "+d.testUrl)'
echo ""
echo "── internal/sync RLS suite defaults ─────────────────────"
grep -n 'defaultHQAdminURL = \|defaultFDWPort = ' backend/internal/sync/rowvisibility_rls_test.go
echo ""
echo "── scripts/verify-test-harness.sh probe URL ─────────────"
grep -n "DEAD_URL='postgres" scripts/verify-test-harness.sh

