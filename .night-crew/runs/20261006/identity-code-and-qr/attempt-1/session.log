never reads as delivered.\n//\n// `media_url` is the public path of the code's image (GET /m/{id}.png), null\n// until there is one. `requested_at` carries the last `resend_requested` so\n// the sheet can say \"Resend requested · 2026-10-01\" without implying a send\n// happened.\ntype identityCodeDTO struct {\n\tStatus      string     `json:\"status\"`\n\tMediaURL    *string    `json:\"media_url\"`\n\tSentAt      *time.Time `json:\"sent_at\"`\n\tRequestedAt *time.Time `json:\"requested_at\"`\n}''')\n\nrep('''type importResultDTO struct {\n\tSource     string `json:\"source\"`\n\tRead       int    `json:\"read\"`\n\tCreated    int    `json:\"created\"`\n\tUpdated    int    `json:\"updated\"`\n\tUnchanged  int    `json:\"unchanged\"`\n\tSkipped    int    `json:\"skipped\"`\n\tScansBound int    `json:\"scans_bound\"`\n}''','''//\n// `warnings` is decision 187's shape, the one a campaign save already uses:\n// the import SUCCEEDED, and something after it did not. \"not_projected\" — a\n// new signup's identity code was minted but the scanner's server does not know\n// it yet. \"identity_not_minted\" — a new signup was saved without a code.\ntype importResultDTO struct {\n\tSource     string   `json:\"source\"`\n\tRead       int      `json:\"read\"`\n\tCreated    int      `json:\"created\"`\n\tUpdated    int      `json:\"updated\"`\n\tUnchanged  int      `json:\"unchanged\"`\n\tSkipped    int      `json:\"skipped\"`\n\tScansBound int      `json:\"scans_bound\"`\n\tWarnings   []string `json:\"warnings,omitempty\"`\n}''')\n\nrep('''\t\t\toptedOut                                     *time.Time\n\t\t\tvisits                                       int\n\t\t)\n\t\terr := d.Pool.QueryRow(r.Context(), `\n\t\t\tSELECT s.display_name, s.phone_e164, s.email, s.source, s.source_short,\n\t\t\t       c.name, s.consent_evidence, s.joined_at, s.sms_consent,\n\t\t\t       s.email_consent, s.opted_out_at,\n\t\t\t       (SELECT count(*) FROM subscriber_events e\n\t\t\t          WHERE e.subscriber_id = s.id AND e.kind IN ('scanned','redeemed'))\n\t\t\t  FROM subscribers s''','''\t\t\toptedOut                                     *time.Time\n\t\t\tvisits                                       int\n\t\t\tminted                                       bool\n\t\t\tmediaID                                      *string\n\t\t)\n\t\terr := d.Pool.QueryRow(r.Context(), `\n\t\t\tSELECT s.display_name, s.phone_e164, s.email, s.source, s.source_short,\n\t\t\t       c.name, s.consent_evidence, s.joined_at, s.sms_consent,\n\t\t\t       s.email_consent, s.opted_out_at,\n\t\t\t       (SELECT count(*) FROM subscriber_events e\n\t\t\t          WHERE e.subscriber_id = s.id AND e.kind IN ('scanned','redeemed')),\n\t\t\t       s.identity_token_hash IS NOT NULL,\n\t\t\t       (SELECT m.id::text FROM identity_media m\n\t\t\t         WHERE m.subscriber_id = s.id ORDER BY m.created_at DESC, m.id LIMIT 1)\n\t\t\t  FROM subscribers s''')\nrep('''\t\t\tScan(&name, &phone, &email, &source, &short, &camName, &evidence,\n\t\t\t\t&joined, &sms, &emailOK, &optedOut, &visits)''','''\t\t\tScan(&name, &phone, &email, &source, &short, &camName, &evidence,\n\t\t\t\t&joined, &sms, &emailOK, &optedOut, &visits, &minted, &mediaID)''')\nrep('''\t\toffers, err := offersNow(r.Context(), d)\n\t\tif err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"detail_failed\")\n\t\t\treturn\n\t\t}\n\t\twriteJSON''','''\t\t// The timeline decides \"sent\"; the subscriber row decides the rest.\n\t\tif ic.Status != IdentitySent && minted {\n\t\t\tic.Status = IdentityMinted\n\t\t}\n\t\tif mediaID != nil {\n\t\t\tu := identityMediaPath(*mediaID)\n\t\t\tic.MediaURL = &u\n\t\t}\n\t\toffers, err := offersNow(r.Context(), d)\n\t\tif err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"detail_failed\")\n\t\t\treturn\n\t\t}\n\t\twriteJSON''')\nrep('''// subscriberTimeline reads the events newest-first and derives the\n// identity-code status from them in one pass.''','''// subscriberTimeline reads the events newest-first and derives the timeline's\n// half of the identity-code status from them in one pass: \"sent\" when a\n// `code_sent` event exists, otherwise \"not_minted\" — which the caller raises to\n// \"minted\" when the subscriber row holds a code.''')\nrep('''\tic := identityCodeDTO{Status: \"not_sent\"}''','''\tic := identityCodeDTO{Status: IdentityNotMinted}''')\nrep('''\t\t\t\t\tic.Status = \"sent\"''','''\t\t\t\t\tic.Status = IdentitySent''')\nrep('''\tres, err := ImportSubscribers(r.Context(), d.Pool, imp)''','''\tres, err := ImportSubscribers(r.Context(), d, imp)''')\nrep('''// history of the person.\nfunc ImportSubscribers(ctx context.Context, pool interface {\n\tBegin(context.Context) (pgx.Tx, error)\n}, imp sources.Importer) (importResultDTO, error) {''','''// history of the person.\n//\n// # Identity codes (card `identity-code-and-qr`, run 20261006)\n//\n// Every subscriber this import CREATES gets their one permanent identity code,\n// minted after the import's transaction has committed (mintForNewSubscribers).\n// A subscriber the import merely updated is not touched: a code is never\n// rotated by an import. Minting cannot fail or undo the import — a code that\n// could not be projected to the scanner's server, or could not be minted at\n// all, comes back as a `warnings` entry on a 200.\nfunc ImportSubscribers(ctx context.Context, d Deps, imp sources.Importer) (importResultDTO, error) {''')\nrep('''\ttx, err := pool.Begin(ctx)\n\tif err != nil {\n\t\treturn res, err\n\t}\n\tdefer func() { _ = tx.Rollback(ctx) }()\n\n\tfor _, c := range cands {''','''\ttx, err := d.Pool.Begin(ctx)\n\tif err != nil {\n\t\treturn res, err\n\t}\n\tdefer func() { _ = tx.Rollback(ctx) }()\n\n\tvar created []string\n\tfor _, c := range cands {''')\nrep('''\t\t\tres.Created++\n\t\t}''','''\t\t\tres.Created++\n\t\t\tcreated = append(created, id)\n\t\t}''')\nrep('''\tif err := tx.Commit(ctx); err != nil {\n\t\treturn res, err\n\t}\n\treturn res, nil\n}\n\nfunc findSubscriber''','''\tif err := tx.Commit(ctx); err != nil {\n\t\treturn res, err\n\t}\n\tres.Warnings = mintForNewSubscribers(ctx, d, created)\n\treturn res, nil\n}\n\nfunc findSubscriber''')\nopen(p,'w').write(s)\n\np='backend/internal/marketing/subscribers_test.go'\ns=open(p).read()\nn=s.count(\"ImportSubscribers(ctx, pool, \")\ns=s.replace(\"ImportSubscribers(ctx, pool, \",\"ImportSubscribers(ctx, testDeps(pool), \")\nprint(\"call sites\",n)\nold='''\tif detail.IdentityCode.Status != \"not_sent\" {\n\t\tt.Errorf(\"identity_code.status = %q, want not_sent — a request is not a send\", detail.IdentityCode.Status)\n\t}'''\nnew='''\t// \"minted\", not \"sent\": the import gave this subscriber a code (card\n\t// identity-code-and-qr), and a resend REQUEST still sends nothing.\n\tif detail.IdentityCode.Status != IdentityMinted {\n\t\tt.Errorf(\"identity_code.status = %q, want %q — a request is not a send\", detail.IdentityCode.Status, IdentityMinted)\n\t}'''\nassert s.count(old)==1\ns=s.replace(old,new)\nopen(p,'w').write(s)\n\np='tests/marketing-subscribers.spec.js'\ns=open(p).read()\nold=\"    expect(detail.identity_code.status).toBe('not_sent');\"\nassert s.count(old)==1\nopen(p,'w').write(s.replace(old,\"\"\"    // A Toast-guest import mints the subscriber's identity code (card\n    // identity-code-and-qr), so the status is \"minted\" — and still not \"sent\".\n    expect(detail.identity_code.status).toBe('minted');\"\"\"))\n\np='marketing.html'\ns=open(p).read()\nold='id=\"scan-file-surface\" style=\"position:absolute;left:-9999px;width:320px;height:320px;'\nassert s.count(old)==1\nopen(p,'w').write(s.replace(old,'id=\"scan-file-surface\" style=\"position:absolute;left:-9999px;width:640px;height:640px;'))\nEOF\nsed -n 136,144p marketing.html; export PATH=\"/usr/local/go/bin:$PATH\"; cd backend && go build ./... && go vet ./internal/marketing/ ./cmd/qrgen/ && echo VET_OK","description":"Wire the mint into the import and detail DTO, update the two status asse