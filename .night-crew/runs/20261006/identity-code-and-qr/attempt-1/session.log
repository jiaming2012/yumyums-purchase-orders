{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfjyfvhRbaCPpibgWB7di","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HC6Yikx5mX8SNyRBPvu8A1","name":"Write","input":{"file_path":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/backend/internal/marketing/identity_test.go","content":"package marketing\n\n// identity_test.go — card E1 (`identity-code-and-qr`, roadmap Activity E).\n//\n// The five named gates, and three that ride with them:\n//\n//\tTestMintIdentityCodeIsIdempotent                  one code per customer, for good\n//\tTestMintIdentityCodeNoFirstTouchIsIdentityOnly    no campaign → no offer in the QR, nothing projected\n//\tTestProjectIdentityCodeUpserts                    the arbiter row, and a failed projection keeps the mint\n//\tTestMigration0088IdentityCodesDownAndUpRoundTrip  0088's Down, run\n//\t(TestNothingInThisPackageSends is subscribers_test.go's, unedited)\n//\n//\tTestIdentityMediaRouteIsPublicPNG                 GET/HEAD /m/{id}.png\n//\tTestSubscriberDetailReportsIdentityCodeStatus     not_minted → minted → sent\n//\tTestIdentityCodeLongOfferTextStaysScannable       a long offer never produces a denser symbol\n//\n// 🛑 No test here learns a token from the database — there is none there. The\n// token is fixed by handing the mint a known random stream (withIdentityRand),\n// and every claim about the QR is made by re-encoding the expected payload and\n// comparing it to the stored PNG byte for byte.\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/go-chi/chi/v5\"\n\t\"github.com/jackc/pgx/v5/pgxpool\"\n\tqrcode \"github.com/skip2/go-qrcode\"\n\t\"github.com/yumyums/hq/internal/db\"\n)\n\n// withIdentityRand swaps the mint's random source for a fixed stream and\n// returns the token that stream produces, so a test knows the token without it\n// ever having been stored.\nfunc withIdentityRand(t *testing.T, seed byte) string {\n\tt.Helper()\n\tstream := make([]byte, 256)\n\tfor i := range stream {\n\t\tstream[i] = seed + byte(i*7)\n\t}\n\ttoken, err := newIdentityToken(bytes.NewReader(stream))\n\tif err != nil {\n\t\tt.Fatalf(\"newIdentityToken on the fixed stream: %v\", err)\n\t}\n\tprev := identityRand\n\tidentityRand = bytes.NewReader(stream)\n\tt.Cleanup(func() { identityRand = prev })\n\treturn token\n}\n\nfunc sha256Hex(s string) string {\n\tsum := sha256.Sum256([]byte(s))\n\treturn hex.EncodeToString(sum[:])\n}\n\n// seedFirstTouchCampaign creates a campaign through the real route and\n// re-points its first code's short, returning the campaign.\nfunc seedFirstTouchCampaign(t *testing.T, pool *pgxpool.Pool, mux *chi.Mux, short, offerText string, cents int) campaignDTO {\n\tt.Helper()\n\tmgr := seedUser(t, pool, \"manager\")\n\tcreated := createCampaign(t, mux, mgr, map[string]any{\n\t\t\"name\": \"Wing Wednesday \" + randSuffix(t), \"offer_text\": offerText,\n\t\t\"face_value_cents\": cents, \"runs_days\": 14,\n\t\t\"channels\": []map[string]any{{\"channel\": \"flyer\"}},\n\t})\n\tif _, err := pool.Exec(context.Background(),\n\t\t`UPDATE qr_codes SET short = $2 WHERE id = $1`, created.Codes[0].ID, short); err != nil {\n\t\tt.Fatalf(\"re-point the code's short: %v\", err)\n\t}\n\treturn created.Campaign\n}\n\n// seedSubscriber inserts one subscriber directly; short \"\" means no first touch.\nfunc seedSubscriber(t *testing.T, pool *pgxpool.Pool, short string) string {\n\tt.Helper()\n\tvar id string\n\tif err := pool.QueryRow(context.Background(), `\n\t\tINSERT INTO subscribers (display_name, email, source, source_short, joined_at)\n\t\tVALUES ('Identity Test', $1, 'web_form', NULLIF($2,''), now())\n\t\tRETURNING id::text`,\n\t\t\"ic-\"+randSuffix(t)+\"@test.invalid\", short).Scan(&id); err != nil {\n\t\tt.Fatalf(\"seedSubscriber: %v\", err)\n\t}\n\treturn id\n}\n\n// mintInTx runs MintIdentityCode in its own committed transaction.\nfunc mintInTx(t *testing.T, pool *pgxpool.Pool, subID string) IdentityCode {\n\tt.Helper()\n\tctx := context.Background()\n\ttx, err := pool.Begin(ctx)\n\tif err != nil {\n\t\tt.Fatalf(\"begin: %v\", err)\n\t}\n\tdefer func() { _ = tx.Rollback(ctx) }()\n\tcode, err := MintIdentityCode(ctx, tx, subID)\n\tif err != nil {\n\t\tt.Fatalf(\"MintIdentityCode: %v\", err)\n\t}\n\tif err := tx.Commit(ctx); err != nil {\n\t\tt.Fatalf(\"commit: %v\", err)\n\t}\n\treturn code\n}\n\nfunc storedPNG(t *testing.T, pool *pgxpool.Pool, mediaID string) []byte {\n\tt.Helper()\n\tvar png []byte\n\tif err := pool.QueryRow(context.Background(),\n\t\t`SELECT png FROM identity_media WHERE id = $1`, mediaID).Scan(&png); err != nil {\n\t\tt.Fatalf(\"read identity_media %s: %v\", mediaID, err)\n\t}\n\treturn png\n}\n\n// encodeAsTheCardDoes is the spec's encoding, restated independently of the\n// code under test: Low correction, 512 px.\nfunc encodeAsTheCardDoes(t *testing.T, payload string) (png []byte, version int) {\n\tt.Helper()\n\tq, err := qrcode.New(payload, qrcode.Low)\n\tif err != nil {\n\t\tt.Fatalf(\"encode %q: %v\", payload, err)\n\t}\n\tpng, err = q.PNG(512)\n\tif err != nil {\n\t\tt.Fatalf(\"png: %v\", err)\n\t}\n\treturn png, q.VersionNumber\n}\n\nfunc descriptorFragment(t *testing.T, label, campaignID, expires string, faceValue float64) string {\n\tt.Helper()\n\t// Key ORDER is part of the byte-for-byte comparison, so this is a struct\n\t// and not a map.\n\traw, err := json.Marshal(struct {\n\t\tLabel      string  `json:\"label\"`\n\t\tCampaignID string  `json:\"campaign_id\"`\n\t\tExpiresAt  string  `json:\"expires_at\"`\n\t\tFaceValue  float64 `json:\"face_value\"`\n\t}{label, campaignID, expires, faceValue})\n\tif err != nil {\n\t\tt.Fatalf(\"marshal descriptor: %v\", err)\n\t}\n\treturn \"#o=\" + base64.RawURLEncoding.EncodeToString(raw)\n}\n\n// A customer gets one code and keeps it: minting twice — and importing twice —\n// leaves the same hash, the same image and one image row.\nfunc TestMintIdentityCodeIsIdempotent(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tctx := context.Background()\n\td := testDeps(pool)\n\tcamp := seedFirstTouchCampaign(t, pool, mountedMux(d), \"K7MNPQ\", \"Free side of wings\", 200)\n\tsubID := seedSubscriber(t, pool, \"K7MNPQ\")\n\n\ttoken := withIdentityRand(t, 3)\n\tif len(token) != 16 {\n\t\tt.Fatalf(\"token %q is %d chars, want 16\", token, len(token))\n\t}\n\tfor _, r := range token {\n\t\tif !strings.ContainsRune(\"23456789abcdefghjkmnpqrstuvwxyz\", r) {\n\t\t\tt.Fatalf(\"token %q carries %q, which is outside the alphabet\", token, r)\n\t\t}\n\t}\n\n\tfirst := mintInTx(t, pool, subID)\n\tif !first.Minted {\n\t\tt.Error(\"first mint reported Minted=false\")\n\t}\n\tif first.TokenHash != sha256Hex(token) {\n\t\tt.Fatalf(\"token_hash = %s, want hex(sha256(token)) = %s\", first.TokenHash, sha256Hex(token))\n\t}\n\tif first.CampaignID != camp.ID {\n\t\tt.Errorf(\"CampaignID = %q, want the first-touch campaign %q\", first.CampaignID, camp.ID)\n\t}\n\tif !first.ExpiresAt.Equal(camp.EndsAt) {\n\t\tt.Errorf(\"ExpiresAt = %s, want the campaign's ends_at %s\", first.ExpiresAt, camp.EndsAt)\n\t}\n\n\tvar storedHash string\n\tvar mintedAt *time.Time\n\tif err := pool.QueryRow(ctx,\n\t\t`SELECT identity_token_hash, identity_minted_at FROM subscribers WHERE id = $1`, subID).\n\t\tScan(&storedHash, &mintedAt); err != nil {\n\t\tt.Fatalf(\"read the subscriber: %v\", err)\n\t}\n\tif storedHash != first.TokenHash || mintedAt == nil {\n\t\tt.Fatalf(\"subscriber row holds hash %q / minted_at %v, want %q and a timestamp\", storedHash, mintedAt, first.TokenHash)\n\t}\n\n\t// The stored image IS the spec's payload at the spec's encoding.\n\twantPayload := DefaultQRBaseURL + \"/r/\" + token +\n\t\tdescriptorFragment(t, \"Free side of wings\", camp.ID, camp.EndsAt.UTC().Format(\"2006-01-02\"), 2)\n\twantPNG, version := encodeAsTheCardDoes(t, wantPayload)\n\tpng := storedPNG(t, pool, first.MediaID)\n\tif !bytes.Equal(png, wantPNG) {\n\t\tt.Fatalf(\"stored PNG is not qrcode.New(%q, Low).PNG(512)\", wantPayload)\n\t}\n\tif version > 10 {\n\t\tt.Errorf(\"the card's payload encodes at version %d; the shipped reader was measured to version 10\", version)\n\t}\n\tt.Logf(\"payload %d chars, QR version %d at Low\", len(wantPayload), version)\n\n\t// 🛑 The raw token is in no row.\n\tfor _, q := range []string{\n\t\t`SELECT count(*) FROM subscribers s WHERE to_jsonb(s)::text LIKE '%' || $1 || '%'`,\n\t\t`SELECT count(*) FROM subscriber_events e WHERE to_jsonb(e)::text LIKE '%' || $1 || '%'`,\n\t} {\n\t\tif n := countRows(t, pool, q, token); n != 0 {\n\t\t\tt.Errorf(\"the raw token appears in %d row(s): %s\", n, q)\n\t\t}\n\t}\n\n\t// Mint again with a DIFFERENT random stream: nothing may move.\n\twithIdentityRand(t, 91)\n\tsecond := mintInTx(t, pool, subID)\n\tif second.Minted {\n\t\tt.Error(\"second mint reported Minted=true — it must return the existing code\")\n\t}\n\tif second.TokenHash != first.TokenHash || second.MediaID != first.MediaID {\n\t\tt.Fatalf(\"second mint = hash %s / media %s, want the first's %s / %s\",\n\t\t\tsecond.TokenHash, second.MediaID, first.TokenHash, first.MediaID)\n\t}\n\tif second.CampaignID != first.CampaignID || !second.ExpiresAt.Equal(first.ExpiresAt) {\n\t\tt.Errorf(\"second mint's campaign/expiry = %q/%s, want %q/%s\",\n\t\t\tsecond.CampaignID, second.ExpiresAt, first.CampaignID, first.ExpiresAt)\n\t}\n\tif n := countRows(t, pool, `SELECT count(*) FROM identity_media WHERE subscriber_id = $1`, subID); n != 1 {\n\t\tt.Fatalf(\"identity_media rows = %d, want 1\", n)\n\t}\n\tif !bytes.Equal(storedPNG(t, pool, first.MediaID), wantPNG) {\n\t\tt.Fatal(\"the stored PNG changed on the second mint\")\n\t}\n\n\t// And through the import: every NEW subscriber is minted, a re-import\n\t// mints nobody and rotates nothing.\n\tidentityRand = prevRandForImport(t)\n\tres, err := ImportSubscribers(ctx, d, ffImporter(t))\n\tif err != nil {\n\t\tt.Fatalf(\"first import: %v\", err)\n\t}\n\tif res.Created != 4 {\n\t\tt.Fatalf(\"first import created %d, want 4\", res.Created)\n\t}\n\tbefore := identityHashes(t, pool)\n\tif len(before) != 5 { // the four imported + the one seeded above\n\t\tt.Fatalf(\"%d subscribers carry a code after the import, want 5: %v\", len(before), before)\n\t}\n\tif _, err := ImportSubscribers(ctx, d, ffImporter(t)); err != nil {\n\t\tt.Fatalf(\"second import: %v\", err)\n\t}\n\tafter := identityHashes(t, pool)\n\tif len(after) != len(before) {\n\t\tt.Fatalf(\"re-import changed the minted count: %d → %d\", len(before), len(after))\n\t}\n\tfor id, h := range before {\n\t\tif after[id] != h {\n\t\t\tt.Errorf(\"subscriber %s's code rotated on re-import: %s → %s\", id, h, after[id])\n\t\t}\n\t}\n\tif n := countRows(t, pool, `SELECT count(*) FROM identity_media`); n != 5 {\n\t\tt.Errorf(\"identity_media rows = %d after two imports, want 5\", n)\n\t}\n}\n\n// prevRandForImport puts the real random source back for the import legs (two\n// subscribers minted from one fixed stream would collide on the unique hash,\n// which is the constraint doing its job, not the behaviour under test).\nfunc prevRandForImport(t *testing.T) io.Reader {\n\tt.Helper()\n\treturn defaultIdentityRand\n}\n\nfunc identityHashes(t *testing.T, pool *pgxpool.Pool) map[string]string {\n\tt.Helper()\n\trows, err := pool.Query(context.Background(),\n\t\t`SELECT id::text, identity_token_hash FROM subscribers WHERE identity_token_hash IS NOT NULL`)\n\tif err != nil {\n\t\tt.Fatalf(\"read hashes: %v\", err)\n\t}\n\tdefer rows.Close()\n\tout := map[string]string{}\n\tfor rows.Next() {\n\t\tvar id, h string\n\t\tif err := rows.Scan(&id, &h); err != nil {\n\t\t\tt.Fatalf(\"scan: %v\", err)\n\t\t}\n\t\tout[id] = h\n\t}\n\treturn out\n}\n\n// fakePostgREST records what the projection sent and answers with `status`.\ntype fakePostgREST struct {\n\tmu     sync.Mutex\n\tstatus int\n\thits   []recordedUpsert\n\tsrv    *httptest.Server\n}\n\ntype recordedUpsert struct {\n\tMethod, Path, Prefer, APIKey, Auth string\n\tBody                               []map[string]any\n}\n\nfunc newFakePostgREST(t *testing.T, status int) *fakePostgREST {\n\tt.Helper()\n\tf := &fakePostgREST{status: status}\n\tf.srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\traw, _ := io.ReadAll(r.Body)\n\t\tvar body []map[string]any\n\t\t_ = json.Unmarshal(raw, &body)\n\t\tf.mu.Lock()\n\t\tf.hits = append(f.hits, recordedUpsert{\n\t\t\tMethod: r.Method, Path: r.URL.Path, Prefer: r.Header.Get(\"Prefer\"),\n\t\t\tAPIKey: r.Header.Get(\"apikey\"), Auth: r.Header.Get(\"Authorization\"), Body: body,\n\t\t})\n\t\tf.mu.Unlock()\n\t\tw.WriteHeader(f.status)\n\t}))\n\tt.Cleanup(f.srv.Close)\n\treturn f\n}\n\nfunc (f *fakePostgREST) config() ProjectionConfig {\n\treturn ProjectionConfig{RESTURL: f.srv.URL, ServiceKey: \"test-service-key\"}\n}\n\nfunc (f *fakePostgREST) recorded() []recordedUpsert {\n\tf.mu.Lock()\n\tdefer f.mu.Unlock()\n\treturn append([]recordedUpsert(nil), f.hits...)\n}\n\n// A signup with no first-touch code gets a code that says who they are and\n// nothing about an offer, and no entitlement row is written anywhere.\nfunc TestMintIdentityCodeNoFirstTouchIsIdentityOnly(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tctx := context.Background()\n\tsubID := seedSubscriber(t, pool, \"\")\n\n\ttoken := withIdentityRand(t, 17)\n\tcode := mintInTx(t, pool, subID)\n\tif code.CampaignID != \"\" || !code.ExpiresAt.IsZero() {\n\t\tt.Fatalf(\"identity-only code carries campaign %q / expiry %s, want neither\", code.CampaignID, code.ExpiresAt)\n\t}\n\tif code.TokenHash != sha256Hex(token) {\n\t\tt.Fatalf(\"token_hash = %s, want %s\", code.TokenHash, sha256Hex(token))\n\t}\n\twantPayload := DefaultQRBaseURL + \"/r/\" + token\n\tif strings.Contains(wantPayload, \"#o=\") {\n\t\tt.Fatal(\"test bug: the expected identity-only payload carries a fragment\")\n\t}\n\twantPNG, version := encodeAsTheCardDoes(t, wantPayload)\n\tif !bytes.Equal(storedPNG(t, pool, code.MediaID), wantPNG) {\n\t\tt.Fatalf(\"stored PNG is not the bare %q — an identity-only code must carry no #o= fragment\", wantPayload)\n\t}\n\tt.Logf(\"identity-only payload %d chars, QR version %d\", len(wantPayload), version)\n\n\t// Through the import, with a projection that WOULD answer: the fixture's\n\t// one short (K7MNPQ) names no code here, so all four signups are\n\t// identity-only — and the substrate must hear nothing.\n\tidentityRand = defaultIdentityRand\n\tfake := newFakePostgREST(t, http.StatusCreated)\n\td := testDeps(pool)\n\td.Projection = fake.config()\n\tres, err := ImportSubscribers(ctx, d, ffImporter(t))\n\tif err != nil {\n\t\tt.Fatalf(\"import: %v\", err)\n\t}\n\tif res.Created != 4 {\n\t\tt.Fatalf(\"import created %d, want 4\", res.Created)\n\t}\n\tif n := countRows(t, pool,\n\t\t`SELECT count(*) FROM subscribers WHERE identity_token_hash IS NOT NULL AND source_short IS NULL`); n != 5 {\n\t\tt.Fatalf(\"%d identity-only subscribers minted, want 5 (four imported + one seeded)\", n)\n\t}\n\tif hits := fake.recorded(); len(hits) != 0 {\n\t\tt.Fatalf(\"the projection was called %d time(s) for identity-only codes, want 0: %+v\", len(hits), hits)\n\t}\n\tif len(res.Warnings) != 0 {\n\t\tt.Errorf(\"warnings = %v, want none — nothing was owed to the substrate\", res.Warnings)\n\t}\n\n\t// Unconfigured projection, still nothing owed: no warning either.\n\tif _, err := pool.Exec(ctx, `TRUNCATE subscriber_events, subscribers RESTART IDENTITY CASCADE`); err != nil {\n\t\tt.Fatalf(\"truncate: %v\", err)\n\t}\n\tres, err = ImportSubscribers(ctx, testDeps(pool), ffImporter(t))\n\tif err != nil {\n\t\tt.Fatalf(\"import (unconfigured): %v\", err)\n\t}\n\tif len(res.Warnings) != 0 {\n\t\tt.Errorf(\"warnings = %v with no campaign anywhere, want none\", res.Warnings)\n\t}\n}\n\n// The entitlement row the arbiter answers from: where it is written, how, and\n// what happens to the customer's code when the write fails.\nfunc TestProjectIdentityCodeUpserts(t *testing.T) {\n\tends := time.Date(2028, 1, 1, 5, 59, 59, 0, time.UTC)\n\trow := IdentityProjectionRow{\n\t\tID:         IdentityCodeID(\"0b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b\"),\n\t\tTokenHash:  sha256Hex(\"ic7k3m9q2x5p8w4z\"),\n\t\tCampaignID: \"a0000000-0000-4000-8000-000000000001\",\n\t\tExpiresAt:  ends,\n\t}\n\n\tt.Run(\"201 lands one row on /codes as a merge-duplicates upsert\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusCreated)\n\t\tif err := ProjectIdentityCode(context.Background(), fake.config(), row); err != nil {\n\t\t\tt.Fatalf(\"ProjectIdentityCode = %v, want nil on 201\", err)\n\t\t}\n\t\thits := fake.recorded()\n\t\tif len(hits) != 1 {\n\t\t\tt.Fatalf(\"%d requests, want 1\", len(hits))\n\t\t}\n\t\th := hits[0]\n\t\tif h.Method != http.MethodPost || h.Path != \"/codes\" {\n\t\t\tt.Errorf(\"request = %s %s, want POST /codes\", h.Method, h.Path)\n\t\t}\n\t\tif h.Prefer != \"resolution=merge-duplicates\" {\n\t\t\tt.Errorf(\"Prefer = %q, want resolution=merge-duplicates\", h.Prefer)\n\t\t}\n\t\tif h.APIKey != \"test-service-key\" || h.Auth != \"Bearer test-service-key\" {\n\t\t\tt.Errorf(\"apikey/Authorization = %q / %q, want the service_role key on both\", h.APIKey, h.Auth)\n\t\t}\n\t\tif len(h.Body) != 1 {\n\t\t\tt.Fatalf(\"body carries %d rows, want 1: %v\", len(h.Body), h.Body)\n\t\t}\n\t\tgot := h.Body[0]\n\t\tif len(got) != 4 {\n\t\t\tt.Errorf(\"row has %d fields (%v), want exactly id, token_hash, campaign_id, expires_at\", len(got), got)\n\t\t}\n\t\tif got[\"id\"] != row.ID || got[\"token_hash\"] != row.TokenHash || got[\"campaign_id\"] != row.CampaignID {\n\t\t\tt.Errorf(\"row = %v, want id %s / token_hash %s / campaign_id %s\", got, row.ID, row.TokenHash, row.CampaignID)\n\t\t}\n\t\texp, _ := got[\"expires_at\"].(string)\n\t\tparsed, err := time.Parse(time.RFC3339, exp)\n\t\tif err != nil || !parsed.Equal(ends) {\n\t\t\tt.Errorf(\"expires_at = %q, want the campaign's ends_at %s as RFC 3339\", exp, ends)\n\t\t}\n\t})\n\n\tt.Run(\"the id is derived from the subscriber, so a re-projection is the same row\", func(t *testing.T) {\n\t\ta := IdentityCodeID(\"0b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b\")\n\t\tb := IdentityCodeID(\"0B6F2C1E-6F0A-4F6E-9C59-0C1D2E3F4A5B\")\n\t\tc := IdentityCodeID(\"1b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b\")\n\t\tif a != b {\n\t\t\tt.Errorf(\"the id depends on the subscriber id's letter case: %s vs %s\", a, b)\n\t\t}\n\t\tif a == c {\n\t\t\tt.Error(\"two subscribers derived the same code id\")\n\t\t}\n\t\tif len(a) != 36 || a[14] != '5' || !strings.ContainsRune(\"89ab\", rune(a[19])) {\n\t\t\tt.Errorf(\"%s is not a version-5 uuid\", a)\n\t\t}\n\t})\n\n\tt.Run(\"500 is an error and unconfigured is an error\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusInternalServerError)\n\t\tif err := ProjectIdentityCode(context.Background(), fake.config(), row); err == nil {\n\t\t\tt.Error(\"ProjectIdentityCode = nil on a 500\")\n\t\t}\n\t\tif err := ProjectIdentityCode(context.Background(), ProjectionConfig{}, row); err == nil {\n\t\t\tt.Error(\"ProjectIdentityCode = nil with the projection unconfigured\")\n\t\t}\n\t})\n\n\t// The same three outcomes through the import, against a real database.\n\timportWith := func(t *testing.T, cfg ProjectionConfig) (importResultDTO, campaignDTO, string, string) {\n\t\tt.Helper()\n\t\tpool := setupSubsTestDB(t)\n\t\td := testDeps(pool)\n\t\tcamp := seedFirstTouchCampaign(t, pool, mountedMux(d), \"K7MNPQ\", \"Free side of wings\", 200)\n\t\td.Projection = cfg\n\t\tres, err := ImportSubscribers(context.Background(), d, ffImporter(t))\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"import: %v\", err)\n\t\t}\n\t\tvar subID string\n\t\tvar hash *string\n\t\tif err := pool.QueryRow(context.Background(),\n\t\t\t`SELECT id::text, identity_token_hash FROM subscribers WHERE external_ref = '1182'`).\n\t\t\tScan(&subID, &hash); err != nil {\n\t\t\tt.Fatalf(\"read the first-touch subscriber: %v\", err)\n\t\t}\n\t\tif hash == nil {\n\t\t\tt.Fatal(\"the first-touch subscriber has no identity_token_hash — the mint did not commit\")\n\t\t}\n\t\tif n := countRows(t, pool, `SELECT count(*) FROM identity_media WHERE subscriber_id = $1`, subID); n != 1 {\n\t\t\tt.Fatalf(\"identity_media rows for the first-touch subscriber = %d, want 1\", n)\n\t\t}\n\t\tif n := countRows(t, pool, `SELECT count(*) FROM subscribers WHERE identity_token_hash IS NULL`); n != 0 {\n\t\t\tt.Fatalf(\"%d imported subscribers were left without a code\", n)\n\t\t}\n\t\treturn res, camp, subID, *hash\n\t}\n\n\tt.Run(\"import: a 201 projects the first-touch code and only that one\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusCreated)\n\t\tres, camp, subID, hash := importWith(t, fake.config())\n\t\tif len(res.Warnings) != 0 {\n\t\t\tt.Errorf(\"warnings = %v, want none\", res.Warnings)\n\t\t}\n\t\thits := fake.recorded()\n\t\tif len(hits) != 1 {\n\t\t\tt.Fatalf(\"%d projection requests, want 1 (three of the four signups are identity-only)\", len(hits))\n\t\t}\n\t\tgot := hits[0].Body[0]\n\t\tif got[\"id\"] != IdentityCodeID(subID) || got[\"token_hash\"] != hash || got[\"campaign_id\"] != camp.ID {\n\t\t\tt.Errorf(\"projected row = %v, want id %s / hash %s / campaign %s\", got, IdentityCodeID(subID), hash, camp.ID)\n\t\t}\n\t\texp, _ := got[\"expires_at\"].(string)\n\t\tif parsed, err := time.Parse(time.RFC3339, exp); err != nil || !parsed.Equal(camp.EndsAt) {\n\t\t\tt.Errorf(\"projected expires_at = %q, want the campaign's ends_at %s\", exp, camp.EndsAt)\n\t\t}\n\t})\n\n\tt.Run(\"import: a 500 keeps the mint and says not_projected\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusInternalServerError)\n\t\tres, _, _, _ := importWith(t, fake.config()) // importWith asserts the mint committed\n\t\tif len(res.Warnings) != 1 || res.Warnings[0] != WarningNotProjected {\n\t\t\tt.Fatalf(\"warnings = %v, want [%q]\", res.Warnings, WarningNotProjected)\n\t\t}\n\t})\n\n\tt.Run(\"import: an unconfigured projection keeps the mint and says not_projected\", func(t *testing.T) {\n\t\tres, _, _, _ := importWith(t, ProjectionConfig{})\n\t\tif len(res.Warnings) != 1 || res.Warnings[0] != WarningNotProjected {\n\t\t\tt.Fatalf(\"warnings = %v, want [%q]\", res.Warnings, WarningNotProjected)\n\t\t}\n\t})\n}\n\n// GET and HEAD /m/{id}.png: public, image/png, privately cached for an hour,\n// and 404 for anything that is not a stored image.\nfunc TestIdentityMediaRouteIsPublicPNG(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tmux := mountedMux(testDeps(pool))\n\tcode := mintInTx(t, pool, seedSubscriber(t, pool, \"\"))\n\twant := storedPNG(t, pool, code.MediaID)\n\n\t// context.Background(): no user, no session — the route is public.\n\trec := do(t, mux, context.Background(), http.MethodGet, \"/m/\"+code.MediaID+\".png\", nil)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"GET = %d, want 200\\nbody: %s\", rec.Code, rec.Body.String())\n\t}\n\tif ct := rec.Header().Get(\"Content-Type\"); ct != \"image/png\" {\n\t\tt.Errorf(\"Content-Type = %q, want image/png\", ct)\n\t}\n\tif cc := rec.Header().Get(\"Cache-Control\"); cc != \"private, max-age=3600\" {\n\t\tt.Errorf(\"Cache-Control = %q, want private, max-age=3600\", cc)\n\t}\n\tif !bytes.Equal(rec.Body.Bytes(), want) {\n\t\tt.Error(\"GET body is not the stored PNG\")\n\t}\n\tif !bytes.HasPrefix(rec.Body.Bytes(), []byte(\"\\x89PNG\\r\\n\\x1a\\n\")) {\n\t\tt.Error(\"GET body does not start with the PNG signature\")\n\t}\n\n\thead := do(t, mux, context.Background(), http.MethodHead, \"/m/\"+code.MediaID+\".png\", nil)\n\tif head.Code != http.StatusOK || head.Body.Len() != 0 {\n\t\tt.Errorf(\"HEAD = %d with %d body bytes, want 200 and none\", head.Code, head.Body.Len())\n\t}\n\tif cl := head.Header().Get(\"Content-Length\"); cl != strconv.Itoa(len(want)) {\n\t\tt.Errorf(\"HEAD Content-Length = %q, want %d\", cl, len(want))\n\t}\n\n\tfor _, id := range []string{\"00000000-0000-4000-8000-000000000000\", \"not-a-uuid\", code.MediaID + \"x\"} {\n\t\tfor _, method := range []string{http.MethodGet, http.MethodHead} {\n\t\t\tif rec := do(t, mux, context.Background(), method, \"/m/\"+id+\".png\", nil); rec.Code != http.StatusNotFound {\n\t\t\t\tt.Errorf(\"%s /m/%s.png = %d, want 404\", method, id, rec.Code)\n\t\t\t}\n\t\t}\n\t}\n}\n\n// The detail sheet's status: no code, a code, a code that was sent.\nfunc TestSubscriberDetailReportsIdentityCodeStatus(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tctx := context.Background()\n\tmgr := seedUser(t, pool, \"manager\")\n\tmux := mountedMux(testDeps(pool))\n\tsubID := seedSubscriber(t, pool, \"\")\n\n\tdetail := func() identityCodeDTO {\n\t\trec := do(t, mux, userCtx(mgr, \"manager\"), http.MethodGet, \"/api/v1/marketing/subscribers/\"+subID, nil)\n\t\tif rec.Code != http.StatusOK {\n\t\t\tt.Fatalf(\"GET detail = %d\\nbody: %s\", rec.Code, rec.Body.String())\n\t\t}\n\t\tvar out subscriberDetailDTO\n\t\tdecode(t, rec, &out)\n\t\treturn out.IdentityCode\n\t}\n\n\tif ic := detail(); ic.Status != \"not_minted\" || ic.MediaURL != nil {\n\t\tt.Fatalf(\"before the mint: status %q / media_url %v, want not_minted / null\", ic.Status, ic.MediaURL)\n\t}\n\tcode := mintInTx(t, pool, subID)\n\tic := detail()\n\tif ic.Status != \"minted\" {\n\t\tt.Fatalf(\"after the mint: status %q, want minted\", ic.Status)\n\t}\n\tif ic.MediaURL == nil || *ic.MediaURL != \"/m/\"+code.MediaID+\".png\" {\n\t\tt.Fatalf(\"media_url = %v, want /m/%s.png\", ic.MediaURL, code.MediaID)\n\t}\n\tif rec := do(t, mux, context.Background(), http.MethodGet, *ic.MediaURL, nil); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"GET media_url = %d, want 200\", rec.Code)\n\t}\n\t// `sent` is Card 2's to cause; this card only reports it.\n\tif _, err := pool.Exec(ctx,\n\t\t`INSERT INTO subscriber_events (subscriber_id, kind) VALUES ($1, 'code_sent')`, subID); err != nil {\n\t\tt.Fatalf(\"seed code_sent: %v\", err)\n\t}\n\tif ic := detail(); ic.Status != \"sent\" || ic.SentAt == nil || ic.MediaURL == nil {\n\t\tt.Fatalf(\"after a code_sent event: status %q / sent_at %v / media_url %v, want sent with both\", ic.Status, ic.SentAt, ic.MediaURL)\n\t}\n}\n\n// The shipped reader was measured up to QR version 10. A campaign with a long\n// offer line must not push a customer's code past that: the label in the QR is\n// shortened, the code itself is not weakened.\nfunc TestIdentityCodeLongOfferTextStaysScannable(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tlong := \"Buy any two combos and get a free large side of our signature honey-garlic wings plus a drink\"\n\tcamp := seedFirstTouchCampaign(t, pool, mountedMux(testDeps(pool)), \"K7MNPQ\", long, 1250)\n\tsubID := seedSubscriber(t, pool, \"K7MNPQ\")\n\n\ttoken := withIdentityRand(t, 44)\n\tcode := mintInTx(t, pool, subID)\n\tpng := storedPNG(t, pool, code.MediaID)\n\n\t// Find the label the mint settled on: the longest prefix whose payload\n\t// reproduces the stored PNG.\n\trunes := []rune(long)\n\tfor n := len(runes); n >= 1; n-- {\n\t\tlabel := string(runes[:n])\n\t\tif n < len(runes) {\n\t\t\tlabel = strings.TrimRight(label, \" \") + \"…\"\n\t\t}\n\t\tpayload := DefaultQRBaseURL + \"/r/\" + token +\n\t\t\tdescriptorFragment(t, label, camp.ID, camp.EndsAt.UTC().Format(\"2006-01-02\"), 12.5)\n\t\twant, version := encodeAsTheCardDoes(t, payload)\n\t\tif !bytes.Equal(png, want) {\n\t\t\tcontinue\n\t\t}\n\t\tif n == len(runes) {\n\t\t\tt.Fatalf(\"the full %d-char offer text was encoded at version %d — expected it to be shortened\", len(runes), version)\n\t\t}\n\t\tif version > 10 {\n\t\t\tt.Fatalf(\"label shortened to %q but the symbol is still version %d\", label, version)\n\t\t}\n\t\tt.Logf(\"label shortened to %d of %d chars (%q); payload %d chars, version %d\", n, len(runes), label, len(payload), version)\n\t\treturn\n\t}\n\tt.Fatal(\"the stored PNG matches no prefix of the offer text — the label rule is not the one this test states\")\n}\n\n// 0088's Down, run: the two columns and the image table go, `subscribers`\n// itself stays, and re-applying brings them back with the cascade and the\n// unique hash intact.\n//\n// Same rules as the 0085 and 0086 legs: start from HEAD, derive the version\n// from the filename, restore with db.Migrate (never a literal), touch no row.\nfunc TestMigration0088IdentityCodesDownAndUpRoundTrip(t *testing.T) {\n\tif testPool == nil {\n\t\tt.Skip(\"no test database (DB_TEST_URL unset and the local fallback is unreachable)\")\n\t}\n\tpool := testPool\n\tctx := context.Background()\n\tif err := db.Migrate(pool); err != nil {\n\t\tt.Fatalf(\"migrate up to HEAD before the down leg: %v\", err)\n\t}\n\tt.Cleanup(func() {\n\t\tif err := db.Migrate(pool); err != nil {\n\t\t\tt.Errorf(\"restore to HEAD: %v\", err)\n\t\t}\n\t})\n\n\tversion := identityMigrationVersion(t)\n\tif version != 88 {\n\t\tt.Fatalf(\"*_identity_codes.sql is migration %d; the slate fixes it at 88 (a renumbering is scope drift)\", version)\n\t}\n\n\ttableExists := func(name string) bool {\n\t\tvar ok bool\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT EXISTS (SELECT 1 FROM information_schema.tables\n\t\t\t                WHERE table_schema = current_schema() AND table_name = $1)`, name).Scan(&ok); err != nil {\n\t\t\tt.Fatalf(\"tableExists(%s): %v\", name, err)\n\t\t}\n\t\treturn ok\n\t}\n\tcolumnExists := func(table, column string) bool {\n\t\tvar ok bool\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT EXISTS (SELECT 1 FROM information_schema.columns\n\t\t\t                WHERE table_schema = current_schema() AND table_name = $1 AND column_name = $2)`,\n\t\t\ttable, column).Scan(&ok); err != nil {\n\t\t\tt.Fatalf(\"columnExists(%s.%s): %v\", table, column, err)\n\t\t}\n\t\treturn ok\n\t}\n\tassertUp := func(leg string) {\n\t\tt.Helper()\n\t\tif !tableExists(\"identity_media\") {\n\t\t\tt.Errorf(\"%s: identity_media is missing\", leg)\n\t\t}\n\t\tfor _, c := range []string{\"identity_token_hash\", \"identity_minted_at\"} {\n\t\t\tif !columnExists(\"subscribers\", c) {\n\t\t\t\tt.Errorf(\"%s: subscribers.%s is missing\", leg, c)\n\t\t\t}\n\t\t}\n\t\t// The erasure path: deleting a subscriber deletes their image.\n\t\tvar del string\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT confdeltype::text FROM pg_constraint\n\t\t\t WHERE conrelid = 'identity_media'::regclass AND contype = 'f'\n\t\t\t   AND confrelid = 'subscribers'::regclass`).Scan(&del); err != nil {\n\t\t\tt.Errorf(\"%s: read identity_media's FK onto subscribers: %v\", leg, err)\n\t\t} else if del != \"c\" {\n\t\t\tt.Errorf(\"%s: identity_media → subscribers is ON DELETE %q, want c (cascade)\", leg, del)\n\t\t}\n\t\t// Two customers can never share a code.\n\t\tvar uniques int\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT count(*) FROM pg_constraint c\n\t\t\t  JOIN pg_attribute a ON a.attrelid = c.conrelid AND a.attnum = ANY (c.conkey)\n\t\t\t WHERE c.conrelid = 'subscribers'::regclass AND c.contype = 'u'\n\t\t\t   AND a.attname = 'identity_token_hash'`).Scan(&uniques); err != nil {\n\t\t\tt.Errorf(\"%s: read the unique constraint: %v\", leg, err)\n\t\t} else if uniques != 1 {\n\t\t\tt.Errorf(\"%s: %d unique constraints on subscribers.identity_token_hash, want 1\", leg, uniques)\n\t\t}\n\t}\n\n\tassertUp(\"at HEAD\")\n\n\tif err := db.MigrateTo(pool, version-1); err != nil {\n\t\tt.Fatalf(\"migrate down to %d: %v\", version-1, err)\n\t}\n\tif tableExists(\"identity_media\") {\n\t\tt.Errorf(\"identity_media survived migration %d's Down\", version)\n\t}\n\tfor _, c := range []string{\"identity_token_hash\", \"identity_minted_at\"} {\n\t\tif columnExists(\"subscribers\", c) {\n\t\t\tt.Errorf(\"subscribers.%s survived migration %d's Down\", c, version)\n\t\t}\n\t}\n\tif !tableExists(\"subscribers\") || !columnExists(\"subscribers\", \"source_short\") {\n\t\tt.Fatalf(\"migration %d's Down took more than its own: subscribers (or its 0085 columns) is gone\", version)\n\t}\n\n\tif err := db.Migrate(pool); err != nil {\n\t\tt.Fatalf(\"migrate back up to HEAD: %v\", err)\n\t}\n\tassertUp(\"after re-apply\")\n\tt.Logf(\"migration %d Down/Up round-trip clean; schema restored to HEAD (not to a literal)\", version)\n}\n\nfunc identityMigrationVersion(t *testing.T) int64 {\n\tt.Helper()\n\tentries, err := os.ReadDir(migrationsDir)\n\tif err != nil {\n\t\tt.Fatalf(\"read %s: %v\", migrationsDir, err)\n\t}\n\tfor _, e := range entries {\n\t\tif !strings.HasSuffix(e.Name(), \"_identity_codes.sql\") {\n\t\t\tcontinue\n\t\t}\n\t\tm := migrationNumRe.FindStringSubmatch(e.Name())\n\t\tif m == nil {\n\t\t\tt.Fatalf(\"migration %q does not start with a version number\", e.Name())\n\t\t}\n\t\tv, err := strconv.ParseInt(m[1], 10, 64)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"parse version from %q: %v\", e.Name(), err)\n\t\t}\n\t\treturn v\n\t}\n\tt.Fatalf(\"no *_identity_codes.sql migration found in %s\", migrationsDir)\n\treturn 0\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":412,"cache_read_input_tokens":193796,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":412},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"792dcbd6-aa1d-4c6e-83da-0e3997c4c9b1","uuid":"08e32b58-a0cb-49f2-9b14-144cf67260bd","timestamp":"2026-10-05T23:45:24.117Z","request_id":"req_011CfjyfurKtEUYypvcBYBU3","wire_tool_inputs":{"toolu_01HC6Yikx5mX8SNyRBPvu8A1":{"file_path":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/backend/internal/marketing/identity_test.go","content":"package marketing\n\n// identity_test.go — card E1 (`identity-code-and-qr`, roadmap Activity E).\n//\n// The five named gates, and three that ride with them:\n//\n//\tTestMintIdentityCodeIsIdempotent                  one code per customer, for good\n//\tTestMintIdentityCodeNoFirstTouchIsIdentityOnly    no campaign → no offer in the QR, nothing projected\n//\tTestProjectIdentityCodeUpserts                    the arbiter row, and a failed projection keeps the mint\n//\tTestMigration0088IdentityCodesDownAndUpRoundTrip  0088's Down, run\n//\t(TestNothingInThisPackageSends is subscribers_test.go's, unedited)\n//\n//\tTestIdentityMediaRouteIsPublicPNG                 GET/HEAD /m/{id}.png\n//\tTestSubscriberDetailReportsIdentityCodeStatus     not_minted → minted → sent\n//\tTestIdentityCodeLongOfferTextStaysScannable       a long offer never produces a denser symbol\n//\n// 🛑 No test here learns a token from the database — there is none there. The\n// token is fixed by handing the mint a known random stream (withIdentityRand),\n// and every claim about the QR is made by re-encoding the expected payload and\n// comparing it to the stored PNG byte for byte.\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/go-chi/chi/v5\"\n\t\"github.com/jackc/pgx/v5/pgxpool\"\n\tqrcode \"github.com/skip2/go-qrcode\"\n\t\"github.com/yumyums/hq/internal/db\"\n)\n\n// withIdentityRand swaps the mint's random source for a fixed stream and\n// returns the token that stream produces, so a test knows the token without it\n// ever having been stored.\nfunc withIdentityRand(t *testing.T, seed byte) string {\n\tt.Helper()\n\tstream := make([]byte, 256)\n\tfor i := range stream {\n\t\tstream[i] = seed + byte(i*7)\n\t}\n\ttoken, err := newIdentityToken(bytes.NewReader(stream))\n\tif err != nil {\n\t\tt.Fatalf(\"newIdentityToken on the fixed stream: %v\", err)\n\t}\n\tprev := identityRand\n\tidentityRand = bytes.NewReader(stream)\n\tt.Cleanup(func() { identityRand = prev })\n\treturn token\n}\n\nfunc sha256Hex(s string) string {\n\tsum := sha256.Sum256([]byte(s))\n\treturn hex.EncodeToString(sum[:])\n}\n\n// seedFirstTouchCampaign creates a campaign through the real route and\n// re-points its first code's short, returning the campaign.\nfunc seedFirstTouchCampaign(t *testing.T, pool *pgxpool.Pool, mux *chi.Mux, short, offerText string, cents int) campaignDTO {\n\tt.Helper()\n\tmgr := seedUser(t, pool, \"manager\")\n\tcreated := createCampaign(t, mux, mgr, map[string]any{\n\t\t\"name\": \"Wing Wednesday \" + randSuffix(t), \"offer_text\": offerText,\n\t\t\"face_value_cents\": cents, \"runs_days\": 14,\n\t\t\"channels\": []map[string]any{{\"channel\": \"flyer\"}},\n\t})\n\tif _, err := pool.Exec(context.Background(),\n\t\t`UPDATE qr_codes SET short = $2 WHERE id = $1`, created.Codes[0].ID, short); err != nil {\n\t\tt.Fatalf(\"re-point the code's short: %v\", err)\n\t}\n\treturn created.Campaign\n}\n\n// seedSubscriber inserts one subscriber directly; short \"\" means no first touch.\nfunc seedSubscriber(t *testing.T, pool *pgxpool.Pool, short string) string {\n\tt.Helper()\n\tvar id string\n\tif err := pool.QueryRow(context.Background(), `\n\t\tINSERT INTO subscribers (display_name, email, source, source_short, joined_at)\n\t\tVALUES ('Identity Test', $1, 'web_form', NULLIF($2,''), now())\n\t\tRETURNING id::text`,\n\t\t\"ic-\"+randSuffix(t)+\"@test.invalid\", short).Scan(&id); err != nil {\n\t\tt.Fatalf(\"seedSubscriber: %v\", err)\n\t}\n\treturn id\n}\n\n// mintInTx runs MintIdentityCode in its own committed transaction.\nfunc mintInTx(t *testing.T, pool *pgxpool.Pool, subID string) IdentityCode {\n\tt.Helper()\n\tctx := context.Background()\n\ttx, err := pool.Begin(ctx)\n\tif err != nil {\n\t\tt.Fatalf(\"begin: %v\", err)\n\t}\n\tdefer func() { _ = tx.Rollback(ctx) }()\n\tcode, err := MintIdentityCode(ctx, tx, subID)\n\tif err != nil {\n\t\tt.Fatalf(\"MintIdentityCode: %v\", err)\n\t}\n\tif err := tx.Commit(ctx); err != nil {\n\t\tt.Fatalf(\"commit: %v\", err)\n\t}\n\treturn code\n}\n\nfunc storedPNG(t *testing.T, pool *pgxpool.Pool, mediaID string) []byte {\n\tt.Helper()\n\tvar png []byte\n\tif err := pool.QueryRow(context.Background(),\n\t\t`SELECT png FROM identity_media WHERE id = $1`, mediaID).Scan(&png); err != nil {\n\t\tt.Fatalf(\"read identity_media %s: %v\", mediaID, err)\n\t}\n\treturn png\n}\n\n// encodeAsTheCardDoes is the spec's encoding, restated independently of the\n// code under test: Low correction, 512 px.\nfunc encodeAsTheCardDoes(t *testing.T, payload string) (png []byte, version int) {\n\tt.Helper()\n\tq, err := qrcode.New(payload, qrcode.Low)\n\tif err != nil {\n\t\tt.Fatalf(\"encode %q: %v\", payload, err)\n\t}\n\tpng, err = q.PNG(512)\n\tif err != nil {\n\t\tt.Fatalf(\"png: %v\", err)\n\t}\n\treturn png, q.VersionNumber\n}\n\nfunc descriptorFragment(t *testing.T, label, campaignID, expires string, faceValue float64) string {\n\tt.Helper()\n\t// Key ORDER is part of the byte-for-byte comparison, so this is a struct\n\t// and not a map.\n\traw, err := json.Marshal(struct {\n\t\tLabel      string  `json:\"label\"`\n\t\tCampaignID string  `json:\"campaign_id\"`\n\t\tExpiresAt  string  `json:\"expires_at\"`\n\t\tFaceValue  float64 `json:\"face_value\"`\n\t}{label, campaignID, expires, faceValue})\n\tif err != nil {\n\t\tt.Fatalf(\"marshal descriptor: %v\", err)\n\t}\n\treturn \"#o=\" + base64.RawURLEncoding.EncodeToString(raw)\n}\n\n// A customer gets one code and keeps it: minting twice — and importing twice —\n// leaves the same hash, the same image and one image row.\nfunc TestMintIdentityCodeIsIdempotent(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tctx := context.Background()\n\td := testDeps(pool)\n\tcamp := seedFirstTouchCampaign(t, pool, mountedMux(d), \"K7MNPQ\", \"Free side of wings\", 200)\n\tsubID := seedSubscriber(t, pool, \"K7MNPQ\")\n\n\ttoken := withIdentityRand(t, 3)\n\tif len(token) != 16 {\n\t\tt.Fatalf(\"token %q is %d chars, want 16\", token, len(token))\n\t}\n\tfor _, r := range token {\n\t\tif !strings.ContainsRune(\"23456789abcdefghjkmnpqrstuvwxyz\", r) {\n\t\t\tt.Fatalf(\"token %q carries %q, which is outside the alphabet\", token, r)\n\t\t}\n\t}\n\n\tfirst := mintInTx(t, pool, subID)\n\tif !first.Minted {\n\t\tt.Error(\"first mint reported Minted=false\")\n\t}\n\tif first.TokenHash != sha256Hex(token) {\n\t\tt.Fatalf(\"token_hash = %s, want hex(sha256(token)) = %s\", first.TokenHash, sha256Hex(token))\n\t}\n\tif first.CampaignID != camp.ID {\n\t\tt.Errorf(\"CampaignID = %q, want the first-touch campaign %q\", first.CampaignID, camp.ID)\n\t}\n\tif !first.ExpiresAt.Equal(camp.EndsAt) {\n\t\tt.Errorf(\"ExpiresAt = %s, want the campaign's ends_at %s\", first.ExpiresAt, camp.EndsAt)\n\t}\n\n\tvar storedHash string\n\tvar mintedAt *time.Time\n\tif err := pool.QueryRow(ctx,\n\t\t`SELECT identity_token_hash, identity_minted_at FROM subscribers WHERE id = $1`, subID).\n\t\tScan(&storedHash, &mintedAt); err != nil {\n\t\tt.Fatalf(\"read the subscriber: %v\", err)\n\t}\n\tif storedHash != first.TokenHash || mintedAt == nil {\n\t\tt.Fatalf(\"subscriber row holds hash %q / minted_at %v, want %q and a timestamp\", storedHash, mintedAt, first.TokenHash)\n\t}\n\n\t// The stored image IS the spec's payload at the spec's encoding.\n\twantPayload := DefaultQRBaseURL + \"/r/\" + token +\n\t\tdescriptorFragment(t, \"Free side of wings\", camp.ID, camp.EndsAt.UTC().Format(\"2006-01-02\"), 2)\n\twantPNG, version := encodeAsTheCardDoes(t, wantPayload)\n\tpng := storedPNG(t, pool, first.MediaID)\n\tif !bytes.Equal(png, wantPNG) {\n\t\tt.Fatalf(\"stored PNG is not qrcode.New(%q, Low).PNG(512)\", wantPayload)\n\t}\n\tif version > 10 {\n\t\tt.Errorf(\"the card's payload encodes at version %d; the shipped reader was measured to version 10\", version)\n\t}\n\tt.Logf(\"payload %d chars, QR version %d at Low\", len(wantPayload), version)\n\n\t// 🛑 The raw token is in no row.\n\tfor _, q := range []string{\n\t\t`SELECT count(*) FROM subscribers s WHERE to_jsonb(s)::text LIKE '%' || $1 || '%'`,\n\t\t`SELECT count(*) FROM subscriber_events e WHERE to_jsonb(e)::text LIKE '%' || $1 || '%'`,\n\t} {\n\t\tif n := countRows(t, pool, q, token); n != 0 {\n\t\t\tt.Errorf(\"the raw token appears in %d row(s): %s\", n, q)\n\t\t}\n\t}\n\n\t// Mint again with a DIFFERENT random stream: nothing may move.\n\twithIdentityRand(t, 91)\n\tsecond := mintInTx(t, pool, subID)\n\tif second.Minted {\n\t\tt.Error(\"second mint reported Minted=true — it must return the existing code\")\n\t}\n\tif second.TokenHash != first.TokenHash || second.MediaID != first.MediaID {\n\t\tt.Fatalf(\"second mint = hash %s / media %s, want the first's %s / %s\",\n\t\t\tsecond.TokenHash, second.MediaID, first.TokenHash, first.MediaID)\n\t}\n\tif second.CampaignID != first.CampaignID || !second.ExpiresAt.Equal(first.ExpiresAt) {\n\t\tt.Errorf(\"second mint's campaign/expiry = %q/%s, want %q/%s\",\n\t\t\tsecond.CampaignID, second.ExpiresAt, first.CampaignID, first.ExpiresAt)\n\t}\n\tif n := countRows(t, pool, `SELECT count(*) FROM identity_media WHERE subscriber_id = $1`, subID); n != 1 {\n\t\tt.Fatalf(\"identity_media rows = %d, want 1\", n)\n\t}\n\tif !bytes.Equal(storedPNG(t, pool, first.MediaID), wantPNG) {\n\t\tt.Fatal(\"the stored PNG changed on the second mint\")\n\t}\n\n\t// And through the import: every NEW subscriber is minted, a re-import\n\t// mints nobody and rotates nothing.\n\tidentityRand = prevRandForImport(t)\n\tres, err := ImportSubscribers(ctx, d, ffImporter(t))\n\tif err != nil {\n\t\tt.Fatalf(\"first import: %v\", err)\n\t}\n\tif res.Created != 4 {\n\t\tt.Fatalf(\"first import created %d, want 4\", res.Created)\n\t}\n\tbefore := identityHashes(t, pool)\n\tif len(before) != 5 { // the four imported + the one seeded above\n\t\tt.Fatalf(\"%d subscribers carry a code after the import, want 5: %v\", len(before), before)\n\t}\n\tif _, err := ImportSubscribers(ctx, d, ffImporter(t)); err != nil {\n\t\tt.Fatalf(\"second import: %v\", err)\n\t}\n\tafter := identityHashes(t, pool)\n\tif len(after) != len(before) {\n\t\tt.Fatalf(\"re-import changed the minted count: %d → %d\", len(before), len(after))\n\t}\n\tfor id, h := range before {\n\t\tif after[id] != h {\n\t\t\tt.Errorf(\"subscriber %s's code rotated on re-import: %s → %s\", id, h, after[id])\n\t\t}\n\t}\n\tif n := countRows(t, pool, `SELECT count(*) FROM identity_media`); n != 5 {\n\t\tt.Errorf(\"identity_media rows = %d after two imports, want 5\", n)\n\t}\n}\n\n// prevRandForImport puts the real random source back for the import legs (two\n// subscribers minted from one fixed stream would collide on the unique hash,\n// which is the constraint doing its job, not the behaviour under test).\nfunc prevRandForImport(t *testing.T) io.Reader {\n\tt.Helper()\n\treturn defaultIdentityRand\n}\n\nfunc identityHashes(t *testing.T, pool *pgxpool.Pool) map[string]string {\n\tt.Helper()\n\trows, err := pool.Query(context.Background(),\n\t\t`SELECT id::text, identity_token_hash FROM subscribers WHERE identity_token_hash IS NOT NULL`)\n\tif err != nil {\n\t\tt.Fatalf(\"read hashes: %v\", err)\n\t}\n\tdefer rows.Close()\n\tout := map[string]string{}\n\tfor rows.Next() {\n\t\tvar id, h string\n\t\tif err := rows.Scan(&id, &h); err != nil {\n\t\t\tt.Fatalf(\"scan: %v\", err)\n\t\t}\n\t\tout[id] = h\n\t}\n\treturn out\n}\n\n// fakePostgREST records what the projection sent and answers with `status`.\ntype fakePostgREST struct {\n\tmu     sync.Mutex\n\tstatus int\n\thits   []recordedUpsert\n\tsrv    *httptest.Server\n}\n\ntype recordedUpsert struct {\n\tMethod, Path, Prefer, APIKey, Auth string\n\tBody                               []map[string]any\n}\n\nfunc newFakePostgREST(t *testing.T, status int) *fakePostgREST {\n\tt.Helper()\n\tf := &fakePostgREST{status: status}\n\tf.srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\traw, _ := io.ReadAll(r.Body)\n\t\tvar body []map[string]any\n\t\t_ = json.Unmarshal(raw, &body)\n\t\tf.mu.Lock()\n\t\tf.hits = append(f.hits, recordedUpsert{\n\t\t\tMethod: r.Method, Path: r.URL.Path, Prefer: r.Header.Get(\"Prefer\"),\n\t\t\tAPIKey: r.Header.Get(\"apikey\"), Auth: r.Header.Get(\"Authorization\"), Body: body,\n\t\t})\n\t\tf.mu.Unlock()\n\t\tw.WriteHeader(f.status)\n\t}))\n\tt.Cleanup(f.srv.Close)\n\treturn f\n}\n\nfunc (f *fakePostgREST) config() ProjectionConfig {\n\treturn ProjectionConfig{RESTURL: f.srv.URL, ServiceKey: \"test-service-key\"}\n}\n\nfunc (f *fakePostgREST) recorded() []recordedUpsert {\n\tf.mu.Lock()\n\tdefer f.mu.Unlock()\n\treturn append([]recordedUpsert(nil), f.hits...)\n}\n\n// A signup with no first-touch code gets a code that says who they are and\n// nothing about an offer, and no entitlement row is written anywhere.\nfunc TestMintIdentityCodeNoFirstTouchIsIdentityOnly(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tctx := context.Background()\n\tsubID := seedSubscriber(t, pool, \"\")\n\n\ttoken := withIdentityRand(t, 17)\n\tcode := mintInTx(t, pool, subID)\n\tif code.CampaignID != \"\" || !code.ExpiresAt.IsZero() {\n\t\tt.Fatalf(\"identity-only code carries campaign %q / expiry %s, want neither\", code.CampaignID, code.ExpiresAt)\n\t}\n\tif code.TokenHash != sha256Hex(token) {\n\t\tt.Fatalf(\"token_hash = %s, want %s\", code.TokenHash, sha256Hex(token))\n\t}\n\twantPayload := DefaultQRBaseURL + \"/r/\" + token\n\tif strings.Contains(wantPayload, \"#o=\") {\n\t\tt.Fatal(\"test bug: the expected identity-only payload carries a fragment\")\n\t}\n\twantPNG, version := encodeAsTheCardDoes(t, wantPayload)\n\tif !bytes.Equal(storedPNG(t, pool, code.MediaID), wantPNG) {\n\t\tt.Fatalf(\"stored PNG is not the bare %q — an identity-only code must carry no #o= fragment\", wantPayload)\n\t}\n\tt.Logf(\"identity-only payload %d chars, QR version %d\", len(wantPayload), version)\n\n\t// Through the import, with a projection that WOULD answer: the fixture's\n\t// one short (K7MNPQ) names no code here, so all four signups are\n\t// identity-only — and the substrate must hear nothing.\n\tidentityRand = defaultIdentityRand\n\tfake := newFakePostgREST(t, http.StatusCreated)\n\td := testDeps(pool)\n\td.Projection = fake.config()\n\tres, err := ImportSubscribers(ctx, d, ffImporter(t))\n\tif err != nil {\n\t\tt.Fatalf(\"import: %v\", err)\n\t}\n\tif res.Created != 4 {\n\t\tt.Fatalf(\"import created %d, want 4\", res.Created)\n\t}\n\tif n := countRows(t, pool,\n\t\t`SELECT count(*) FROM subscribers WHERE identity_token_hash IS NOT NULL AND source_short IS NULL`); n != 5 {\n\t\tt.Fatalf(\"%d identity-only subscribers minted, want 5 (four imported + one seeded)\", n)\n\t}\n\tif hits := fake.recorded(); len(hits) != 0 {\n\t\tt.Fatalf(\"the projection was called %d time(s) for identity-only codes, want 0: %+v\", len(hits), hits)\n\t}\n\tif len(res.Warnings) != 0 {\n\t\tt.Errorf(\"warnings = %v, want none — nothing was owed to the substrate\", res.Warnings)\n\t}\n\n\t// Unconfigured projection, still nothing owed: no warning either.\n\tif _, err := pool.Exec(ctx, `TRUNCATE subscriber_events, subscribers RESTART IDENTITY CASCADE`); err != nil {\n\t\tt.Fatalf(\"truncate: %v\", err)\n\t}\n\tres, err = ImportSubscribers(ctx, testDeps(pool), ffImporter(t))\n\tif err != nil {\n\t\tt.Fatalf(\"import (unconfigured): %v\", err)\n\t}\n\tif len(res.Warnings) != 0 {\n\t\tt.Errorf(\"warnings = %v with no campaign anywhere, want none\", res.Warnings)\n\t}\n}\n\n// The entitlement row the arbiter answers from: where it is written, how, and\n// what happens to the customer's code when the write fails.\nfunc TestProjectIdentityCodeUpserts(t *testing.T) {\n\tends := time.Date(2028, 1, 1, 5, 59, 59, 0, time.UTC)\n\trow := IdentityProjectionRow{\n\t\tID:         IdentityCodeID(\"0b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b\"),\n\t\tTokenHash:  sha256Hex(\"ic7k3m9q2x5p8w4z\"),\n\t\tCampaignID: \"a0000000-0000-4000-8000-000000000001\",\n\t\tExpiresAt:  ends,\n\t}\n\n\tt.Run(\"201 lands one row on /codes as a merge-duplicates upsert\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusCreated)\n\t\tif err := ProjectIdentityCode(context.Background(), fake.config(), row); err != nil {\n\t\t\tt.Fatalf(\"ProjectIdentityCode = %v, want nil on 201\", err)\n\t\t}\n\t\thits := fake.recorded()\n\t\tif len(hits) != 1 {\n\t\t\tt.Fatalf(\"%d requests, want 1\", len(hits))\n\t\t}\n\t\th := hits[0]\n\t\tif h.Method != http.MethodPost || h.Path != \"/codes\" {\n\t\t\tt.Errorf(\"request = %s %s, want POST /codes\", h.Method, h.Path)\n\t\t}\n\t\tif h.Prefer != \"resolution=merge-duplicates\" {\n\t\t\tt.Errorf(\"Prefer = %q, want resolution=merge-duplicates\", h.Prefer)\n\t\t}\n\t\tif h.APIKey != \"test-service-key\" || h.Auth != \"Bearer test-service-key\" {\n\t\t\tt.Errorf(\"apikey/Authorization = %q / %q, want the service_role key on both\", h.APIKey, h.Auth)\n\t\t}\n\t\tif len(h.Body) != 1 {\n\t\t\tt.Fatalf(\"body carries %d rows, want 1: %v\", len(h.Body), h.Body)\n\t\t}\n\t\tgot := h.Body[0]\n\t\tif len(got) != 4 {\n\t\t\tt.Errorf(\"row has %d fields (%v), want exactly id, token_hash, campaign_id, expires_at\", len(got), got)\n\t\t}\n\t\tif got[\"id\"] != row.ID || got[\"token_hash\"] != row.TokenHash || got[\"campaign_id\"] != row.CampaignID {\n\t\t\tt.Errorf(\"row = %v, want id %s / token_hash %s / campaign_id %s\", got, row.ID, row.TokenHash, row.CampaignID)\n\t\t}\n\t\texp, _ := got[\"expires_at\"].(string)\n\t\tparsed, err := time.Parse(time.RFC3339, exp)\n\t\tif err != nil || !parsed.Equal(ends) {\n\t\t\tt.Errorf(\"expires_at = %q, want the campaign's ends_at %s as RFC 3339\", exp, ends)\n\t\t}\n\t})\n\n\tt.Run(\"the id is derived from the subscriber, so a re-projection is the same row\", func(t *testing.T) {\n\t\ta := IdentityCodeID(\"0b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b\")\n\t\tb := IdentityCodeID(\"0B6F2C1E-6F0A-4F6E-9C59-0C1D2E3F4A5B\")\n\t\tc := IdentityCodeID(\"1b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b\")\n\t\tif a != b {\n\t\t\tt.Errorf(\"the id depends on the subscriber id's letter case: %s vs %s\", a, b)\n\t\t}\n\t\tif a == c {\n\t\t\tt.Error(\"two subscribers derived the same code id\")\n\t\t}\n\t\tif len(a) != 36 || a[14] != '5' || !strings.ContainsRune(\"89ab\", rune(a[19])) {\n\t\t\tt.Errorf(\"%s is not a version-5 uuid\", a)\n\t\t}\n\t})\n\n\tt.Run(\"500 is an error and unconfigured is an error\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusInternalServerError)\n\t\tif err := ProjectIdentityCode(context.Background(), fake.config(), row); err == nil {\n\t\t\tt.Error(\"ProjectIdentityCode = nil on a 500\")\n\t\t}\n\t\tif err := ProjectIdentityCode(context.Background(), ProjectionConfig{}, row); err == nil {\n\t\t\tt.Error(\"ProjectIdentityCode = nil with the projection unconfigured\")\n\t\t}\n\t})\n\n\t// The same three outcomes through the import, against a real database.\n\timportWith := func(t *testing.T, cfg ProjectionConfig) (importResultDTO, campaignDTO, string, string) {\n\t\tt.Helper()\n\t\tpool := setupSubsTestDB(t)\n\t\td := testDeps(pool)\n\t\tcamp := seedFirstTouchCampaign(t, pool, mountedMux(d), \"K7MNPQ\", \"Free side of wings\", 200)\n\t\td.Projection = cfg\n\t\tres, err := ImportSubscribers(context.Background(), d, ffImporter(t))\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"import: %v\", err)\n\t\t}\n\t\tvar subID string\n\t\tvar hash *string\n\t\tif err := pool.QueryRow(context.Background(),\n\t\t\t`SELECT id::text, identity_token_hash FROM subscribers WHERE external_ref = '1182'`).\n\t\t\tScan(&subID, &hash); err != nil {\n\t\t\tt.Fatalf(\"read the first-touch subscriber: %v\", err)\n\t\t}\n\t\tif hash == nil {\n\t\t\tt.Fatal(\"the first-touch subscriber has no identity_token_hash — the mint did not commit\")\n\t\t}\n\t\tif n := countRows(t, pool, `SELECT count(*) FROM identity_media WHERE subscriber_id = $1`, subID); n != 1 {\n\t\t\tt.Fatalf(\"identity_media rows for the first-touch subscriber = %d, want 1\", n)\n\t\t}\n\t\tif n := countRows(t, pool, `SELECT count(*) FROM subscribers WHERE identity_token_hash IS NULL`); n != 0 {\n\t\t\tt.Fatalf(\"%d imported subscribers were left without a code\", n)\n\t\t}\n\t\treturn res, camp, subID, *hash\n\t}\n\n\tt.Run(\"import: a 201 projects the first-touch code and only that one\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusCreated)\n\t\tres, camp, subID, hash := importWith(t, fake.config())\n\t\tif len(res.Warnings) != 0 {\n\t\t\tt.Errorf(\"warnings = %v, want none\", res.Warnings)\n\t\t}\n\t\thits := fake.recorded()\n\t\tif len(hits) != 1 {\n\t\t\tt.Fatalf(\"%d projection requests, want 1 (three of the four signups are identity-only)\", len(hits))\n\t\t}\n\t\tgot := hits[0].Body[0]\n\t\tif got[\"id\"] != IdentityCodeID(subID) || got[\"token_hash\"] != hash || got[\"campaign_id\"] != camp.ID {\n\t\t\tt.Errorf(\"projected row = %v, want id %s / hash %s / campaign %s\", got, IdentityCodeID(subID), hash, camp.ID)\n\t\t}\n\t\texp, _ := got[\"expires_at\"].(string)\n\t\tif parsed, err := time.Parse(time.RFC3339, exp); err != nil || !parsed.Equal(camp.EndsAt) {\n\t\t\tt.Errorf(\"projected expires_at = %q, want the campaign's ends_at %s\", exp, camp.EndsAt)\n\t\t}\n\t})\n\n\tt.Run(\"import: a 500 keeps the mint and says not_projected\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusInternalServerError)\n\t\tres, _, _, _ := importWith(t, fake.config()) // importWith asserts the mint committed\n\t\tif len(res.Warnings) != 1 || res.Warnings[0] != WarningNotProjected {\n\t\t\tt.Fatalf(\"warnings = %v, want [%q]\", res.Warnings, WarningNotProjected)\n\t\t}\n\t})\n\n\tt.Run(\"import: an unconfigured projection keeps the mint and says not_projected\", func(t *testing.T) {\n\t\tres, _, _, _ := importWith(t, ProjectionConfig{})\n\t\tif len(res.Warnings) != 1 || res.Warnings[0] != WarningNotProjected {\n\t\t\tt.Fatalf(\"warnings = %v, want [%q]\", res.Warnings, WarningNotProjected)\n\t\t}\n\t})\n}\n\n// GET and HEAD /m/{id}.png: public, image/png, privately cached for an hour,\n// and 404 for anything that is not a stored image.\nfunc TestIdentityMediaRouteIsPublicPNG(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tmux := mountedMux(testDeps(pool))\n\tcode := mintInTx(t, pool, seedSubscriber(t, pool, \"\"))\n\twant := storedPNG(t, pool, code.MediaID)\n\n\t// context.Background(): no user, no session — the route is public.\n\trec := do(t, mux, context.Background(), http.MethodGet, \"/m/\"+code.MediaID+\".png\", nil)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"GET = %d, want 200\\nbody: %s\", rec.Code, rec.Body.String())\n\t}\n\tif ct := rec.Header().Get(\"Content-Type\"); ct != \"image/png\" {\n\t\tt.Errorf(\"Content-Type = %q, want image/png\", ct)\n\t}\n\tif cc := rec.Header().Get(\"Cache-Control\"); cc != \"private, max-age=3600\" {\n\t\tt.Errorf(\"Cache-Control = %q, want private, max-age=3600\", cc)\n\t}\n\tif !bytes.Equal(rec.Body.Bytes(), want) {\n\t\tt.Error(\"GET body is not the stored PNG\")\n\t}\n\tif !bytes.HasPrefix(rec.Body.Bytes(), []byte(\"\\x89PNG\\r\\n\\x1a\\n\")) {\n\t\tt.Error(\"GET body does not start with the PNG signature\")\n\t}\n\n\thead := do(t, mux, context.Background(), http.MethodHead, \"/m/\"+code.MediaID+\".png\", nil)\n\tif head.Code != http.StatusOK || head.Body.Len() != 0 {\n\t\tt.Errorf(\"HEAD = %d with %d body bytes, want 200 and none\", head.Code, head.Body.Len())\n\t}\n\tif cl := head.Header().Get(\"Content-Length\"); cl != strconv.Itoa(len(want)) {\n\t\tt.Errorf(\"HEAD Content-Length = %q, want %d\", cl, len(want))\n\t}\n\n\tfor _, id := range []string{\"00000000-0000-4000-8000-000000000000\", \"not-a-uuid\", code.MediaID + \"x\"} {\n\t\tfor _, method := range []string{http.MethodGet, http.MethodHead} {\n\t\t\tif rec := do(t, mux, context.Background(), method, \"/m/\"+id+\".png\", nil); rec.Code != http.StatusNotFound {\n\t\t\t\tt.Errorf(\"%s /m/%s.png = %d, want 404\", method, id, rec.Code)\n\t\t\t}\n\t\t}\n\t}\n}\n\n// The detail sheet's status: no code, a code, a code that was sent.\nfunc TestSubscriberDetailReportsIdentityCodeStatus(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tctx := context.Background()\n\tmgr := seedUser(t, pool, \"manager\")\n\tmux := mountedMux(testDeps(pool))\n\tsubID := seedSubscriber(t, pool, \"\")\n\n\tdetail := func() identityCodeDTO {\n\t\trec := do(t, mux, userCtx(mgr, \"manager\"), http.MethodGet, \"/api/v1/marketing/subscribers/\"+subID, nil)\n\t\tif rec.Code != http.StatusOK {\n\t\t\tt.Fatalf(\"GET detail = %d\\nbody: %s\", rec.Code, rec.Body.String())\n\t\t}\n\t\tvar out subscriberDetailDTO\n\t\tdecode(t, rec, &out)\n\t\treturn out.IdentityCode\n\t}\n\n\tif ic := detail(); ic.Status != \"not_minted\" || ic.MediaURL != nil {\n\t\tt.Fatalf(\"before the mint: status %q / media_url %v, want not_minted / null\", ic.Status, ic.MediaURL)\n\t}\n\tcode := mintInTx(t, pool, subID)\n\tic := detail()\n\tif ic.Status != \"minted\" {\n\t\tt.Fatalf(\"after the mint: status %q, want minted\", ic.Status)\n\t}\n\tif ic.MediaURL == nil || *ic.MediaURL != \"/m/\"+code.MediaID+\".png\" {\n\t\tt.Fatalf(\"media_url = %v, want /m/%s.png\", ic.MediaURL, code.MediaID)\n\t}\n\tif rec := do(t, mux, context.Background(), http.MethodGet, *ic.MediaURL, nil); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"GET media_url = %d, want 200\", rec.Code)\n\t}\n\t// `sent` is Card 2's to cause; this card only reports it.\n\tif _, err := pool.Exec(ctx,\n\t\t`INSERT INTO subscriber_events (subscriber_id, kind) VALUES ($1, 'code_sent')`, subID); err != nil {\n\t\tt.Fatalf(\"seed code_sent: %v\", err)\n\t}\n\tif ic := detail(); ic.Status != \"sent\" || ic.SentAt == nil || ic.MediaURL == nil {\n\t\tt.Fatalf(\"after a code_sent event: status %q / sent_at %v / media_url %v, want sent with both\", ic.Status, ic.SentAt, ic.MediaURL)\n\t}\n}\n\n// The shipped reader was measured up to QR version 10. A campaign with a long\n// offer line must not push a customer's code past that: the label in the QR is\n// shortened, the code itself is not weakened.\nfunc TestIdentityCodeLongOfferTextStaysScannable(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tlong := \"Buy any two combos and get a free large side of our signature honey-garlic wings plus a drink\"\n\tcamp := seedFirstTouchCampaign(t, pool, mountedMux(testDeps(pool)), \"K7MNPQ\", long, 1250)\n\tsubID := seedSubscriber(t, pool, \"K7MNPQ\")\n\n\ttoken := withIdentityRand(t, 44)\n\tcode := mintInTx(t, pool, subID)\n\tpng := storedPNG(t, pool, code.MediaID)\n\n\t// Find the label the mint settled on: the longest prefix whose payload\n\t// reproduces the stored PNG.\n\trunes := []rune(long)\n\tfor n := len(runes); n >= 1; n-- {\n\t\tlabel := string(runes[:n])\n\t\tif n < len(runes) {\n\t\t\tlabel = strings.TrimRight(label, \" \") + \"…\"\n\t\t}\n\t\tpayload := DefaultQRBaseURL + \"/r/\" + token +\n\t\t\tdescriptorFragment(t, label, camp.ID, camp.EndsAt.UTC().Format(\"2006-01-02\"), 12.5)\n\t\twant, version := encodeAsTheCardDoes(t, payload)\n\t\tif !bytes.Equal(png, want) {\n\t\t\tcontinue\n\t\t}\n\t\tif n == len(runes) {\n\t\t\tt.Fatalf(\"the full %d-char offer text was encoded at version %d — expected it to be shortened\", len(runes), version)\n\t\t}\n\t\tif version > 10 {\n\t\t\tt.Fatalf(\"label shortened to %q but the symbol is still version %d\", label, version)\n\t\t}\n\t\tt.Logf(\"label shortened to %d of %d chars (%q); payload %d chars, version %d\", n, len(runes), label, len(payload), version)\n\t\treturn\n\t}\n\tt.Fatal(\"the stored PNG matches no prefix of the offer text — the label rule is not the one this test states\")\n}\n\n// 0088's Down, run: the two columns and the image table go, `subscribers`\n// itself stays, and re-applying brings them back with the cascade and the\n// unique hash intact.\n//\n// Same rules as the 0085 and 0086 legs: start from HEAD, derive the version\n// from the filename, restore with db.Migrate (never a literal), touch no row.\nfunc TestMigration0088IdentityCodesDownAndUpRoundTrip(t *testing.T) {\n\tif testPool == nil {\n\t\tt.Skip(\"no test database (DB_TEST_URL unset and the local fallback is unreachable)\")\n\t}\n\tpool := testPool\n\tctx := context.Background()\n\tif err := db.Migrate(pool); err != nil {\n\t\tt.Fatalf(\"migrate up to HEAD before the down leg: %v\", err)\n\t}\n\tt.Cleanup(func() {\n\t\tif err := db.Migrate(pool); err != nil {\n\t\t\tt.Errorf(\"restore to HEAD: %v\", err)\n\t\t}\n\t})\n\n\tversion := identityMigrationVersion(t)\n\tif version != 88 {\n\t\tt.Fatalf(\"*_identity_codes.sql is migration %d; the slate fixes it at 88 (a renumbering is scope drift)\", version)\n\t}\n\n\ttableExists := func(name string) bool {\n\t\tvar ok bool\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT EXISTS (SELECT 1 FROM information_schema.tables\n\t\t\t                WHERE table_schema = current_schema() AND table_name = $1)`, name).Scan(&ok); err != nil {\n\t\t\tt.Fatalf(\"tableExists(%s): %v\", name, err)\n\t\t}\n\t\treturn ok\n\t}\n\tcolumnExists := func(table, column string) bool {\n\t\tvar ok bool\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT EXISTS (SELECT 1 FROM information_schema.columns\n\t\t\t                WHERE table_schema = current_schema() AND table_name = $1 AND column_name = $2)`,\n\t\t\ttable, column).Scan(&ok); err != nil {\n\t\t\tt.Fatalf(\"columnExists(%s.%s): %v\", table, column, err)\n\t\t}\n\t\treturn ok\n\t}\n\tassertUp := func(leg string) {\n\t\tt.Helper()\n\t\tif !tableExists(\"identity_media\") {\n\t\t\tt.Errorf(\"%s: identity_media is missing\", leg)\n\t\t}\n\t\tfor _, c := range []string{\"identity_token_hash\", \"identity_minted_at\"} {\n\t\t\tif !columnExists(\"subscribers\", c) {\n\t\t\t\tt.Errorf(\"%s: subscribers.%s is missing\", leg, c)\n\t\t\t}\n\t\t}\n\t\t// The erasure path: deleting a subscriber deletes their image.\n\t\tvar del string\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT confdeltype::text FROM pg_constraint\n\t\t\t WHERE conrelid = 'identity_media'::regclass AND contype = 'f'\n\t\t\t   AND confrelid = 'subscribers'::regclass`).Scan(&del); err != nil {\n\t\t\tt.Errorf(\"%s: read identity_media's FK onto subscribers: %v\", leg, err)\n\t\t} else if del != \"c\" {\n\t\t\tt.Errorf(\"%s: identity_media → subscribers is ON DELETE %q, want c (cascade)\", leg, del)\n\t\t}\n\t\t// Two customers can never share a code.\n\t\tvar uniques int\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT count(*) FROM pg_constraint c\n\t\t\t  JOIN pg_attribute a ON a.attrelid = c.conrelid AND a.attnum = ANY (c.conkey)\n\t\t\t WHERE c.conrelid = 'subscribers'::regclass AND c.contype = 'u'\n\t\t\t   AND a.attname = 'identity_token_hash'`).Scan(&uniques); err != nil {\n\t\t\tt.Errorf(\"%s: read the unique constraint: %v\", leg, err)\n\t\t} else if uniques != 1 {\n\t\t\tt.Errorf(\"%s: %d unique constraints on subscribers.identity_token_hash, want 1\", leg, uniques)\n\t\t}\n\t}\n\n\tassertUp(\"at HEAD\")\n\n\tif err := db.MigrateTo(pool, version-1); err != nil {\n\t\tt.Fatalf(\"migrate down to %d: %v\", version-1, err)\n\t}\n\tif tableExists(\"identity_media\") {\n\t\tt.Errorf(\"identity_media survived migration %d's Down\", version)\n\t}\n\tfor _, c := range []string{\"identity_token_hash\", \"identity_minted_at\"} {\n\t\tif columnExists(\"subscribers\", c) {\n\t\t\tt.Errorf(\"subscribers.%s survived migration %d's Down\", c, version)\n\t\t}\n\t}\n\tif !tableExists(\"subscribers\") || !columnExists(\"subscribers\", \"source_short\") {\n\t\tt.Fatalf(\"migration %d's Down took more than its own: subscribers (or its 0085 columns) is gone\", version)\n\t}\n\n\tif err := db.Migrate(pool); err != nil {\n\t\tt.Fatalf(\"migrate back up to HEAD: %v\", err)\n\t}\n\tassertUp(\"after re-apply\")\n\tt.Logf(\"migration %d Down/Up round-trip clean; schema restored to HEAD (not to a literal)\", version)\n}\n\nfunc identityMigrationVersion(t *testing.T) int64 {\n\tt.Helper()\n\tentries, err := os.ReadDir(migrationsDir)\n\tif err != nil {\n\t\tt.Fatalf(\"read %s: %v\", migrationsDir, err)\n\t}\n\tfor _, e := range entries {\n\t\tif !strings.HasSuffix(e.Name(), \"_identity_codes.sql\") {\n\t\t\tcontinue\n\t\t}\n\t\tm := migrationNumRe.FindStringSubmatch(e.Name())\n\t\tif m == nil {\n\t\t\tt.Fatalf(\"migration %q does not start with a version number\", e.Name())\n\t\t}\n\t\tv, err := strconv.ParseInt(m[1], 10, 64)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"parse version from %q: %v\", e.Name(), err)\n\t\t}\n\t\treturn v\n\t}\n\tt.Fatalf(\"no *_identity_codes.sql migration found in %s\", migrationsDir)\n\treturn 0\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HC6Yikx5mX8SNyRBPvu8A1","type":"tool_result","content":"File created successfully at: /home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/backend/internal/marketing/identity_test.go (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"792dcbd6-aa1d-4c6e-83da-0e3997c4c9b1","uuid":"db070f48-2ea8-4a38-a475-4f50707e7708","timestamp":"2026-10-05T23:45:24.419Z","tool_use_result":{"type":"create","filePath":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/backend/internal/marketing/identity_test.go","content":"package marketing\n\n// identity_test.go — card E1 (`identity-code-and-qr`, roadmap Activity E).\n//\n// The five named gates, and three that ride with them:\n//\n//\tTestMintIdentityCodeIsIdempotent                  one code per customer, for good\n//\tTestMintIdentityCodeNoFirstTouchIsIdentityOnly    no campaign → no offer in the QR, nothing projected\n//\tTestProjectIdentityCodeUpserts                    the arbiter row, and a failed projection keeps the mint\n//\tTestMigration0088IdentityCodesDownAndUpRoundTrip  0088's Down, run\n//\t(TestNothingInThisPackageSends is subscribers_test.go's, unedited)\n//\n//\tTestIdentityMediaRouteIsPublicPNG                 GET/HEAD /m/{id}.png\n//\tTestSubscriberDetailReportsIdentityCodeStatus     not_minted → minted → sent\n//\tTestIdentityCodeLongOfferTextStaysScannable       a long offer never produces a denser symbol\n//\n// 🛑 No test here learns a token from the database — there is none there. The\n// token is fixed by handing the mint a known random stream (withIdentityRand),\n// and every claim about the QR is made by re-encoding the expected payload and\n// comparing it to the stored PNG byte for byte.\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/go-chi/chi/v5\"\n\t\"github.com/jackc/pgx/v5/pgxpool\"\n\tqrcode \"github.com/skip2/go-qrcode\"\n\t\"github.com/yumyums/hq/internal/db\"\n)\n\n// withIdentityRand swaps the mint's random source for a fixed stream and\n// returns the token that stream produces, so a test knows the token without it\n// ever having been stored.\nfunc withIdentityRand(t *testing.T, seed byte) string {\n\tt.Helper()\n\tstream := make([]byte, 256)\n\tfor i := range stream {\n\t\tstream[i] = seed + byte(i*7)\n\t}\n\ttoken, err := newIdentityToken(bytes.NewReader(stream))\n\tif err != nil {\n\t\tt.Fatalf(\"newIdentityToken on the fixed stream: %v\", err)\n\t}\n\tprev := identityRand\n\tidentityRand = bytes.NewReader(stream)\n\tt.Cleanup(func() { identityRand = prev })\n\treturn token\n}\n\nfunc sha256Hex(s string) string {\n\tsum := sha256.Sum256([]byte(s))\n\treturn hex.EncodeToString(sum[:])\n}\n\n// seedFirstTouchCampaign creates a campaign through the real route and\n// re-points its first code's short, returning the campaign.\nfunc seedFirstTouchCampaign(t *testing.T, pool *pgxpool.Pool, mux *chi.Mux, short, offerText string, cents int) campaignDTO {\n\tt.Helper()\n\tmgr := seedUser(t, pool, \"manager\")\n\tcreated := createCampaign(t, mux, mgr, map[string]any{\n\t\t\"name\": \"Wing Wednesday \" + randSuffix(t), \"offer_text\": offerText,\n\t\t\"face_value_cents\": cents, \"runs_days\": 14,\n\t\t\"channels\": []map[string]any{{\"channel\": \"flyer\"}},\n\t})\n\tif _, err := pool.Exec(context.Background(),\n\t\t`UPDATE qr_codes SET short = $2 WHERE id = $1`, created.Codes[0].ID, short); err != nil {\n\t\tt.Fatalf(\"re-point the code's short: %v\", err)\n\t}\n\treturn created.Campaign\n}\n\n// seedSubscriber inserts one subscriber directly; short \"\" means no first touch.\nfunc seedSubscriber(t *testing.T, pool *pgxpool.Pool, short string) string {\n\tt.Helper()\n\tvar id string\n\tif err := pool.QueryRow(context.Background(), `\n\t\tINSERT INTO subscribers (display_name, email, source, source_short, joined_at)\n\t\tVALUES ('Identity Test', $1, 'web_form', NULLIF($2,''), now())\n\t\tRETURNING id::text`,\n\t\t\"ic-\"+randSuffix(t)+\"@test.invalid\", short).Scan(&id); err != nil {\n\t\tt.Fatalf(\"seedSubscriber: %v\", err)\n\t}\n\treturn id\n}\n\n// mintInTx runs MintIdentityCode in its own committed transaction.\nfunc mintInTx(t *testing.T, pool *pgxpool.Pool, subID string) IdentityCode {\n\tt.Helper()\n\tctx := context.Background()\n\ttx, err := pool.Begin(ctx)\n\tif err != nil {\n\t\tt.Fatalf(\"begin: %v\", err)\n\t}\n\tdefer func() { _ = tx.Rollback(ctx) }()\n\tcode, err := MintIdentityCode(ctx, tx, subID)\n\tif err != nil {\n\t\tt.Fatalf(\"MintIdentityCode: %v\", err)\n\t}\n\tif err := tx.Commit(ctx); err != nil {\n\t\tt.Fatalf(\"commit: %v\", err)\n\t}\n\treturn code\n}\n\nfunc storedPNG(t *testing.T, pool *pgxpool.Pool, mediaID string) []byte {\n\tt.Helper()\n\tvar png []byte\n\tif err := pool.QueryRow(context.Background(),\n\t\t`SELECT png FROM identity_media WHERE id = $1`, mediaID).Scan(&png); err != nil {\n\t\tt.Fatalf(\"read identity_media %s: %v\", mediaID, err)\n\t}\n\treturn png\n}\n\n// encodeAsTheCardDoes is the spec's encoding, restated independently of the\n// code under test: Low correction, 512 px.\nfunc encodeAsTheCardDoes(t *testing.T, payload string) (png []byte, version int) {\n\tt.Helper()\n\tq, err := qrcode.New(payload, qrcode.Low)\n\tif err != nil {\n\t\tt.Fatalf(\"encode %q: %v\", payload, err)\n\t}\n\tpng, err = q.PNG(512)\n\tif err != nil {\n\t\tt.Fatalf(\"png: %v\", err)\n\t}\n\treturn png, q.VersionNumber\n}\n\nfunc descriptorFragment(t *testing.T, label, campaignID, expires string, faceValue float64) string {\n\tt.Helper()\n\t// Key ORDER is part of the byte-for-byte comparison, so this is a struct\n\t// and not a map.\n\traw, err := json.Marshal(struct {\n\t\tLabel      string  `json:\"label\"`\n\t\tCampaignID string  `json:\"campaign_id\"`\n\t\tExpiresAt  string  `json:\"expires_at\"`\n\t\tFaceValue  float64 `json:\"face_value\"`\n\t}{label, campaignID, expires, faceValue})\n\tif err != nil {\n\t\tt.Fatalf(\"marshal descriptor: %v\", err)\n\t}\n\treturn \"#o=\" + base64.RawURLEncoding.EncodeToString(raw)\n}\n\n// A customer gets one code and keeps it: minting twice — and importing twice —\n// leaves the same hash, the same image and one image row.\nfunc TestMintIdentityCodeIsIdempotent(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tctx := context.Background()\n\td := testDeps(pool)\n\tcamp := seedFirstTouchCampaign(t, pool, mountedMux(d), \"K7MNPQ\", \"Free side of wings\", 200)\n\tsubID := seedSubscriber(t, pool, \"K7MNPQ\")\n\n\ttoken := withIdentityRand(t, 3)\n\tif len(token) != 16 {\n\t\tt.Fatalf(\"token %q is %d chars, want 16\", token, len(token))\n\t}\n\tfor _, r := range token {\n\t\tif !strings.ContainsRune(\"23456789abcdefghjkmnpqrstuvwxyz\", r) {\n\t\t\tt.Fatalf(\"token %q carries %q, which is outside the alphabet\", token, r)\n\t\t}\n\t}\n\n\tfirst := mintInTx(t, pool, subID)\n\tif !first.Minted {\n\t\tt.Error(\"first mint reported Minted=false\")\n\t}\n\tif first.TokenHash != sha256Hex(token) {\n\t\tt.Fatalf(\"token_hash = %s, want hex(sha256(token)) = %s\", first.TokenHash, sha256Hex(token))\n\t}\n\tif first.CampaignID != camp.ID {\n\t\tt.Errorf(\"CampaignID = %q, want the first-touch campaign %q\", first.CampaignID, camp.ID)\n\t}\n\tif !first.ExpiresAt.Equal(camp.EndsAt) {\n\t\tt.Errorf(\"ExpiresAt = %s, want the campaign's ends_at %s\", first.ExpiresAt, camp.EndsAt)\n\t}\n\n\tvar storedHash string\n\tvar mintedAt *time.Time\n\tif err := pool.QueryRow(ctx,\n\t\t`SELECT identity_token_hash, identity_minted_at FROM subscribers WHERE id = $1`, subID).\n\t\tScan(&storedHash, &mintedAt); err != nil {\n\t\tt.Fatalf(\"read the subscriber: %v\", err)\n\t}\n\tif storedHash != first.TokenHash || mintedAt == nil {\n\t\tt.Fatalf(\"subscriber row holds hash %q / minted_at %v, want %q and a timestamp\", storedHash, mintedAt, first.TokenHash)\n\t}\n\n\t// The stored image IS the spec's payload at the spec's encoding.\n\twantPayload := DefaultQRBaseURL + \"/r/\" + token +\n\t\tdescriptorFragment(t, \"Free side of wings\", camp.ID, camp.EndsAt.UTC().Format(\"2006-01-02\"), 2)\n\twantPNG, version := encodeAsTheCardDoes(t, wantPayload)\n\tpng := storedPNG(t, pool, first.MediaID)\n\tif !bytes.Equal(png, wantPNG) {\n\t\tt.Fatalf(\"stored PNG is not qrcode.New(%q, Low).PNG(512)\", wantPayload)\n\t}\n\tif version > 10 {\n\t\tt.Errorf(\"the card's payload encodes at version %d; the shipped reader was measured to version 10\", version)\n\t}\n\tt.Logf(\"payload %d chars, QR version %d at Low\", len(wantPayload), version)\n\n\t// 🛑 The raw token is in no row.\n\tfor _, q := range []string{\n\t\t`SELECT count(*) FROM subscribers s WHERE to_jsonb(s)::text LIKE '%' || $1 || '%'`,\n\t\t`SELECT count(*) FROM subscriber_events e WHERE to_jsonb(e)::text LIKE '%' || $1 || '%'`,\n\t} {\n\t\tif n := countRows(t, pool, q, token); n != 0 {\n\t\t\tt.Errorf(\"the raw token appears in %d row(s): %s\", n, q)\n\t\t}\n\t}\n\n\t// Mint again with a DIFFERENT random stream: nothing may move.\n\twithIdentityRand(t, 91)\n\tsecond := mintInTx(t, pool, subID)\n\tif second.Minted {\n\t\tt.Error(\"second mint reported Minted=true — it must return the existing code\")\n\t}\n\tif second.TokenHash != first.TokenHash || second.MediaID != first.MediaID {\n\t\tt.Fatalf(\"second mint = hash %s / media %s, want the first's %s / %s\",\n\t\t\tsecond.TokenHash, second.MediaID, first.TokenHash, first.MediaID)\n\t}\n\tif second.CampaignID != first.CampaignID || !second.ExpiresAt.Equal(first.ExpiresAt) {\n\t\tt.Errorf(\"second mint's campaign/expiry = %q/%s, want %q/%s\",\n\t\t\tsecond.CampaignID, second.ExpiresAt, first.CampaignID, first.ExpiresAt)\n\t}\n\tif n := countRows(t, pool, `SELECT count(*) FROM identity_media WHERE subscriber_id = $1`, subID); n != 1 {\n\t\tt.Fatalf(\"identity_media rows = %d, want 1\", n)\n\t}\n\tif !bytes.Equal(storedPNG(t, pool, first.MediaID), wantPNG) {\n\t\tt.Fatal(\"the stored PNG changed on the second mint\")\n\t}\n\n\t// And through the import: every NEW subscriber is minted, a re-import\n\t// mints nobody and rotates nothing.\n\tidentityRand = prevRandForImport(t)\n\tres, err := ImportSubscribers(ctx, d, ffImporter(t))\n\tif err != nil {\n\t\tt.Fatalf(\"first import: %v\", err)\n\t}\n\tif res.Created != 4 {\n\t\tt.Fatalf(\"first import created %d, want 4\", res.Created)\n\t}\n\tbefore := identityHashes(t, pool)\n\tif len(before) != 5 { // the four imported + the one seeded above\n\t\tt.Fatalf(\"%d subscribers carry a code after the import, want 5: %v\", len(before), before)\n\t}\n\tif _, err := ImportSubscribers(ctx, d, ffImporter(t)); err != nil {\n\t\tt.Fatalf(\"second import: %v\", err)\n\t}\n\tafter := identityHashes(t, pool)\n\tif len(after) != len(before) {\n\t\tt.Fatalf(\"re-import changed the minted count: %d → %d\", len(before), len(after))\n\t}\n\tfor id, h := range before {\n\t\tif after[id] != h {\n\t\t\tt.Errorf(\"subscriber %s's code rotated on re-import: %s → %s\", id, h, after[id])\n\t\t}\n\t}\n\tif n := countRows(t, pool, `SELECT count(*) FROM identity_media`); n != 5 {\n\t\tt.Errorf(\"identity_media rows = %d after two imports, want 5\", n)\n\t}\n}\n\n// prevRandForImport puts the real random source back for the import legs (two\n// subscribers minted from one fixed stream would collide on the unique hash,\n// which is the constraint doing its job, not the behaviour under test).\nfunc prevRandForImport(t *testing.T) io.Reader {\n\tt.Helper()\n\treturn defaultIdentityRand\n}\n\nfunc identityHashes(t *testing.T, pool *pgxpool.Pool) map[string]string {\n\tt.Helper()\n\trows, err := pool.Query(context.Background(),\n\t\t`SELECT id::text, identity_token_hash FROM subscribers WHERE identity_token_hash IS NOT NULL`)\n\tif err != nil {\n\t\tt.Fatalf(\"read hashes: %v\", err)\n\t}\n\tdefer rows.Close()\n\tout := map[string]string{}\n\tfor rows.Next() {\n\t\tvar id, h string\n\t\tif err := rows.Scan(&id, &h); err != nil {\n\t\t\tt.Fatalf(\"scan: %v\", err)\n\t\t}\n\t\tout[id] = h\n\t}\n\treturn out\n}\n\n// fakePostgREST records what the projection sent and answers with `status`.\ntype fakePostgREST struct {\n\tmu     sync.Mutex\n\tstatus int\n\thits   []recordedUpsert\n\tsrv    *httptest.Server\n}\n\ntype recordedUpsert struct {\n\tMethod, Path, Prefer, APIKey, Auth string\n\tBody                               []map[string]any\n}\n\nfunc newFakePostgREST(t *testing.T, status int) *fakePostgREST {\n\tt.Helper()\n\tf := &fakePostgREST{status: status}\n\tf.srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\traw, _ := io.ReadAll(r.Body)\n\t\tvar body []map[string]any\n\t\t_ = json.Unmarshal(raw, &body)\n\t\tf.mu.Lock()\n\t\tf.hits = append(f.hits, recordedUpsert{\n\t\t\tMethod: r.Method, Path: r.URL.Path, Prefer: r.Header.Get(\"Prefer\"),\n\t\t\tAPIKey: r.Header.Get(\"apikey\"), Auth: r.Header.Get(\"Authorization\"), Body: body,\n\t\t})\n\t\tf.mu.Unlock()\n\t\tw.WriteHeader(f.status)\n\t}))\n\tt.Cleanup(f.srv.Close)\n\treturn f\n}\n\nfunc (f *fakePostgREST) config() ProjectionConfig {\n\treturn ProjectionConfig{RESTURL: f.srv.URL, ServiceKey: \"test-service-key\"}\n}\n\nfunc (f *fakePostgREST) recorded() []recordedUpsert {\n\tf.mu.Lock()\n\tdefer f.mu.Unlock()\n\treturn append([]recordedUpsert(nil), f.hits...)\n}\n\n// A signup with no first-touch code gets a code that says who they are and\n// nothing about an offer, and no entitlement row is written anywhere.\nfunc TestMintIdentityCodeNoFirstTouchIsIdentityOnly(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tctx := context.Background()\n\tsubID := seedSubscriber(t, pool, \"\")\n\n\ttoken := withIdentityRand(t, 17)\n\tcode := mintInTx(t, pool, subID)\n\tif code.CampaignID != \"\" || !code.ExpiresAt.IsZero() {\n\t\tt.Fatalf(\"identity-only code carries campaign %q / expiry %s, want neither\", code.CampaignID, code.ExpiresAt)\n\t}\n\tif code.TokenHash != sha256Hex(token) {\n\t\tt.Fatalf(\"token_hash = %s, want %s\", code.TokenHash, sha256Hex(token))\n\t}\n\twantPayload := DefaultQRBaseURL + \"/r/\" + token\n\tif strings.Contains(wantPayload, \"#o=\") {\n\t\tt.Fatal(\"test bug: the expected identity-only payload carries a fragment\")\n\t}\n\twantPNG, version := encodeAsTheCardDoes(t, wantPayload)\n\tif !bytes.Equal(storedPNG(t, pool, code.MediaID), wantPNG) {\n\t\tt.Fatalf(\"stored PNG is not the bare %q — an identity-only code must carry no #o= fragment\", wantPayload)\n\t}\n\tt.Logf(\"identity-only payload %d chars, QR version %d\", len(wantPayload), version)\n\n\t// Through the import, with a projection that WOULD answer: the fixture's\n\t// one short (K7MNPQ) names no code here, so all four signups are\n\t// identity-only — and the substrate must hear nothing.\n\tidentityRand = defaultIdentityRand\n\tfake := newFakePostgREST(t, http.StatusCreated)\n\td := testDeps(pool)\n\td.Projection = fake.config()\n\tres, err := ImportSubscribers(ctx, d, ffImporter(t))\n\tif err != nil {\n\t\tt.Fatalf(\"import: %v\", err)\n\t}\n\tif res.Created != 4 {\n\t\tt.Fatalf(\"import created %d, want 4\", res.Created)\n\t}\n\tif n := countRows(t, pool,\n\t\t`SELECT count(*) FROM subscribers WHERE identity_token_hash IS NOT NULL AND source_short IS NULL`); n != 5 {\n\t\tt.Fatalf(\"%d identity-only subscribers minted, want 5 (four imported + one seeded)\", n)\n\t}\n\tif hits := fake.recorded(); len(hits) != 0 {\n\t\tt.Fatalf(\"the projection was called %d time(s) for identity-only codes, want 0: %+v\", len(hits), hits)\n\t}\n\tif len(res.Warnings) != 0 {\n\t\tt.Errorf(\"warnings = %v, want none — nothing was owed to the substrate\", res.Warnings)\n\t}\n\n\t// Unconfigured projection, still nothing owed: no warning either.\n\tif _, err := pool.Exec(ctx, `TRUNCATE subscriber_events, subscribers RESTART IDENTITY CASCADE`); err != nil {\n\t\tt.Fatalf(\"truncate: %v\", err)\n\t}\n\tres, err = ImportSubscribers(ctx, testDeps(pool), ffImporter(t))\n\tif err != nil {\n\t\tt.Fatalf(\"import (unconfigured): %v\", err)\n\t}\n\tif len(res.Warnings) != 0 {\n\t\tt.Errorf(\"warnings = %v with no campaign anywhere, want none\", res.Warnings)\n\t}\n}\n\n// The entitlement row the arbiter answers from: where it is written, how, and\n// what happens to the customer's code when the write fails.\nfunc TestProjectIdentityCodeUpserts(t *testing.T) {\n\tends := time.Date(2028, 1, 1, 5, 59, 59, 0, time.UTC)\n\trow := IdentityProjectionRow{\n\t\tID:         IdentityCodeID(\"0b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b\"),\n\t\tTokenHash:  sha256Hex(\"ic7k3m9q2x5p8w4z\"),\n\t\tCampaignID: \"a0000000-0000-4000-8000-000000000001\",\n\t\tExpiresAt:  ends,\n\t}\n\n\tt.Run(\"201 lands one row on /codes as a merge-duplicates upsert\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusCreated)\n\t\tif err := ProjectIdentityCode(context.Background(), fake.config(), row); err != nil {\n\t\t\tt.Fatalf(\"ProjectIdentityCode = %v, want nil on 201\", err)\n\t\t}\n\t\thits := fake.recorded()\n\t\tif len(hits) != 1 {\n\t\t\tt.Fatalf(\"%d requests, want 1\", len(hits))\n\t\t}\n\t\th := hits[0]\n\t\tif h.Method != http.MethodPost || h.Path != \"/codes\" {\n\t\t\tt.Errorf(\"request = %s %s, want POST /codes\", h.Method, h.Path)\n\t\t}\n\t\tif h.Prefer != \"resolution=merge-duplicates\" {\n\t\t\tt.Errorf(\"Prefer = %q, want resolution=merge-duplicates\", h.Prefer)\n\t\t}\n\t\tif h.APIKey != \"test-service-key\" || h.Auth != \"Bearer test-service-key\" {\n\t\t\tt.Errorf(\"apikey/Authorization = %q / %q, want the service_role key on both\", h.APIKey, h.Auth)\n\t\t}\n\t\tif len(h.Body) != 1 {\n\t\t\tt.Fatalf(\"body carries %d rows, want 1: %v\", len(h.Body), h.Body)\n\t\t}\n\t\tgot := h.Body[0]\n\t\tif len(got) != 4 {\n\t\t\tt.Errorf(\"row has %d fields (%v), want exactly id, token_hash, campaign_id, expires_at\", len(got), got)\n\t\t}\n\t\tif got[\"id\"] != row.ID || got[\"token_hash\"] != row.TokenHash || got[\"campaign_id\"] != row.CampaignID {\n\t\t\tt.Errorf(\"row = %v, want id %s / token_hash %s / campaign_id %s\", got, row.ID, row.TokenHash, row.CampaignID)\n\t\t}\n\t\texp, _ := got[\"expires_at\"].(string)\n\t\tparsed, err := time.Parse(time.RFC3339, exp)\n\t\tif err != nil || !parsed.Equal(ends) {\n\t\t\tt.Errorf(\"expires_at = %q, want the campaign's ends_at %s as RFC 3339\", exp, ends)\n\t\t}\n\t})\n\n\tt.Run(\"the id is derived from the subscriber, so a re-projection is the same row\", func(t *testing.T) {\n\t\ta := IdentityCodeID(\"0b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b\")\n\t\tb := IdentityCodeID(\"0B6F2C1E-6F0A-4F6E-9C59-0C1D2E3F4A5B\")\n\t\tc := IdentityCodeID(\"1b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b\")\n\t\tif a != b {\n\t\t\tt.Errorf(\"the id depends on the subscriber id's letter case: %s vs %s\", a, b)\n\t\t}\n\t\tif a == c {\n\t\t\tt.Error(\"two subscribers derived the same code id\")\n\t\t}\n\t\tif len(a) != 36 || a[14] != '5' || !strings.ContainsRune(\"89ab\", rune(a[19])) {\n\t\t\tt.Errorf(\"%s is not a version-5 uuid\", a)\n\t\t}\n\t})\n\n\tt.Run(\"500 is an error and unconfigured is an error\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusInternalServerError)\n\t\tif err := ProjectIdentityCode(context.Background(), fake.config(), row); err == nil {\n\t\t\tt.Error(\"ProjectIdentityCode = nil on a 500\")\n\t\t}\n\t\tif err := ProjectIdentityCode(context.Background(), ProjectionConfig{}, row); err == nil {\n\t\t\tt.Error(\"ProjectIdentityCode = nil with the projection unconfigured\")\n\t\t}\n\t})\n\n\t// The same three outcomes through the import, against a real database.\n\timportWith := func(t *testing.T, cfg ProjectionConfig) (importResultDTO, campaignDTO, string, string) {\n\t\tt.Helper()\n\t\tpool := setupSubsTestDB(t)\n\t\td := testDeps(pool)\n\t\tcamp := seedFirstTouchCampaign(t, pool, mountedMux(d), \"K7MNPQ\", \"Free side of wings\", 200)\n\t\td.Projection = cfg\n\t\tres, err := ImportSubscribers(context.Background(), d, ffImporter(t))\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"import: %v\", err)\n\t\t}\n\t\tvar subID string\n\t\tvar hash *string\n\t\tif err := pool.QueryRow(context.Background(),\n\t\t\t`SELECT id::text, identity_token_hash FROM subscribers WHERE external_ref = '1182'`).\n\t\t\tScan(&subID, &hash); err != nil {\n\t\t\tt.Fatalf(\"read the first-touch subscriber: %v\", err)\n\t\t}\n\t\tif hash == nil {\n\t\t\tt.Fatal(\"the first-touch subscriber has no identity_token_hash — the mint did not commit\")\n\t\t}\n\t\tif n := countRows(t, pool, `SELECT count(*) FROM identity_media WHERE subscriber_id = $1`, subID); n != 1 {\n\t\t\tt.Fatalf(\"identity_media rows for the first-touch subscriber = %d, want 1\", n)\n\t\t}\n\t\tif n := countRows(t, pool, `SELECT count(*) FROM subscribers WHERE identity_token_hash IS NULL`); n != 0 {\n\t\t\tt.Fatalf(\"%d imported subscribers were left without a code\", n)\n\t\t}\n\t\treturn res, camp, subID, *hash\n\t}\n\n\tt.Run(\"import: a 201 projects the first-touch code and only that one\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusCreated)\n\t\tres, camp, subID, hash := importWith(t, fake.config())\n\t\tif len(res.Warnings) != 0 {\n\t\t\tt.Errorf(\"warnings = %v, want none\", res.Warnings)\n\t\t}\n\t\thits := fake.recorded()\n\t\tif len(hits) != 1 {\n\t\t\tt.Fatalf(\"%d projection requests, want 1 (three of the four signups are identity-only)\", len(hits))\n\t\t}\n\t\tgot := hits[0].Body[0]\n\t\tif got[\"id\"] != IdentityCodeID(subID) || got[\"token_hash\"] != hash || got[\"campaign_id\"] != camp.ID {\n\t\t\tt.Errorf(\"projected row = %v, want id %s / hash %s / campaign %s\", got, IdentityCodeID(subID), hash, camp.ID)\n\t\t}\n\t\texp, _ := got[\"expires_at\"].(string)\n\t\tif parsed, err := time.Parse(time.RFC3339, exp); err != nil || !parsed.Equal(camp.EndsAt) {\n\t\t\tt.Errorf(\"projected expires_at = %q, want the campaign's ends_at %s\", exp, camp.EndsAt)\n\t\t}\n\t})\n\n\tt.Run(\"import: a 500 keeps the mint and says not_projected\", func(t *testing.T) {\n\t\tfake := newFakePostgREST(t, http.StatusInternalServerError)\n\t\tres, _, _, _ := importWith(t, fake.config()) // importWith asserts the mint committed\n\t\tif len(res.Warnings) != 1 || res.Warnings[0] != WarningNotProjected {\n\t\t\tt.Fatalf(\"warnings = %v, want [%q]\", res.Warnings, WarningNotProjected)\n\t\t}\n\t})\n\n\tt.Run(\"import: an unconfigured projection keeps the mint and says not_projected\", func(t *testing.T) {\n\t\tres, _, _, _ := importWith(t, ProjectionConfig{})\n\t\tif len(res.Warnings) != 1 || res.Warnings[0] != WarningNotProjected {\n\t\t\tt.Fatalf(\"warnings = %v, want [%q]\", res.Warnings, WarningNotProjected)\n\t\t}\n\t})\n}\n\n// GET and HEAD /m/{id}.png: public, image/png, privately cached for an hour,\n// and 404 for anything that is not a stored image.\nfunc TestIdentityMediaRouteIsPublicPNG(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tmux := mountedMux(testDeps(pool))\n\tcode := mintInTx(t, pool, seedSubscriber(t, pool, \"\"))\n\twant := storedPNG(t, pool, code.MediaID)\n\n\t// context.Background(): no user, no session — the route is public.\n\trec := do(t, mux, context.Background(), http.MethodGet, \"/m/\"+code.MediaID+\".png\", nil)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"GET = %d, want 200\\nbody: %s\", rec.Code, rec.Body.String())\n\t}\n\tif ct := rec.Header().Get(\"Content-Type\"); ct != \"image/png\" {\n\t\tt.Errorf(\"Content-Type = %q, want image/png\", ct)\n\t}\n\tif cc := rec.Header().Get(\"Cache-Control\"); cc != \"private, max-age=3600\" {\n\t\tt.Errorf(\"Cache-Control = %q, want private, max-age=3600\", cc)\n\t}\n\tif !bytes.Equal(rec.Body.Bytes(), want) {\n\t\tt.Error(\"GET body is not the stored PNG\")\n\t}\n\tif !bytes.HasPrefix(rec.Body.Bytes(), []byte(\"\\x89PNG\\r\\n\\x1a\\n\")) {\n\t\tt.Error(\"GET body does not start with the PNG signature\")\n\t}\n\n\thead := do(t, mux, context.Background(), http.MethodHead, \"/m/\"+code.MediaID+\".png\", nil)\n\tif head.Code != http.StatusOK || head.Body.Len() != 0 {\n\t\tt.Errorf(\"HEAD = %d with %d body bytes, want 200 and none\", head.Code, head.Body.Len())\n\t}\n\tif cl := head.Header().Get(\"Content-Length\"); cl != strconv.Itoa(len(want)) {\n\t\tt.Errorf(\"HEAD Content-Length = %q, want %d\", cl, len(want))\n\t}\n\n\tfor _, id := range []string{\"00000000-0000-4000-8000-000000000000\", \"not-a-uuid\", code.MediaID + \"x\"} {\n\t\tfor _, method := range []string{http.MethodGet, http.MethodHead} {\n\t\t\tif rec := do(t, mux, context.Background(), method, \"/m/\"+id+\".png\", nil); rec.Code != http.StatusNotFound {\n\t\t\t\tt.Errorf(\"%s /m/%s.png = %d, want 404\", method, id, rec.Code)\n\t\t\t}\n\t\t}\n\t}\n}\n\n// The detail sheet's status: no code, a code, a code that was sent.\nfunc TestSubscriberDetailReportsIdentityCodeStatus(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tctx := context.Background()\n\tmgr := seedUser(t, pool, \"manager\")\n\tmux := mountedMux(testDeps(pool))\n\tsubID := seedSubscriber(t, pool, \"\")\n\n\tdetail := func() identityCodeDTO {\n\t\trec := do(t, mux, userCtx(mgr, \"manager\"), http.MethodGet, \"/api/v1/marketing/subscribers/\"+subID, nil)\n\t\tif rec.Code != http.StatusOK {\n\t\t\tt.Fatalf(\"GET detail = %d\\nbody: %s\", rec.Code, rec.Body.String())\n\t\t}\n\t\tvar out subscriberDetailDTO\n\t\tdecode(t, rec, &out)\n\t\treturn out.IdentityCode\n\t}\n\n\tif ic := detail(); ic.Status != \"not_minted\" || ic.MediaURL != nil {\n\t\tt.Fatalf(\"before the mint: status %q / media_url %v, want not_minted / null\", ic.Status, ic.MediaURL)\n\t}\n\tcode := mintInTx(t, pool, subID)\n\tic := detail()\n\tif ic.Status != \"minted\" {\n\t\tt.Fatalf(\"after the mint: status %q, want minted\", ic.Status)\n\t}\n\tif ic.MediaURL == nil || *ic.MediaURL != \"/m/\"+code.MediaID+\".png\" {\n\t\tt.Fatalf(\"media_url = %v, want /m/%s.png\", ic.MediaURL, code.MediaID)\n\t}\n\tif rec := do(t, mux, context.Background(), http.MethodGet, *ic.MediaURL, nil); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"GET media_url = %d, want 200\", rec.Code)\n\t}\n\t// `sent` is Card 2's to cause; this card only reports it.\n\tif _, err := pool.Exec(ctx,\n\t\t`INSERT INTO subscriber_events (subscriber_id, kind) VALUES ($1, 'code_sent')`, subID); err != nil {\n\t\tt.Fatalf(\"seed code_sent: %v\", err)\n\t}\n\tif ic := detail(); ic.Status != \"sent\" || ic.SentAt == nil || ic.MediaURL == nil {\n\t\tt.Fatalf(\"after a code_sent event: status %q / sent_at %v / media_url %v, want sent with both\", ic.Status, ic.SentAt, ic.MediaURL)\n\t}\n}\n\n// The shipped reader was measured up to QR version 10. A campaign with a long\n// offer line must not push a customer's code past that: the label in the QR is\n// shortened, the code itself is not weakened.\nfunc TestIdentityCodeLongOfferTextStaysScannable(t *testing.T) {\n\tpool := setupSubsTestDB(t)\n\tlong := \"Buy any two combos and get a free large side of our signature honey-garlic wings plus a drink\"\n\tcamp := seedFirstTouchCampaign(t, pool, mountedMux(testDeps(pool)), \"K7MNPQ\", long, 1250)\n\tsubID := seedSubscriber(t, pool, \"K7MNPQ\")\n\n\ttoken := withIdentityRand(t, 44)\n\tcode := mintInTx(t, pool, subID)\n\tpng := storedPNG(t, pool, code.MediaID)\n\n\t// Find the label the mint settled on: the longest prefix whose payload\n\t// reproduces the stored PNG.\n\trunes := []rune(long)\n\tfor n := len(runes); n >= 1; n-- {\n\t\tlabel := string(runes[:n])\n\t\tif n < len(runes) {\n\t\t\tlabel = strings.TrimRight(label, \" \") + \"…\"\n\t\t}\n\t\tpayload := DefaultQRBaseURL + \"/r/\" + token +\n\t\t\tdescriptorFragment(t, label, camp.ID, camp.EndsAt.UTC().Format(\"2006-01-02\"), 12.5)\n\t\twant, version := encodeAsTheCardDoes(t, payload)\n\t\tif !bytes.Equal(png, want) {\n\t\t\tcontinue\n\t\t}\n\t\tif n == len(runes) {\n\t\t\tt.Fatalf(\"the full %d-char offer text was encoded at version %d — expected it to be shortened\", len(runes), version)\n\t\t}\n\t\tif version > 10 {\n\t\t\tt.Fatalf(\"label shortened to %q but the symbol is still version %d\", label, version)\n\t\t}\n\t\tt.Logf(\"label shortened to %d of %d chars (%q); payload %d chars, version %d\", n, len(runes), label, len(payload), version)\n\t\treturn\n\t}\n\tt.Fatal(\"the stored PNG matches no prefix of the offer text — the label rule is not the one this test states\")\n}\n\n// 0088's Down, run: the two columns and the image table go, `subscribers`\n// itself stays, and re-applying brings them back with the cascade and the\n// unique hash intact.\n//\n// Same rules as the 0085 and 0086 legs: start from HEAD, derive the version\n// from the filename, restore with db.Migrate (never a literal), touch no row.\nfunc TestMigration0088IdentityCodesDownAndUpRoundTrip(t *testing.T) {\n\tif testPool == nil {\n\t\tt.Skip(\"no test database (DB_TEST_URL unset and the local fallback is unreachable)\")\n\t}\n\tpool := testPool\n\tctx := context.Background()\n\tif err := db.Migrate(pool); err != nil {\n\t\tt.Fatalf(\"migrate up to HEAD before the down leg: %v\", err)\n\t}\n\tt.Cleanup(func() {\n\t\tif err := db.Migrate(pool); err != nil {\n\t\t\tt.Errorf(\"restore to HEAD: %v\", err)\n\t\t}\n\t})\n\n\tversion := identityMigrationVersion(t)\n\tif version != 88 {\n\t\tt.Fatalf(\"*_identity_codes.sql is migration %d; the slate fixes it at 88 (a renumbering is scope drift)\", version)\n\t}\n\n\ttableExists := func(name string) bool {\n\t\tvar ok bool\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT EXISTS (SELECT 1 FROM information_schema.tables\n\t\t\t                WHERE table_schema = current_schema() AND table_name = $1)`, name).Scan(&ok); err != nil {\n\t\t\tt.Fatalf(\"tableExists(%s): %v\", name, err)\n\t\t}\n\t\treturn ok\n\t}\n\tcolumnExists := func(table, column string) bool {\n\t\tvar ok bool\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT EXISTS (SELECT 1 FROM information_schema.columns\n\t\t\t                WHERE table_schema = current_schema() AND table_name = $1 AND column_name = $2)`,\n\t\t\ttable, column).Scan(&ok); err != nil {\n\t\t\tt.Fatalf(\"columnExists(%s.%s): %v\", table, column, err)\n\t\t}\n\t\treturn ok\n\t}\n\tassertUp := func(leg string) {\n\t\tt.Helper()\n\t\tif !tableExists(\"identity_media\") {\n\t\t\tt.Errorf(\"%s: identity_media is missing\", leg)\n\t\t}\n\t\tfor _, c := range []string{\"identity_token_hash\", \"identity_minted_at\"} {\n\t\t\tif !columnExists(\"subscribers\", c) {\n\t\t\t\tt.Errorf(\"%s: subscribers.%s is missing\", leg, c)\n\t\t\t}\n\t\t}\n\t\t// The erasure path: deleting a subscriber deletes their image.\n\t\tvar del string\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT confdeltype::text FROM pg_constraint\n\t\t\t WHERE conrelid = 'identity_media'::regclass AND contype = 'f'\n\t\t\t   AND confrelid = 'subscribers'::regclass`).Scan(&del); err != nil {\n\t\t\tt.Errorf(\"%s: read identity_media's FK onto subscribers: %v\", leg, err)\n\t\t} else if del != \"c\" {\n\t\t\tt.Errorf(\"%s: identity_media → subscribers is ON DELETE %q, want c (cascade)\", leg, del)\n\t\t}\n\t\t// Two customers can never share a code.\n\t\tvar uniques int\n\t\tif err := pool.QueryRow(ctx, `\n\t\t\tSELECT count(*) FROM pg_constraint c\n\t\t\t  JOIN pg_attribute a ON a.attrelid = c.conrelid AND a.attnum = ANY (c.conkey)\n\t\t\t WHERE c.conrelid = 'subscribers'::regclass AND c.contype = 'u'\n\t\t\t   AND a.attname = 'identity_token_hash'`).Scan(&uniques); err != nil {\n\t\t\tt.Errorf(\"%s: read the unique constraint: %v\", leg, err)\n\t\t} else if uniques != 1 {\n\t\t\tt.Errorf(\"%s: %d unique constraints on subscribers.identity_token_hash, want 1\", leg, uniques)\n\t\t}\n\t}\n\n\tassertUp(\"at HEAD\")\n\n\tif err := db.MigrateTo(pool, version-1); err != nil {\n\t\tt.Fatalf(\"migrate down to %d: %v\", version-1, err)\n\t}\n\tif tableExists(\"identity_media\") {\n\t\tt.Errorf(\"identity_media survived migration %d's Down\", version)\n\t}\n\tfor _, c := range []string{\"identity_token_hash\", \"identity_minted_at\"} {\n\t\tif columnExists(\"subscribers\", c) {\n\t\t\tt.Errorf(\"subscribers.%s survived migration %d's Down\", c, version)\n\t\t}\n\t}\n\tif !tableExists(\"subscribers\") || !columnExists(\"subscribers\", \"source_short\") {\n\t\tt.Fatalf(\"migration %d's Down took more than its own: subscribers (or its 0085 columns) is gone\", version)\n\t}\n\n\tif err := db.Migrate(pool); err != nil {\n\t\tt.Fatalf(\"migrate back up to HEAD: %v\", err)\n\t}\n\tassertUp(\"after re-apply\")\n\tt.Logf(\"migration %d Down/Up round-trip clean; schema restored to HEAD (not to a literal)\", version)\n}\n\nfunc identityMigrationVersion(t *testing.T) int64 {\n\tt.Helper()\n\tentries, err := os.ReadDir(migrationsDir)\n\tif err != nil {\n\t\tt.Fatalf(\"read %s: %v\", migrationsDir, err)\n\t}\n\tfor _, e := range entries {\n\t\tif !strings.HasSuffix(e.Name(), \"_identity_codes.sql\") {\n\t\t\tcontinue\n\t\t}\n\t\tm := migrationNumRe.FindStringSubmatch(e.Name())\n\t\tif m == nil {\n\t\t\tt.Fatalf(\"migration %q does not start with a version number\", e.Name())\n\t\t}\n\t\tv, err := strconv.ParseInt(m[1], 10, 64)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"parse version from %q: %v\", e.Name(), err)\n\t\t}\n\t\treturn v\n\t}\n\tt.Fatalf(\"no *_identity_codes.sql migration found in %s\", migrationsDir)\n\treturn 0\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
