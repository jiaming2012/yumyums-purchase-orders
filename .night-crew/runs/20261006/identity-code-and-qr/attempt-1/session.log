n      cases.push({ t, out, lvl, version: Number(/version=(\\d+)/.exec(o)[1]) });\n    }\n  }\n  await page.goto('/login.html');\n  await page.fill('input[type=\"email\"]', 'jamal@yumyums.kitchen');\n  await page.fill('input[type=\"password\"]', 'test123');\n  await page.click('button.btn');\n  await page.waitForURL((u) => !u.pathname.includes('login'));\n  await page.goto('/marketing.html');\n  await page.waitForFunction(() => window.MarketingScan && window.MarketingScan.booted === true);\n  await page.context().setOffline(true);\n  const tally = {};\n  for (const px of (process.env.PROBE_SURFACES || '640,320').split(',')) {\n    await page.evaluate((p) => { const s = document.getElementById('scan-file-surface'); s.style.width = p + 'px'; s.style.height = p + 'px'; }, px);\n    for (const c of cases) {\n      await page.evaluate(() => { const r = document.getElementById('scan-result'); r.removeAttribute('data-kind'); });\n      await page.setInputFiles('#scan-file', c.out);\n      await page.waitForSelector('#scan-result[data-kind]', { state: 'attached' });\n      const r = page.locator('#scan-result');\n      const kind = await r.getAttribute('data-kind'); const hash = await r.getAttribute('data-token-hash');\n      const key = `surface=${px} level=${c.lvl} v${c.version}`;\n      tally[key] = tally[key] || { n: 0, ok: 0, kinds: {} };\n      tally[key].n++; if (kind === 'embeddedOffer' && hash === sha(c.t)) tally[key].ok++;\n      const k = hash && hash !== sha(c.t) ? kind + ':WRONGHASH' : kind;\n      tally[key].kinds[k] = (tally[key].kinds[k] || 0) + 1;\n    }\n  }\n  console.log('PROBE ' + JSON.stringify(tally));\n});\nEOF\nPROBE_N=40 PROBE_LEVELS=L,M TEST_DB_NAME=hq_test_e2e_e1_20261006 TEST_PORT=8341 npx playwright test tests/zz-e1-density-probe.spec.js --project=chromium --retries=0 --reporter=line 2>&1 | grep -v WebServer | grep -E \"PROBE|passed|failed|Error\" | sed 's/\\x1b\\[[0-9;]*[A-Za-z]//g'; git checkout -- .night-crew/runs/2026-10-02-autonomous/logs/