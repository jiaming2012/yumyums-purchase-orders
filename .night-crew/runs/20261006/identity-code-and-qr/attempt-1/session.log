{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfjyLpttz4civKymKj12k","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018mfvtD76w9qGzSJgTvwhK7","name":"Read","input":{"file_path":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/backend/internal/marketing/subscribers.go","offset":44},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1144,"cache_read_input_tokens":108740,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1144},"output_tokens":52,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"792dcbd6-aa1d-4c6e-83da-0e3997c4c9b1","uuid":"e7f69c3f-f5ff-4668-8183-efa1ba492547","timestamp":"2026-10-05T23:39:16.024Z","request_id":"req_011CfjyLpPtck8XG6XqdVdvz","wire_tool_inputs":{"toolu_018mfvtD76w9qGzSJgTvwhK7":{"file_path":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/backend/internal/marketing/subscribers.go","offset":44}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018mfvtD76w9qGzSJgTvwhK7","type":"tool_result","content":"44\t// maxCSVBytes caps a guest-CSV upload. A Toast guest book for a one-truck\n45\t// business is kilobytes; 4 MB is four orders of magnitude of headroom and still\n46\t// refuses a mis-drag of a video.\n47\tconst maxCSVBytes = 4 << 20\n48\t\n49\t// maxCSVRows caps the row count independently of the byte count.\n50\tconst maxCSVRows = 50000\n51\t\n52\t// SubsFixtureEnv points the web-form importer at a committed JSON fixture\n53\t// instead of the live MySQL. It exists so the ATTENDED first import can be\n54\t// rehearsed against the fixture on the operator's own box without touching the\n55\t// website database, and so the E2E gate can drive the real HTTP route with no\n56\t// network at all.\n57\t//\n58\t// 🛑 It is never set in production and never set by the night's gates except\n59\t// where a test sets it explicitly for one request.\n60\tconst SubsFixtureEnv = \"HQ_FF_FIXTURE_PATH\"\n61\t\n62\t// ── wire shapes (§5, field for field; UI reads these json tags verbatim) ──\n63\t\n64\t// Consent states §5 enumerates. \"stop\" is an OPTED-OUT row, derived from §4's\n65\t// own `opted_out_at` column and nothing else.\n66\tconst (\n67\t\tConsentSMS       = \"sms\"\n68\t\tConsentEmailOnly = \"email_only\"\n69\t\tConsentPending   = \"pending\"\n70\t\tConsentStop      = \"stop\"\n71\t)\n72\t\n73\t// subscriberRowDTO is one row of §5's `rows:[…]`.\n74\t//\n75\t// 🛑 There is no `phone_e164` and no `email` field, on purpose. Adding one is a\n76\t// privacy regression, not a convenience.\n77\ttype subscriberRowDTO struct {\n78\t\tID          string    `json:\"id\"`\n79\t\tDisplayName *string   `json:\"display_name\"`\n80\t\tPhoneLast4  *string   `json:\"phone_last4\"`\n81\t\tEmailMasked *string   `json:\"email_masked\"`\n82\t\tSource      string    `json:\"source\"`\n83\t\tSourceShort *string   `json:\"source_short\"`\n84\t\tCampaignName *string  `json:\"campaign_name\"`\n85\t\tJoinedAt    time.Time `json:\"joined_at\"`\n86\t\tVisits      int       `json:\"visits\"`\n87\t\tConsent     string    `json:\"consent\"`\n88\t}\n89\t\n90\t// subscriberListResponse is §5's `{total, sms_opt_in, joined_this_week, rows}`.\n91\t// The three counts are over the WHOLE list, not the filtered page: they are the\n92\t// header's standing reading of the mailing list, and a count that moved when\n93\t// the operator tapped a filter chip would be a different number every tap.\n94\ttype subscriberListResponse struct {\n95\t\tTotal          int                `json:\"total\"`\n96\t\tSMSOptIn       int                `json:\"sms_opt_in\"`\n97\t\tJoinedThisWeek int                `json:\"joined_this_week\"`\n98\t\tRows           []subscriberRowDTO `json:\"rows\"`\n99\t}\n100\t\n101\t// eventDTO is one timeline entry.\n102\ttype eventDTO struct {\n103\t\tID   int64          `json:\"id\"`\n104\t\tKind string         `json:\"kind\"`\n105\t\tAt   time.Time      `json:\"at\"`\n106\t\tRef  map[string]any `json:\"ref\"`\n107\t}\n108\t\n109\t// offerDTO is one row of the detail sheet's `offers_now[]`: a campaign live\n110\t// right now that this subscriber could walk in and redeem.\n111\ttype offerDTO struct {\n112\t\tCampaignID     string    `json:\"campaign_id\"`\n113\t\tName           string    `json:\"name\"`\n114\t\tOfferText      string    `json:\"offer_text\"`\n115\t\tFaceValueCents int       `json:\"face_value_cents\"`\n116\t\tEndsAt         time.Time `json:\"ends_at\"`\n117\t}\n118\t\n119\t// identityCodeDTO is the detail sheet's \"identity-code status\".\n120\t//\n121\t// Activity E owns the identity code itself (`identity-code-and-qr`), so there\n122\t// is no code to show yet and no table holding one. The honest status is\n123\t// therefore derived from the TIMELINE: a `code_sent` event means a code went\n124\t// out and when; no such event means it has not. `status` is \"sent\" or\n125\t// \"not_sent\", and `requested_at` carries the last `resend_requested` so the\n126\t// sheet can say \"Resend requested · 2026-10-01\" without implying a send\n127\t// happened.\n128\ttype identityCodeDTO struct {\n129\t\tStatus      string     `json:\"status\"`\n130\t\tSentAt      *time.Time `json:\"sent_at\"`\n131\t\tRequestedAt *time.Time `json:\"requested_at\"`\n132\t}\n133\t\n134\t// consentTrailDTO is the audit half of the sheet: the §4 columns, spelled out.\n135\ttype consentTrailDTO struct {\n136\t\tSMSConsent   bool       `json:\"sms_consent\"`\n137\t\tEmailConsent bool       `json:\"email_consent\"`\n138\t\tEvidence     *string    `json:\"consent_evidence\"`\n139\t\tOptedOutAt   *time.Time `json:\"opted_out_at\"`\n140\t\tState        string     `json:\"state\"`\n141\t}\n142\t\n143\t// subscriberDetailDTO is §5's `detail + events[] + offers_now[]`.\n144\ttype subscriberDetailDTO struct {\n145\t\tsubscriberRowDTO\n146\t\tIdentityCode identityCodeDTO  `json:\"identity_code\"`\n147\t\tConsent      consentTrailDTO  `json:\"consent_trail\"`\n148\t\tEvents       []eventDTO       `json:\"events\"`\n149\t\tOffersNow    []offerDTO       `json:\"offers_now\"`\n150\t}\n151\t\n152\t// importResultDTO is what an import route answers with. It carries COUNTS and\n153\t// no contact values — an import summary is a response body like any other and\n154\t// the masking contract applies to it too.\n155\ttype importResultDTO struct {\n156\t\tSource     string `json:\"source\"`\n157\t\tRead       int    `json:\"read\"`\n158\t\tCreated    int    `json:\"created\"`\n159\t\tUpdated    int    `json:\"updated\"`\n160\t\tUnchanged  int    `json:\"unchanged\"`\n161\t\tSkipped    int    `json:\"skipped\"`\n162\t\tScansBound int    `json:\"scans_bound\"`\n163\t}\n164\t\n165\t// ── GET /subscribers ──\n166\t\n167\t// The §5 filter set. `all` is the default for anything unrecognized: the\n168\t// designed chip row is fixed, so an unexpected value is a client bug and a read\n169\t// that returns the list beats a read that returns a 400.\n170\t//\n171\t// Semantics (this card's call — the slate: \"the filter set … is the night's\"):\n172\t//\n173\t//\tall        every subscriber\n174\t//\tsms        sms_consent AND NOT opted out — who an SMS blast may reach\n175\t//\temail_only email_consent AND NOT sms_consent AND NOT opted out — reachable,\n176\t//\t           but not by text; the chip exists so a manager can see the people\n177\t//\t           an SMS campaign will silently miss\n178\t//\topted_out  opted_out_at IS NOT NULL — the suppression list, which must be\n179\t//\t           visible precisely because it must never be messaged\n180\tconst (\n181\t\tFilterAll       = \"all\"\n182\t\tFilterSMS       = \"sms\"\n183\t\tFilterEmailOnly = \"email_only\"\n184\t\tFilterOptedOut  = \"opted_out\"\n185\t)\n186\t\n187\t// ListSubscribersHandler is §5's GET /subscribers?q=&filter=&source=.\n188\tfunc ListSubscribersHandler(d Deps) http.HandlerFunc {\n189\t\treturn func(w http.ResponseWriter, r *http.Request) {\n190\t\t\tif requireManager(w, r) == nil {\n191\t\t\t\treturn\n192\t\t\t}\n193\t\t\tq := strings.TrimSpace(r.URL.Query().Get(\"q\"))\n194\t\t\tfilter := r.URL.Query().Get(\"filter\")\n195\t\t\tsource := r.URL.Query().Get(\"source\")\n196\t\n197\t\t\twhere := []string{\"TRUE\"}\n198\t\t\targs := []any{}\n199\t\t\t// Placeholders are numbered explicitly rather than rewritten into a\n200\t\t\t// template. A $N-substituting helper reads tidier and is wrong: once the\n201\t\t\t// first clause has shifted $1 to $2 the clause contains two \"$2\"s and the\n202\t\t\t// next substitution picks whichever comes first in the string.\n203\t\t\tph := func(v any) string {\n204\t\t\t\targs = append(args, v)\n205\t\t\t\treturn fmt.Sprintf(\"$%d\", len(args))\n206\t\t\t}\n207\t\t\tswitch filter {\n208\t\t\tcase FilterSMS:\n209\t\t\t\twhere = append(where, \"(s.sms_consent AND s.opted_out_at IS NULL)\")\n210\t\t\tcase FilterEmailOnly:\n211\t\t\t\twhere = append(where, \"(s.email_consent AND NOT s.sms_consent AND s.opted_out_at IS NULL)\")\n212\t\t\tcase FilterOptedOut:\n213\t\t\t\twhere = append(where, \"(s.opted_out_at IS NOT NULL)\")\n214\t\t\t}\n215\t\t\tif containsString(subscriberSources, source) {\n216\t\t\t\twhere = append(where, \"s.source = \"+ph(source))\n217\t\t\t}\n218\t\t\tif q != \"\" {\n219\t\t\t\t// q matches the display name, the email, the campaign name, the\n220\t\t\t\t// short, or the phone BY SUFFIX. The suffix match is what makes the\n221\t\t\t\t// masked cell searchable: a manager reads \"•••• 4821\" off the screen\n222\t\t\t\t// and types 4821. The full number is never rendered, but it is still\n223\t\t\t\t// the server's to search.\n224\t\t\t\tlike := ph(\"%\" + q + \"%\")\n225\t\t\t\tclause := \"(s.display_name ILIKE \" + like +\n226\t\t\t\t\t\" OR s.email ILIKE \" + like +\n227\t\t\t\t\t\" OR c.name ILIKE \" + like +\n228\t\t\t\t\t\" OR s.source_short ILIKE \" + like\n229\t\t\t\tif digits := onlyDigits(q); digits != \"\" {\n230\t\t\t\t\tclause += \" OR s.phone_e164 LIKE \" + ph(\"%\"+digits)\n231\t\t\t\t}\n232\t\t\t\twhere = append(where, clause+\")\")\n233\t\t\t}\n234\t\n235\t\t\tsql := `\n236\t\t\t\tSELECT s.id::text, s.display_name, s.phone_e164, s.email, s.source,\n237\t\t\t\t       s.source_short, c.name, s.joined_at, s.sms_consent,\n238\t\t\t\t       s.email_consent, s.opted_out_at,\n239\t\t\t\t       (SELECT count(*) FROM subscriber_events e\n240\t\t\t\t          WHERE e.subscriber_id = s.id AND e.kind IN ('scanned','redeemed'))\n241\t\t\t\t  FROM subscribers s\n242\t\t\t\t  LEFT JOIN qr_codes k ON k.short = s.source_short\n243\t\t\t\t  LEFT JOIN campaigns_admin c ON c.id = k.campaign_id\n244\t\t\t\t WHERE ` + strings.Join(where, \" AND \") + `\n245\t\t\t\t ORDER BY s.joined_at DESC, s.id\n246\t\t\t\t LIMIT 500`\n247\t\t\trows, err := d.Pool.Query(r.Context(), sql, args...)\n248\t\t\tif err != nil {\n249\t\t\t\twriteError(w, http.StatusInternalServerError, \"list_failed\")\n250\t\t\t\treturn\n251\t\t\t}\n252\t\t\tdefer rows.Close()\n253\t\t\tout := subscriberListResponse{Rows: []subscriberRowDTO{}}\n254\t\t\tfor rows.Next() {\n255\t\t\t\tvar (\n256\t\t\t\t\tid, source                         string\n257\t\t\t\t\tname, phone, email, short, camName *string\n258\t\t\t\t\tjoined                             time.Time\n259\t\t\t\t\tsms, emailOK                       bool\n260\t\t\t\t\toptedOut                           *time.Time\n261\t\t\t\t\tvisits                             int\n262\t\t\t\t)\n263\t\t\t\tif err := rows.Scan(&id, &name, &phone, &email, &source, &short, &camName,\n264\t\t\t\t\t&joined, &sms, &emailOK, &optedOut, &visits); err != nil {\n265\t\t\t\t\twriteError(w, http.StatusInternalServerError, \"list_failed\")\n266\t\t\t\t\treturn\n267\t\t\t\t}\n268\t\t\t\tout.Rows = append(out.Rows, subscriberRowDTO{\n269\t\t\t\t\tID: id, DisplayName: name,\n270\t\t\t\t\t// 🛑 maskPtr is where the privacy contract is kept. `phone` and\n271\t\t\t\t\t// `email` are local variables that END HERE.\n272\t\t\t\t\tPhoneLast4:  maskPtr(sources.Last4(deref(phone))),\n273\t\t\t\t\tEmailMasked: maskPtr(sources.MaskEmail(deref(email))),\n274\t\t\t\t\tSource:      source, SourceShort: short, CampaignName: camName,\n275\t\t\t\t\tJoinedAt: joined, Visits: visits,\n276\t\t\t\t\tConsent: consentState(sms, emailOK, optedOut),\n277\t\t\t\t})\n278\t\t\t}\n279\t\t\tif rows.Err() != nil {\n280\t\t\t\twriteError(w, http.StatusInternalServerError, \"list_failed\")\n281\t\t\t\treturn\n282\t\t\t}\n283\t\t\tif err := d.Pool.QueryRow(r.Context(), `\n284\t\t\t\tSELECT count(*),\n285\t\t\t\t       count(*) FILTER (WHERE sms_consent AND opted_out_at IS NULL),\n286\t\t\t\t       count(*) FILTER (WHERE joined_at >= now() - interval '7 days')\n287\t\t\t\t  FROM subscribers`).Scan(&out.Total, &out.SMSOptIn, &out.JoinedThisWeek); err != nil {\n288\t\t\t\twriteError(w, http.StatusInternalServerError, \"list_failed\")\n289\t\t\t\treturn\n290\t\t\t}\n291\t\t\twriteJSON(w, http.StatusOK, out)\n292\t\t}\n293\t}\n294\t\n295\t// ── GET /subscribers/{id} ──\n296\t\n297\t// GetSubscriberHandler is §5's detail route: the masked identity, the\n298\t// identity-code status, the consent trail, the timeline and the live offers.\n299\tfunc GetSubscriberHandler(d Deps) http.HandlerFunc {\n300\t\treturn func(w http.ResponseWriter, r *http.Request) {\n301\t\t\tif requireManager(w, r) == nil {\n302\t\t\t\treturn\n303\t\t\t}\n304\t\t\tid := chi.URLParam(r, \"id\")\n305\t\t\tvar (\n306\t\t\t\tname, phone, email, short, camName, evidence *string\n307\t\t\t\tsource                                       string\n308\t\t\t\tjoined                                       time.Time\n309\t\t\t\tsms, emailOK                                 bool\n310\t\t\t\toptedOut                                     *time.Time\n311\t\t\t\tvisits                                       int\n312\t\t\t)\n313\t\t\terr := d.Pool.QueryRow(r.Context(), `\n314\t\t\t\tSELECT s.display_name, s.phone_e164, s.email, s.source, s.source_short,\n315\t\t\t\t       c.name, s.consent_evidence, s.joined_at, s.sms_consent,\n316\t\t\t\t       s.email_consent, s.opted_out_at,\n317\t\t\t\t       (SELECT count(*) FROM subscriber_events e\n318\t\t\t\t          WHERE e.subscriber_id = s.id AND e.kind IN ('scanned','redeemed'))\n319\t\t\t\t  FROM subscribers s\n320\t\t\t\t  LEFT JOIN qr_codes k ON k.short = s.source_short\n321\t\t\t\t  LEFT JOIN campaigns_admin c ON c.id = k.campaign_id\n322\t\t\t\t WHERE s.id = $1`, id).\n323\t\t\t\tScan(&name, &phone, &email, &source, &short, &camName, &evidence,\n324\t\t\t\t\t&joined, &sms, &emailOK, &optedOut, &visits)\n325\t\t\tif errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {\n326\t\t\t\twriteError(w, http.StatusNotFound, \"not_found\")\n327\t\t\t\treturn\n328\t\t\t}\n329\t\t\tif err != nil {\n330\t\t\t\twriteError(w, http.StatusInternalServerError, \"detail_failed\")\n331\t\t\t\treturn\n332\t\t\t}\n333\t\n334\t\t\tevents, ic, err := subscriberTimeline(r.Context(), d, id)\n335\t\t\tif err != nil {\n336\t\t\t\twriteError(w, http.StatusInternalServerError, \"detail_failed\")\n337\t\t\t\treturn\n338\t\t\t}\n339\t\t\toffers, err := offersNow(r.Context(), d)\n340\t\t\tif err != nil {\n341\t\t\t\twriteError(w, http.StatusInternalServerError, \"detail_failed\")\n342\t\t\t\treturn\n343\t\t\t}\n344\t\t\twriteJSON(w, http.StatusOK, subscriberDetailDTO{\n345\t\t\t\tsubscriberRowDTO: subscriberRowDTO{\n346\t\t\t\t\tID: id, DisplayName: name,\n347\t\t\t\t\tPhoneLast4:  maskPtr(sources.Last4(deref(phone))),\n348\t\t\t\t\tEmailMasked: maskPtr(sources.MaskEmail(deref(email))),\n349\t\t\t\t\tSource:      source, SourceShort: short, CampaignName: camName,\n350\t\t\t\t\tJoinedAt: joined, Visits: visits,\n351\t\t\t\t\tConsent: consentState(sms, emailOK, optedOut),\n352\t\t\t\t},\n353\t\t\t\tIdentityCode: ic,\n354\t\t\t\tConsent: consentTrailDTO{\n355\t\t\t\t\tSMSConsent: sms, EmailConsent: emailOK, Evidence: evidence,\n356\t\t\t\t\tOptedOutAt: optedOut, State: consentState(sms, emailOK, optedOut),\n357\t\t\t\t},\n358\t\t\t\tEvents:    events,\n359\t\t\t\tOffersNow: offers,\n360\t\t\t})\n361\t\t}\n362\t}\n363\t\n364\t// subscriberTimeline reads the events newest-first and derives the\n365\t// identity-code status from them in one pass.\n366\tfunc subscriberTimeline(ctx context.Context, d Deps, id string) ([]eventDTO, identityCodeDTO, error) {\n367\t\trows, err := d.Pool.Query(ctx, `\n368\t\t\tSELECT id, kind, at, ref FROM subscriber_events\n369\t\t\t WHERE subscriber_id = $1 ORDER BY at DESC, id DESC LIMIT 200`, id)\n370\t\tif err != nil {\n371\t\t\treturn nil, identityCodeDTO{}, err\n372\t\t}\n373\t\tdefer rows.Close()\n374\t\tout := []eventDTO{}\n375\t\tic := identityCodeDTO{Status: \"not_sent\"}\n376\t\tfor rows.Next() {\n377\t\t\tvar e eventDTO\n378\t\t\tif err := rows.Scan(&e.ID, &e.Kind, &e.At, &e.Ref); err != nil {\n379\t\t\t\treturn nil, identityCodeDTO{}, err\n380\t\t\t}\n381\t\t\t// Rows arrive newest-first, so the FIRST of each kind is the latest.\n382\t\t\tswitch e.Kind {\n383\t\t\tcase \"code_sent\":\n384\t\t\t\tif ic.SentAt == nil {\n385\t\t\t\t\tat := e.At\n386\t\t\t\t\tic.SentAt = &at\n387\t\t\t\t\tic.Status = \"sent\"\n388\t\t\t\t}\n389\t\t\tcase \"resend_requested\":\n390\t\t\t\tif ic.RequestedAt == nil {\n391\t\t\t\t\tat := e.At\n392\t\t\t\t\tic.RequestedAt = &at\n393\t\t\t\t}\n394\t\t\t}\n395\t\t\tout = append(out, e)\n396\t\t}\n397\t\treturn out, ic, rows.Err()\n398\t}\n399\t\n400\t// offersNow is every campaign a walk-in could redeem right now. It is not\n401\t// per-subscriber because nothing in §4 scopes an offer to a person — the sheet\n402\t// answers \"what can I honor if they show up\", which is a property of the\n403\t// campaign set and of the clock.\n404\tfunc offersNow(ctx context.Context, d Deps) ([]offerDTO, error) {\n405\t\trows, err := d.Pool.Query(ctx, `\n406\t\t\tSELECT id::text, name, offer_text, face_value_cents, ends_at\n407\t\t\t  FROM campaigns_admin\n408\t\t\t WHERE status = 'live' AND starts_at <= now() AND ends_at >= now()\n409\t\t\t ORDER BY ends_at ASC LIMIT 20`)\n410\t\tif err != nil {\n411\t\t\treturn nil, err\n412\t\t}\n413\t\tdefer rows.Close()\n414\t\tout := []offerDTO{}\n415\t\tfor rows.Next() {\n416\t\t\tvar o offerDTO\n417\t\t\tif err := rows.Scan(&o.CampaignID, &o.Name, &o.OfferText, &o.FaceValueCents, &o.EndsAt); err != nil {\n418\t\t\t\treturn nil, err\n419\t\t\t}\n420\t\t\tout = append(out, o)\n421\t\t}\n422\t\treturn out, rows.Err()\n423\t}\n424\t\n425\t// ── POST /subscribers/{id}/resend ──\n426\t\n427\t// ResendQRHandler is §5's one write: 202, an appended `resend_requested`\n428\t// event, and NO SEND.\n429\t//\n430\t// 🛑 Read the whole function. There is no branch, no flag and no env var that\n431\t// makes it send anything; the only side effect is the INSERT below. The event\n432\t// kind is `resend_requested` and NOT `code_sent` precisely so the Stats funnel\n433\t// (which counts `code_sent`) cannot be inflated by a request nobody fulfilled.\n434\t// Activity E will append `code_sent` when a message actually leaves.\n435\tfunc ResendQRHandler(d Deps) http.HandlerFunc {\n436\t\treturn func(w http.ResponseWriter, r *http.Request) {\n437\t\t\tuser := requireManager(w, r)\n438\t\t\tif user == nil {\n439\t\t\t\treturn\n440\t\t\t}\n441\t\t\tid := chi.URLParam(r, \"id\")\n442\t\t\tvar exists bool\n443\t\t\terr := d.Pool.QueryRow(r.Context(),\n444\t\t\t\t`SELECT true FROM subscribers WHERE id = $1`, id).Scan(&exists)\n445\t\t\tif errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {\n446\t\t\t\twriteError(w, http.StatusNotFound, \"not_found\")\n447\t\t\t\treturn\n448\t\t\t}\n449\t\t\tif err != nil {\n450\t\t\t\twriteError(w, http.StatusInternalServerError, \"resend_failed\")\n451\t\t\t\treturn\n452\t\t\t}\n453\t\t\tif _, err := d.Pool.Exec(r.Context(), `\n454\t\t\t\tINSERT INTO subscriber_events (subscriber_id, kind, ref)\n455\t\t\t\tVALUES ($1, 'resend_requested', jsonb_build_object('requested_by', $2::text, 'sent', false))`,\n456\t\t\t\tid, user.ID); err != nil {\n457\t\t\t\twriteError(w, http.StatusInternalServerError, \"resend_failed\")\n458\t\t\t\treturn\n459\t\t\t}\n460\t\t\t// 202 Accepted, and the body says so in words: the request is\n461\t\t\t// recorded, the send is Activity E's. A 200 here would read as \"done\".\n462\t\t\twriteJSON(w, http.StatusAccepted, map[string]any{\n463\t\t\t\t\"status\": \"recorded\",\n464\t\t\t\t\"sent\":   false,\n465\t\t\t\t\"note\":   \"resend_requested recorded; sending is not implemented yet\",\n466\t\t\t})\n467\t\t}\n468\t}\n469\t\n470\t// ── the import entry points ──\n471\t\n472\t// ImportToastGuestsHandler takes a Toast guest CSV on the request body\n473\t// (text/csv or multipart `file`) and lands it through the one upsert.\n474\tfunc ImportToastGuestsHandler(d Deps) http.HandlerFunc {\n475\t\treturn func(w http.ResponseWriter, r *http.Request) {\n476\t\t\tif requireManager(w, r) == nil {\n477\t\t\t\treturn\n478\t\t\t}\n479\t\t\tbody, err := csvBody(r)\n480\t\t\tif err != nil {\n481\t\t\t\twriteError(w, http.StatusBadRequest, \"bad_upload\")\n482\t\t\t\treturn\n483\t\t\t}\n484\t\t\timp, err := sources.NewToastGuests(strings.NewReader(body), maxCSVRows)\n485\t\t\tif err != nil {\n486\t\t\t\tif errors.Is(err, sources.ErrNoGuestColumns) {\n487\t\t\t\t\twriteError(w, http.StatusBadRequest, \"no_guest_columns\")\n488\t\t\t\t\treturn\n489\t\t\t\t}\n490\t\t\t\twriteError(w, http.StatusBadRequest, \"bad_csv\")\n491\t\t\t\treturn\n492\t\t\t}\n493\t\t\trunImport(w, r, d, imp)\n494\t\t}\n495\t}\n496\t\n497\t// ImportWebFormHandler runs the Fluent Forms reader.\n498\t//\n499\t// 🛑 ATTENDED ONLY. With FF_DB_* unset — which is their state in every gate,\n500\t// every worktree and prod — this answers 503 {\"error\":\"ff_not_configured\"} and\n501\t// opens no connection. The first live import is an operator act, by design\n502\t// (see internal/marketing/sources/testdata/README.md).\n503\tfunc ImportWebFormHandler(d Deps) http.HandlerFunc {\n504\t\treturn func(w http.ResponseWriter, r *http.Request) {\n505\t\t\tif requireManager(w, r) == nil {\n506\t\t\t\treturn\n507\t\t\t}\n508\t\t\tvar imp *sources.FluentForms\n509\t\t\tvar err error\n510\t\t\tif p := strings.TrimSpace(os.Getenv(SubsFixtureEnv)); p != \"\" {\n511\t\t\t\tvar raw []byte\n512\t\t\t\tif raw, err = os.ReadFile(p); err == nil {\n513\t\t\t\t\timp, err = sources.NewFluentFormsFromJSON(raw)\n514\t\t\t\t}\n515\t\t\t\tif err != nil {\n516\t\t\t\t\twriteError(w, http.StatusInternalServerError, \"ff_fixture_unreadable\")\n517\t\t\t\t\treturn\n518\t\t\t\t}\n519\t\t\t} else {\n520\t\t\t\timp, err = sources.NewFluentForms()\n521\t\t\t\tif errors.Is(err, sources.ErrFluentFormsNotConfigured) {\n522\t\t\t\t\twriteError(w, http.StatusServiceUnavailable, \"ff_not_configured\")\n523\t\t\t\t\treturn\n524\t\t\t\t}\n525\t\t\t\tif err != nil {\n526\t\t\t\t\twriteError(w, http.StatusInternalServerError, \"ff_open_failed\")\n527\t\t\t\t\treturn\n528\t\t\t\t}\n529\t\t\t}\n530\t\t\trunImport(w, r, d, imp)\n531\t\t}\n532\t}\n533\t\n534\tfunc runImport(w http.ResponseWriter, r *http.Request, d Deps, imp sources.Importer) {\n535\t\tres, err := ImportSubscribers(r.Context(), d.Pool, imp)\n536\t\tif err != nil {\n537\t\t\twriteError(w, http.StatusInternalServerError, \"import_failed\")\n538\t\t\treturn\n539\t\t}\n540\t\twriteJSON(w, http.StatusOK, res)\n541\t}\n542\t\n543\t// csvBody reads either a raw body or a multipart `file` part.\n544\tfunc csvBody(r *http.Request) (string, error) {\n545\t\tct := r.Header.Get(\"Content-Type\")\n546\t\tif strings.HasPrefix(ct, \"multipart/form-data\") {\n547\t\t\tif err := r.ParseMultipartForm(maxCSVBytes); err != nil {\n548\t\t\t\treturn \"\", err\n549\t\t\t}\n550\t\t\tf, _, err := r.FormFile(\"file\")\n551\t\t\tif err != nil {\n552\t\t\t\treturn \"\", err\n553\t\t\t}\n554\t\t\tdefer f.Close()\n555\t\t\tb, err := io.ReadAll(io.LimitReader(f, maxCSVBytes))\n556\t\t\treturn string(b), err\n557\t\t}\n558\t\tb, err := io.ReadAll(io.LimitReader(r.Body, maxCSVBytes))\n559\t\tif err != nil {\n560\t\t\treturn \"\", err\n561\t\t}\n562\t\tif strings.TrimSpace(string(b)) == \"\" {\n563\t\t\treturn \"\", fmt.Errorf(\"empty body\")\n564\t\t}\n565\t\treturn string(b), nil\n566\t}\n567\t\n568\t// ── the ONE upsert every adapter lands through ──\n569\t\n570\t// ImportSubscribers reads an Importer and lands its candidates.\n571\t//\n572\t// # Idempotency, in the order it is attempted\n573\t//\n574\t//  1. `(source, external_ref)` — §4's unique key, and the only handle a source\n575\t//     with stable ids needs. Re-running the same import updates in place.\n576\t//  2. `phone_e164` — §4's other unique, and the key spike 02 proved closed.\n577\t//     This is what collapses \"17735554821\" onto the row \"(773) 555-4821\"\n578\t//     already created, across sources: a Toast guest who later fills in the web\n579\t//     form is ONE person, not two rows the operator has to reconcile by eye.\n580\t//  3. otherwise INSERT.\n581\t//\n582\t// An UPDATE is a MERGE with a FIELD-BY-FIELD policy, not a blanket\n583\t// fill-the-NULLs — see mergeSubscriber for the rule each column gets and why.\n584\t// In short: display_name and email converge on the LATEST value (they are\n585\t// corrections), identity and first-touch keep the FIRST, consent is MONOTONIC,\n586\t// and an opt-out is sticky. The result distinguishes `updated` from\n587\t// `unchanged`, so a re-import never claims a write it did not make.\n588\t//\n589\t// `signed_up` is appended on INSERT only. An idempotent re-run that appended an\n590\t// event every time would make the timeline a log of imports instead of a\n591\t// history of the person.\n592\tfunc ImportSubscribers(ctx context.Context, pool interface {\n593\t\tBegin(context.Context) (pgx.Tx, error)\n594\t}, imp sources.Importer) (importResultDTO, error) {\n595\t\tcands, err := imp.Read()\n596\t\tif err != nil {\n597\t\t\treturn importResultDTO{}, err\n598\t\t}\n599\t\tres := importResultDTO{Source: imp.Source(), Read: len(cands)}\n600\t\ttx, err := pool.Begin(ctx)\n601\t\tif err != nil {\n602\t\t\treturn res, err\n603\t\t}\n604\t\tdefer func() { _ = tx.Rollback(ctx) }()\n605\t\n606\t\tfor _, c := range cands {\n607\t\t\tif c.PhoneE164 == \"\" && c.Email == \"\" {\n608\t\t\t\tres.Skipped++\n609\t\t\t\tcontinue\n610\t\t\t}\n611\t\t\t// An unknown short would violate the FK onto qr_codes(short) and cost\n612\t\t\t// the whole import. A printed code that no longer exists is the\n613\t\t\t// customer's reality, not an error: keep the person, drop the\n614\t\t\t// attribution, and say so in the evidence line.\n615\t\t\tshort := c.SourceShort\n616\t\t\tif short != \"\" {\n617\t\t\t\tvar ok bool\n618\t\t\t\tif err := tx.QueryRow(ctx, `SELECT true FROM qr_codes WHERE short = $1`, short).Scan(&ok); err != nil {\n619\t\t\t\t\tif !errors.Is(err, pgx.ErrNoRows) {\n620\t\t\t\t\t\treturn res, err\n621\t\t\t\t\t}\n622\t\t\t\t\tshort = \"\"\n623\t\t\t\t}\n624\t\t\t}\n625\t\n626\t\t\tid, found, err := findSubscriber(ctx, tx, c)\n627\t\t\tif err != nil {\n628\t\t\t\treturn res, err\n629\t\t\t}\n630\t\t\tif found {\n631\t\t\t\tchanged, err := mergeSubscriber(ctx, tx, id, c, short)\n632\t\t\t\tif err != nil {\n633\t\t\t\t\treturn res, err\n634\t\t\t\t}\n635\t\t\t\tif changed {\n636\t\t\t\t\tres.Updated++\n637\t\t\t\t} else {\n638\t\t\t\t\tres.Unchanged++\n639\t\t\t\t}\n640\t\t\t} else {\n641\t\t\t\tid, err = insertSubscriber(ctx, tx, c, short)\n642\t\t\t\tif err != nil {\n643\t\t\t\t\treturn res, err\n644\t\t\t\t}\n645\t\t\t\tres.Created++\n646\t\t\t}\n647\t\t\tif short != \"\" {\n648\t\t\t\tn, err := sources.BackfillScanSubscriber(ctx, tx, short, id, c.JoinedAt)\n649\t\t\t\tif err != nil {\n650\t\t\t\t\treturn res, err\n651\t\t\t\t}\n652\t\t\t\tres.ScansBound += n\n653\t\t\t}\n654\t\t}\n655\t\tif err := tx.Commit(ctx); err != nil {\n656\t\t\treturn res, err\n657\t\t}\n658\t\treturn res, nil\n659\t}\n660\t\n661\tfunc findSubscriber(ctx context.Context, tx pgx.Tx, c sources.Candidate) (string, bool, error) {\n662\t\tif c.ExternalRef != \"\" {\n663\t\t\tvar id string\n664\t\t\terr := tx.QueryRow(ctx,\n665\t\t\t\t`SELECT id::text FROM subscribers WHERE source = $1 AND external_ref = $2`,\n666\t\t\t\tc.Source, c.ExternalRef).Scan(&id)\n667\t\t\tif err == nil {\n668\t\t\t\treturn id, true, nil\n669\t\t\t}\n670\t\t\tif !errors.Is(err, pgx.ErrNoRows) {\n671\t\t\t\treturn \"\", false, err\n672\t\t\t}\n673\t\t}\n674\t\tif c.PhoneE164 != \"\" {\n675\t\t\tvar id string\n676\t\t\terr := tx.QueryRow(ctx,\n677\t\t\t\t`SELECT id::text FROM subscribers WHERE phone_e164 = $1`, c.PhoneE164).Scan(&id)\n678\t\t\tif err == nil {\n679\t\t\t\treturn id, true, nil\n680\t\t\t}\n681\t\t\tif !errors.Is(err, pgx.ErrNoRows) {\n682\t\t\t\treturn \"\", false, err\n683\t\t\t}\n684\t\t}\n685\t\treturn \"\", false, nil\n686\t}\n687\t\n688\tfunc insertSubscriber(ctx context.Context, tx pgx.Tx, c sources.Candidate, short string) (string, error) {\n689\t\tvar id string\n690\t\terr := tx.QueryRow(ctx, `\n691\t\t\tINSERT INTO subscribers (display_name, phone_e164, email, source, source_short,\n692\t\t\t                         sms_consent, email_consent, consent_evidence,\n693\t\t\t                         opted_out_at, joined_at, external_ref)\n694\t\t\tVALUES (NULLIF($1,''), NULLIF($2,''), NULLIF($3,''), $4, NULLIF($5,''),\n695\t\t\t        $6, $7, NULLIF($8,''),\n696\t\t\t        CASE WHEN $9 THEN now() ELSE NULL END, $10, NULLIF($11,''))\n697\t\t\tRETURNING id::text`,\n698\t\t\tc.DisplayName, c.PhoneE164, c.Email, c.Source, short,\n699\t\t\tc.SMSConsent, c.EmailConsent, c.ConsentEvidence, c.OptedOut,\n700\t\t\tc.JoinedAt, c.ExternalRef).Scan(&id)\n701\t\tif err != nil {\n702\t\t\t// A concurrent import, or a phone that findSubscriber could not see\n703\t\t\t// because the candidate carried only an email on the first pass. Fall\n704\t\t\t// back to the merge rather than failing the whole file.\n705\t\t\tvar pgErr *pgconn.PgError\n706\t\t\tif errors.As(err, &pgErr) && pgErr.Code == \"23505\" && c.PhoneE164 != \"\" {\n707\t\t\t\tif e2 := tx.QueryRow(ctx,\n708\t\t\t\t\t`SELECT id::text FROM subscribers WHERE phone_e164 = $1`, c.PhoneE164).Scan(&id); e2 == nil {\n709\t\t\t\t\t_, mErr := mergeSubscriber(ctx, tx, id, c, short)\n710\t\t\t\t\treturn id, mErr\n711\t\t\t\t}\n712\t\t\t}\n713\t\t\treturn \"\", fmt.Errorf(\"insert subscriber: %w\", err)\n714\t\t}\n715\t\tif _, err := tx.Exec(ctx, `\n716\t\t\tINSERT INTO subscriber_events (subscriber_id, kind, at, ref)\n717\t\t\tVALUES ($1, 'signed_up', $2, jsonb_build_object('source', $3::text))`,\n718\t\t\tid, c.JoinedAt, c.Source); err != nil {\n719\t\t\treturn \"\", fmt.Errorf(\"insert signed_up: %w\", err)\n720\t\t}\n721\t\tif c.OptedOut {\n722\t\t\tif _, err := tx.Exec(ctx, `\n723\t\t\t\tINSERT INTO subscriber_events (subscriber_id, kind, ref)\n724\t\t\t\tVALUES ($1, 'opted_out', jsonb_build_object('source', $2::text))`,\n725\t\t\t\tid, c.Source); err != nil {\n726\t\t\t\treturn \"\", fmt.Errorf(\"insert opted_out: %w\", err)\n727\t\t\t}\n728\t\t}\n729\t\treturn id, nil\n730\t}\n731\t\n732\t// mergeSubscriber applies this card's FIELD-BY-FIELD merge policy and reports\n733\t// whether anything actually changed.\n734\t//\n735\t// ═══════════════════════════════════════════════════════════════════════════\n736\t// THE POLICY, AND WHY EACH FIELD GETS THE RULE IT GETS (G6 finding F4)\n737\t//\n738\t// \"COALESCE(existing, new) everywhere\" was wrong in one direction and\n739\t// right in the other, so the fields are now split explicitly:\n740\t//\n741\t//\tdisplay_name  LATEST WINS. A name corrected upstream (\"Dana\" → \"Dana\n742\t//\temail         Reyes\") is a CORRECTION, and silently discarding it while\n743\t//\t              reporting `updated: 1` is the worst of both. These are the\n744\t//\t              two fields a human actually fixes at the source.\n745\t//\n746\t//\tphone_e164    FIRST WINS. This is the dedupe IDENTITY — the key\n747\t//\t              findSubscriber matched on. Reassigning it under a row would\n748\t//\t              silently re-point who that record is.\n749\t//\n750\t//\tsource_short  FIRST WINS. Decision 189 is FIRST-TOUCH: a subscriber's\n751\t//\t              campaign is the first code they scanned, so a later import\n752\t//\t              carrying a different short must not overwrite it.\n753\t//\n754\t//\tsms_consent   MONOTONIC (OR). Consent is granted, never revoked by an\n755\t//\temail_consent import: an import that omits a box is silent about it, not a\n756\t//\t              withdrawal. Withdrawal is opted_out_at, which WINS over both\n757\t//\t              when the list derives its consent state.\n758\t//\n759\t//\tconsent_evidence  FIRST WINS. The trail records the consent originally\n760\t//\t              given; successive actions live in subscriber_events.\n761\t//\n762\t//\topted_out_at  STICKY, EARLIEST. Once set it is never cleared by an import.\n763\t//\t              An opt-out is the one thing that must survive every source.\n764\t//\n765\t//\tjoined_at     EARLIEST (LEAST). They joined when they first joined.\n766\t//\texternal_ref  FIRST WINS. It is an idempotency handle, not data.\n767\t//\n768\t// The asymmetry between display_name (latest wins) and consent (monotonic) is\n769\t// deliberate: a name is a fact an upstream system can correct, and consent is a\n770\t// permission that only the person can widen and only an opt-out can close.\n771\t//\n772\t// ═══════════════════════════════════════════════════════════════════════════\n773\t// AND THE COUNT IS HONEST\n774\t//\n775\t// The UPDATE carries an IS DISTINCT FROM guard over exactly the tuple it would\n776\t// write, so RowsAffected is 1 only when a field genuinely moves. An unchanged\n777\t// re-import now reports `unchanged`, not `updated`. A count that claims an\n778\t// update that did not happen is a count nobody can reconcile against.\n779\tfunc mergeSubscriber(ctx context.Context, tx pgx.Tx, id string, c sources.Candidate, short string) (bool, error) {\n780\t\ttag, err := tx.Exec(ctx, `\n781\t\t\tUPDATE subscribers SET\n782\t\t\t  display_name     = COALESCE(NULLIF($2,''), display_name),\n783\t\t\t  email            = COALESCE(NULLIF($4,''), email),\n784\t\t\t  phone_e164       = COALESCE(phone_e164,   NULLIF($3,'')),\n785\t\t\t  source_short     = COALESCE(source_short, NULLIF($5,'')),\n786\t\t\t  sms_consent      = sms_consent   OR $6,\n787\t\t\t  email_consent    = email_consent OR $7,\n788\t\t\t  consent_evidence = COALESCE(consent_evidence, NULLIF($8,'')),\n789\t\t\t  opted_out_at     = CASE WHEN $9 THEN COALESCE(opted_out_at, now()) ELSE opted_out_at END,\n790\t\t\t  joined_at        = LEAST(joined_at, $10),\n791\t\t\t  external_ref     = COALESCE(external_ref, NULLIF($11,''))\n792\t\t\tWHERE id = $1\n793\t\t\t  AND (display_name, email, phone_e164, source_short, sms_consent,\n794\t\t\t       email_consent, consent_evidence, opted_out_at, joined_at, external_ref)\n795\t\t\t      IS DISTINCT FROM\n796\t\t\t      (COALESCE(NULLIF($2,''), display_name),\n797\t\t\t       COALESCE(NULLIF($4,''), email),\n798\t\t\t       COALESCE(phone_e164,   NULLIF($3,'')),\n799\t\t\t       COALESCE(source_short, NULLIF($5,'')),\n800\t\t\t       sms_consent   OR $6,\n801\t\t\t       email_consent OR $7,\n802\t\t\t       COALESCE(consent_evidence, NULLIF($8,'')),\n803\t\t\t       CASE WHEN $9 THEN COALESCE(opted_out_at, now()) ELSE opted_out_at END,\n804\t\t\t       LEAST(joined_at, $10),\n805\t\t\t       COALESCE(external_ref, NULLIF($11,'')))`,\n806\t\t\tid, c.DisplayName, c.PhoneE164, c.Email, short,\n807\t\t\tc.SMSConsent, c.EmailConsent, c.ConsentEvidence, c.OptedOut,\n808\t\t\tc.JoinedAt, c.ExternalRef)\n809\t\tif err != nil {\n810\t\t\treturn false, fmt.Errorf(\"merge subscriber: %w\", err)\n811\t\t}\n812\t\treturn tag.RowsAffected() > 0, nil\n813\t}\n814\t\n815\t// ── small helpers ──\n816\t\n817\t// subscriberSources is §4's enum, used to validate the `source=` filter.\n818\tvar subscriberSources = []string{\n819\t\tsources.SourceWebForm, sources.SourceToastImport,\n820\t\tsources.SourceSMSKeyword, sources.SourceQR,\n821\t}\n822\t\n823\t// consentState derives §5's four-value consent field from the §4 columns.\n824\t// opted_out_at WINS over both flags: a person who said STOP is \"stop\" even if\n825\t// a stale checkbox is still true, and that precedence is the whole point of\n826\t// surfacing the state at all.\n827\tfunc consentState(sms, email bool, optedOut *time.Time) string {\n828\t\tswitch {\n829\t\tcase optedOut != nil:\n830\t\t\treturn ConsentStop\n831\t\tcase sms:\n832\t\t\treturn ConsentSMS\n833\t\tcase email:\n834\t\t\treturn ConsentEmailOnly\n835\t\tdefault:\n836\t\t\treturn ConsentPending\n837\t\t}\n838\t}\n839\t\n840\tfunc deref(s *string) string {\n841\t\tif s == nil {\n842\t\t\treturn \"\"\n843\t\t}\n844\t\treturn *s\n845\t}\n846\t\n847\t// maskPtr turns \"\" into a JSON null, so the UI can tell \"no phone on file\"\n848\t// from \"a phone whose mask is empty\" — there is no second case, and null is\n849\t// the honest wire value for the first.\n850\tfunc maskPtr(s string) *string {\n851\t\tif s == \"\" {\n852\t\t\treturn nil\n853\t\t}\n854\t\treturn &s\n855\t}\n856\t\n857\tfunc onlyDigits(s string) string {\n858\t\tvar b strings.Builder\n859\t\tfor _, r := range s {\n860\t\t\tif r >= '0' && r <= '9' {\n861\t\t\t\tb.WriteRune(r)\n862\t\t\t}\n863\t\t}\n864\t\treturn b.String()\n865\t}\n866\t"}]},"parent_tool_use_id":null,"session_id":"792dcbd6-aa1d-4c6e-83da-0e3997c4c9b1","uuid":"07936e59-cea9-4a98-8b77-a948d64cab8f","timestamp":"2026-10-05T23:39:16.288Z","tool_use_result":{"type":"text","file":{"filePath":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/backend/internal/marketing/subscribers.go","content":"// maxCSVBytes caps a guest-CSV upload. A Toast guest book for a one-truck\n// business is kilobytes; 4 MB is four orders of magnitude of headroom and still\n// refuses a mis-drag of a video.\nconst maxCSVBytes = 4 << 20\n\n// maxCSVRows caps the row count independently of the byte count.\nconst maxCSVRows = 50000\n\n// SubsFixtureEnv points the web-form importer at a committed JSON fixture\n// instead of the live MySQL. It exists so the ATTENDED first import can be\n// rehearsed against the fixture on the operator's own box without touching the\n// website database, and so the E2E gate can drive the real HTTP route with no\n// network at all.\n//\n// 🛑 It is never set in production and never set by the night's gates except\n// where a test sets it explicitly for one request.\nconst SubsFixtureEnv = \"HQ_FF_FIXTURE_PATH\"\n\n// ── wire shapes (§5, field for field; UI reads these json tags verbatim) ──\n\n// Consent states §5 enumerates. \"stop\" is an OPTED-OUT row, derived from §4's\n// own `opted_out_at` column and nothing else.\nconst (\n\tConsentSMS       = \"sms\"\n\tConsentEmailOnly = \"email_only\"\n\tConsentPending   = \"pending\"\n\tConsentStop      = \"stop\"\n)\n\n// subscriberRowDTO is one row of §5's `rows:[…]`.\n//\n// 🛑 There is no `phone_e164` and no `email` field, on purpose. Adding one is a\n// privacy regression, not a convenience.\ntype subscriberRowDTO struct {\n\tID          string    `json:\"id\"`\n\tDisplayName *string   `json:\"display_name\"`\n\tPhoneLast4  *string   `json:\"phone_last4\"`\n\tEmailMasked *string   `json:\"email_masked\"`\n\tSource      string    `json:\"source\"`\n\tSourceShort *string   `json:\"source_short\"`\n\tCampaignName *string  `json:\"campaign_name\"`\n\tJoinedAt    time.Time `json:\"joined_at\"`\n\tVisits      int       `json:\"visits\"`\n\tConsent     string    `json:\"consent\"`\n}\n\n// subscriberListResponse is §5's `{total, sms_opt_in, joined_this_week, rows}`.\n// The three counts are over the WHOLE list, not the filtered page: they are the\n// header's standing reading of the mailing list, and a count that moved when\n// the operator tapped a filter chip would be a different number every tap.\ntype subscriberListResponse struct {\n\tTotal          int                `json:\"total\"`\n\tSMSOptIn       int                `json:\"sms_opt_in\"`\n\tJoinedThisWeek int                `json:\"joined_this_week\"`\n\tRows           []subscriberRowDTO `json:\"rows\"`\n}\n\n// eventDTO is one timeline entry.\ntype eventDTO struct {\n\tID   int64          `json:\"id\"`\n\tKind string         `json:\"kind\"`\n\tAt   time.Time      `json:\"at\"`\n\tRef  map[string]any `json:\"ref\"`\n}\n\n// offerDTO is one row of the detail sheet's `offers_now[]`: a campaign live\n// right now that this subscriber could walk in and redeem.\ntype offerDTO struct {\n\tCampaignID     string    `json:\"campaign_id\"`\n\tName           string    `json:\"name\"`\n\tOfferText      string    `json:\"offer_text\"`\n\tFaceValueCents int       `json:\"face_value_cents\"`\n\tEndsAt         time.Time `json:\"ends_at\"`\n}\n\n// identityCodeDTO is the detail sheet's \"identity-code status\".\n//\n// Activity E owns the identity code itself (`identity-code-and-qr`), so there\n// is no code to show yet and no table holding one. The honest status is\n// therefore derived from the TIMELINE: a `code_sent` event means a code went\n// out and when; no such event means it has not. `status` is \"sent\" or\n// \"not_sent\", and `requested_at` carries the last `resend_requested` so the\n// sheet can say \"Resend requested · 2026-10-01\" without implying a send\n// happened.\ntype identityCodeDTO struct {\n\tStatus      string     `json:\"status\"`\n\tSentAt      *time.Time `json:\"sent_at\"`\n\tRequestedAt *time.Time `json:\"requested_at\"`\n}\n\n// consentTrailDTO is the audit half of the sheet: the §4 columns, spelled out.\ntype consentTrailDTO struct {\n\tSMSConsent   bool       `json:\"sms_consent\"`\n\tEmailConsent bool       `json:\"email_consent\"`\n\tEvidence     *string    `json:\"consent_evidence\"`\n\tOptedOutAt   *time.Time `json:\"opted_out_at\"`\n\tState        string     `json:\"state\"`\n}\n\n// subscriberDetailDTO is §5's `detail + events[] + offers_now[]`.\ntype subscriberDetailDTO struct {\n\tsubscriberRowDTO\n\tIdentityCode identityCodeDTO  `json:\"identity_code\"`\n\tConsent      consentTrailDTO  `json:\"consent_trail\"`\n\tEvents       []eventDTO       `json:\"events\"`\n\tOffersNow    []offerDTO       `json:\"offers_now\"`\n}\n\n// importResultDTO is what an import route answers with. It carries COUNTS and\n// no contact values — an import summary is a response body like any other and\n// the masking contract applies to it too.\ntype importResultDTO struct {\n\tSource     string `json:\"source\"`\n\tRead       int    `json:\"read\"`\n\tCreated    int    `json:\"created\"`\n\tUpdated    int    `json:\"updated\"`\n\tUnchanged  int    `json:\"unchanged\"`\n\tSkipped    int    `json:\"skipped\"`\n\tScansBound int    `json:\"scans_bound\"`\n}\n\n// ── GET /subscribers ──\n\n// The §5 filter set. `all` is the default for anything unrecognized: the\n// designed chip row is fixed, so an unexpected value is a client bug and a read\n// that returns the list beats a read that returns a 400.\n//\n// Semantics (this card's call — the slate: \"the filter set … is the night's\"):\n//\n//\tall        every subscriber\n//\tsms        sms_consent AND NOT opted out — who an SMS blast may reach\n//\temail_only email_consent AND NOT sms_consent AND NOT opted out — reachable,\n//\t           but not by text; the chip exists so a manager can see the people\n//\t           an SMS campaign will silently miss\n//\topted_out  opted_out_at IS NOT NULL — the suppression list, which must be\n//\t           visible precisely because it must never be messaged\nconst (\n\tFilterAll       = \"all\"\n\tFilterSMS       = \"sms\"\n\tFilterEmailOnly = \"email_only\"\n\tFilterOptedOut  = \"opted_out\"\n)\n\n// ListSubscribersHandler is §5's GET /subscribers?q=&filter=&source=.\nfunc ListSubscribersHandler(d Deps) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tif requireManager(w, r) == nil {\n\t\t\treturn\n\t\t}\n\t\tq := strings.TrimSpace(r.URL.Query().Get(\"q\"))\n\t\tfilter := r.URL.Query().Get(\"filter\")\n\t\tsource := r.URL.Query().Get(\"source\")\n\n\t\twhere := []string{\"TRUE\"}\n\t\targs := []any{}\n\t\t// Placeholders are numbered explicitly rather than rewritten into a\n\t\t// template. A $N-substituting helper reads tidier and is wrong: once the\n\t\t// first clause has shifted $1 to $2 the clause contains two \"$2\"s and the\n\t\t// next substitution picks whichever comes first in the string.\n\t\tph := func(v any) string {\n\t\t\targs = append(args, v)\n\t\t\treturn fmt.Sprintf(\"$%d\", len(args))\n\t\t}\n\t\tswitch filter {\n\t\tcase FilterSMS:\n\t\t\twhere = append(where, \"(s.sms_consent AND s.opted_out_at IS NULL)\")\n\t\tcase FilterEmailOnly:\n\t\t\twhere = append(where, \"(s.email_consent AND NOT s.sms_consent AND s.opted_out_at IS NULL)\")\n\t\tcase FilterOptedOut:\n\t\t\twhere = append(where, \"(s.opted_out_at IS NOT NULL)\")\n\t\t}\n\t\tif containsString(subscriberSources, source) {\n\t\t\twhere = append(where, \"s.source = \"+ph(source))\n\t\t}\n\t\tif q != \"\" {\n\t\t\t// q matches the display name, the email, the campaign name, the\n\t\t\t// short, or the phone BY SUFFIX. The suffix match is what makes the\n\t\t\t// masked cell searchable: a manager reads \"•••• 4821\" off the screen\n\t\t\t// and types 4821. The full number is never rendered, but it is still\n\t\t\t// the server's to search.\n\t\t\tlike := ph(\"%\" + q + \"%\")\n\t\t\tclause := \"(s.display_name ILIKE \" + like +\n\t\t\t\t\" OR s.email ILIKE \" + like +\n\t\t\t\t\" OR c.name ILIKE \" + like +\n\t\t\t\t\" OR s.source_short ILIKE \" + like\n\t\t\tif digits := onlyDigits(q); digits != \"\" {\n\t\t\t\tclause += \" OR s.phone_e164 LIKE \" + ph(\"%\"+digits)\n\t\t\t}\n\t\t\twhere = append(where, clause+\")\")\n\t\t}\n\n\t\tsql := `\n\t\t\tSELECT s.id::text, s.display_name, s.phone_e164, s.email, s.source,\n\t\t\t       s.source_short, c.name, s.joined_at, s.sms_consent,\n\t\t\t       s.email_consent, s.opted_out_at,\n\t\t\t       (SELECT count(*) FROM subscriber_events e\n\t\t\t          WHERE e.subscriber_id = s.id AND e.kind IN ('scanned','redeemed'))\n\t\t\t  FROM subscribers s\n\t\t\t  LEFT JOIN qr_codes k ON k.short = s.source_short\n\t\t\t  LEFT JOIN campaigns_admin c ON c.id = k.campaign_id\n\t\t\t WHERE ` + strings.Join(where, \" AND \") + `\n\t\t\t ORDER BY s.joined_at DESC, s.id\n\t\t\t LIMIT 500`\n\t\trows, err := d.Pool.Query(r.Context(), sql, args...)\n\t\tif err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"list_failed\")\n\t\t\treturn\n\t\t}\n\t\tdefer rows.Close()\n\t\tout := subscriberListResponse{Rows: []subscriberRowDTO{}}\n\t\tfor rows.Next() {\n\t\t\tvar (\n\t\t\t\tid, source                         string\n\t\t\t\tname, phone, email, short, camName *string\n\t\t\t\tjoined                             time.Time\n\t\t\t\tsms, emailOK                       bool\n\t\t\t\toptedOut                           *time.Time\n\t\t\t\tvisits                             int\n\t\t\t)\n\t\t\tif err := rows.Scan(&id, &name, &phone, &email, &source, &short, &camName,\n\t\t\t\t&joined, &sms, &emailOK, &optedOut, &visits); err != nil {\n\t\t\t\twriteError(w, http.StatusInternalServerError, \"list_failed\")\n\t\t\t\treturn\n\t\t\t}\n\t\t\tout.Rows = append(out.Rows, subscriberRowDTO{\n\t\t\t\tID: id, DisplayName: name,\n\t\t\t\t// 🛑 maskPtr is where the privacy contract is kept. `phone` and\n\t\t\t\t// `email` are local variables that END HERE.\n\t\t\t\tPhoneLast4:  maskPtr(sources.Last4(deref(phone))),\n\t\t\t\tEmailMasked: maskPtr(sources.MaskEmail(deref(email))),\n\t\t\t\tSource:      source, SourceShort: short, CampaignName: camName,\n\t\t\t\tJoinedAt: joined, Visits: visits,\n\t\t\t\tConsent: consentState(sms, emailOK, optedOut),\n\t\t\t})\n\t\t}\n\t\tif rows.Err() != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"list_failed\")\n\t\t\treturn\n\t\t}\n\t\tif err := d.Pool.QueryRow(r.Context(), `\n\t\t\tSELECT count(*),\n\t\t\t       count(*) FILTER (WHERE sms_consent AND opted_out_at IS NULL),\n\t\t\t       count(*) FILTER (WHERE joined_at >= now() - interval '7 days')\n\t\t\t  FROM subscribers`).Scan(&out.Total, &out.SMSOptIn, &out.JoinedThisWeek); err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"list_failed\")\n\t\t\treturn\n\t\t}\n\t\twriteJSON(w, http.StatusOK, out)\n\t}\n}\n\n// ── GET /subscribers/{id} ──\n\n// GetSubscriberHandler is §5's detail route: the masked identity, the\n// identity-code status, the consent trail, the timeline and the live offers.\nfunc GetSubscriberHandler(d Deps) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tif requireManager(w, r) == nil {\n\t\t\treturn\n\t\t}\n\t\tid := chi.URLParam(r, \"id\")\n\t\tvar (\n\t\t\tname, phone, email, short, camName, evidence *string\n\t\t\tsource                                       string\n\t\t\tjoined                                       time.Time\n\t\t\tsms, emailOK                                 bool\n\t\t\toptedOut                                     *time.Time\n\t\t\tvisits                                       int\n\t\t)\n\t\terr := d.Pool.QueryRow(r.Context(), `\n\t\t\tSELECT s.display_name, s.phone_e164, s.email, s.source, s.source_short,\n\t\t\t       c.name, s.consent_evidence, s.joined_at, s.sms_consent,\n\t\t\t       s.email_consent, s.opted_out_at,\n\t\t\t       (SELECT count(*) FROM subscriber_events e\n\t\t\t          WHERE e.subscriber_id = s.id AND e.kind IN ('scanned','redeemed'))\n\t\t\t  FROM subscribers s\n\t\t\t  LEFT JOIN qr_codes k ON k.short = s.source_short\n\t\t\t  LEFT JOIN campaigns_admin c ON c.id = k.campaign_id\n\t\t\t WHERE s.id = $1`, id).\n\t\t\tScan(&name, &phone, &email, &source, &short, &camName, &evidence,\n\t\t\t\t&joined, &sms, &emailOK, &optedOut, &visits)\n\t\tif errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {\n\t\t\twriteError(w, http.StatusNotFound, \"not_found\")\n\t\t\treturn\n\t\t}\n\t\tif err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"detail_failed\")\n\t\t\treturn\n\t\t}\n\n\t\tevents, ic, err := subscriberTimeline(r.Context(), d, id)\n\t\tif err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"detail_failed\")\n\t\t\treturn\n\t\t}\n\t\toffers, err := offersNow(r.Context(), d)\n\t\tif err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"detail_failed\")\n\t\t\treturn\n\t\t}\n\t\twriteJSON(w, http.StatusOK, subscriberDetailDTO{\n\t\t\tsubscriberRowDTO: subscriberRowDTO{\n\t\t\t\tID: id, DisplayName: name,\n\t\t\t\tPhoneLast4:  maskPtr(sources.Last4(deref(phone))),\n\t\t\t\tEmailMasked: maskPtr(sources.MaskEmail(deref(email))),\n\t\t\t\tSource:      source, SourceShort: short, CampaignName: camName,\n\t\t\t\tJoinedAt: joined, Visits: visits,\n\t\t\t\tConsent: consentState(sms, emailOK, optedOut),\n\t\t\t},\n\t\t\tIdentityCode: ic,\n\t\t\tConsent: consentTrailDTO{\n\t\t\t\tSMSConsent: sms, EmailConsent: emailOK, Evidence: evidence,\n\t\t\t\tOptedOutAt: optedOut, State: consentState(sms, emailOK, optedOut),\n\t\t\t},\n\t\t\tEvents:    events,\n\t\t\tOffersNow: offers,\n\t\t})\n\t}\n}\n\n// subscriberTimeline reads the events newest-first and derives the\n// identity-code status from them in one pass.\nfunc subscriberTimeline(ctx context.Context, d Deps, id string) ([]eventDTO, identityCodeDTO, error) {\n\trows, err := d.Pool.Query(ctx, `\n\t\tSELECT id, kind, at, ref FROM subscriber_events\n\t\t WHERE subscriber_id = $1 ORDER BY at DESC, id DESC LIMIT 200`, id)\n\tif err != nil {\n\t\treturn nil, identityCodeDTO{}, err\n\t}\n\tdefer rows.Close()\n\tout := []eventDTO{}\n\tic := identityCodeDTO{Status: \"not_sent\"}\n\tfor rows.Next() {\n\t\tvar e eventDTO\n\t\tif err := rows.Scan(&e.ID, &e.Kind, &e.At, &e.Ref); err != nil {\n\t\t\treturn nil, identityCodeDTO{}, err\n\t\t}\n\t\t// Rows arrive newest-first, so the FIRST of each kind is the latest.\n\t\tswitch e.Kind {\n\t\tcase \"code_sent\":\n\t\t\tif ic.SentAt == nil {\n\t\t\t\tat := e.At\n\t\t\t\tic.SentAt = &at\n\t\t\t\tic.Status = \"sent\"\n\t\t\t}\n\t\tcase \"resend_requested\":\n\t\t\tif ic.RequestedAt == nil {\n\t\t\t\tat := e.At\n\t\t\t\tic.RequestedAt = &at\n\t\t\t}\n\t\t}\n\t\tout = append(out, e)\n\t}\n\treturn out, ic, rows.Err()\n}\n\n// offersNow is every campaign a walk-in could redeem right now. It is not\n// per-subscriber because nothing in §4 scopes an offer to a person — the sheet\n// answers \"what can I honor if they show up\", which is a property of the\n// campaign set and of the clock.\nfunc offersNow(ctx context.Context, d Deps) ([]offerDTO, error) {\n\trows, err := d.Pool.Query(ctx, `\n\t\tSELECT id::text, name, offer_text, face_value_cents, ends_at\n\t\t  FROM campaigns_admin\n\t\t WHERE status = 'live' AND starts_at <= now() AND ends_at >= now()\n\t\t ORDER BY ends_at ASC LIMIT 20`)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer rows.Close()\n\tout := []offerDTO{}\n\tfor rows.Next() {\n\t\tvar o offerDTO\n\t\tif err := rows.Scan(&o.CampaignID, &o.Name, &o.OfferText, &o.FaceValueCents, &o.EndsAt); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tout = append(out, o)\n\t}\n\treturn out, rows.Err()\n}\n\n// ── POST /subscribers/{id}/resend ──\n\n// ResendQRHandler is §5's one write: 202, an appended `resend_requested`\n// event, and NO SEND.\n//\n// 🛑 Read the whole function. There is no branch, no flag and no env var that\n// makes it send anything; the only side effect is the INSERT below. The event\n// kind is `resend_requested` and NOT `code_sent` precisely so the Stats funnel\n// (which counts `code_sent`) cannot be inflated by a request nobody fulfilled.\n// Activity E will append `code_sent` when a message actually leaves.\nfunc ResendQRHandler(d Deps) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tuser := requireManager(w, r)\n\t\tif user == nil {\n\t\t\treturn\n\t\t}\n\t\tid := chi.URLParam(r, \"id\")\n\t\tvar exists bool\n\t\terr := d.Pool.QueryRow(r.Context(),\n\t\t\t`SELECT true FROM subscribers WHERE id = $1`, id).Scan(&exists)\n\t\tif errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {\n\t\t\twriteError(w, http.StatusNotFound, \"not_found\")\n\t\t\treturn\n\t\t}\n\t\tif err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"resend_failed\")\n\t\t\treturn\n\t\t}\n\t\tif _, err := d.Pool.Exec(r.Context(), `\n\t\t\tINSERT INTO subscriber_events (subscriber_id, kind, ref)\n\t\t\tVALUES ($1, 'resend_requested', jsonb_build_object('requested_by', $2::text, 'sent', false))`,\n\t\t\tid, user.ID); err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"resend_failed\")\n\t\t\treturn\n\t\t}\n\t\t// 202 Accepted, and the body says so in words: the request is\n\t\t// recorded, the send is Activity E's. A 200 here would read as \"done\".\n\t\twriteJSON(w, http.StatusAccepted, map[string]any{\n\t\t\t\"status\": \"recorded\",\n\t\t\t\"sent\":   false,\n\t\t\t\"note\":   \"resend_requested recorded; sending is not implemented yet\",\n\t\t})\n\t}\n}\n\n// ── the import entry points ──\n\n// ImportToastGuestsHandler takes a Toast guest CSV on the request body\n// (text/csv or multipart `file`) and lands it through the one upsert.\nfunc ImportToastGuestsHandler(d Deps) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tif requireManager(w, r) == nil {\n\t\t\treturn\n\t\t}\n\t\tbody, err := csvBody(r)\n\t\tif err != nil {\n\t\t\twriteError(w, http.StatusBadRequest, \"bad_upload\")\n\t\t\treturn\n\t\t}\n\t\timp, err := sources.NewToastGuests(strings.NewReader(body), maxCSVRows)\n\t\tif err != nil {\n\t\t\tif errors.Is(err, sources.ErrNoGuestColumns) {\n\t\t\t\twriteError(w, http.StatusBadRequest, \"no_guest_columns\")\n\t\t\t\treturn\n\t\t\t}\n\t\t\twriteError(w, http.StatusBadRequest, \"bad_csv\")\n\t\t\treturn\n\t\t}\n\t\trunImport(w, r, d, imp)\n\t}\n}\n\n// ImportWebFormHandler runs the Fluent Forms reader.\n//\n// 🛑 ATTENDED ONLY. With FF_DB_* unset — which is their state in every gate,\n// every worktree and prod — this answers 503 {\"error\":\"ff_not_configured\"} and\n// opens no connection. The first live import is an operator act, by design\n// (see internal/marketing/sources/testdata/README.md).\nfunc ImportWebFormHandler(d Deps) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tif requireManager(w, r) == nil {\n\t\t\treturn\n\t\t}\n\t\tvar imp *sources.FluentForms\n\t\tvar err error\n\t\tif p := strings.TrimSpace(os.Getenv(SubsFixtureEnv)); p != \"\" {\n\t\t\tvar raw []byte\n\t\t\tif raw, err = os.ReadFile(p); err == nil {\n\t\t\t\timp, err = sources.NewFluentFormsFromJSON(raw)\n\t\t\t}\n\t\t\tif err != nil {\n\t\t\t\twriteError(w, http.StatusInternalServerError, \"ff_fixture_unreadable\")\n\t\t\t\treturn\n\t\t\t}\n\t\t} else {\n\t\t\timp, err = sources.NewFluentForms()\n\t\t\tif errors.Is(err, sources.ErrFluentFormsNotConfigured) {\n\t\t\t\twriteError(w, http.StatusServiceUnavailable, \"ff_not_configured\")\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif err != nil {\n\t\t\t\twriteError(w, http.StatusInternalServerError, \"ff_open_failed\")\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\trunImport(w, r, d, imp)\n\t}\n}\n\nfunc runImport(w http.ResponseWriter, r *http.Request, d Deps, imp sources.Importer) {\n\tres, err := ImportSubscribers(r.Context(), d.Pool, imp)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"import_failed\")\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, res)\n}\n\n// csvBody reads either a raw body or a multipart `file` part.\nfunc csvBody(r *http.Request) (string, error) {\n\tct := r.Header.Get(\"Content-Type\")\n\tif strings.HasPrefix(ct, \"multipart/form-data\") {\n\t\tif err := r.ParseMultipartForm(maxCSVBytes); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tf, _, err := r.FormFile(\"file\")\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tdefer f.Close()\n\t\tb, err := io.ReadAll(io.LimitReader(f, maxCSVBytes))\n\t\treturn string(b), err\n\t}\n\tb, err := io.ReadAll(io.LimitReader(r.Body, maxCSVBytes))\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif strings.TrimSpace(string(b)) == \"\" {\n\t\treturn \"\", fmt.Errorf(\"empty body\")\n\t}\n\treturn string(b), nil\n}\n\n// ── the ONE upsert every adapter lands through ──\n\n// ImportSubscribers reads an Importer and lands its candidates.\n//\n// # Idempotency, in the order it is attempted\n//\n//  1. `(source, external_ref)` — §4's unique key, and the only handle a source\n//     with stable ids needs. Re-running the same import updates in place.\n//  2. `phone_e164` — §4's other unique, and the key spike 02 proved closed.\n//     This is what collapses \"17735554821\" onto the row \"(773) 555-4821\"\n//     already created, across sources: a Toast guest who later fills in the web\n//     form is ONE person, not two rows the operator has to reconcile by eye.\n//  3. otherwise INSERT.\n//\n// An UPDATE is a MERGE with a FIELD-BY-FIELD policy, not a blanket\n// fill-the-NULLs — see mergeSubscriber for the rule each column gets and why.\n// In short: display_name and email converge on the LATEST value (they are\n// corrections), identity and first-touch keep the FIRST, consent is MONOTONIC,\n// and an opt-out is sticky. The result distinguishes `updated` from\n// `unchanged`, so a re-import never claims a write it did not make.\n//\n// `signed_up` is appended on INSERT only. An idempotent re-run that appended an\n// event every time would make the timeline a log of imports instead of a\n// history of the person.\nfunc ImportSubscribers(ctx context.Context, pool interface {\n\tBegin(context.Context) (pgx.Tx, error)\n}, imp sources.Importer) (importResultDTO, error) {\n\tcands, err := imp.Read()\n\tif err != nil {\n\t\treturn importResultDTO{}, err\n\t}\n\tres := importResultDTO{Source: imp.Source(), Read: len(cands)}\n\ttx, err := pool.Begin(ctx)\n\tif err != nil {\n\t\treturn res, err\n\t}\n\tdefer func() { _ = tx.Rollback(ctx) }()\n\n\tfor _, c := range cands {\n\t\tif c.PhoneE164 == \"\" && c.Email == \"\" {\n\t\t\tres.Skipped++\n\t\t\tcontinue\n\t\t}\n\t\t// An unknown short would violate the FK onto qr_codes(short) and cost\n\t\t// the whole import. A printed code that no longer exists is the\n\t\t// customer's reality, not an error: keep the person, drop the\n\t\t// attribution, and say so in the evidence line.\n\t\tshort := c.SourceShort\n\t\tif short != \"\" {\n\t\t\tvar ok bool\n\t\t\tif err := tx.QueryRow(ctx, `SELECT true FROM qr_codes WHERE short = $1`, short).Scan(&ok); err != nil {\n\t\t\t\tif !errors.Is(err, pgx.ErrNoRows) {\n\t\t\t\t\treturn res, err\n\t\t\t\t}\n\t\t\t\tshort = \"\"\n\t\t\t}\n\t\t}\n\n\t\tid, found, err := findSubscriber(ctx, tx, c)\n\t\tif err != nil {\n\t\t\treturn res, err\n\t\t}\n\t\tif found {\n\t\t\tchanged, err := mergeSubscriber(ctx, tx, id, c, short)\n\t\t\tif err != nil {\n\t\t\t\treturn res, err\n\t\t\t}\n\t\t\tif changed {\n\t\t\t\tres.Updated++\n\t\t\t} else {\n\t\t\t\tres.Unchanged++\n\t\t\t}\n\t\t} else {\n\t\t\tid, err = insertSubscriber(ctx, tx, c, short)\n\t\t\tif err != nil {\n\t\t\t\treturn res, err\n\t\t\t}\n\t\t\tres.Created++\n\t\t}\n\t\tif short != \"\" {\n\t\t\tn, err := sources.BackfillScanSubscriber(ctx, tx, short, id, c.JoinedAt)\n\t\t\tif err != nil {\n\t\t\t\treturn res, err\n\t\t\t}\n\t\t\tres.ScansBound += n\n\t\t}\n\t}\n\tif err := tx.Commit(ctx); err != nil {\n\t\treturn res, err\n\t}\n\treturn res, nil\n}\n\nfunc findSubscriber(ctx context.Context, tx pgx.Tx, c sources.Candidate) (string, bool, error) {\n\tif c.ExternalRef != \"\" {\n\t\tvar id string\n\t\terr := tx.QueryRow(ctx,\n\t\t\t`SELECT id::text FROM subscribers WHERE source = $1 AND external_ref = $2`,\n\t\t\tc.Source, c.ExternalRef).Scan(&id)\n\t\tif err == nil {\n\t\t\treturn id, true, nil\n\t\t}\n\t\tif !errors.Is(err, pgx.ErrNoRows) {\n\t\t\treturn \"\", false, err\n\t\t}\n\t}\n\tif c.PhoneE164 != \"\" {\n\t\tvar id string\n\t\terr := tx.QueryRow(ctx,\n\t\t\t`SELECT id::text FROM subscribers WHERE phone_e164 = $1`, c.PhoneE164).Scan(&id)\n\t\tif err == nil {\n\t\t\treturn id, true, nil\n\t\t}\n\t\tif !errors.Is(err, pgx.ErrNoRows) {\n\t\t\treturn \"\", false, err\n\t\t}\n\t}\n\treturn \"\", false, nil\n}\n\nfunc insertSubscriber(ctx context.Context, tx pgx.Tx, c sources.Candidate, short string) (string, error) {\n\tvar id string\n\terr := tx.QueryRow(ctx, `\n\t\tINSERT INTO subscribers (display_name, phone_e164, email, source, source_short,\n\t\t                         sms_consent, email_consent, consent_evidence,\n\t\t                         opted_out_at, joined_at, external_ref)\n\t\tVALUES (NULLIF($1,''), NULLIF($2,''), NULLIF($3,''), $4, NULLIF($5,''),\n\t\t        $6, $7, NULLIF($8,''),\n\t\t        CASE WHEN $9 THEN now() ELSE NULL END, $10, NULLIF($11,''))\n\t\tRETURNING id::text`,\n\t\tc.DisplayName, c.PhoneE164, c.Email, c.Source, short,\n\t\tc.SMSConsent, c.EmailConsent, c.ConsentEvidence, c.OptedOut,\n\t\tc.JoinedAt, c.ExternalRef).Scan(&id)\n\tif err != nil {\n\t\t// A concurrent import, or a phone that findSubscriber could not see\n\t\t// because the candidate carried only an email on the first pass. Fall\n\t\t// back to the merge rather than failing the whole file.\n\t\tvar pgErr *pgconn.PgError\n\t\tif errors.As(err, &pgErr) && pgErr.Code == \"23505\" && c.PhoneE164 != \"\" {\n\t\t\tif e2 := tx.QueryRow(ctx,\n\t\t\t\t`SELECT id::text FROM subscribers WHERE phone_e164 = $1`, c.PhoneE164).Scan(&id); e2 == nil {\n\t\t\t\t_, mErr := mergeSubscriber(ctx, tx, id, c, short)\n\t\t\t\treturn id, mErr\n\t\t\t}\n\t\t}\n\t\treturn \"\", fmt.Errorf(\"insert subscriber: %w\", err)\n\t}\n\tif _, err := tx.Exec(ctx, `\n\t\tINSERT INTO subscriber_events (subscriber_id, kind, at, ref)\n\t\tVALUES ($1, 'signed_up', $2, jsonb_build_object('source', $3::text))`,\n\t\tid, c.JoinedAt, c.Source); err != nil {\n\t\treturn \"\", fmt.Errorf(\"insert signed_up: %w\", err)\n\t}\n\tif c.OptedOut {\n\t\tif _, err := tx.Exec(ctx, `\n\t\t\tINSERT INTO subscriber_events (subscriber_id, kind, ref)\n\t\t\tVALUES ($1, 'opted_out', jsonb_build_object('source', $2::text))`,\n\t\t\tid, c.Source); err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"insert opted_out: %w\", err)\n\t\t}\n\t}\n\treturn id, nil\n}\n\n// mergeSubscriber applies this card's FIELD-BY-FIELD merge policy and reports\n// whether anything actually changed.\n//\n// ═══════════════════════════════════════════════════════════════════════════\n// THE POLICY, AND WHY EACH FIELD GETS THE RULE IT GETS (G6 finding F4)\n//\n// \"COALESCE(existing, new) everywhere\" was wrong in one direction and\n// right in the other, so the fields are now split explicitly:\n//\n//\tdisplay_name  LATEST WINS. A name corrected upstream (\"Dana\" → \"Dana\n//\temail         Reyes\") is a CORRECTION, and silently discarding it while\n//\t              reporting `updated: 1` is the worst of both. These are the\n//\t              two fields a human actually fixes at the source.\n//\n//\tphone_e164    FIRST WINS. This is the dedupe IDENTITY — the key\n//\t              findSubscriber matched on. Reassigning it under a row would\n//\t              silently re-point who that record is.\n//\n//\tsource_short  FIRST WINS. Decision 189 is FIRST-TOUCH: a subscriber's\n//\t              campaign is the first code they scanned, so a later import\n//\t              carrying a different short must not overwrite it.\n//\n//\tsms_consent   MONOTONIC (OR). Consent is granted, never revoked by an\n//\temail_consent import: an import that omits a box is silent about it, not a\n//\t              withdrawal. Withdrawal is opted_out_at, which WINS over both\n//\t              when the list derives its consent state.\n//\n//\tconsent_evidence  FIRST WINS. The trail records the consent originally\n//\t              given; successive actions live in subscriber_events.\n//\n//\topted_out_at  STICKY, EARLIEST. Once set it is never cleared by an import.\n//\t              An opt-out is the one thing that must survive every source.\n//\n//\tjoined_at     EARLIEST (LEAST). They joined when they first joined.\n//\texternal_ref  FIRST WINS. It is an idempotency handle, not data.\n//\n// The asymmetry between display_name (latest wins) and consent (monotonic) is\n// deliberate: a name is a fact an upstream system can correct, and consent is a\n// permission that only the person can widen and only an opt-out can close.\n//\n// ═══════════════════════════════════════════════════════════════════════════\n// AND THE COUNT IS HONEST\n//\n// The UPDATE carries an IS DISTINCT FROM guard over exactly the tuple it would\n// write, so RowsAffected is 1 only when a field genuinely moves. An unchanged\n// re-import now reports `unchanged`, not `updated`. A count that claims an\n// update that did not happen is a count nobody can reconcile against.\nfunc mergeSubscriber(ctx context.Context, tx pgx.Tx, id string, c sources.Candidate, short string) (bool, error) {\n\ttag, err := tx.Exec(ctx, `\n\t\tUPDATE subscribers SET\n\t\t  display_name     = COALESCE(NULLIF($2,''), display_name),\n\t\t  email            = COALESCE(NULLIF($4,''), email),\n\t\t  phone_e164       = COALESCE(phone_e164,   NULLIF($3,'')),\n\t\t  source_short     = COALESCE(source_short, NULLIF($5,'')),\n\t\t  sms_consent      = sms_consent   OR $6,\n\t\t  email_consent    = email_consent OR $7,\n\t\t  consent_evidence = COALESCE(consent_evidence, NULLIF($8,'')),\n\t\t  opted_out_at     = CASE WHEN $9 THEN COALESCE(opted_out_at, now()) ELSE opted_out_at END,\n\t\t  joined_at        = LEAST(joined_at, $10),\n\t\t  external_ref     = COALESCE(external_ref, NULLIF($11,''))\n\t\tWHERE id = $1\n\t\t  AND (display_name, email, phone_e164, source_short, sms_consent,\n\t\t       email_consent, consent_evidence, opted_out_at, joined_at, external_ref)\n\t\t      IS DISTINCT FROM\n\t\t      (COALESCE(NULLIF($2,''), display_name),\n\t\t       COALESCE(NULLIF($4,''), email),\n\t\t       COALESCE(phone_e164,   NULLIF($3,'')),\n\t\t       COALESCE(source_short, NULLIF($5,'')),\n\t\t       sms_consent   OR $6,\n\t\t       email_consent OR $7,\n\t\t       COALESCE(consent_evidence, NULLIF($8,'')),\n\t\t       CASE WHEN $9 THEN COALESCE(opted_out_at, now()) ELSE opted_out_at END,\n\t\t       LEAST(joined_at, $10),\n\t\t       COALESCE(external_ref, NULLIF($11,'')))`,\n\t\tid, c.DisplayName, c.PhoneE164, c.Email, short,\n\t\tc.SMSConsent, c.EmailConsent, c.ConsentEvidence, c.OptedOut,\n\t\tc.JoinedAt, c.ExternalRef)\n\tif err != nil {\n\t\treturn false, fmt.Errorf(\"merge subscriber: %w\", err)\n\t}\n\treturn tag.RowsAffected() > 0, nil\n}\n\n// ── small helpers ──\n\n// subscriberSources is §4's enum, used to validate the `source=` filter.\nvar subscriberSources = []string{\n\tsources.SourceWebForm, sources.SourceToastImport,\n\tsources.SourceSMSKeyword, sources.SourceQR,\n}\n\n// consentState derives §5's four-value consent field from the §4 columns.\n// opted_out_at WINS over both flags: a person who said STOP is \"stop\" even if\n// a stale checkbox is still true, and that precedence is the whole point of\n// surfacing the state at all.\nfunc consentState(sms, email bool, optedOut *time.Time) string {\n\tswitch {\n\tcase optedOut != nil:\n\t\treturn ConsentStop\n\tcase sms:\n\t\treturn ConsentSMS\n\tcase email:\n\t\treturn ConsentEmailOnly\n\tdefault:\n\t\treturn ConsentPending\n\t}\n}\n\nfunc deref(s *string) string {\n\tif s == nil {\n\t\treturn \"\"\n\t}\n\treturn *s\n}\n\n// maskPtr turns \"\" into a JSON null, so the UI can tell \"no phone on file\"\n// from \"a phone whose mask is empty\" — there is no second case, and null is\n// the honest wire value for the first.\nfunc maskPtr(s string) *string {\n\tif s == \"\" {\n\t\treturn nil\n\t}\n\treturn &s\n}\n\nfunc onlyDigits(s string) string {\n\tvar b strings.Builder\n\tfor _, r := range s {\n\t\tif r >= '0' && r <= '9' {\n\t\t\tb.WriteRune(r)\n\t\t}\n\t}\n\treturn b.String()\n}\n","numLines":823,"startLine":44,"totalLines":866}}}
