{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfjytBJqYUp97EmsHvFpL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014tuSHuuXFypr7b78fAVyHT","name":"Write","input":{"file_path":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/tests/marketing-identity.spec.js","content":"// ═══════════════════════════════════════════════════════════════════════════\n// Marketing · identity codes — card E1 `identity-code-and-qr` (run 20261006)\n// roadmap Activity E; goal ledger\n// .night-crew/knowledge/spikes/activity-e-customer-delivery-one-identity-code-qr-image/identity-code-and-qr.md\n// ═══════════════════════════════════════════════════════════════════════════\n//\n// What these three tests are about, in the truck's terms: a customer who signed\n// up holds ONE code on their phone. The crew member photographs it.\n//\n//   [IC-01] With no signal, and before that customer has ever synced to this\n//           tablet, the scanner still shows the offer they signed up for.\n//   [IC-02] With signal, the scanner shows the server's answer for that code.\n//   [IC-03] NEGATIVE control: the same code drawn more densely (Medium error\n//           correction, QR version 11) is NOT read off the photo by the shipped\n//           scanner — which is why the server draws it at Low. A change that\n//           \"upgrades\" the correction level turns [IC-01] into this.\n//\n// 🛑 THE PNG IS THE SERVER'S. Subscribers are imported through the real\n// POST /subscribers/import/web-form (the committed Fluent Forms fixture, via\n// HQ_FF_FIXTURE_PATH on the e2e server — never the live website database), the\n// code is minted by that import, and the image is fetched from the real public\n// GET /m/{id}.png. The raw token is stored nowhere, so the test learns it the\n// only way anyone can: by DECODING THE PNG.\n//\n// 🟡 THE ONE STUB is in [IC-02]: the server lookup is answered by page.route on\n// the sync door's path (the e2e stack has no substrate). It returns the row the\n// projection would have written. The projection itself is gated in Go\n// (TestProjectIdentityCodeUpserts).\n//\n// RED-FIRST: written and run against the pre-change tree — no /m/ route, no\n// mint, `identity_code.status` still \"not_sent\". Evidence:\n// .night-crew/runs/2026-10-06-autonomous/logs/identity-code-and-qr/.\n\nconst { test, expect } = require('@playwright/test');\nconst { execFileSync } = require('child_process');\nconst crypto = require('crypto');\nconst fs = require('fs');\nconst path = require('path');\nconst { resolveE2eDb } = require('../scripts/reset-e2e-db');\n\nconst ADMIN_EMAIL = 'jamal@yumyums.kitchen';\nconst ADMIN_PASSWORD = 'test123';\nconst MINT_SUB = 'e2e-identity-mint-sub';\n\n// The committed fixture's row 1182 is the one signup carrying a first-touch\n// code (`source: \"K7MNPQ\"`); the other three have none.\nconst FIRST_TOUCH_SHORT = 'K7MNPQ';\nconst OFFER_TEXT = 'Free side of wings';\nconst TOKEN_RE = /^[23456789abcdefghjkmnpqrstuvwxyz]{16}$/;\n\nconst sha256Hex = (s) => crypto.createHash('sha256').update(s).digest('hex');\n\n// The arbiter row's id, derived the way internal/marketing/identity.go derives\n// it: uuid v5 (RFC 4122 URL namespace) over a URL naming the subscriber.\nfunction identityCodeId(subscriberId) {\n  const ns = Buffer.from('6ba7b8119dad11d180b400c04fd430c8', 'hex');\n  const name = 'https://hq.yumyums.kitchen/identity-code/' + subscriberId.toLowerCase();\n  const h = crypto.createHash('sha1').update(ns).update(name).digest().subarray(0, 16);\n  h[6] = (h[6] & 0x0f) | 0x50;\n  h[8] = (h[8] & 0x3f) | 0x80;\n  const x = h.toString('hex');\n  return `${x.slice(0, 8)}-${x.slice(8, 12)}-${x.slice(12, 16)}-${x.slice(16, 20)}-${x.slice(20)}`;\n}\n\n// `psqlUrl`, not `testUrl` — libpq does not understand TimeZone (the note\n// tests/marketing-stats.spec.js carries).\nfunction psql(sqlText) {\n  const db = resolveE2eDb();\n  return execFileSync('psql', [db.psqlUrl, '-At', '-v', 'ON_ERROR_STOP=1', '-c', sqlText],\n    { encoding: 'utf8' }).trim();\n}\n\n// This file owns subscribers, campaigns and codes while it runs. Deleting a\n// subscriber deletes their timeline and their identity image with them.\nfunction resetIdentityFixture() {\n  psql(`DELETE FROM subscribers;\n        DELETE FROM reconciliation_decisions;\n        DELETE FROM scan_attempts_mirror;\n        DELETE FROM qr_scans;\n        DELETE FROM qr_codes;\n        DELETE FROM campaigns_admin;`);\n}\n\nasync function loginAs(page, email, password) {\n  await page.goto('/login.html');\n  await page.fill('input[type=\"email\"]', email);\n  await page.fill('input[type=\"password\"]', password);\n  await page.click('button.btn');\n  await page.waitForURL((url) => !url.pathname.includes('login'));\n}\n\nasync function api(page, method, url, body) {\n  return page.evaluate(async ([m, u, b]) => {\n    const r = await fetch(u, {\n      method: m,\n      headers: b ? { 'Content-Type': 'application/json' } : {},\n      body: b ? JSON.stringify(b) : undefined,\n    });\n    const text = await r.text();\n    let json = null;\n    try { json = JSON.parse(text); } catch (e) { /* not JSON */ }\n    return { status: r.status, text, json };\n  }, [method, url, body || null]);\n}\n\n// mintFixtureCode: a live campaign whose code is the fixture's first-touch\n// short, then the real import. Returns what the SERVER reports — and the PNG,\n// fetched with NO session, written to a per-test file.\nasync function mintFixtureCode(page, testInfo) {\n  resetIdentityFixture();\n  await loginAs(page, ADMIN_EMAIL, ADMIN_PASSWORD);\n\n  const created = await api(page, 'POST', '/api/v1/marketing/campaigns', {\n    name: 'Identity E2E', offer_text: OFFER_TEXT, face_value_cents: 200, runs_days: 14,\n    channels: [{ channel: 'flyer' }],\n  });\n  expect(created.status, `POST /campaigns → ${created.text}`).toBe(201);\n  const campaign = created.json.campaign;\n  psql(`UPDATE qr_codes SET short = '${FIRST_TOUCH_SHORT}' WHERE id = '${created.json.codes[0].id}'`);\n\n  const imported = await api(page, 'POST', '/api/v1/marketing/subscribers/import/web-form');\n  expect(imported.status,\n    `POST /subscribers/import/web-form → ${imported.text}. A 503 ff_not_configured means the e2e ` +\n    'server was started without HQ_FF_FIXTURE_PATH (playwright.config.js sets it; a stack ' +\n    'hand-provisioned behind NIGHTCREW_ENV_URL must export it too).').toBe(200);\n  expect(imported.json.created, 'the committed fixture lands four new subscribers').toBe(4);\n  // The e2e stack has no substrate, so the first-touch code could not be\n  // projected — and the import says so instead of failing (decision 187's shape).\n  expect(imported.json.warnings, 'an unprojected identity code is reported, not hidden').toEqual(['not_projected']);\n\n  const subscriberId = psql(`SELECT id FROM subscribers WHERE source_short = '${FIRST_TOUCH_SHORT}'`);\n  expect(subscriberId, 'the first-touch subscriber exists').toMatch(/^[0-9a-f-]{36}$/);\n  const detail = await api(page, 'GET', `/api/v1/marketing/subscribers/${subscriberId}`);\n  expect(detail.status, `GET /subscribers/{id} → ${detail.text}`).toBe(200);\n  expect(detail.json.identity_code.status, 'an imported subscriber has a code, and nothing has been sent').toBe('minted');\n  const mediaUrl = detail.json.identity_code.media_url;\n  expect(mediaUrl, 'identity_code.media_url').toMatch(/^\\/m\\/[0-9a-f-]{36}\\.png$/);\n\n  // PUBLIC: a context with no cookies at all, as a customer's phone has.\n  const anon = await page.context().browser().newContext({ baseURL: testInfo.project.use.baseURL });\n  let png;\n  try {\n    const res = await anon.request.get(mediaUrl);\n    expect(res.status(), `GET ${mediaUrl} with no session`).toBe(200);\n    expect(res.headers()['content-type']).toBe('image/png');\n    expect(res.headers()['cache-control']).toBe('private, max-age=3600');\n    png = await res.body();\n    const head = await anon.request.head(mediaUrl);\n    expect(head.status(), 'HEAD is supported').toBe(200);\n    const missing = await anon.request.get('/m/00000000-0000-4000-8000-000000000000.png');\n    expect(missing.status(), 'an unknown media id is a 404').toBe(404);\n  } finally {\n    await anon.close();\n  }\n  const pngPath = testInfo.outputPath('identity-code.png');\n  fs.writeFileSync(pngPath, png);\n\n  const storedHash = psql(`SELECT identity_token_hash FROM subscribers WHERE id = '${subscriberId}'`);\n  return { campaign, subscriberId, mediaUrl, pngPath, storedHash };\n}\n\nasync function openScanner(page) {\n  await page.goto('/marketing.html');\n  await page.waitForFunction(() => window.MarketingScan && window.MarketingScan.booted === true);\n}\n\nasync function scanFile(page, file) {\n  await page.setInputFiles('#scan-file', file);\n  await page.waitForSelector('#scan-result[data-kind]', { state: 'attached' });\n}\n\nasync function readResult(page) {\n  const r = page.locator('#scan-result');\n  return {\n    kind: await r.getAttribute('data-kind'),\n    hash: await r.getAttribute('data-token-hash'),\n    source: await r.getAttribute('data-source'),\n  };\n}\n\n// decodePng reads the QR's TEXT out of a PNG with the page's own vendored\n// decoder on a wide private surface — independent of the scanner's result\n// rendering. This is the only way the test (or anyone) learns the token.\nasync function decodePng(page, pngPath) {\n  const b64 = fs.readFileSync(pngPath).toString('base64');\n  return page.evaluate(async (data) => {\n    const host = document.createElement('div');\n    host.id = 'ic-test-decode-surface';\n    host.style.cssText = 'position:absolute;left:-9999px;width:1024px;height:1024px;overflow:hidden';\n    document.body.appendChild(host);\n    try {\n      const bytes = Uint8Array.from(atob(data), (c) => c.charCodeAt(0));\n      const file = new File([bytes], 'identity-code.png', { type: 'image/png' });\n      // eslint-disable-next-line no-undef\n      return await new Html5Qrcode(host.id).scanFile(file, false);\n    } finally {\n      host.remove();\n    }\n  }, b64);\n}\n\n// What the payload must be, read off the decoded text.\nfunction parsePayload(text) {\n  const m = /^https:\\/\\/hq\\.yumyums\\.kitchen\\/r\\/([^/?#]+)(?:#o=([A-Za-z0-9_-]+))?$/.exec(text);\n  expect(m, `decoded payload is not <base>/r/<token>[#o=<descriptor>]: ${text}`).not.toBeNull();\n  return {\n    token: m[1],\n    descriptor: m[2] ? JSON.parse(Buffer.from(m[2], 'base64url').toString('utf8')) : null,\n  };\n}\n\nasync function mockSyncTransports(page, campaign) {\n  await page.route('**/api/v1/sync/token', (route) => route.fulfill({\n    status: 200, contentType: 'application/json',\n    body: JSON.stringify({\n      token: 'e2e-bridge-token', expires_at: Math.floor(Date.now() / 1000) + 900,\n      sub: MINT_SUB, role: 'authenticated', grants: ['marketing'],\n    }),\n  }));\n  await page.route('**/sync/rest/**', (route) => {\n    const req = route.request();\n    const u = new URL(req.url());\n    // The replica pulls: this tablet has never seen the customer's code.\n    if (req.method() === 'GET' && u.pathname.endsWith('/codes')) {\n      return route.fulfill({ status: 200, contentType: 'application/json', body: '[]' });\n    }\n    if (req.method() === 'GET' && u.pathname.endsWith('/campaigns')) {\n      return route.fulfill({\n        status: 200, contentType: 'application/json',\n        body: JSON.stringify([{\n          id: campaign.id, name: campaign.name, requires_online: false,\n          updated_at: '2026-09-01T00:00:00.000Z',\n        }]),\n      });\n    }\n    if (req.method() === 'POST' && u.pathname.endsWith('/scan_attempts')) {\n      return route.fulfill({ status: 201, contentType: 'application/json', body: '' });\n    }\n    return route.fulfill({ status: 503, body: 'unmocked sync transport' });\n  });\n}\n\nconst isLookupUrl = (url) =>\n  url.pathname.endsWith('/sync/rest/codes') && url.searchParams.has('token_hash');\n\n// qrgen draws a payload with the repo's own go-qrcode (the library the server\n// mints with) at a chosen correction level, and reports the QR version.\nfunction qrgen(payload, outPath, level) {\n  const out = execFileSync('go', ['run', './cmd/qrgen', payload, outPath, '512', level], {\n    cwd: path.join(__dirname, '..', 'backend'),\n    encoding: 'utf8',\n    env: { ...process.env, PATH: `/usr/local/go/bin:${process.env.PATH}` },\n  });\n  const m = /version=(\\d+) modules=(\\d+)/.exec(out);\n  expect(m, `qrgen output: ${out}`).not.toBeNull();\n  return { version: Number(m[1]), modules: Number(m[2]) };\n}\n\ntest.describe('Identity code — minted by the server, read by the shipped scanner (card identity-code-and-qr)', () => {\n  // `go run` on a cold build cache and the import both sit inside one test.\n  test.setTimeout(120000);\n\n  test('[IC-01] OFFLINE, nothing seeded: the server-minted PNG shows the signup\\'s offer and the hash of its own token', async ({ page }, testInfo) => {\n    const minted = await mintFixtureCode(page, testInfo);\n    await openScanner(page);\n\n    // The token, learned ONLY by decoding the server's PNG.\n    const text = await decodePng(page, minted.pngPath);\n    const { token, descriptor } = parsePayload(text);\n    expect(token, 'a 16-character token over the unambiguous alphabet').toMatch(TOKEN_RE);\n    expect(sha256Hex(token), 'the server stored the hash of exactly the token it drew').toBe(minted.storedHash);\n    expect(descriptor, 'a first-touch signup\\'s code carries the offer').toEqual({\n      label: OFFER_TEXT,\n      campaign_id: minted.campaign.id,\n      expires_at: minted.campaign.ends_at.slice(0, 10),\n      face_value: 2,\n    });\n    // The token itself is in no column of the subscriber's row.\n    expect(psql(`SELECT count(*) FROM subscribers s WHERE to_jsonb(s)::text LIKE '%${token}%'`)).toBe('0');\n\n    await page.context().setOffline(true);\n    await scanFile(page, minted.pngPath);\n    const result = page.locator('#scan-result');\n    await expect(result).toHaveAttribute('data-kind', 'embeddedOffer');\n    await expect(result).toHaveAttribute('data-source', 'embedded');\n    await expect(result).toHaveAttribute('data-token-hash', sha256Hex(token));\n    await expect(result).toContainText(OFFER_TEXT);\n    // Display-only until the server has been asked — the crew is told so.\n    await expect(result.locator('.result-note')).toContainText('not yet verified');\n    // The raw token never lands in the DOM — only its hash.\n    expect(await result.innerHTML()).not.toContain(token);\n  });\n\n  test('[IC-02] ONLINE: the same PNG resolves the server\\'s row for that code → offerReady, source server', async ({ page }, testInfo) => {\n    const minted = await mintFixtureCode(page, testInfo);\n    await mockSyncTransports(page, minted.campaign);\n\n    // 🟡 The permitted stub. The \"server\" holds exactly the row the projection\n    // writes for this subscriber, keyed by the hash HQ stored; any other hash\n    // gets `200 []`, the way PostgREST answers.\n    const projected = {\n      id: identityCodeId(minted.subscriberId),\n      campaign_id: minted.campaign.id,\n      expires_at: minted.campaign.ends_at.replace(/Z$/, '+00:00'),\n      redeemed_at: null,\n      redeemed_by: null,\n    };\n    const lookups = [];\n    await page.route(isLookupUrl, (route) => {\n      const asked = /^eq\\.(.+)$/.exec(new URL(route.request().url()).searchParams.get('token_hash') || '');\n      lookups.push(asked ? asked[1] : null);\n      const rows = asked && asked[1] === minted.storedHash ? [projected] : [];\n      return route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify(rows) });\n    });\n\n    await page.goto('/marketing.html');\n    await page.waitForFunction(() =>\n      window.MarketingScan && window.MarketingScan.booted === true\n      && window.MarketingSubmit && window.MarketingSubmit.booted === true);\n    await page.waitForFunction(() =>\n      document.getElementById('scan-status').textContent.includes('Replica synced'));\n    await expect(page.locator('#scan-conn')).toHaveAttribute('data-conn', 'online');\n\n    const { token } = parsePayload(await decodePng(page, minted.pngPath));\n    await scanFile(page, minted.pngPath);\n    await page.waitForFunction(() =>\n      document.getElementById('scan-result').getAttribute('data-kind') !== 'checkingServer', null, { timeout: 10000 });\n\n    const result = page.locator('#scan-result');\n    await expect(result).toHaveAttribute('data-kind', 'offerReady');\n    await expect(result).toHaveAttribute('data-source', 'server');\n    await expect(result).toHaveAttribute('data-token-hash', sha256Hex(token));\n    await expect(result.locator('.offer-row').first()).toHaveAttribute('data-code-id', projected.id);\n    expect(lookups, 'the scanner asked the server about this code\\'s hash, and only that').toEqual([minted.storedHash]);\n  });\n\n  test('[IC-03] NEGATIVE control: the same payload at Medium correction (QR version 11) renders no offer', async ({ page }, testInfo) => {\n    const minted = await mintFixtureCode(page, testInfo);\n    await openScanner(page);\n    const text = await decodePng(page, minted.pngPath);\n    const { token } = parsePayload(text);\n\n    // The control must be what it claims: the SAME text, one correction level\n    // up, which costs two QR versions. The Low twin is drawn by the same tool\n    // so the comparison is like for like.\n    const mediumPath = testInfo.outputPath('identity-code-medium.png');\n    const lowPath = testInfo.outputPath('identity-code-low.png');\n    const medium = qrgen(text, mediumPath, 'M');\n    const low = qrgen(text, lowPath, 'L');\n    expect(medium.version, `the ${text.length}-char payload at Medium`).toBe(11);\n    expect(low.version, `the ${text.length}-char payload at Low — the card's encoding`).toBeLessThanOrEqual(10);\n    expect(fs.readFileSync(lowPath).equals(fs.readFileSync(minted.pngPath)),\n      'the server\\'s PNG is byte-for-byte the Low/512 drawing of its payload').toBe(true);\n\n    await page.context().setOffline(true);\n    await scanFile(page, mediumPath);\n    const got = await readResult(page);\n    console.log('IC-03 ' + JSON.stringify({ payload_len: text.length, medium, low, ...got }));\n    expect(['decodeError', 'invalidPayload'], `Medium/version-11 photo → ${got.kind}`).toContain(got.kind);\n    // Whatever the reader made of it, it never showed an offer under a hash\n    // that is not this token's.\n    if (got.hash) expect(got.hash).toBe(sha256Hex(token));\n    await expect(page.locator('#scan-result .offer-row')).toHaveCount(0);\n    await expect(page.locator('#scan-result')).not.toContainText(OFFER_TEXT);\n  });\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3090,"cache_read_input_tokens":220018,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3090},"output_tokens":43,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"792dcbd6-aa1d-4c6e-83da-0e3997c4c9b1","uuid":"c1feaba2-5343-48e2-9934-647f6963d49c","timestamp":"2026-10-05T23:47:20.010Z","request_id":"req_011CfjytArZEEunozAcaDB6f","wire_tool_inputs":{"toolu_014tuSHuuXFypr7b78fAVyHT":{"file_path":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/tests/marketing-identity.spec.js","content":"// ═══════════════════════════════════════════════════════════════════════════\n// Marketing · identity codes — card E1 `identity-code-and-qr` (run 20261006)\n// roadmap Activity E; goal ledger\n// .night-crew/knowledge/spikes/activity-e-customer-delivery-one-identity-code-qr-image/identity-code-and-qr.md\n// ═══════════════════════════════════════════════════════════════════════════\n//\n// What these three tests are about, in the truck's terms: a customer who signed\n// up holds ONE code on their phone. The crew member photographs it.\n//\n//   [IC-01] With no signal, and before that customer has ever synced to this\n//           tablet, the scanner still shows the offer they signed up for.\n//   [IC-02] With signal, the scanner shows the server's answer for that code.\n//   [IC-03] NEGATIVE control: the same code drawn more densely (Medium error\n//           correction, QR version 11) is NOT read off the photo by the shipped\n//           scanner — which is why the server draws it at Low. A change that\n//           \"upgrades\" the correction level turns [IC-01] into this.\n//\n// 🛑 THE PNG IS THE SERVER'S. Subscribers are imported through the real\n// POST /subscribers/import/web-form (the committed Fluent Forms fixture, via\n// HQ_FF_FIXTURE_PATH on the e2e server — never the live website database), the\n// code is minted by that import, and the image is fetched from the real public\n// GET /m/{id}.png. The raw token is stored nowhere, so the test learns it the\n// only way anyone can: by DECODING THE PNG.\n//\n// 🟡 THE ONE STUB is in [IC-02]: the server lookup is answered by page.route on\n// the sync door's path (the e2e stack has no substrate). It returns the row the\n// projection would have written. The projection itself is gated in Go\n// (TestProjectIdentityCodeUpserts).\n//\n// RED-FIRST: written and run against the pre-change tree — no /m/ route, no\n// mint, `identity_code.status` still \"not_sent\". Evidence:\n// .night-crew/runs/2026-10-06-autonomous/logs/identity-code-and-qr/.\n\nconst { test, expect } = require('@playwright/test');\nconst { execFileSync } = require('child_process');\nconst crypto = require('crypto');\nconst fs = require('fs');\nconst path = require('path');\nconst { resolveE2eDb } = require('../scripts/reset-e2e-db');\n\nconst ADMIN_EMAIL = 'jamal@yumyums.kitchen';\nconst ADMIN_PASSWORD = 'test123';\nconst MINT_SUB = 'e2e-identity-mint-sub';\n\n// The committed fixture's row 1182 is the one signup carrying a first-touch\n// code (`source: \"K7MNPQ\"`); the other three have none.\nconst FIRST_TOUCH_SHORT = 'K7MNPQ';\nconst OFFER_TEXT = 'Free side of wings';\nconst TOKEN_RE = /^[23456789abcdefghjkmnpqrstuvwxyz]{16}$/;\n\nconst sha256Hex = (s) => crypto.createHash('sha256').update(s).digest('hex');\n\n// The arbiter row's id, derived the way internal/marketing/identity.go derives\n// it: uuid v5 (RFC 4122 URL namespace) over a URL naming the subscriber.\nfunction identityCodeId(subscriberId) {\n  const ns = Buffer.from('6ba7b8119dad11d180b400c04fd430c8', 'hex');\n  const name = 'https://hq.yumyums.kitchen/identity-code/' + subscriberId.toLowerCase();\n  const h = crypto.createHash('sha1').update(ns).update(name).digest().subarray(0, 16);\n  h[6] = (h[6] & 0x0f) | 0x50;\n  h[8] = (h[8] & 0x3f) | 0x80;\n  const x = h.toString('hex');\n  return `${x.slice(0, 8)}-${x.slice(8, 12)}-${x.slice(12, 16)}-${x.slice(16, 20)}-${x.slice(20)}`;\n}\n\n// `psqlUrl`, not `testUrl` — libpq does not understand TimeZone (the note\n// tests/marketing-stats.spec.js carries).\nfunction psql(sqlText) {\n  const db = resolveE2eDb();\n  return execFileSync('psql', [db.psqlUrl, '-At', '-v', 'ON_ERROR_STOP=1', '-c', sqlText],\n    { encoding: 'utf8' }).trim();\n}\n\n// This file owns subscribers, campaigns and codes while it runs. Deleting a\n// subscriber deletes their timeline and their identity image with them.\nfunction resetIdentityFixture() {\n  psql(`DELETE FROM subscribers;\n        DELETE FROM reconciliation_decisions;\n        DELETE FROM scan_attempts_mirror;\n        DELETE FROM qr_scans;\n        DELETE FROM qr_codes;\n        DELETE FROM campaigns_admin;`);\n}\n\nasync function loginAs(page, email, password) {\n  await page.goto('/login.html');\n  await page.fill('input[type=\"email\"]', email);\n  await page.fill('input[type=\"password\"]', password);\n  await page.click('button.btn');\n  await page.waitForURL((url) => !url.pathname.includes('login'));\n}\n\nasync function api(page, method, url, body) {\n  return page.evaluate(async ([m, u, b]) => {\n    const r = await fetch(u, {\n      method: m,\n      headers: b ? { 'Content-Type': 'application/json' } : {},\n      body: b ? JSON.stringify(b) : undefined,\n    });\n    const text = await r.text();\n    let json = null;\n    try { json = JSON.parse(text); } catch (e) { /* not JSON */ }\n    return { status: r.status, text, json };\n  }, [method, url, body || null]);\n}\n\n// mintFixtureCode: a live campaign whose code is the fixture's first-touch\n// short, then the real import. Returns what the SERVER reports — and the PNG,\n// fetched with NO session, written to a per-test file.\nasync function mintFixtureCode(page, testInfo) {\n  resetIdentityFixture();\n  await loginAs(page, ADMIN_EMAIL, ADMIN_PASSWORD);\n\n  const created = await api(page, 'POST', '/api/v1/marketing/campaigns', {\n    name: 'Identity E2E', offer_text: OFFER_TEXT, face_value_cents: 200, runs_days: 14,\n    channels: [{ channel: 'flyer' }],\n  });\n  expect(created.status, `POST /campaigns → ${created.text}`).toBe(201);\n  const campaign = created.json.campaign;\n  psql(`UPDATE qr_codes SET short = '${FIRST_TOUCH_SHORT}' WHERE id = '${created.json.codes[0].id}'`);\n\n  const imported = await api(page, 'POST', '/api/v1/marketing/subscribers/import/web-form');\n  expect(imported.status,\n    `POST /subscribers/import/web-form → ${imported.text}. A 503 ff_not_configured means the e2e ` +\n    'server was started without HQ_FF_FIXTURE_PATH (playwright.config.js sets it; a stack ' +\n    'hand-provisioned behind NIGHTCREW_ENV_URL must export it too).').toBe(200);\n  expect(imported.json.created, 'the committed fixture lands four new subscribers').toBe(4);\n  // The e2e stack has no substrate, so the first-touch code could not be\n  // projected — and the import says so instead of failing (decision 187's shape).\n  expect(imported.json.warnings, 'an unprojected identity code is reported, not hidden').toEqual(['not_projected']);\n\n  const subscriberId = psql(`SELECT id FROM subscribers WHERE source_short = '${FIRST_TOUCH_SHORT}'`);\n  expect(subscriberId, 'the first-touch subscriber exists').toMatch(/^[0-9a-f-]{36}$/);\n  const detail = await api(page, 'GET', `/api/v1/marketing/subscribers/${subscriberId}`);\n  expect(detail.status, `GET /subscribers/{id} → ${detail.text}`).toBe(200);\n  expect(detail.json.identity_code.status, 'an imported subscriber has a code, and nothing has been sent').toBe('minted');\n  const mediaUrl = detail.json.identity_code.media_url;\n  expect(mediaUrl, 'identity_code.media_url').toMatch(/^\\/m\\/[0-9a-f-]{36}\\.png$/);\n\n  // PUBLIC: a context with no cookies at all, as a customer's phone has.\n  const anon = await page.context().browser().newContext({ baseURL: testInfo.project.use.baseURL });\n  let png;\n  try {\n    const res = await anon.request.get(mediaUrl);\n    expect(res.status(), `GET ${mediaUrl} with no session`).toBe(200);\n    expect(res.headers()['content-type']).toBe('image/png');\n    expect(res.headers()['cache-control']).toBe('private, max-age=3600');\n    png = await res.body();\n    const head = await anon.request.head(mediaUrl);\n    expect(head.status(), 'HEAD is supported').toBe(200);\n    const missing = await anon.request.get('/m/00000000-0000-4000-8000-000000000000.png');\n    expect(missing.status(), 'an unknown media id is a 404').toBe(404);\n  } finally {\n    await anon.close();\n  }\n  const pngPath = testInfo.outputPath('identity-code.png');\n  fs.writeFileSync(pngPath, png);\n\n  const storedHash = psql(`SELECT identity_token_hash FROM subscribers WHERE id = '${subscriberId}'`);\n  return { campaign, subscriberId, mediaUrl, pngPath, storedHash };\n}\n\nasync function openScanner(page) {\n  await page.goto('/marketing.html');\n  await page.waitForFunction(() => window.MarketingScan && window.MarketingScan.booted === true);\n}\n\nasync function scanFile(page, file) {\n  await page.setInputFiles('#scan-file', file);\n  await page.waitForSelector('#scan-result[data-kind]', { state: 'attached' });\n}\n\nasync function readResult(page) {\n  const r = page.locator('#scan-result');\n  return {\n    kind: await r.getAttribute('data-kind'),\n    hash: await r.getAttribute('data-token-hash'),\n    source: await r.getAttribute('data-source'),\n  };\n}\n\n// decodePng reads the QR's TEXT out of a PNG with the page's own vendored\n// decoder on a wide private surface — independent of the scanner's result\n// rendering. This is the only way the test (or anyone) learns the token.\nasync function decodePng(page, pngPath) {\n  const b64 = fs.readFileSync(pngPath).toString('base64');\n  return page.evaluate(async (data) => {\n    const host = document.createElement('div');\n    host.id = 'ic-test-decode-surface';\n    host.style.cssText = 'position:absolute;left:-9999px;width:1024px;height:1024px;overflow:hidden';\n    document.body.appendChild(host);\n    try {\n      const bytes = Uint8Array.from(atob(data), (c) => c.charCodeAt(0));\n      const file = new File([bytes], 'identity-code.png', { type: 'image/png' });\n      // eslint-disable-next-line no-undef\n      return await new Html5Qrcode(host.id).scanFile(file, false);\n    } finally {\n      host.remove();\n    }\n  }, b64);\n}\n\n// What the payload must be, read off the decoded text.\nfunction parsePayload(text) {\n  const m = /^https:\\/\\/hq\\.yumyums\\.kitchen\\/r\\/([^/?#]+)(?:#o=([A-Za-z0-9_-]+))?$/.exec(text);\n  expect(m, `decoded payload is not <base>/r/<token>[#o=<descriptor>]: ${text}`).not.toBeNull();\n  return {\n    token: m[1],\n    descriptor: m[2] ? JSON.parse(Buffer.from(m[2], 'base64url').toString('utf8')) : null,\n  };\n}\n\nasync function mockSyncTransports(page, campaign) {\n  await page.route('**/api/v1/sync/token', (route) => route.fulfill({\n    status: 200, contentType: 'application/json',\n    body: JSON.stringify({\n      token: 'e2e-bridge-token', expires_at: Math.floor(Date.now() / 1000) + 900,\n      sub: MINT_SUB, role: 'authenticated', grants: ['marketing'],\n    }),\n  }));\n  await page.route('**/sync/rest/**', (route) => {\n    const req = route.request();\n    const u = new URL(req.url());\n    // The replica pulls: this tablet has never seen the customer's code.\n    if (req.method() === 'GET' && u.pathname.endsWith('/codes')) {\n      return route.fulfill({ status: 200, contentType: 'application/json', body: '[]' });\n    }\n    if (req.method() === 'GET' && u.pathname.endsWith('/campaigns')) {\n      return route.fulfill({\n        status: 200, contentType: 'application/json',\n        body: JSON.stringify([{\n          id: campaign.id, name: campaign.name, requires_online: false,\n          updated_at: '2026-09-01T00:00:00.000Z',\n        }]),\n      });\n    }\n    if (req.method() === 'POST' && u.pathname.endsWith('/scan_attempts')) {\n      return route.fulfill({ status: 201, contentType: 'application/json', body: '' });\n    }\n    return route.fulfill({ status: 503, body: 'unmocked sync transport' });\n  });\n}\n\nconst isLookupUrl = (url) =>\n  url.pathname.endsWith('/sync/rest/codes') && url.searchParams.has('token_hash');\n\n// qrgen draws a payload with the repo's own go-qrcode (the library the server\n// mints with) at a chosen correction level, and reports the QR version.\nfunction qrgen(payload, outPath, level) {\n  const out = execFileSync('go', ['run', './cmd/qrgen', payload, outPath, '512', level], {\n    cwd: path.join(__dirname, '..', 'backend'),\n    encoding: 'utf8',\n    env: { ...process.env, PATH: `/usr/local/go/bin:${process.env.PATH}` },\n  });\n  const m = /version=(\\d+) modules=(\\d+)/.exec(out);\n  expect(m, `qrgen output: ${out}`).not.toBeNull();\n  return { version: Number(m[1]), modules: Number(m[2]) };\n}\n\ntest.describe('Identity code — minted by the server, read by the shipped scanner (card identity-code-and-qr)', () => {\n  // `go run` on a cold build cache and the import both sit inside one test.\n  test.setTimeout(120000);\n\n  test('[IC-01] OFFLINE, nothing seeded: the server-minted PNG shows the signup\\'s offer and the hash of its own token', async ({ page }, testInfo) => {\n    const minted = await mintFixtureCode(page, testInfo);\n    await openScanner(page);\n\n    // The token, learned ONLY by decoding the server's PNG.\n    const text = await decodePng(page, minted.pngPath);\n    const { token, descriptor } = parsePayload(text);\n    expect(token, 'a 16-character token over the unambiguous alphabet').toMatch(TOKEN_RE);\n    expect(sha256Hex(token), 'the server stored the hash of exactly the token it drew').toBe(minted.storedHash);\n    expect(descriptor, 'a first-touch signup\\'s code carries the offer').toEqual({\n      label: OFFER_TEXT,\n      campaign_id: minted.campaign.id,\n      expires_at: minted.campaign.ends_at.slice(0, 10),\n      face_value: 2,\n    });\n    // The token itself is in no column of the subscriber's row.\n    expect(psql(`SELECT count(*) FROM subscribers s WHERE to_jsonb(s)::text LIKE '%${token}%'`)).toBe('0');\n\n    await page.context().setOffline(true);\n    await scanFile(page, minted.pngPath);\n    const result = page.locator('#scan-result');\n    await expect(result).toHaveAttribute('data-kind', 'embeddedOffer');\n    await expect(result).toHaveAttribute('data-source', 'embedded');\n    await expect(result).toHaveAttribute('data-token-hash', sha256Hex(token));\n    await expect(result).toContainText(OFFER_TEXT);\n    // Display-only until the server has been asked — the crew is told so.\n    await expect(result.locator('.result-note')).toContainText('not yet verified');\n    // The raw token never lands in the DOM — only its hash.\n    expect(await result.innerHTML()).not.toContain(token);\n  });\n\n  test('[IC-02] ONLINE: the same PNG resolves the server\\'s row for that code → offerReady, source server', async ({ page }, testInfo) => {\n    const minted = await mintFixtureCode(page, testInfo);\n    await mockSyncTransports(page, minted.campaign);\n\n    // 🟡 The permitted stub. The \"server\" holds exactly the row the projection\n    // writes for this subscriber, keyed by the hash HQ stored; any other hash\n    // gets `200 []`, the way PostgREST answers.\n    const projected = {\n      id: identityCodeId(minted.subscriberId),\n      campaign_id: minted.campaign.id,\n      expires_at: minted.campaign.ends_at.replace(/Z$/, '+00:00'),\n      redeemed_at: null,\n      redeemed_by: null,\n    };\n    const lookups = [];\n    await page.route(isLookupUrl, (route) => {\n      const asked = /^eq\\.(.+)$/.exec(new URL(route.request().url()).searchParams.get('token_hash') || '');\n      lookups.push(asked ? asked[1] : null);\n      const rows = asked && asked[1] === minted.storedHash ? [projected] : [];\n      return route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify(rows) });\n    });\n\n    await page.goto('/marketing.html');\n    await page.waitForFunction(() =>\n      window.MarketingScan && window.MarketingScan.booted === true\n      && window.MarketingSubmit && window.MarketingSubmit.booted === true);\n    await page.waitForFunction(() =>\n      document.getElementById('scan-status').textContent.includes('Replica synced'));\n    await expect(page.locator('#scan-conn')).toHaveAttribute('data-conn', 'online');\n\n    const { token } = parsePayload(await decodePng(page, minted.pngPath));\n    await scanFile(page, minted.pngPath);\n    await page.waitForFunction(() =>\n      document.getElementById('scan-result').getAttribute('data-kind') !== 'checkingServer', null, { timeout: 10000 });\n\n    const result = page.locator('#scan-result');\n    await expect(result).toHaveAttribute('data-kind', 'offerReady');\n    await expect(result).toHaveAttribute('data-source', 'server');\n    await expect(result).toHaveAttribute('data-token-hash', sha256Hex(token));\n    await expect(result.locator('.offer-row').first()).toHaveAttribute('data-code-id', projected.id);\n    expect(lookups, 'the scanner asked the server about this code\\'s hash, and only that').toEqual([minted.storedHash]);\n  });\n\n  test('[IC-03] NEGATIVE control: the same payload at Medium correction (QR version 11) renders no offer', async ({ page }, testInfo) => {\n    const minted = await mintFixtureCode(page, testInfo);\n    await openScanner(page);\n    const text = await decodePng(page, minted.pngPath);\n    const { token } = parsePayload(text);\n\n    // The control must be what it claims: the SAME text, one correction level\n    // up, which costs two QR versions. The Low twin is drawn by the same tool\n    // so the comparison is like for like.\n    const mediumPath = testInfo.outputPath('identity-code-medium.png');\n    const lowPath = testInfo.outputPath('identity-code-low.png');\n    const medium = qrgen(text, mediumPath, 'M');\n    const low = qrgen(text, lowPath, 'L');\n    expect(medium.version, `the ${text.length}-char payload at Medium`).toBe(11);\n    expect(low.version, `the ${text.length}-char payload at Low — the card's encoding`).toBeLessThanOrEqual(10);\n    expect(fs.readFileSync(lowPath).equals(fs.readFileSync(minted.pngPath)),\n      'the server\\'s PNG is byte-for-byte the Low/512 drawing of its payload').toBe(true);\n\n    await page.context().setOffline(true);\n    await scanFile(page, mediumPath);\n    const got = await readResult(page);\n    console.log('IC-03 ' + JSON.stringify({ payload_len: text.length, medium, low, ...got }));\n    expect(['decodeError', 'invalidPayload'], `Medium/version-11 photo → ${got.kind}`).toContain(got.kind);\n    // Whatever the reader made of it, it never showed an offer under a hash\n    // that is not this token's.\n    if (got.hash) expect(got.hash).toBe(sha256Hex(token));\n    await expect(page.locator('#scan-result .offer-row')).toHaveCount(0);\n    await expect(page.locator('#scan-result')).not.toContainText(OFFER_TEXT);\n  });\n});\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014tuSHuuXFypr7b78fAVyHT","type":"tool_result","content":"File created successfully at: /home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/tests/marketing-identity.spec.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"792dcbd6-aa1d-4c6e-83da-0e3997c4c9b1","uuid":"b57012c8-ce3a-4236-880d-629e7761249c","timestamp":"2026-10-05T23:47:20.257Z","tool_use_result":{"type":"create","filePath":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/tests/marketing-identity.spec.js","content":"// ═══════════════════════════════════════════════════════════════════════════\n// Marketing · identity codes — card E1 `identity-code-and-qr` (run 20261006)\n// roadmap Activity E; goal ledger\n// .night-crew/knowledge/spikes/activity-e-customer-delivery-one-identity-code-qr-image/identity-code-and-qr.md\n// ═══════════════════════════════════════════════════════════════════════════\n//\n// What these three tests are about, in the truck's terms: a customer who signed\n// up holds ONE code on their phone. The crew member photographs it.\n//\n//   [IC-01] With no signal, and before that customer has ever synced to this\n//           tablet, the scanner still shows the offer they signed up for.\n//   [IC-02] With signal, the scanner shows the server's answer for that code.\n//   [IC-03] NEGATIVE control: the same code drawn more densely (Medium error\n//           correction, QR version 11) is NOT read off the photo by the shipped\n//           scanner — which is why the server draws it at Low. A change that\n//           \"upgrades\" the correction level turns [IC-01] into this.\n//\n// 🛑 THE PNG IS THE SERVER'S. Subscribers are imported through the real\n// POST /subscribers/import/web-form (the committed Fluent Forms fixture, via\n// HQ_FF_FIXTURE_PATH on the e2e server — never the live website database), the\n// code is minted by that import, and the image is fetched from the real public\n// GET /m/{id}.png. The raw token is stored nowhere, so the test learns it the\n// only way anyone can: by DECODING THE PNG.\n//\n// 🟡 THE ONE STUB is in [IC-02]: the server lookup is answered by page.route on\n// the sync door's path (the e2e stack has no substrate). It returns the row the\n// projection would have written. The projection itself is gated in Go\n// (TestProjectIdentityCodeUpserts).\n//\n// RED-FIRST: written and run against the pre-change tree — no /m/ route, no\n// mint, `identity_code.status` still \"not_sent\". Evidence:\n// .night-crew/runs/2026-10-06-autonomous/logs/identity-code-and-qr/.\n\nconst { test, expect } = require('@playwright/test');\nconst { execFileSync } = require('child_process');\nconst crypto = require('crypto');\nconst fs = require('fs');\nconst path = require('path');\nconst { resolveE2eDb } = require('../scripts/reset-e2e-db');\n\nconst ADMIN_EMAIL = 'jamal@yumyums.kitchen';\nconst ADMIN_PASSWORD = 'test123';\nconst MINT_SUB = 'e2e-identity-mint-sub';\n\n// The committed fixture's row 1182 is the one signup carrying a first-touch\n// code (`source: \"K7MNPQ\"`); the other three have none.\nconst FIRST_TOUCH_SHORT = 'K7MNPQ';\nconst OFFER_TEXT = 'Free side of wings';\nconst TOKEN_RE = /^[23456789abcdefghjkmnpqrstuvwxyz]{16}$/;\n\nconst sha256Hex = (s) => crypto.createHash('sha256').update(s).digest('hex');\n\n// The arbiter row's id, derived the way internal/marketing/identity.go derives\n// it: uuid v5 (RFC 4122 URL namespace) over a URL naming the subscriber.\nfunction identityCodeId(subscriberId) {\n  const ns = Buffer.from('6ba7b8119dad11d180b400c04fd430c8', 'hex');\n  const name = 'https://hq.yumyums.kitchen/identity-code/' + subscriberId.toLowerCase();\n  const h = crypto.createHash('sha1').update(ns).update(name).digest().subarray(0, 16);\n  h[6] = (h[6] & 0x0f) | 0x50;\n  h[8] = (h[8] & 0x3f) | 0x80;\n  const x = h.toString('hex');\n  return `${x.slice(0, 8)}-${x.slice(8, 12)}-${x.slice(12, 16)}-${x.slice(16, 20)}-${x.slice(20)}`;\n}\n\n// `psqlUrl`, not `testUrl` — libpq does not understand TimeZone (the note\n// tests/marketing-stats.spec.js carries).\nfunction psql(sqlText) {\n  const db = resolveE2eDb();\n  return execFileSync('psql', [db.psqlUrl, '-At', '-v', 'ON_ERROR_STOP=1', '-c', sqlText],\n    { encoding: 'utf8' }).trim();\n}\n\n// This file owns subscribers, campaigns and codes while it runs. Deleting a\n// subscriber deletes their timeline and their identity image with them.\nfunction resetIdentityFixture() {\n  psql(`DELETE FROM subscribers;\n        DELETE FROM reconciliation_decisions;\n        DELETE FROM scan_attempts_mirror;\n        DELETE FROM qr_scans;\n        DELETE FROM qr_codes;\n        DELETE FROM campaigns_admin;`);\n}\n\nasync function loginAs(page, email, password) {\n  await page.goto('/login.html');\n  await page.fill('input[type=\"email\"]', email);\n  await page.fill('input[type=\"password\"]', password);\n  await page.click('button.btn');\n  await page.waitForURL((url) => !url.pathname.includes('login'));\n}\n\nasync function api(page, method, url, body) {\n  return page.evaluate(async ([m, u, b]) => {\n    const r = await fetch(u, {\n      method: m,\n      headers: b ? { 'Content-Type': 'application/json' } : {},\n      body: b ? JSON.stringify(b) : undefined,\n    });\n    const text = await r.text();\n    let json = null;\n    try { json = JSON.parse(text); } catch (e) { /* not JSON */ }\n    return { status: r.status, text, json };\n  }, [method, url, body || null]);\n}\n\n// mintFixtureCode: a live campaign whose code is the fixture's first-touch\n// short, then the real import. Returns what the SERVER reports — and the PNG,\n// fetched with NO session, written to a per-test file.\nasync function mintFixtureCode(page, testInfo) {\n  resetIdentityFixture();\n  await loginAs(page, ADMIN_EMAIL, ADMIN_PASSWORD);\n\n  const created = await api(page, 'POST', '/api/v1/marketing/campaigns', {\n    name: 'Identity E2E', offer_text: OFFER_TEXT, face_value_cents: 200, runs_days: 14,\n    channels: [{ channel: 'flyer' }],\n  });\n  expect(created.status, `POST /campaigns → ${created.text}`).toBe(201);\n  const campaign = created.json.campaign;\n  psql(`UPDATE qr_codes SET short = '${FIRST_TOUCH_SHORT}' WHERE id = '${created.json.codes[0].id}'`);\n\n  const imported = await api(page, 'POST', '/api/v1/marketing/subscribers/import/web-form');\n  expect(imported.status,\n    `POST /subscribers/import/web-form → ${imported.text}. A 503 ff_not_configured means the e2e ` +\n    'server was started without HQ_FF_FIXTURE_PATH (playwright.config.js sets it; a stack ' +\n    'hand-provisioned behind NIGHTCREW_ENV_URL must export it too).').toBe(200);\n  expect(imported.json.created, 'the committed fixture lands four new subscribers').toBe(4);\n  // The e2e stack has no substrate, so the first-touch code could not be\n  // projected — and the import says so instead of failing (decision 187's shape).\n  expect(imported.json.warnings, 'an unprojected identity code is reported, not hidden').toEqual(['not_projected']);\n\n  const subscriberId = psql(`SELECT id FROM subscribers WHERE source_short = '${FIRST_TOUCH_SHORT}'`);\n  expect(subscriberId, 'the first-touch subscriber exists').toMatch(/^[0-9a-f-]{36}$/);\n  const detail = await api(page, 'GET', `/api/v1/marketing/subscribers/${subscriberId}`);\n  expect(detail.status, `GET /subscribers/{id} → ${detail.text}`).toBe(200);\n  expect(detail.json.identity_code.status, 'an imported subscriber has a code, and nothing has been sent').toBe('minted');\n  const mediaUrl = detail.json.identity_code.media_url;\n  expect(mediaUrl, 'identity_code.media_url').toMatch(/^\\/m\\/[0-9a-f-]{36}\\.png$/);\n\n  // PUBLIC: a context with no cookies at all, as a customer's phone has.\n  const anon = await page.context().browser().newContext({ baseURL: testInfo.project.use.baseURL });\n  let png;\n  try {\n    const res = await anon.request.get(mediaUrl);\n    expect(res.status(), `GET ${mediaUrl} with no session`).toBe(200);\n    expect(res.headers()['content-type']).toBe('image/png');\n    expect(res.headers()['cache-control']).toBe('private, max-age=3600');\n    png = await res.body();\n    const head = await anon.request.head(mediaUrl);\n    expect(head.status(), 'HEAD is supported').toBe(200);\n    const missing = await anon.request.get('/m/00000000-0000-4000-8000-000000000000.png');\n    expect(missing.status(), 'an unknown media id is a 404').toBe(404);\n  } finally {\n    await anon.close();\n  }\n  const pngPath = testInfo.outputPath('identity-code.png');\n  fs.writeFileSync(pngPath, png);\n\n  const storedHash = psql(`SELECT identity_token_hash FROM subscribers WHERE id = '${subscriberId}'`);\n  return { campaign, subscriberId, mediaUrl, pngPath, storedHash };\n}\n\nasync function openScanner(page) {\n  await page.goto('/marketing.html');\n  await page.waitForFunction(() => window.MarketingScan && window.MarketingScan.booted === true);\n}\n\nasync function scanFile(page, file) {\n  await page.setInputFiles('#scan-file', file);\n  await page.waitForSelector('#scan-result[data-kind]', { state: 'attached' });\n}\n\nasync function readResult(page) {\n  const r = page.locator('#scan-result');\n  return {\n    kind: await r.getAttribute('data-kind'),\n    hash: await r.getAttribute('data-token-hash'),\n    source: await r.getAttribute('data-source'),\n  };\n}\n\n// decodePng reads the QR's TEXT out of a PNG with the page's own vendored\n// decoder on a wide private surface — independent of the scanner's result\n// rendering. This is the only way the test (or anyone) learns the token.\nasync function decodePng(page, pngPath) {\n  const b64 = fs.readFileSync(pngPath).toString('base64');\n  return page.evaluate(async (data) => {\n    const host = document.createElement('div');\n    host.id = 'ic-test-decode-surface';\n    host.style.cssText = 'position:absolute;left:-9999px;width:1024px;height:1024px;overflow:hidden';\n    document.body.appendChild(host);\n    try {\n      const bytes = Uint8Array.from(atob(data), (c) => c.charCodeAt(0));\n      const file = new File([bytes], 'identity-code.png', { type: 'image/png' });\n      // eslint-disable-next-line no-undef\n      return await new Html5Qrcode(host.id).scanFile(file, false);\n    } finally {\n      host.remove();\n    }\n  }, b64);\n}\n\n// What the payload must be, read off the decoded text.\nfunction parsePayload(text) {\n  const m = /^https:\\/\\/hq\\.yumyums\\.kitchen\\/r\\/([^/?#]+)(?:#o=([A-Za-z0-9_-]+))?$/.exec(text);\n  expect(m, `decoded payload is not <base>/r/<token>[#o=<descriptor>]: ${text}`).not.toBeNull();\n  return {\n    token: m[1],\n    descriptor: m[2] ? JSON.parse(Buffer.from(m[2], 'base64url').toString('utf8')) : null,\n  };\n}\n\nasync function mockSyncTransports(page, campaign) {\n  await page.route('**/api/v1/sync/token', (route) => route.fulfill({\n    status: 200, contentType: 'application/json',\n    body: JSON.stringify({\n      token: 'e2e-bridge-token', expires_at: Math.floor(Date.now() / 1000) + 900,\n      sub: MINT_SUB, role: 'authenticated', grants: ['marketing'],\n    }),\n  }));\n  await page.route('**/sync/rest/**', (route) => {\n    const req = route.request();\n    const u = new URL(req.url());\n    // The replica pulls: this tablet has never seen the customer's code.\n    if (req.method() === 'GET' && u.pathname.endsWith('/codes')) {\n      return route.fulfill({ status: 200, contentType: 'application/json', body: '[]' });\n    }\n    if (req.method() === 'GET' && u.pathname.endsWith('/campaigns')) {\n      return route.fulfill({\n        status: 200, contentType: 'application/json',\n        body: JSON.stringify([{\n          id: campaign.id, name: campaign.name, requires_online: false,\n          updated_at: '2026-09-01T00:00:00.000Z',\n        }]),\n      });\n    }\n    if (req.method() === 'POST' && u.pathname.endsWith('/scan_attempts')) {\n      return route.fulfill({ status: 201, contentType: 'application/json', body: '' });\n    }\n    return route.fulfill({ status: 503, body: 'unmocked sync transport' });\n  });\n}\n\nconst isLookupUrl = (url) =>\n  url.pathname.endsWith('/sync/rest/codes') && url.searchParams.has('token_hash');\n\n// qrgen draws a payload with the repo's own go-qrcode (the library the server\n// mints with) at a chosen correction level, and reports the QR version.\nfunction qrgen(payload, outPath, level) {\n  const out = execFileSync('go', ['run', './cmd/qrgen', payload, outPath, '512', level], {\n    cwd: path.join(__dirname, '..', 'backend'),\n    encoding: 'utf8',\n    env: { ...process.env, PATH: `/usr/local/go/bin:${process.env.PATH}` },\n  });\n  const m = /version=(\\d+) modules=(\\d+)/.exec(out);\n  expect(m, `qrgen output: ${out}`).not.toBeNull();\n  return { version: Number(m[1]), modules: Number(m[2]) };\n}\n\ntest.describe('Identity code — minted by the server, read by the shipped scanner (card identity-code-and-qr)', () => {\n  // `go run` on a cold build cache and the import both sit inside one test.\n  test.setTimeout(120000);\n\n  test('[IC-01] OFFLINE, nothing seeded: the server-minted PNG shows the signup\\'s offer and the hash of its own token', async ({ page }, testInfo) => {\n    const minted = await mintFixtureCode(page, testInfo);\n    await openScanner(page);\n\n    // The token, learned ONLY by decoding the server's PNG.\n    const text = await decodePng(page, minted.pngPath);\n    const { token, descriptor } = parsePayload(text);\n    expect(token, 'a 16-character token over the unambiguous alphabet').toMatch(TOKEN_RE);\n    expect(sha256Hex(token), 'the server stored the hash of exactly the token it drew').toBe(minted.storedHash);\n    expect(descriptor, 'a first-touch signup\\'s code carries the offer').toEqual({\n      label: OFFER_TEXT,\n      campaign_id: minted.campaign.id,\n      expires_at: minted.campaign.ends_at.slice(0, 10),\n      face_value: 2,\n    });\n    // The token itself is in no column of the subscriber's row.\n    expect(psql(`SELECT count(*) FROM subscribers s WHERE to_jsonb(s)::text LIKE '%${token}%'`)).toBe('0');\n\n    await page.context().setOffline(true);\n    await scanFile(page, minted.pngPath);\n    const result = page.locator('#scan-result');\n    await expect(result).toHaveAttribute('data-kind', 'embeddedOffer');\n    await expect(result).toHaveAttribute('data-source', 'embedded');\n    await expect(result).toHaveAttribute('data-token-hash', sha256Hex(token));\n    await expect(result).toContainText(OFFER_TEXT);\n    // Display-only until the server has been asked — the crew is told so.\n    await expect(result.locator('.result-note')).toContainText('not yet verified');\n    // The raw token never lands in the DOM — only its hash.\n    expect(await result.innerHTML()).not.toContain(token);\n  });\n\n  test('[IC-02] ONLINE: the same PNG resolves the server\\'s row for that code → offerReady, source server', async ({ page }, testInfo) => {\n    const minted = await mintFixtureCode(page, testInfo);\n    await mockSyncTransports(page, minted.campaign);\n\n    // 🟡 The permitted stub. The \"server\" holds exactly the row the projection\n    // writes for this subscriber, keyed by the hash HQ stored; any other hash\n    // gets `200 []`, the way PostgREST answers.\n    const projected = {\n      id: identityCodeId(minted.subscriberId),\n      campaign_id: minted.campaign.id,\n      expires_at: minted.campaign.ends_at.replace(/Z$/, '+00:00'),\n      redeemed_at: null,\n      redeemed_by: null,\n    };\n    const lookups = [];\n    await page.route(isLookupUrl, (route) => {\n      const asked = /^eq\\.(.+)$/.exec(new URL(route.request().url()).searchParams.get('token_hash') || '');\n      lookups.push(asked ? asked[1] : null);\n      const rows = asked && asked[1] === minted.storedHash ? [projected] : [];\n      return route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify(rows) });\n    });\n\n    await page.goto('/marketing.html');\n    await page.waitForFunction(() =>\n      window.MarketingScan && window.MarketingScan.booted === true\n      && window.MarketingSubmit && window.MarketingSubmit.booted === true);\n    await page.waitForFunction(() =>\n      document.getElementById('scan-status').textContent.includes('Replica synced'));\n    await expect(page.locator('#scan-conn')).toHaveAttribute('data-conn', 'online');\n\n    const { token } = parsePayload(await decodePng(page, minted.pngPath));\n    await scanFile(page, minted.pngPath);\n    await page.waitForFunction(() =>\n      document.getElementById('scan-result').getAttribute('data-kind') !== 'checkingServer', null, { timeout: 10000 });\n\n    const result = page.locator('#scan-result');\n    await expect(result).toHaveAttribute('data-kind', 'offerReady');\n    await expect(result).toHaveAttribute('data-source', 'server');\n    await expect(result).toHaveAttribute('data-token-hash', sha256Hex(token));\n    await expect(result.locator('.offer-row').first()).toHaveAttribute('data-code-id', projected.id);\n    expect(lookups, 'the scanner asked the server about this code\\'s hash, and only that').toEqual([minted.storedHash]);\n  });\n\n  test('[IC-03] NEGATIVE control: the same payload at Medium correction (QR version 11) renders no offer', async ({ page }, testInfo) => {\n    const minted = await mintFixtureCode(page, testInfo);\n    await openScanner(page);\n    const text = await decodePng(page, minted.pngPath);\n    const { token } = parsePayload(text);\n\n    // The control must be what it claims: the SAME text, one correction level\n    // up, which costs two QR versions. The Low twin is drawn by the same tool\n    // so the comparison is like for like.\n    const mediumPath = testInfo.outputPath('identity-code-medium.png');\n    const lowPath = testInfo.outputPath('identity-code-low.png');\n    const medium = qrgen(text, mediumPath, 'M');\n    const low = qrgen(text, lowPath, 'L');\n    expect(medium.version, `the ${text.length}-char payload at Medium`).toBe(11);\n    expect(low.version, `the ${text.length}-char payload at Low — the card's encoding`).toBeLessThanOrEqual(10);\n    expect(fs.readFileSync(lowPath).equals(fs.readFileSync(minted.pngPath)),\n      'the server\\'s PNG is byte-for-byte the Low/512 drawing of its payload').toBe(true);\n\n    await page.context().setOffline(true);\n    await scanFile(page, mediumPath);\n    const got = await readResult(page);\n    console.log('IC-03 ' + JSON.stringify({ payload_len: text.length, medium, low, ...got }));\n    expect(['decodeError', 'invalidPayload'], `Medium/version-11 photo → ${got.kind}`).toContain(got.kind);\n    // Whatever the reader made of it, it never showed an offer under a hash\n    // that is not this token's.\n    if (got.hash) expect(got.hash).toBe(sha256Hex(token));\n    await expect(page.locator('#scan-result .offer-row')).toHaveCount(0);\n    await expect(page.locator('#scan-result')).not.toContainText(OFFER_TEXT);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
