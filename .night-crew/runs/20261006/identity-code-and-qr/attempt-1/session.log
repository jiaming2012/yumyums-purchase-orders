{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfjzFczWRvrGhJZ3WE6wG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GX6nMjv8kmqktvkWNF9i5K","name":"Write","input":{"file_path":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/backend/internal/marketing/identity.go","content":"package marketing\n\n// identity.go — card E1 (`identity-code-and-qr`, roadmap Activity E, run\n// 20261006). One permanent identity code per customer.\n//\n// What a customer holds is ONE QR image. Photographed at the truck:\n//\n//   - with no signal, on a tablet that has never synced this customer, the\n//     scanner shows the offer they signed up for — it is written INTO the QR;\n//   - with signal, the scanner asks the server about the code and shows the\n//     server's answer instead.\n//\n// This file mints the code, draws the image and serves it. It sends nothing:\n// delivering the image to the customer is card `mms-send-on-signup`.\n//\n// ═══════════════════════════════════════════════════════════════════════════\n// 🛑 THREE THINGS THAT LOOK IMPROVABLE AND ARE NOT\n//\n//  1. LOW ERROR CORRECTION, A 16-CHARACTER TOKEN, A DATE-ONLY EXPIRY. The\n//     shipped scanner reads a photo of the code, and what it can read is\n//     bounded by how DENSE the symbol is, not by how large the image is. The\n//     signed spike measured it: this encoding (QR version 9) reads; the same\n//     payload at Medium (version 11) does not, at any pixel size, and one\n//     larger copy decoded to a corrupted payload. \"Upgrading\" to Medium makes\n//     every customer's code unreadable. tests/marketing-identity.spec.js\n//     [IC-03] is the control. Low is acceptable because the image lives on a\n//     phone screen, never on a weathered sign.\n//\n//  2. THE RAW TOKEN IS STORED NOWHERE. It exists only inside the PNG's QR\n//     symbol. HQ keeps hex(sha256(token)) — what the scanner computes on-device\n//     and what the arbiter's `codes` table is keyed by. Nothing here logs the\n//     token, returns it, or writes it to a column.\n//\n//  3. NO FIRST-TOUCH CODE → NO OFFER. A signup that did not come through a\n//     campaign's QR gets a code that says who they are and nothing else: no\n//     `#o=` fragment, and no entitlement row is projected. Which campaign such\n//     a signup is entitled to is an OPERATOR decision (the card's PARK note);\n//     this file never guesses one.\n// ═══════════════════════════════════════════════════════════════════════════\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha1\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"net/http\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/go-chi/chi/v5\"\n\t\"github.com/jackc/pgx/v5\"\n\tqrcode \"github.com/skip2/go-qrcode\"\n)\n\n// identityAlphabet is the token alphabet: digits and lower-case letters with\n// 0, 1, i, l and o removed, so a token read aloud or retyped cannot be\n// mistaken. 31 symbols × 16 characters is a little over 79 bits.\nconst identityAlphabet = \"23456789abcdefghjkmnpqrstuvwxyz\"\n\n// identityTokenLen is fixed by the signed encoding (see the file comment).\nconst identityTokenLen = 16\n\n// identityPNGSize is the stored image's edge in pixels.\nconst identityPNGSize = 512\n\n// identityMaxQRVersion is the densest symbol the shipped reader was MEASURED\n// to read from a photo (spike 01's variant table: versions 9 and 10 read,\n// version 11 did not). A payload that would encode above it has its embedded\n// label shortened — see buildIdentityQR.\nconst identityMaxQRVersion = 10\n\n// defaultIdentityRand is the token's entropy source; identityRand is the\n// variable the mint reads, so a test can hand it a fixed stream and know the\n// token without it ever having been stored.\nvar (\n\tdefaultIdentityRand io.Reader = rand.Reader\n\tidentityRand                  = defaultIdentityRand\n)\n\n// ErrSubscriberNotFound is returned by the mint for an id that names nobody.\nvar ErrSubscriberNotFound = errors.New(\"marketing: subscriber not found\")\n\n// IdentityCode is what a mint reports. It carries no token and no payload.\ntype IdentityCode struct {\n\tSubscriberID string\n\tTokenHash    string\n\t// MediaID is the identity_media row holding the PNG — GET /m/{MediaID}.png.\n\tMediaID string\n\t// CampaignID and ExpiresAt describe the first-touch campaign the code's\n\t// entitlement comes from. Both are zero for an identity-only code.\n\tCampaignID string\n\tExpiresAt  time.Time\n\t// Minted is false when the subscriber already had a code and it was\n\t// returned unchanged.\n\tMinted bool\n}\n\n// identityDescriptor is the offer written into the QR. The four keys, and\n// their ORDER, are the ones the shipped reader's parseEmbeddedOffer reads\n// (marketing/scanner.js) — the descriptor contract is not this card's to\n// change.\ntype identityDescriptor struct {\n\tLabel      string  `json:\"label\"`\n\tCampaignID string  `json:\"campaign_id\"`\n\tExpiresAt  string  `json:\"expires_at\"`\n\tFaceValue  float64 `json:\"face_value\"`\n}\n\n// newIdentityToken draws identityTokenLen characters from identityAlphabet.\n// Bytes at or above the largest multiple of 31 are discarded rather than\n// folded, so every symbol is equally likely.\nfunc newIdentityToken(r io.Reader) (string, error) {\n\tconst n = len(identityAlphabet)\n\tlimit := byte(256 - 256%n)\n\tout := make([]byte, 0, identityTokenLen)\n\tbuf := make([]byte, 1)\n\tfor len(out) < identityTokenLen {\n\t\tif _, err := io.ReadFull(r, buf); err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"read entropy: %w\", err)\n\t\t}\n\t\tif buf[0] >= limit {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, identityAlphabet[int(buf[0])%n])\n\t}\n\treturn string(out), nil\n}\n\nfunc identityTokenHash(token string) string {\n\tsum := sha256.Sum256([]byte(token))\n\treturn hex.EncodeToString(sum[:])\n}\n\n// identityPayload is the text the QR encodes: the URL wrapping the token, plus\n// — only when there is an offer — the descriptor as base64url JSON in the\n// FRAGMENT, so a customer who opens the URL on their own phone never sends the\n// descriptor to any server.\nfunc identityPayload(baseURL, token string, d *identityDescriptor) (string, error) {\n\tpayload := strings.TrimRight(baseURL, \"/\") + \"/r/\" + token\n\tif d == nil {\n\t\treturn payload, nil\n\t}\n\traw, err := json.Marshal(d)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"marshal descriptor: %w\", err)\n\t}\n\treturn payload + \"#o=\" + base64.RawURLEncoding.EncodeToString(raw), nil\n}\n\n// buildIdentityQR draws the PNG at the signed encoding.\n//\n// A campaign with a long offer line would otherwise push the symbol past the\n// densest version the shipped reader was measured to read. When that happens\n// the LABEL written into the QR is shortened, one character at a time, to the\n// longest prefix that fits, and ends in \"…\". Nothing else gives: the token,\n// the campaign id, the expiry and the correction level are untouched, and the\n// full offer text is still what the server answers with online. An ordinary\n// offer line (\"Free side of wings\", \"$2 off any 6pc wings\") is never touched.\nfunc buildIdentityQR(baseURL, token string, d *identityDescriptor) ([]byte, error) {\n\tencode := func(desc *identityDescriptor) (*qrcode.QRCode, error) {\n\t\tpayload, err := identityPayload(baseURL, token, desc)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\treturn qrcode.New(payload, qrcode.Low)\n\t}\n\tq, err := encode(d)\n\tif d != nil {\n\t\tfull := []rune(d.Label)\n\t\tfor n := len(full) - 1; n >= 1 && (err != nil || q.VersionNumber > identityMaxQRVersion); n-- {\n\t\t\tshort := *d\n\t\t\tshort.Label = strings.TrimRight(string(full[:n]), \" \") + \"…\"\n\t\t\tq, err = encode(&short)\n\t\t}\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"encode identity qr: %w\", err)\n\t}\n\tpng, err := q.PNG(identityPNGSize)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"render identity qr: %w\", err)\n\t}\n\treturn png, nil\n}\n\n// identityBaseURL resolves the host the QR encodes the way NewDeps does, for\n// callers that hold no Deps.\nfunc identityBaseURL() string {\n\tif v := strings.TrimRight(os.Getenv(QRBaseURLEnv), \"/\"); v != \"\" {\n\t\treturn v\n\t}\n\treturn DefaultQRBaseURL\n}\n\n// MintIdentityCode gives a subscriber their one permanent identity code.\n//\n// It is IDEMPOTENT: a subscriber who already has a code gets that code back,\n// unchanged, and Minted is false. The subscriber row is locked for the mint, so\n// two concurrent calls cannot both draw a token.\n//\n// The offer written into the QR is the subscriber's FIRST-TOUCH campaign\n// (source_short → qr_codes.campaign_id → campaigns_admin). With no first-touch\n// code the payload is the bare URL and CampaignID is empty.\n//\n// It writes inside the caller's transaction and reaches no network.\nfunc MintIdentityCode(ctx context.Context, tx pgx.Tx, subscriberID string) (IdentityCode, error) {\n\treturn mintIdentityCode(ctx, tx, subscriberID, identityBaseURL())\n}\n\nfunc mintIdentityCode(ctx context.Context, tx pgx.Tx, subscriberID, baseURL string) (IdentityCode, error) {\n\tvar (\n\t\texisting   *string\n\t\tcampaignID *string\n\t\tofferText  *string\n\t\tfaceCents  *int\n\t\tendsAt     *time.Time\n\t)\n\terr := tx.QueryRow(ctx, `\n\t\tSELECT s.identity_token_hash, c.id::text, c.offer_text, c.face_value_cents, c.ends_at\n\t\t  FROM subscribers s\n\t\t  LEFT JOIN qr_codes k ON k.short = s.source_short\n\t\t  LEFT JOIN campaigns_admin c ON c.id = k.campaign_id\n\t\t WHERE s.id = $1\n\t\t   FOR UPDATE OF s`, subscriberID).\n\t\tScan(&existing, &campaignID, &offerText, &faceCents, &endsAt)\n\tif errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {\n\t\treturn IdentityCode{}, ErrSubscriberNotFound\n\t}\n\tif err != nil {\n\t\treturn IdentityCode{}, fmt.Errorf(\"load subscriber for mint: %w\", err)\n\t}\n\n\tcode := IdentityCode{SubscriberID: subscriberID}\n\tvar desc *identityDescriptor\n\tif campaignID != nil {\n\t\tcode.CampaignID = *campaignID\n\t\tcode.ExpiresAt = *endsAt\n\t\tdesc = &identityDescriptor{\n\t\t\tLabel:      *offerText,\n\t\t\tCampaignID: *campaignID,\n\t\t\t// Date-only, in UTC: the reader parses a bare date as UTC midnight,\n\t\t\t// so the offline display never outlives the campaign's real end.\n\t\t\tExpiresAt: endsAt.UTC().Format(\"2006-01-02\"),\n\t\t\tFaceValue: float64(*faceCents) / 100.0,\n\t\t}\n\t}\n\n\tif existing != nil {\n\t\tcode.TokenHash = *existing\n\t\tif err := tx.QueryRow(ctx, `\n\t\t\tSELECT id::text FROM identity_media\n\t\t\t WHERE subscriber_id = $1 ORDER BY created_at DESC, id LIMIT 1`, subscriberID).\n\t\t\tScan(&code.MediaID); err != nil {\n\t\t\treturn IdentityCode{}, fmt.Errorf(\"load identity media: %w\", err)\n\t\t}\n\t\treturn code, nil\n\t}\n\n\ttoken, err := newIdentityToken(identityRand)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tpng, err := buildIdentityQR(baseURL, token, desc)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tcode.TokenHash = identityTokenHash(token)\n\tif _, err := tx.Exec(ctx, `\n\t\tUPDATE subscribers SET identity_token_hash = $2, identity_minted_at = now()\n\t\t WHERE id = $1`, subscriberID, code.TokenHash); err != nil {\n\t\treturn IdentityCode{}, fmt.Errorf(\"store identity hash: %w\", err)\n\t}\n\tif err := tx.QueryRow(ctx, `\n\t\tINSERT INTO identity_media (subscriber_id, png) VALUES ($1, $2)\n\t\tRETURNING id::text`, subscriberID, png).Scan(&code.MediaID); err != nil {\n\t\treturn IdentityCode{}, fmt.Errorf(\"store identity media: %w\", err)\n\t}\n\tcode.Minted = true\n\treturn code, nil\n}\n\n// identityCodeNamespace is RFC 4122's URL namespace.\nvar identityCodeNamespace = [16]byte{\n\t0x6b, 0xa7, 0xb8, 0x11, 0x9d, 0xad, 0x11, 0xd1,\n\t0x80, 0xb4, 0x00, 0xc0, 0x4f, 0xd4, 0x30, 0xc8,\n}\n\n// IdentityCodeID is the arbiter row's id for a subscriber's identity code: a\n// version-5 uuid over a URL naming the subscriber. It is derived, not drawn,\n// so projecting the same subscriber twice writes the same row.\n//\n// tests/marketing-identity.spec.js derives it the same way; change both or\n// neither. Changing it at all orphans every row already projected.\nfunc IdentityCodeID(subscriberID string) string {\n\th := sha1.New()\n\th.Write(identityCodeNamespace[:])\n\th.Write([]byte(DefaultQRBaseURL + \"/identity-code/\" + strings.ToLower(subscriberID)))\n\tu := h.Sum(nil)[:16]\n\tu[6] = (u[6] & 0x0f) | 0x50 // version 5\n\tu[8] = (u[8] & 0x3f) | 0x80 // RFC 4122 variant\n\tx := hex.EncodeToString(u)\n\treturn x[0:8] + \"-\" + x[8:12] + \"-\" + x[12:16] + \"-\" + x[16:20] + \"-\" + x[20:]\n}\n\n// WarningIdentityNotMinted is reported by an import when a new subscriber was\n// saved but their code could not be minted. The subscriber is kept.\nconst WarningIdentityNotMinted = \"identity_not_minted\"\n\n// mintForNewSubscribers runs after an import's transaction has committed: one\n// short transaction per new subscriber, then — for a code that carries an\n// offer — the projection to the arbiter.\n//\n// Nothing here can undo the import or a mint. A projection that is\n// unconfigured or failing leaves the code minted and adds \"not_projected\" to\n// the returned warnings (decision 187's shape); after the first failure the\n// rest of this import's projections are skipped rather than each waiting out\n// a dead substrate inside one manager's request.\nfunc mintForNewSubscribers(ctx context.Context, d Deps, subscriberIDs []string) []string {\n\tvar notMinted, notProjected bool\n\tprojectionDown := !d.Projection.Configured()\n\tfor _, id := range subscriberIDs {\n\t\tcode, err := mintOne(ctx, d, id)\n\t\tif err != nil {\n\t\t\tslog.Error(\"marketing: identity code not minted; the subscriber is saved without one\",\n\t\t\t\t\"error\", err, \"subscriber_id\", id)\n\t\t\tnotMinted = true\n\t\t\tcontinue\n\t\t}\n\t\tif code.CampaignID == \"\" {\n\t\t\tcontinue // identity-only: there is no entitlement to project\n\t\t}\n\t\tif projectionDown {\n\t\t\tnotProjected = true\n\t\t\tcontinue\n\t\t}\n\t\tif err := ProjectIdentityCode(ctx, d.Projection, IdentityProjectionRow{\n\t\t\tID:         IdentityCodeID(id),\n\t\t\tTokenHash:  code.TokenHash,\n\t\t\tCampaignID: code.CampaignID,\n\t\t\tExpiresAt:  code.ExpiresAt,\n\t\t}); err != nil {\n\t\t\tslog.Error(\"marketing: identity code projection failed; the code is minted but the arbiter does not know it\",\n\t\t\t\t\"error\", err, \"subscriber_id\", id)\n\t\t\tnotProjected = true\n\t\t\tprojectionDown = true\n\t\t}\n\t}\n\tvar warnings []string\n\tif notProjected {\n\t\twarnings = append(warnings, WarningNotProjected)\n\t}\n\tif notMinted {\n\t\twarnings = append(warnings, WarningIdentityNotMinted)\n\t}\n\treturn warnings\n}\n\nfunc mintOne(ctx context.Context, d Deps, subscriberID string) (IdentityCode, error) {\n\ttx, err := d.Pool.Begin(ctx)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tdefer func() { _ = tx.Rollback(ctx) }()\n\tcode, err := mintIdentityCode(ctx, tx, subscriberID, d.QRBaseURL)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tif err := tx.Commit(ctx); err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\treturn code, nil\n}\n\n// identityMediaPath is the public path of a stored identity image.\nfunc identityMediaPath(mediaID string) string {\n\treturn \"/m/\" + mediaID + \".png\"\n}\n\n// IdentityMediaHandler serves GET and HEAD /m/{id}.png: a subscriber's\n// identity-code image.\n//\n// It is PUBLIC — mounted by MountPublic, outside every gate — because the two\n// things that fetch it hold no HQ session: the customer's phone, and the\n// carrier collecting an MMS attachment. The media id is a random uuid and is\n// the route's only secret, so an unknown id and a malformed id are the same\n// 404.\n//\n// Cache-Control is PRIVATE: the image identifies one person and must not sit\n// in a shared cache.\nfunc IdentityMediaHandler(d Deps) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tid := chi.URLParam(r, \"id\")\n\t\tvar png []byte\n\t\terr := d.Pool.QueryRow(r.Context(),\n\t\t\t`SELECT png FROM identity_media WHERE id = $1`, id).Scan(&png)\n\t\tif errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {\n\t\t\twriteError(w, http.StatusNotFound, \"not_found\")\n\t\t\treturn\n\t\t}\n\t\tif err != nil {\n\t\t\tslog.Error(\"marketing: load identity media\", \"error\", err)\n\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\")\n\t\t\treturn\n\t\t}\n\t\tw.Header().Set(\"Content-Type\", \"image/png\")\n\t\tw.Header().Set(\"Cache-Control\", \"private, max-age=3600\")\n\t\tw.Header().Set(\"Content-Length\", strconv.Itoa(len(png)))\n\t\tw.WriteHeader(http.StatusOK)\n\t\tif r.Method != http.MethodHead {\n\t\t\t_, _ = w.Write(png)\n\t\t}\n\t}\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1482,"cache_read_input_tokens":237792,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1482},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"792dcbd6-aa1d-4c6e-83da-0e3997c4c9b1","uuid":"b2727c9a-0a4c-4077-b3a9-d2f0f2ede821","timestamp":"2026-10-05T23:52:13.403Z","request_id":"req_011CfjzFc7B8c2YmNRRZtQim","wire_tool_inputs":{"toolu_01GX6nMjv8kmqktvkWNF9i5K":{"file_path":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/backend/internal/marketing/identity.go","content":"package marketing\n\n// identity.go — card E1 (`identity-code-and-qr`, roadmap Activity E, run\n// 20261006). One permanent identity code per customer.\n//\n// What a customer holds is ONE QR image. Photographed at the truck:\n//\n//   - with no signal, on a tablet that has never synced this customer, the\n//     scanner shows the offer they signed up for — it is written INTO the QR;\n//   - with signal, the scanner asks the server about the code and shows the\n//     server's answer instead.\n//\n// This file mints the code, draws the image and serves it. It sends nothing:\n// delivering the image to the customer is card `mms-send-on-signup`.\n//\n// ═══════════════════════════════════════════════════════════════════════════\n// 🛑 THREE THINGS THAT LOOK IMPROVABLE AND ARE NOT\n//\n//  1. LOW ERROR CORRECTION, A 16-CHARACTER TOKEN, A DATE-ONLY EXPIRY. The\n//     shipped scanner reads a photo of the code, and what it can read is\n//     bounded by how DENSE the symbol is, not by how large the image is. The\n//     signed spike measured it: this encoding (QR version 9) reads; the same\n//     payload at Medium (version 11) does not, at any pixel size, and one\n//     larger copy decoded to a corrupted payload. \"Upgrading\" to Medium makes\n//     every customer's code unreadable. tests/marketing-identity.spec.js\n//     [IC-03] is the control. Low is acceptable because the image lives on a\n//     phone screen, never on a weathered sign.\n//\n//  2. THE RAW TOKEN IS STORED NOWHERE. It exists only inside the PNG's QR\n//     symbol. HQ keeps hex(sha256(token)) — what the scanner computes on-device\n//     and what the arbiter's `codes` table is keyed by. Nothing here logs the\n//     token, returns it, or writes it to a column.\n//\n//  3. NO FIRST-TOUCH CODE → NO OFFER. A signup that did not come through a\n//     campaign's QR gets a code that says who they are and nothing else: no\n//     `#o=` fragment, and no entitlement row is projected. Which campaign such\n//     a signup is entitled to is an OPERATOR decision (the card's PARK note);\n//     this file never guesses one.\n// ═══════════════════════════════════════════════════════════════════════════\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha1\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"net/http\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/go-chi/chi/v5\"\n\t\"github.com/jackc/pgx/v5\"\n\tqrcode \"github.com/skip2/go-qrcode\"\n)\n\n// identityAlphabet is the token alphabet: digits and lower-case letters with\n// 0, 1, i, l and o removed, so a token read aloud or retyped cannot be\n// mistaken. 31 symbols × 16 characters is a little over 79 bits.\nconst identityAlphabet = \"23456789abcdefghjkmnpqrstuvwxyz\"\n\n// identityTokenLen is fixed by the signed encoding (see the file comment).\nconst identityTokenLen = 16\n\n// identityPNGSize is the stored image's edge in pixels.\nconst identityPNGSize = 512\n\n// identityMaxQRVersion is the densest symbol the shipped reader was MEASURED\n// to read from a photo (spike 01's variant table: versions 9 and 10 read,\n// version 11 did not). A payload that would encode above it has its embedded\n// label shortened — see buildIdentityQR.\nconst identityMaxQRVersion = 10\n\n// defaultIdentityRand is the token's entropy source; identityRand is the\n// variable the mint reads, so a test can hand it a fixed stream and know the\n// token without it ever having been stored.\nvar (\n\tdefaultIdentityRand io.Reader = rand.Reader\n\tidentityRand                  = defaultIdentityRand\n)\n\n// ErrSubscriberNotFound is returned by the mint for an id that names nobody.\nvar ErrSubscriberNotFound = errors.New(\"marketing: subscriber not found\")\n\n// IdentityCode is what a mint reports. It carries no token and no payload.\ntype IdentityCode struct {\n\tSubscriberID string\n\tTokenHash    string\n\t// MediaID is the identity_media row holding the PNG — GET /m/{MediaID}.png.\n\tMediaID string\n\t// CampaignID and ExpiresAt describe the first-touch campaign the code's\n\t// entitlement comes from. Both are zero for an identity-only code.\n\tCampaignID string\n\tExpiresAt  time.Time\n\t// Minted is false when the subscriber already had a code and it was\n\t// returned unchanged.\n\tMinted bool\n}\n\n// identityDescriptor is the offer written into the QR. The four keys, and\n// their ORDER, are the ones the shipped reader's parseEmbeddedOffer reads\n// (marketing/scanner.js) — the descriptor contract is not this card's to\n// change.\ntype identityDescriptor struct {\n\tLabel      string  `json:\"label\"`\n\tCampaignID string  `json:\"campaign_id\"`\n\tExpiresAt  string  `json:\"expires_at\"`\n\tFaceValue  float64 `json:\"face_value\"`\n}\n\n// newIdentityToken draws identityTokenLen characters from identityAlphabet.\n// Bytes at or above the largest multiple of 31 are discarded rather than\n// folded, so every symbol is equally likely.\nfunc newIdentityToken(r io.Reader) (string, error) {\n\tconst n = len(identityAlphabet)\n\tlimit := byte(256 - 256%n)\n\tout := make([]byte, 0, identityTokenLen)\n\tbuf := make([]byte, 1)\n\tfor len(out) < identityTokenLen {\n\t\tif _, err := io.ReadFull(r, buf); err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"read entropy: %w\", err)\n\t\t}\n\t\tif buf[0] >= limit {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, identityAlphabet[int(buf[0])%n])\n\t}\n\treturn string(out), nil\n}\n\nfunc identityTokenHash(token string) string {\n\tsum := sha256.Sum256([]byte(token))\n\treturn hex.EncodeToString(sum[:])\n}\n\n// identityPayload is the text the QR encodes: the URL wrapping the token, plus\n// — only when there is an offer — the descriptor as base64url JSON in the\n// FRAGMENT, so a customer who opens the URL on their own phone never sends the\n// descriptor to any server.\nfunc identityPayload(baseURL, token string, d *identityDescriptor) (string, error) {\n\tpayload := strings.TrimRight(baseURL, \"/\") + \"/r/\" + token\n\tif d == nil {\n\t\treturn payload, nil\n\t}\n\traw, err := json.Marshal(d)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"marshal descriptor: %w\", err)\n\t}\n\treturn payload + \"#o=\" + base64.RawURLEncoding.EncodeToString(raw), nil\n}\n\n// buildIdentityQR draws the PNG at the signed encoding.\n//\n// A campaign with a long offer line would otherwise push the symbol past the\n// densest version the shipped reader was measured to read. When that happens\n// the LABEL written into the QR is shortened, one character at a time, to the\n// longest prefix that fits, and ends in \"…\". Nothing else gives: the token,\n// the campaign id, the expiry and the correction level are untouched, and the\n// full offer text is still what the server answers with online. An ordinary\n// offer line (\"Free side of wings\", \"$2 off any 6pc wings\") is never touched.\nfunc buildIdentityQR(baseURL, token string, d *identityDescriptor) ([]byte, error) {\n\tencode := func(desc *identityDescriptor) (*qrcode.QRCode, error) {\n\t\tpayload, err := identityPayload(baseURL, token, desc)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\treturn qrcode.New(payload, qrcode.Low)\n\t}\n\tq, err := encode(d)\n\tif d != nil {\n\t\tfull := []rune(d.Label)\n\t\tfor n := len(full) - 1; n >= 1 && (err != nil || q.VersionNumber > identityMaxQRVersion); n-- {\n\t\t\tshort := *d\n\t\t\tshort.Label = strings.TrimRight(string(full[:n]), \" \") + \"…\"\n\t\t\tq, err = encode(&short)\n\t\t}\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"encode identity qr: %w\", err)\n\t}\n\tpng, err := q.PNG(identityPNGSize)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"render identity qr: %w\", err)\n\t}\n\treturn png, nil\n}\n\n// identityBaseURL resolves the host the QR encodes the way NewDeps does, for\n// callers that hold no Deps.\nfunc identityBaseURL() string {\n\tif v := strings.TrimRight(os.Getenv(QRBaseURLEnv), \"/\"); v != \"\" {\n\t\treturn v\n\t}\n\treturn DefaultQRBaseURL\n}\n\n// MintIdentityCode gives a subscriber their one permanent identity code.\n//\n// It is IDEMPOTENT: a subscriber who already has a code gets that code back,\n// unchanged, and Minted is false. The subscriber row is locked for the mint, so\n// two concurrent calls cannot both draw a token.\n//\n// The offer written into the QR is the subscriber's FIRST-TOUCH campaign\n// (source_short → qr_codes.campaign_id → campaigns_admin). With no first-touch\n// code the payload is the bare URL and CampaignID is empty.\n//\n// It writes inside the caller's transaction and reaches no network.\nfunc MintIdentityCode(ctx context.Context, tx pgx.Tx, subscriberID string) (IdentityCode, error) {\n\treturn mintIdentityCode(ctx, tx, subscriberID, identityBaseURL())\n}\n\nfunc mintIdentityCode(ctx context.Context, tx pgx.Tx, subscriberID, baseURL string) (IdentityCode, error) {\n\tvar (\n\t\texisting   *string\n\t\tcampaignID *string\n\t\tofferText  *string\n\t\tfaceCents  *int\n\t\tendsAt     *time.Time\n\t)\n\terr := tx.QueryRow(ctx, `\n\t\tSELECT s.identity_token_hash, c.id::text, c.offer_text, c.face_value_cents, c.ends_at\n\t\t  FROM subscribers s\n\t\t  LEFT JOIN qr_codes k ON k.short = s.source_short\n\t\t  LEFT JOIN campaigns_admin c ON c.id = k.campaign_id\n\t\t WHERE s.id = $1\n\t\t   FOR UPDATE OF s`, subscriberID).\n\t\tScan(&existing, &campaignID, &offerText, &faceCents, &endsAt)\n\tif errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {\n\t\treturn IdentityCode{}, ErrSubscriberNotFound\n\t}\n\tif err != nil {\n\t\treturn IdentityCode{}, fmt.Errorf(\"load subscriber for mint: %w\", err)\n\t}\n\n\tcode := IdentityCode{SubscriberID: subscriberID}\n\tvar desc *identityDescriptor\n\tif campaignID != nil {\n\t\tcode.CampaignID = *campaignID\n\t\tcode.ExpiresAt = *endsAt\n\t\tdesc = &identityDescriptor{\n\t\t\tLabel:      *offerText,\n\t\t\tCampaignID: *campaignID,\n\t\t\t// Date-only, in UTC: the reader parses a bare date as UTC midnight,\n\t\t\t// so the offline display never outlives the campaign's real end.\n\t\t\tExpiresAt: endsAt.UTC().Format(\"2006-01-02\"),\n\t\t\tFaceValue: float64(*faceCents) / 100.0,\n\t\t}\n\t}\n\n\tif existing != nil {\n\t\tcode.TokenHash = *existing\n\t\tif err := tx.QueryRow(ctx, `\n\t\t\tSELECT id::text FROM identity_media\n\t\t\t WHERE subscriber_id = $1 ORDER BY created_at DESC, id LIMIT 1`, subscriberID).\n\t\t\tScan(&code.MediaID); err != nil {\n\t\t\treturn IdentityCode{}, fmt.Errorf(\"load identity media: %w\", err)\n\t\t}\n\t\treturn code, nil\n\t}\n\n\ttoken, err := newIdentityToken(identityRand)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tpng, err := buildIdentityQR(baseURL, token, desc)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tcode.TokenHash = identityTokenHash(token)\n\tif _, err := tx.Exec(ctx, `\n\t\tUPDATE subscribers SET identity_token_hash = $2, identity_minted_at = now()\n\t\t WHERE id = $1`, subscriberID, code.TokenHash); err != nil {\n\t\treturn IdentityCode{}, fmt.Errorf(\"store identity hash: %w\", err)\n\t}\n\tif err := tx.QueryRow(ctx, `\n\t\tINSERT INTO identity_media (subscriber_id, png) VALUES ($1, $2)\n\t\tRETURNING id::text`, subscriberID, png).Scan(&code.MediaID); err != nil {\n\t\treturn IdentityCode{}, fmt.Errorf(\"store identity media: %w\", err)\n\t}\n\tcode.Minted = true\n\treturn code, nil\n}\n\n// identityCodeNamespace is RFC 4122's URL namespace.\nvar identityCodeNamespace = [16]byte{\n\t0x6b, 0xa7, 0xb8, 0x11, 0x9d, 0xad, 0x11, 0xd1,\n\t0x80, 0xb4, 0x00, 0xc0, 0x4f, 0xd4, 0x30, 0xc8,\n}\n\n// IdentityCodeID is the arbiter row's id for a subscriber's identity code: a\n// version-5 uuid over a URL naming the subscriber. It is derived, not drawn,\n// so projecting the same subscriber twice writes the same row.\n//\n// tests/marketing-identity.spec.js derives it the same way; change both or\n// neither. Changing it at all orphans every row already projected.\nfunc IdentityCodeID(subscriberID string) string {\n\th := sha1.New()\n\th.Write(identityCodeNamespace[:])\n\th.Write([]byte(DefaultQRBaseURL + \"/identity-code/\" + strings.ToLower(subscriberID)))\n\tu := h.Sum(nil)[:16]\n\tu[6] = (u[6] & 0x0f) | 0x50 // version 5\n\tu[8] = (u[8] & 0x3f) | 0x80 // RFC 4122 variant\n\tx := hex.EncodeToString(u)\n\treturn x[0:8] + \"-\" + x[8:12] + \"-\" + x[12:16] + \"-\" + x[16:20] + \"-\" + x[20:]\n}\n\n// WarningIdentityNotMinted is reported by an import when a new subscriber was\n// saved but their code could not be minted. The subscriber is kept.\nconst WarningIdentityNotMinted = \"identity_not_minted\"\n\n// mintForNewSubscribers runs after an import's transaction has committed: one\n// short transaction per new subscriber, then — for a code that carries an\n// offer — the projection to the arbiter.\n//\n// Nothing here can undo the import or a mint. A projection that is\n// unconfigured or failing leaves the code minted and adds \"not_projected\" to\n// the returned warnings (decision 187's shape); after the first failure the\n// rest of this import's projections are skipped rather than each waiting out\n// a dead substrate inside one manager's request.\nfunc mintForNewSubscribers(ctx context.Context, d Deps, subscriberIDs []string) []string {\n\tvar notMinted, notProjected bool\n\tprojectionDown := !d.Projection.Configured()\n\tfor _, id := range subscriberIDs {\n\t\tcode, err := mintOne(ctx, d, id)\n\t\tif err != nil {\n\t\t\tslog.Error(\"marketing: identity code not minted; the subscriber is saved without one\",\n\t\t\t\t\"error\", err, \"subscriber_id\", id)\n\t\t\tnotMinted = true\n\t\t\tcontinue\n\t\t}\n\t\tif code.CampaignID == \"\" {\n\t\t\tcontinue // identity-only: there is no entitlement to project\n\t\t}\n\t\tif projectionDown {\n\t\t\tnotProjected = true\n\t\t\tcontinue\n\t\t}\n\t\tif err := ProjectIdentityCode(ctx, d.Projection, IdentityProjectionRow{\n\t\t\tID:         IdentityCodeID(id),\n\t\t\tTokenHash:  code.TokenHash,\n\t\t\tCampaignID: code.CampaignID,\n\t\t\tExpiresAt:  code.ExpiresAt,\n\t\t}); err != nil {\n\t\t\tslog.Error(\"marketing: identity code projection failed; the code is minted but the arbiter does not know it\",\n\t\t\t\t\"error\", err, \"subscriber_id\", id)\n\t\t\tnotProjected = true\n\t\t\tprojectionDown = true\n\t\t}\n\t}\n\tvar warnings []string\n\tif notProjected {\n\t\twarnings = append(warnings, WarningNotProjected)\n\t}\n\tif notMinted {\n\t\twarnings = append(warnings, WarningIdentityNotMinted)\n\t}\n\treturn warnings\n}\n\nfunc mintOne(ctx context.Context, d Deps, subscriberID string) (IdentityCode, error) {\n\ttx, err := d.Pool.Begin(ctx)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tdefer func() { _ = tx.Rollback(ctx) }()\n\tcode, err := mintIdentityCode(ctx, tx, subscriberID, d.QRBaseURL)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tif err := tx.Commit(ctx); err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\treturn code, nil\n}\n\n// identityMediaPath is the public path of a stored identity image.\nfunc identityMediaPath(mediaID string) string {\n\treturn \"/m/\" + mediaID + \".png\"\n}\n\n// IdentityMediaHandler serves GET and HEAD /m/{id}.png: a subscriber's\n// identity-code image.\n//\n// It is PUBLIC — mounted by MountPublic, outside every gate — because the two\n// things that fetch it hold no HQ session: the customer's phone, and the\n// carrier collecting an MMS attachment. The media id is a random uuid and is\n// the route's only secret, so an unknown id and a malformed id are the same\n// 404.\n//\n// Cache-Control is PRIVATE: the image identifies one person and must not sit\n// in a shared cache.\nfunc IdentityMediaHandler(d Deps) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tid := chi.URLParam(r, \"id\")\n\t\tvar png []byte\n\t\terr := d.Pool.QueryRow(r.Context(),\n\t\t\t`SELECT png FROM identity_media WHERE id = $1`, id).Scan(&png)\n\t\tif errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {\n\t\t\twriteError(w, http.StatusNotFound, \"not_found\")\n\t\t\treturn\n\t\t}\n\t\tif err != nil {\n\t\t\tslog.Error(\"marketing: load identity media\", \"error\", err)\n\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\")\n\t\t\treturn\n\t\t}\n\t\tw.Header().Set(\"Content-Type\", \"image/png\")\n\t\tw.Header().Set(\"Cache-Control\", \"private, max-age=3600\")\n\t\tw.Header().Set(\"Content-Length\", strconv.Itoa(len(png)))\n\t\tw.WriteHeader(http.StatusOK)\n\t\tif r.Method != http.MethodHead {\n\t\t\t_, _ = w.Write(png)\n\t\t}\n\t}\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GX6nMjv8kmqktvkWNF9i5K","type":"tool_result","content":"File created successfully at: /home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/backend/internal/marketing/identity.go (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"792dcbd6-aa1d-4c6e-83da-0e3997c4c9b1","uuid":"5c9e014e-307c-45e5-8a91-6af2276ddc74","timestamp":"2026-10-05T23:52:13.805Z","tool_use_result":{"type":"create","filePath":"/home/jcole/projects/hq/.night-crew/runs/20261006/worktrees/identity-code-and-qr/backend/internal/marketing/identity.go","content":"package marketing\n\n// identity.go — card E1 (`identity-code-and-qr`, roadmap Activity E, run\n// 20261006). One permanent identity code per customer.\n//\n// What a customer holds is ONE QR image. Photographed at the truck:\n//\n//   - with no signal, on a tablet that has never synced this customer, the\n//     scanner shows the offer they signed up for — it is written INTO the QR;\n//   - with signal, the scanner asks the server about the code and shows the\n//     server's answer instead.\n//\n// This file mints the code, draws the image and serves it. It sends nothing:\n// delivering the image to the customer is card `mms-send-on-signup`.\n//\n// ═══════════════════════════════════════════════════════════════════════════\n// 🛑 THREE THINGS THAT LOOK IMPROVABLE AND ARE NOT\n//\n//  1. LOW ERROR CORRECTION, A 16-CHARACTER TOKEN, A DATE-ONLY EXPIRY. The\n//     shipped scanner reads a photo of the code, and what it can read is\n//     bounded by how DENSE the symbol is, not by how large the image is. The\n//     signed spike measured it: this encoding (QR version 9) reads; the same\n//     payload at Medium (version 11) does not, at any pixel size, and one\n//     larger copy decoded to a corrupted payload. \"Upgrading\" to Medium makes\n//     every customer's code unreadable. tests/marketing-identity.spec.js\n//     [IC-03] is the control. Low is acceptable because the image lives on a\n//     phone screen, never on a weathered sign.\n//\n//  2. THE RAW TOKEN IS STORED NOWHERE. It exists only inside the PNG's QR\n//     symbol. HQ keeps hex(sha256(token)) — what the scanner computes on-device\n//     and what the arbiter's `codes` table is keyed by. Nothing here logs the\n//     token, returns it, or writes it to a column.\n//\n//  3. NO FIRST-TOUCH CODE → NO OFFER. A signup that did not come through a\n//     campaign's QR gets a code that says who they are and nothing else: no\n//     `#o=` fragment, and no entitlement row is projected. Which campaign such\n//     a signup is entitled to is an OPERATOR decision (the card's PARK note);\n//     this file never guesses one.\n// ═══════════════════════════════════════════════════════════════════════════\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha1\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"net/http\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/go-chi/chi/v5\"\n\t\"github.com/jackc/pgx/v5\"\n\tqrcode \"github.com/skip2/go-qrcode\"\n)\n\n// identityAlphabet is the token alphabet: digits and lower-case letters with\n// 0, 1, i, l and o removed, so a token read aloud or retyped cannot be\n// mistaken. 31 symbols × 16 characters is a little over 79 bits.\nconst identityAlphabet = \"23456789abcdefghjkmnpqrstuvwxyz\"\n\n// identityTokenLen is fixed by the signed encoding (see the file comment).\nconst identityTokenLen = 16\n\n// identityPNGSize is the stored image's edge in pixels.\nconst identityPNGSize = 512\n\n// identityMaxQRVersion is the densest symbol the shipped reader was MEASURED\n// to read from a photo (spike 01's variant table: versions 9 and 10 read,\n// version 11 did not). A payload that would encode above it has its embedded\n// label shortened — see buildIdentityQR.\nconst identityMaxQRVersion = 10\n\n// defaultIdentityRand is the token's entropy source; identityRand is the\n// variable the mint reads, so a test can hand it a fixed stream and know the\n// token without it ever having been stored.\nvar (\n\tdefaultIdentityRand io.Reader = rand.Reader\n\tidentityRand                  = defaultIdentityRand\n)\n\n// ErrSubscriberNotFound is returned by the mint for an id that names nobody.\nvar ErrSubscriberNotFound = errors.New(\"marketing: subscriber not found\")\n\n// IdentityCode is what a mint reports. It carries no token and no payload.\ntype IdentityCode struct {\n\tSubscriberID string\n\tTokenHash    string\n\t// MediaID is the identity_media row holding the PNG — GET /m/{MediaID}.png.\n\tMediaID string\n\t// CampaignID and ExpiresAt describe the first-touch campaign the code's\n\t// entitlement comes from. Both are zero for an identity-only code.\n\tCampaignID string\n\tExpiresAt  time.Time\n\t// Minted is false when the subscriber already had a code and it was\n\t// returned unchanged.\n\tMinted bool\n}\n\n// identityDescriptor is the offer written into the QR. The four keys, and\n// their ORDER, are the ones the shipped reader's parseEmbeddedOffer reads\n// (marketing/scanner.js) — the descriptor contract is not this card's to\n// change.\ntype identityDescriptor struct {\n\tLabel      string  `json:\"label\"`\n\tCampaignID string  `json:\"campaign_id\"`\n\tExpiresAt  string  `json:\"expires_at\"`\n\tFaceValue  float64 `json:\"face_value\"`\n}\n\n// newIdentityToken draws identityTokenLen characters from identityAlphabet.\n// Bytes at or above the largest multiple of 31 are discarded rather than\n// folded, so every symbol is equally likely.\nfunc newIdentityToken(r io.Reader) (string, error) {\n\tconst n = len(identityAlphabet)\n\tlimit := byte(256 - 256%n)\n\tout := make([]byte, 0, identityTokenLen)\n\tbuf := make([]byte, 1)\n\tfor len(out) < identityTokenLen {\n\t\tif _, err := io.ReadFull(r, buf); err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"read entropy: %w\", err)\n\t\t}\n\t\tif buf[0] >= limit {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, identityAlphabet[int(buf[0])%n])\n\t}\n\treturn string(out), nil\n}\n\nfunc identityTokenHash(token string) string {\n\tsum := sha256.Sum256([]byte(token))\n\treturn hex.EncodeToString(sum[:])\n}\n\n// identityPayload is the text the QR encodes: the URL wrapping the token, plus\n// — only when there is an offer — the descriptor as base64url JSON in the\n// FRAGMENT, so a customer who opens the URL on their own phone never sends the\n// descriptor to any server.\nfunc identityPayload(baseURL, token string, d *identityDescriptor) (string, error) {\n\tpayload := strings.TrimRight(baseURL, \"/\") + \"/r/\" + token\n\tif d == nil {\n\t\treturn payload, nil\n\t}\n\traw, err := json.Marshal(d)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"marshal descriptor: %w\", err)\n\t}\n\treturn payload + \"#o=\" + base64.RawURLEncoding.EncodeToString(raw), nil\n}\n\n// buildIdentityQR draws the PNG at the signed encoding.\n//\n// A campaign with a long offer line would otherwise push the symbol past the\n// densest version the shipped reader was measured to read. When that happens\n// the LABEL written into the QR is shortened, one character at a time, to the\n// longest prefix that fits, and ends in \"…\". Nothing else gives: the token,\n// the campaign id, the expiry and the correction level are untouched, and the\n// full offer text is still what the server answers with online. An ordinary\n// offer line (\"Free side of wings\", \"$2 off any 6pc wings\") is never touched.\nfunc buildIdentityQR(baseURL, token string, d *identityDescriptor) ([]byte, error) {\n\tencode := func(desc *identityDescriptor) (*qrcode.QRCode, error) {\n\t\tpayload, err := identityPayload(baseURL, token, desc)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\treturn qrcode.New(payload, qrcode.Low)\n\t}\n\tq, err := encode(d)\n\tif d != nil {\n\t\tfull := []rune(d.Label)\n\t\tfor n := len(full) - 1; n >= 1 && (err != nil || q.VersionNumber > identityMaxQRVersion); n-- {\n\t\t\tshort := *d\n\t\t\tshort.Label = strings.TrimRight(string(full[:n]), \" \") + \"…\"\n\t\t\tq, err = encode(&short)\n\t\t}\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"encode identity qr: %w\", err)\n\t}\n\tpng, err := q.PNG(identityPNGSize)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"render identity qr: %w\", err)\n\t}\n\treturn png, nil\n}\n\n// identityBaseURL resolves the host the QR encodes the way NewDeps does, for\n// callers that hold no Deps.\nfunc identityBaseURL() string {\n\tif v := strings.TrimRight(os.Getenv(QRBaseURLEnv), \"/\"); v != \"\" {\n\t\treturn v\n\t}\n\treturn DefaultQRBaseURL\n}\n\n// MintIdentityCode gives a subscriber their one permanent identity code.\n//\n// It is IDEMPOTENT: a subscriber who already has a code gets that code back,\n// unchanged, and Minted is false. The subscriber row is locked for the mint, so\n// two concurrent calls cannot both draw a token.\n//\n// The offer written into the QR is the subscriber's FIRST-TOUCH campaign\n// (source_short → qr_codes.campaign_id → campaigns_admin). With no first-touch\n// code the payload is the bare URL and CampaignID is empty.\n//\n// It writes inside the caller's transaction and reaches no network.\nfunc MintIdentityCode(ctx context.Context, tx pgx.Tx, subscriberID string) (IdentityCode, error) {\n\treturn mintIdentityCode(ctx, tx, subscriberID, identityBaseURL())\n}\n\nfunc mintIdentityCode(ctx context.Context, tx pgx.Tx, subscriberID, baseURL string) (IdentityCode, error) {\n\tvar (\n\t\texisting   *string\n\t\tcampaignID *string\n\t\tofferText  *string\n\t\tfaceCents  *int\n\t\tendsAt     *time.Time\n\t)\n\terr := tx.QueryRow(ctx, `\n\t\tSELECT s.identity_token_hash, c.id::text, c.offer_text, c.face_value_cents, c.ends_at\n\t\t  FROM subscribers s\n\t\t  LEFT JOIN qr_codes k ON k.short = s.source_short\n\t\t  LEFT JOIN campaigns_admin c ON c.id = k.campaign_id\n\t\t WHERE s.id = $1\n\t\t   FOR UPDATE OF s`, subscriberID).\n\t\tScan(&existing, &campaignID, &offerText, &faceCents, &endsAt)\n\tif errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {\n\t\treturn IdentityCode{}, ErrSubscriberNotFound\n\t}\n\tif err != nil {\n\t\treturn IdentityCode{}, fmt.Errorf(\"load subscriber for mint: %w\", err)\n\t}\n\n\tcode := IdentityCode{SubscriberID: subscriberID}\n\tvar desc *identityDescriptor\n\tif campaignID != nil {\n\t\tcode.CampaignID = *campaignID\n\t\tcode.ExpiresAt = *endsAt\n\t\tdesc = &identityDescriptor{\n\t\t\tLabel:      *offerText,\n\t\t\tCampaignID: *campaignID,\n\t\t\t// Date-only, in UTC: the reader parses a bare date as UTC midnight,\n\t\t\t// so the offline display never outlives the campaign's real end.\n\t\t\tExpiresAt: endsAt.UTC().Format(\"2006-01-02\"),\n\t\t\tFaceValue: float64(*faceCents) / 100.0,\n\t\t}\n\t}\n\n\tif existing != nil {\n\t\tcode.TokenHash = *existing\n\t\tif err := tx.QueryRow(ctx, `\n\t\t\tSELECT id::text FROM identity_media\n\t\t\t WHERE subscriber_id = $1 ORDER BY created_at DESC, id LIMIT 1`, subscriberID).\n\t\t\tScan(&code.MediaID); err != nil {\n\t\t\treturn IdentityCode{}, fmt.Errorf(\"load identity media: %w\", err)\n\t\t}\n\t\treturn code, nil\n\t}\n\n\ttoken, err := newIdentityToken(identityRand)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tpng, err := buildIdentityQR(baseURL, token, desc)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tcode.TokenHash = identityTokenHash(token)\n\tif _, err := tx.Exec(ctx, `\n\t\tUPDATE subscribers SET identity_token_hash = $2, identity_minted_at = now()\n\t\t WHERE id = $1`, subscriberID, code.TokenHash); err != nil {\n\t\treturn IdentityCode{}, fmt.Errorf(\"store identity hash: %w\", err)\n\t}\n\tif err := tx.QueryRow(ctx, `\n\t\tINSERT INTO identity_media (subscriber_id, png) VALUES ($1, $2)\n\t\tRETURNING id::text`, subscriberID, png).Scan(&code.MediaID); err != nil {\n\t\treturn IdentityCode{}, fmt.Errorf(\"store identity media: %w\", err)\n\t}\n\tcode.Minted = true\n\treturn code, nil\n}\n\n// identityCodeNamespace is RFC 4122's URL namespace.\nvar identityCodeNamespace = [16]byte{\n\t0x6b, 0xa7, 0xb8, 0x11, 0x9d, 0xad, 0x11, 0xd1,\n\t0x80, 0xb4, 0x00, 0xc0, 0x4f, 0xd4, 0x30, 0xc8,\n}\n\n// IdentityCodeID is the arbiter row's id for a subscriber's identity code: a\n// version-5 uuid over a URL naming the subscriber. It is derived, not drawn,\n// so projecting the same subscriber twice writes the same row.\n//\n// tests/marketing-identity.spec.js derives it the same way; change both or\n// neither. Changing it at all orphans every row already projected.\nfunc IdentityCodeID(subscriberID string) string {\n\th := sha1.New()\n\th.Write(identityCodeNamespace[:])\n\th.Write([]byte(DefaultQRBaseURL + \"/identity-code/\" + strings.ToLower(subscriberID)))\n\tu := h.Sum(nil)[:16]\n\tu[6] = (u[6] & 0x0f) | 0x50 // version 5\n\tu[8] = (u[8] & 0x3f) | 0x80 // RFC 4122 variant\n\tx := hex.EncodeToString(u)\n\treturn x[0:8] + \"-\" + x[8:12] + \"-\" + x[12:16] + \"-\" + x[16:20] + \"-\" + x[20:]\n}\n\n// WarningIdentityNotMinted is reported by an import when a new subscriber was\n// saved but their code could not be minted. The subscriber is kept.\nconst WarningIdentityNotMinted = \"identity_not_minted\"\n\n// mintForNewSubscribers runs after an import's transaction has committed: one\n// short transaction per new subscriber, then — for a code that carries an\n// offer — the projection to the arbiter.\n//\n// Nothing here can undo the import or a mint. A projection that is\n// unconfigured or failing leaves the code minted and adds \"not_projected\" to\n// the returned warnings (decision 187's shape); after the first failure the\n// rest of this import's projections are skipped rather than each waiting out\n// a dead substrate inside one manager's request.\nfunc mintForNewSubscribers(ctx context.Context, d Deps, subscriberIDs []string) []string {\n\tvar notMinted, notProjected bool\n\tprojectionDown := !d.Projection.Configured()\n\tfor _, id := range subscriberIDs {\n\t\tcode, err := mintOne(ctx, d, id)\n\t\tif err != nil {\n\t\t\tslog.Error(\"marketing: identity code not minted; the subscriber is saved without one\",\n\t\t\t\t\"error\", err, \"subscriber_id\", id)\n\t\t\tnotMinted = true\n\t\t\tcontinue\n\t\t}\n\t\tif code.CampaignID == \"\" {\n\t\t\tcontinue // identity-only: there is no entitlement to project\n\t\t}\n\t\tif projectionDown {\n\t\t\tnotProjected = true\n\t\t\tcontinue\n\t\t}\n\t\tif err := ProjectIdentityCode(ctx, d.Projection, IdentityProjectionRow{\n\t\t\tID:         IdentityCodeID(id),\n\t\t\tTokenHash:  code.TokenHash,\n\t\t\tCampaignID: code.CampaignID,\n\t\t\tExpiresAt:  code.ExpiresAt,\n\t\t}); err != nil {\n\t\t\tslog.Error(\"marketing: identity code projection failed; the code is minted but the arbiter does not know it\",\n\t\t\t\t\"error\", err, \"subscriber_id\", id)\n\t\t\tnotProjected = true\n\t\t\tprojectionDown = true\n\t\t}\n\t}\n\tvar warnings []string\n\tif notProjected {\n\t\twarnings = append(warnings, WarningNotProjected)\n\t}\n\tif notMinted {\n\t\twarnings = append(warnings, WarningIdentityNotMinted)\n\t}\n\treturn warnings\n}\n\nfunc mintOne(ctx context.Context, d Deps, subscriberID string) (IdentityCode, error) {\n\ttx, err := d.Pool.Begin(ctx)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tdefer func() { _ = tx.Rollback(ctx) }()\n\tcode, err := mintIdentityCode(ctx, tx, subscriberID, d.QRBaseURL)\n\tif err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\tif err := tx.Commit(ctx); err != nil {\n\t\treturn IdentityCode{}, err\n\t}\n\treturn code, nil\n}\n\n// identityMediaPath is the public path of a stored identity image.\nfunc identityMediaPath(mediaID string) string {\n\treturn \"/m/\" + mediaID + \".png\"\n}\n\n// IdentityMediaHandler serves GET and HEAD /m/{id}.png: a subscriber's\n// identity-code image.\n//\n// It is PUBLIC — mounted by MountPublic, outside every gate — because the two\n// things that fetch it hold no HQ session: the customer's phone, and the\n// carrier collecting an MMS attachment. The media id is a random uuid and is\n// the route's only secret, so an unknown id and a malformed id are the same\n// 404.\n//\n// Cache-Control is PRIVATE: the image identifies one person and must not sit\n// in a shared cache.\nfunc IdentityMediaHandler(d Deps) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tid := chi.URLParam(r, \"id\")\n\t\tvar png []byte\n\t\terr := d.Pool.QueryRow(r.Context(),\n\t\t\t`SELECT png FROM identity_media WHERE id = $1`, id).Scan(&png)\n\t\tif errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {\n\t\t\twriteError(w, http.StatusNotFound, \"not_found\")\n\t\t\treturn\n\t\t}\n\t\tif err != nil {\n\t\t\tslog.Error(\"marketing: load identity media\", \"error\", err)\n\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\")\n\t\t\treturn\n\t\t}\n\t\tw.Header().Set(\"Content-Type\", \"image/png\")\n\t\tw.Header().Set(\"Cache-Control\", \"private, max-age=3600\")\n\t\tw.Header().Set(\"Content-Length\", strconv.Itoa(len(png)))\n\t\tw.WriteHeader(http.StatusOK)\n\t\tif r.Method != http.MethodHead {\n\t\t\t_, _ = w.Write(png)\n\t\t}\n\t}\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
