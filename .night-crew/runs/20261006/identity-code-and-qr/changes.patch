diff --git a/tests/marketing-identity.spec.js b/tests/marketing-identity.spec.js
new file mode 100644
index 0000000..b28ec0d
--- /dev/null
+++ b/tests/marketing-identity.spec.js
@@ -0,0 +1,391 @@
+// ═══════════════════════════════════════════════════════════════════════════
+// Marketing · identity codes — card E1 `identity-code-and-qr` (run 20261006)
+// roadmap Activity E; goal ledger
+// .night-crew/knowledge/spikes/activity-e-customer-delivery-one-identity-code-qr-image/identity-code-and-qr.md
+// ═══════════════════════════════════════════════════════════════════════════
+//
+// What these three tests are about, in the truck's terms: a customer who signed
+// up holds ONE code on their phone. The crew member photographs it.
+//
+//   [IC-01] With no signal, and before that customer has ever synced to this
+//           tablet, the scanner still shows the offer they signed up for.
+//   [IC-02] With signal, the scanner shows the server's answer for that code.
+//   [IC-03] NEGATIVE control: the same code drawn more densely (Medium error
+//           correction, QR version 11) is NOT read off the photo by the shipped
+//           scanner — which is why the server draws it at Low. A change that
+//           "upgrades" the correction level turns [IC-01] into this.
+//
+// 🛑 THE PNG IS THE SERVER'S. Subscribers are imported through the real
+// POST /subscribers/import/web-form (the committed Fluent Forms fixture, via
+// HQ_FF_FIXTURE_PATH on the e2e server — never the live website database), the
+// code is minted by that import, and the image is fetched from the real public
+// GET /m/{id}.png. The raw token is stored nowhere, so the test learns it the
+// only way anyone can: by DECODING THE PNG.
+//
+// 🟡 THE ONE STUB is in [IC-02]: the server lookup is answered by page.route on
+// the sync door's path (the e2e stack has no substrate). It returns the row the
+// projection would have written. The projection itself is gated in Go
+// (TestProjectIdentityCodeUpserts).
+//
+// ═══════════════════════════════════════════════════════════════════════════
+// 🛑 READ BEFORE TRUSTING A RESULT FROM THIS FILE (measured 2026-10-05, run
+// 20261006 — logs/identity-code-and-qr/density-probe.log)
+//
+// These three tests are the signed slate's gates, written as signed. Two of
+// their premises did not survive measurement over 250 freshly drawn codes:
+//
+//   * [IC-03] IS NOT A STABLE PROPERTY. The shipped photo-scan decoder read a
+//     Medium / version-11 code 83% of the time (208 of 250) — as often as it
+//     read the card's own Low / version-9 code (212 of 250). This test passes
+//     only when the one token it happened to mint draws a symbol the decoder
+//     cannot find. Expect it RED on most runs.
+//   * [IC-01] AND [IC-02] PASS ONLY WHEN THE MINTED CODE IS A READABLE ONE —
+//     about six runs in seven. A red here with "decodeError" (or the test's own
+//     decode throwing "No MultiFormat Readers were able to detect the code") is
+//     that, not a regression. 🛑 playwright.config.js retries once, and a retry
+//     mints a NEW token: a pass on retry is the lottery re-drawn, not a flake
+//     going away.
+//
+// The card is PARKED on this (the encoding was a signed correction; what
+// replaces it is the operator's). Do not "stabilise" these tests by pinning a
+// token or adding retries.
+// ═══════════════════════════════════════════════════════════════════════════
+//
+// RED-FIRST: written and run against the pre-change tree — no /m/ route, no
+// mint, `identity_code.status` still "not_sent". Evidence:
+// .night-crew/runs/2026-10-06-autonomous/logs/identity-code-and-qr/.
+
+const { test, expect } = require('@playwright/test');
+const { execFileSync } = require('child_process');
+const crypto = require('crypto');
+const fs = require('fs');
+const path = require('path');
+const { resolveE2eDb } = require('../scripts/reset-e2e-db');
+
+const ADMIN_EMAIL = 'jamal@yumyums.kitchen';
+const ADMIN_PASSWORD = 'test123';
+const MINT_SUB = 'e2e-identity-mint-sub';
+
+// The committed fixture's row 1182 is the one signup carrying a first-touch
+// code (`source: "K7MNPQ"`); the other three have none.
+const FIRST_TOUCH_SHORT = 'K7MNPQ';
+const OFFER_TEXT = 'Free side of wings';
+const TOKEN_RE = /^[23456789abcdefghjkmnpqrstuvwxyz]{16}$/;
+
+const sha256Hex = (s) => crypto.createHash('sha256').update(s).digest('hex');
+
+// The arbiter row's id, derived the way internal/marketing/identity.go derives
+// it: uuid v5 (RFC 4122 URL namespace) over a URL naming the subscriber.
+function identityCodeId(subscriberId) {
+  const ns = Buffer.from('6ba7b8119dad11d180b400c04fd430c8', 'hex');
+  const name = 'https://hq.yumyums.kitchen/identity-code/' + subscriberId.toLowerCase();
+  const h = crypto.createHash('sha1').update(ns).update(name).digest().subarray(0, 16);
+  h[6] = (h[6] & 0x0f) | 0x50;
+  h[8] = (h[8] & 0x3f) | 0x80;
+  const x = h.toString('hex');
+  return `${x.slice(0, 8)}-${x.slice(8, 12)}-${x.slice(12, 16)}-${x.slice(16, 20)}-${x.slice(20)}`;
+}
+
+// `psqlUrl`, not `testUrl` — libpq does not understand TimeZone (the note
+// tests/marketing-stats.spec.js carries).
+function psql(sqlText) {
+  const db = resolveE2eDb();
+  return execFileSync('psql', [db.psqlUrl, '-At', '-v', 'ON_ERROR_STOP=1', '-c', sqlText],
+    { encoding: 'utf8' }).trim();
+}
+
+// This file owns subscribers, campaigns and codes while it runs. Deleting a
+// subscriber deletes their timeline and their identity image with them.
+function resetIdentityFixture() {
+  psql(`DELETE FROM subscribers;
+        DELETE FROM reconciliation_decisions;
+        DELETE FROM scan_attempts_mirror;
+        DELETE FROM qr_scans;
+        DELETE FROM qr_codes;
+        DELETE FROM campaigns_admin;`);
+}
+
+async function loginAs(page, email, password) {
+  await page.goto('/login.html');
+  await page.fill('input[type="email"]', email);
+  await page.fill('input[type="password"]', password);
+  await page.click('button.btn');
+  await page.waitForURL((url) => !url.pathname.includes('login'));
+}
+
+async function api(page, method, url, body) {
+  return page.evaluate(async ([m, u, b]) => {
+    const r = await fetch(u, {
+      method: m,
+      headers: b ? { 'Content-Type': 'application/json' } : {},
+      body: b ? JSON.stringify(b) : undefined,
+    });
+    const text = await r.text();
+    let json = null;
+    try { json = JSON.parse(text); } catch (e) { /* not JSON */ }
+    return { status: r.status, text, json };
+  }, [method, url, body || null]);
+}
+
+// mintFixtureCode: a live campaign whose code is the fixture's first-touch
+// short, then the real import. Returns what the SERVER reports — and the PNG,
+// fetched with NO session, written to a per-test file.
+async function mintFixtureCode(page, testInfo) {
+  resetIdentityFixture();
+  await loginAs(page, ADMIN_EMAIL, ADMIN_PASSWORD);
+
+  const created = await api(page, 'POST', '/api/v1/marketing/campaigns', {
+    name: 'Identity E2E', offer_text: OFFER_TEXT, face_value_cents: 200, runs_days: 14,
+    channels: [{ channel: 'flyer' }],
+  });
+  expect(created.status, `POST /campaigns → ${created.text}`).toBe(201);
+  const campaign = created.json.campaign;
+  psql(`UPDATE qr_codes SET short = '${FIRST_TOUCH_SHORT}' WHERE id = '${created.json.codes[0].id}'`);
+
+  const imported = await api(page, 'POST', '/api/v1/marketing/subscribers/import/web-form');
+  expect(imported.status,
+    `POST /subscribers/import/web-form → ${imported.text}. A 503 ff_not_configured means the e2e ` +
+    'server was started without HQ_FF_FIXTURE_PATH (playwright.config.js sets it; a stack ' +
+    'hand-provisioned behind NIGHTCREW_ENV_URL must export it too).').toBe(200);
+  expect(imported.json.created, 'the committed fixture lands four new subscribers').toBe(4);
+
+  const subscriberId = psql(`SELECT id FROM subscribers WHERE source_short = '${FIRST_TOUCH_SHORT}'`);
+  expect(subscriberId, 'the first-touch subscriber exists').toMatch(/^[0-9a-f-]{36}$/);
+  const detail = await api(page, 'GET', `/api/v1/marketing/subscribers/${subscriberId}`);
+  expect(detail.status, `GET /subscribers/{id} → ${detail.text}`).toBe(200);
+  expect(detail.json.identity_code.status, 'an imported subscriber has a code, and nothing has been sent').toBe('minted');
+  const mediaUrl = detail.json.identity_code.media_url;
+  expect(mediaUrl, 'identity_code.media_url').toMatch(/^\/m\/[0-9a-f-]{36}\.png$/);
+
+  // PUBLIC: a context with no cookies at all, as a customer's phone has.
+  const anon = await page.context().browser().newContext({ baseURL: testInfo.project.use.baseURL });
+  let png;
+  try {
+    const res = await anon.request.get(mediaUrl);
+    expect(res.status(), `GET ${mediaUrl} with no session`).toBe(200);
+    expect(res.headers()['content-type']).toBe('image/png');
+    expect(res.headers()['cache-control']).toBe('private, max-age=3600');
+    png = await res.body();
+    const head = await anon.request.head(mediaUrl);
+    expect(head.status(), 'HEAD is supported').toBe(200);
+    const missing = await anon.request.get('/m/00000000-0000-4000-8000-000000000000.png');
+    expect(missing.status(), 'an unknown media id is a 404').toBe(404);
+  } finally {
+    await anon.close();
+  }
+  const pngPath = testInfo.outputPath('identity-code.png');
+  fs.writeFileSync(pngPath, png);
+
+  // The e2e stack has no substrate, so the first-touch code could not be
+  // projected — and the import says so instead of failing (decision 187's shape).
+  expect(imported.json.warnings, 'an unprojected identity code is reported, not hidden').toEqual(['not_projected']);
+  const storedHash = psql(`SELECT identity_token_hash FROM subscribers WHERE id = '${subscriberId}'`);
+  return { campaign, subscriberId, mediaUrl, pngPath, storedHash };
+}
+
+async function openScanner(page) {
+  await page.goto('/marketing.html');
+  await page.waitForFunction(() => window.MarketingScan && window.MarketingScan.booted === true);
+}
+
+async function scanFile(page, file) {
+  await page.setInputFiles('#scan-file', file);
+  await page.waitForSelector('#scan-result[data-kind]', { state: 'attached' });
+}
+
+async function readResult(page) {
+  const r = page.locator('#scan-result');
+  return {
+    kind: await r.getAttribute('data-kind'),
+    hash: await r.getAttribute('data-token-hash'),
+    source: await r.getAttribute('data-source'),
+  };
+}
+
+// decodePng reads the QR's TEXT out of a PNG with the page's own vendored
+// decoder on a wide private surface — independent of the scanner's result
+// rendering. This is the only way the test (or anyone) learns the token.
+async function decodePng(page, pngPath) {
+  const b64 = fs.readFileSync(pngPath).toString('base64');
+  return page.evaluate(async (data) => {
+    const host = document.createElement('div');
+    host.id = 'ic-test-decode-surface';
+    host.style.cssText = 'position:absolute;left:-9999px;width:1024px;height:1024px;overflow:hidden';
+    document.body.appendChild(host);
+    try {
+      const bytes = Uint8Array.from(atob(data), (c) => c.charCodeAt(0));
+      const file = new File([bytes], 'identity-code.png', { type: 'image/png' });
+      // eslint-disable-next-line no-undef
+      return await new Html5Qrcode(host.id).scanFile(file, false);
+    } finally {
+      host.remove();
+    }
+  }, b64);
+}
+
+// What the payload must be, read off the decoded text.
+function parsePayload(text) {
+  const m = /^https:\/\/hq\.yumyums\.kitchen\/r\/([^/?#]+)(?:#o=([A-Za-z0-9_-]+))?$/.exec(text);
+  expect(m, `decoded payload is not <base>/r/<token>[#o=<descriptor>]: ${text}`).not.toBeNull();
+  return {
+    token: m[1],
+    descriptor: m[2] ? JSON.parse(Buffer.from(m[2], 'base64url').toString('utf8')) : null,
+  };
+}
+
+async function mockSyncTransports(page, campaign) {
+  await page.route('**/api/v1/sync/token', (route) => route.fulfill({
+    status: 200, contentType: 'application/json',
+    body: JSON.stringify({
+      token: 'e2e-bridge-token', expires_at: Math.floor(Date.now() / 1000) + 900,
+      sub: MINT_SUB, role: 'authenticated', grants: ['marketing'],
+    }),
+  }));
+  await page.route('**/sync/rest/**', (route) => {
+    const req = route.request();
+    const u = new URL(req.url());
+    // The replica pulls: this tablet has never seen the customer's code.
+    if (req.method() === 'GET' && u.pathname.endsWith('/codes')) {
+      return route.fulfill({ status: 200, contentType: 'application/json', body: '[]' });
+    }
+    if (req.method() === 'GET' && u.pathname.endsWith('/campaigns')) {
+      return route.fulfill({
+        status: 200, contentType: 'application/json',
+        body: JSON.stringify([{
+          id: campaign.id, name: campaign.name, requires_online: false,
+          updated_at: '2026-09-01T00:00:00.000Z',
+        }]),
+      });
+    }
+    if (req.method() === 'POST' && u.pathname.endsWith('/scan_attempts')) {
+      return route.fulfill({ status: 201, contentType: 'application/json', body: '' });
+    }
+    return route.fulfill({ status: 503, body: 'unmocked sync transport' });
+  });
+}
+
+const isLookupUrl = (url) =>
+  url.pathname.endsWith('/sync/rest/codes') && url.searchParams.has('token_hash');
+
+// qrgen draws a payload with the repo's own go-qrcode (the library the server
+// mints with) at a chosen correction level, and reports the QR version.
+function qrgen(payload, outPath, level) {
+  const out = execFileSync('go', ['run', './cmd/qrgen', payload, outPath, '512', level], {
+    cwd: path.join(__dirname, '..', 'backend'),
+    encoding: 'utf8',
+    env: { ...process.env, PATH: `/usr/local/go/bin:${process.env.PATH}` },
+  });
+  const m = /version=(\d+) modules=(\d+)/.exec(out);
+  expect(m, `qrgen output: ${out}`).not.toBeNull();
+  return { version: Number(m[1]), modules: Number(m[2]) };
+}
+
+test.describe('Identity code — minted by the server, read by the shipped scanner (card identity-code-and-qr)', () => {
+  // `go run` on a cold build cache and the import both sit inside one test.
+  test.setTimeout(120000);
+
+  test('[IC-01] OFFLINE, nothing seeded: the server-minted PNG shows the signup\'s offer and the hash of its own token', async ({ page }, testInfo) => {
+    const minted = await mintFixtureCode(page, testInfo);
+    await openScanner(page);
+
+    // The token, learned ONLY by decoding the server's PNG.
+    const text = await decodePng(page, minted.pngPath);
+    const { token, descriptor } = parsePayload(text);
+    expect(token, 'a 16-character token over the unambiguous alphabet').toMatch(TOKEN_RE);
+    expect(sha256Hex(token), 'the server stored the hash of exactly the token it drew').toBe(minted.storedHash);
+    expect(descriptor, 'a first-touch signup\'s code carries the offer').toEqual({
+      label: OFFER_TEXT,
+      campaign_id: minted.campaign.id,
+      // Date-only and in UTC, whatever offset the API printed ends_at with.
+      expires_at: new Date(minted.campaign.ends_at).toISOString().slice(0, 10),
+      face_value: 2,
+    });
+    // The token itself is in no column of the subscriber's row.
+    expect(psql(`SELECT count(*) FROM subscribers s WHERE to_jsonb(s)::text LIKE '%${token}%'`)).toBe('0');
+
+    await page.context().setOffline(true);
+    await scanFile(page, minted.pngPath);
+    const result = page.locator('#scan-result');
+    await expect(result).toHaveAttribute('data-kind', 'embeddedOffer');
+    await expect(result).toHaveAttribute('data-source', 'embedded');
+    await expect(result).toHaveAttribute('data-token-hash', sha256Hex(token));
+    await expect(result).toContainText(OFFER_TEXT);
+    // Display-only until the server has been asked — the crew is told so.
+    await expect(result.locator('.result-note')).toContainText('not yet verified');
+    // The raw token never lands in the DOM — only its hash.
+    expect(await result.innerHTML()).not.toContain(token);
+  });
+
+  test('[IC-02] ONLINE: the same PNG resolves the server\'s row for that code → offerReady, source server', async ({ page }, testInfo) => {
+    const minted = await mintFixtureCode(page, testInfo);
+    await mockSyncTransports(page, minted.campaign);
+
+    // 🟡 The permitted stub. The "server" holds exactly the row the projection
+    // writes for this subscriber, keyed by the hash HQ stored; any other hash
+    // gets `200 []`, the way PostgREST answers.
+    const projected = {
+      id: identityCodeId(minted.subscriberId),
+      campaign_id: minted.campaign.id,
+      expires_at: new Date(minted.campaign.ends_at).toISOString().replace(/Z$/, '+00:00'),
+      redeemed_at: null,
+      redeemed_by: null,
+    };
+    const lookups = [];
+    await page.route(isLookupUrl, (route) => {
+      const asked = /^eq\.(.+)$/.exec(new URL(route.request().url()).searchParams.get('token_hash') || '');
+      lookups.push(asked ? asked[1] : null);
+      const rows = asked && asked[1] === minted.storedHash ? [projected] : [];
+      return route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify(rows) });
+    });
+
+    await page.goto('/marketing.html');
+    await page.waitForFunction(() =>
+      window.MarketingScan && window.MarketingScan.booted === true
+      && window.MarketingSubmit && window.MarketingSubmit.booted === true);
+    await page.waitForFunction(() =>
+      document.getElementById('scan-status').textContent.includes('Replica synced'));
+    await expect(page.locator('#scan-conn')).toHaveAttribute('data-conn', 'online');
+
+    const { token } = parsePayload(await decodePng(page, minted.pngPath));
+    await scanFile(page, minted.pngPath);
+    await page.waitForFunction(() =>
+      document.getElementById('scan-result').getAttribute('data-kind') !== 'checkingServer', null, { timeout: 10000 });
+
+    const result = page.locator('#scan-result');
+    await expect(result).toHaveAttribute('data-kind', 'offerReady');
+    await expect(result).toHaveAttribute('data-source', 'server');
+    await expect(result).toHaveAttribute('data-token-hash', sha256Hex(token));
+    await expect(result.locator('.offer-row').first()).toHaveAttribute('data-code-id', projected.id);
+    expect(lookups, 'the scanner asked the server about this code\'s hash, and only that').toEqual([minted.storedHash]);
+  });
+
+  test('[IC-03] NEGATIVE control: the same payload at Medium correction (QR version 11) renders no offer', async ({ page }, testInfo) => {
+    const minted = await mintFixtureCode(page, testInfo);
+    await openScanner(page);
+    const text = await decodePng(page, minted.pngPath);
+    const { token } = parsePayload(text);
+
+    // The control must be what it claims: the SAME text, one correction level
+    // up, which costs two QR versions. The Low twin is drawn by the same tool
+    // so the comparison is like for like.
+    const mediumPath = testInfo.outputPath('identity-code-medium.png');
+    const lowPath = testInfo.outputPath('identity-code-low.png');
+    const medium = qrgen(text, mediumPath, 'M');
