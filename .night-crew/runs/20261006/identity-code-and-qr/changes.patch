+// The entitlement row the arbiter answers from: where it is written, how, and
+// what happens to the customer's code when the write fails.
+func TestProjectIdentityCodeUpserts(t *testing.T) {
+	ends := time.Date(2028, 1, 1, 5, 59, 59, 0, time.UTC)
+	row := IdentityProjectionRow{
+		ID:         IdentityCodeID("0b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b"),
+		TokenHash:  sha256Hex("ic7k3m9q2x5p8w4z"),
+		CampaignID: "a0000000-0000-4000-8000-000000000001",
+		ExpiresAt:  ends,
+	}
+
+	t.Run("201 lands one row on /codes as a merge-duplicates upsert", func(t *testing.T) {
+		fake := newFakePostgREST(t, http.StatusCreated)
+		if err := ProjectIdentityCode(context.Background(), fake.config(), row); err != nil {
+			t.Fatalf("ProjectIdentityCode = %v, want nil on 201", err)
+		}
+		hits := fake.recorded()
+		if len(hits) != 1 {
+			t.Fatalf("%d requests, want 1", len(hits))
+		}
+		h := hits[0]
+		if h.Method != http.MethodPost || h.Path != "/codes" {
+			t.Errorf("request = %s %s, want POST /codes", h.Method, h.Path)
+		}
+		if h.Prefer != "resolution=merge-duplicates" {
+			t.Errorf("Prefer = %q, want resolution=merge-duplicates", h.Prefer)
+		}
+		if h.APIKey != "test-service-key" || h.Auth != "Bearer test-service-key" {
+			t.Errorf("apikey/Authorization = %q / %q, want the service_role key on both", h.APIKey, h.Auth)
+		}
+		if len(h.Body) != 1 {
+			t.Fatalf("body carries %d rows, want 1: %v", len(h.Body), h.Body)
+		}
+		got := h.Body[0]
+		if len(got) != 4 {
+			t.Errorf("row has %d fields (%v), want exactly id, token_hash, campaign_id, expires_at", len(got), got)
+		}
+		if got["id"] != row.ID || got["token_hash"] != row.TokenHash || got["campaign_id"] != row.CampaignID {
+			t.Errorf("row = %v, want id %s / token_hash %s / campaign_id %s", got, row.ID, row.TokenHash, row.CampaignID)
+		}
+		exp, _ := got["expires_at"].(string)
+		parsed, err := time.Parse(time.RFC3339, exp)
+		if err != nil || !parsed.Equal(ends) {
+			t.Errorf("expires_at = %q, want the campaign's ends_at %s as RFC 3339", exp, ends)
+		}
+	})
+
+	t.Run("the id is derived from the subscriber, so a re-projection is the same row", func(t *testing.T) {
+		a := IdentityCodeID("0b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b")
+		b := IdentityCodeID("0B6F2C1E-6F0A-4F6E-9C59-0C1D2E3F4A5B")
+		c := IdentityCodeID("1b6f2c1e-6f0a-4f6e-9c59-0c1d2e3f4a5b")
+		if a != b {
+			t.Errorf("the id depends on the subscriber id's letter case: %s vs %s", a, b)
+		}
+		if a == c {
+			t.Error("two subscribers derived the same code id")
+		}
+		if len(a) != 36 || a[14] != '5' || !strings.ContainsRune("89ab", rune(a[19])) {
+			t.Errorf("%s is not a version-5 uuid", a)
+		}
+	})
+
+	t.Run("500 is an error and unconfigured is an error", func(t *testing.T) {
+		fake := newFakePostgREST(t, http.StatusInternalServerError)
+		if err := ProjectIdentityCode(context.Background(), fake.config(), row); err == nil {
+			t.Error("ProjectIdentityCode = nil on a 500")
+		}
+		if err := ProjectIdentityCode(context.Background(), ProjectionConfig{}, row); err == nil {
+			t.Error("ProjectIdentityCode = nil with the projection unconfigured")
+		}
+	})
+
+	// The same three outcomes through the import, against a real database.
+	importWith := func(t *testing.T, cfg ProjectionConfig) (importResultDTO, campaignDTO, string, string) {
+		t.Helper()
+		pool := setupSubsTestDB(t)
+		d := testDeps(pool)
+		camp := seedFirstTouchCampaign(t, pool, mountedMux(d), "K7MNPQ", "Free side of wings", 200)
+		d.Projection = cfg
+		res, err := ImportSubscribers(context.Background(), d, ffImporter(t))
+		if err != nil {
+			t.Fatalf("import: %v", err)
+		}
+		var subID string
+		var hash *string
+		if err := pool.QueryRow(context.Background(),
+			`SELECT id::text, identity_token_hash FROM subscribers WHERE external_ref = '1182'`).
+			Scan(&subID, &hash); err != nil {
+			t.Fatalf("read the first-touch subscriber: %v", err)
+		}
+		if hash == nil {
+			t.Fatal("the first-touch subscriber has no identity_token_hash — the mint did not commit")
+		}
+		if n := countRows(t, pool, `SELECT count(*) FROM identity_media WHERE subscriber_id = $1`, subID); n != 1 {
+			t.Fatalf("identity_media rows for the first-touch subscriber = %d, want 1", n)
+		}
+		if n := countRows(t, pool, `SELECT count(*) FROM subscribers WHERE identity_token_hash IS NULL`); n != 0 {
+			t.Fatalf("%d imported subscribers were left without a code", n)
+		}
+		return res, camp, subID, *hash
+	}
+
+	t.Run("import: a 201 projects the first-touch code and only that one", func(t *testing.T) {
+		fake := newFakePostgREST(t, http.StatusCreated)
+		res, camp, subID, hash := importWith(t, fake.config())
+		if len(res.Warnings) != 0 {
+			t.Errorf("warnings = %v, want none", res.Warnings)
+		}
+		hits := fake.recorded()
+		if len(hits) != 1 {
+			t.Fatalf("%d projection requests, want 1 (three of the four signups are identity-only)", len(hits))
+		}
+		got := hits[0].Body[0]
+		if got["id"] != IdentityCodeID(subID) || got["token_hash"] != hash || got["campaign_id"] != camp.ID {
+			t.Errorf("projected row = %v, want id %s / hash %s / campaign %s", got, IdentityCodeID(subID), hash, camp.ID)
+		}
+		exp, _ := got["expires_at"].(string)
+		if parsed, err := time.Parse(time.RFC3339, exp); err != nil || !parsed.Equal(camp.EndsAt) {
+			t.Errorf("projected expires_at = %q, want the campaign's ends_at %s", exp, camp.EndsAt)
+		}
+	})
+
+	t.Run("import: a 500 keeps the mint and says not_projected", func(t *testing.T) {
+		fake := newFakePostgREST(t, http.StatusInternalServerError)
+		res, _, _, _ := importWith(t, fake.config()) // importWith asserts the mint committed
+		if len(res.Warnings) != 1 || res.Warnings[0] != WarningNotProjected {
+			t.Fatalf("warnings = %v, want [%q]", res.Warnings, WarningNotProjected)
+		}
+	})
+
+	t.Run("import: an unconfigured projection keeps the mint and says not_projected", func(t *testing.T) {
+		res, _, _, _ := importWith(t, ProjectionConfig{})
+		if len(res.Warnings) != 1 || res.Warnings[0] != WarningNotProjected {
+			t.Fatalf("warnings = %v, want [%q]", res.Warnings, WarningNotProjected)
+		}
+	})
+}
