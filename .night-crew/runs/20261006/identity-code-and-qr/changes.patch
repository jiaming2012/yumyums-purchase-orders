+// 0088's Down, run: the two columns and the image table go, `subscribers`
+// itself stays, and re-applying brings them back with the cascade and the
+// unique hash intact.
+//
+// Same rules as the 0085 and 0086 legs: start from HEAD, derive the version
+// from the filename, restore with db.Migrate (never a literal), touch no row.
+func TestMigration0088IdentityCodesDownAndUpRoundTrip(t *testing.T) {
+	if testPool == nil {
+		t.Skip("no test database (DB_TEST_URL unset and the local fallback is unreachable)")
+	}
+	pool := testPool
+	ctx := context.Background()
+	if err := db.Migrate(pool); err != nil {
+		t.Fatalf("migrate up to HEAD before the down leg: %v", err)
+	}
+	t.Cleanup(func() {
+		if err := db.Migrate(pool); err != nil {
+			t.Errorf("restore to HEAD: %v", err)
+		}
+	})
+
+	version := identityMigrationVersion(t)
+	if version != 88 {
+		t.Fatalf("*_identity_codes.sql is migration %d; the slate fixes it at 88 (a renumbering is scope drift)", version)
+	}
+
+	tableExists := func(name string) bool {
+		var ok bool
+		if err := pool.QueryRow(ctx, `
+			SELECT EXISTS (SELECT 1 FROM information_schema.tables
+			                WHERE table_schema = current_schema() AND table_name = $1)`, name).Scan(&ok); err != nil {
+			t.Fatalf("tableExists(%s): %v", name, err)
+		}
+		return ok
+	}
+	columnExists := func(table, column string) bool {
+		var ok bool
+		if err := pool.QueryRow(ctx, `
+			SELECT EXISTS (SELECT 1 FROM information_schema.columns
+			                WHERE table_schema = current_schema() AND table_name = $1 AND column_name = $2)`,
+			table, column).Scan(&ok); err != nil {
+			t.Fatalf("columnExists(%s.%s): %v", table, column, err)
+		}
+		return ok
+	}
+	assertUp := func(leg string) {
+		t.Helper()
+		if !tableExists("identity_media") {
+			t.Errorf("%s: identity_media is missing", leg)
+		}
+		for _, c := range []string{"identity_token_hash", "identity_minted_at"} {
+			if !columnExists("subscribers", c) {
+				t.Errorf("%s: subscribers.%s is missing", leg, c)
+			}
+		}
+		// The erasure path: deleting a subscriber deletes their image.
+		var del string
+		if err := pool.QueryRow(ctx, `
+			SELECT confdeltype::text FROM pg_constraint
+			 WHERE conrelid = 'identity_media'::regclass AND contype = 'f'
+			   AND confrelid = 'subscribers'::regclass`).Scan(&del); err != nil {
+			t.Errorf("%s: read identity_media's FK onto subscribers: %v", leg, err)
+		} else if del != "c" {
+			t.Errorf("%s: identity_media → subscribers is ON DELETE %q, want c (cascade)", leg, del)
+		}
+		// Two customers can never share a code.
+		var uniques int
+		if err := pool.QueryRow(ctx, `
+			SELECT count(*) FROM pg_constraint c
+			  JOIN pg_attribute a ON a.attrelid = c.conrelid AND a.attnum = ANY (c.conkey)
+			 WHERE c.conrelid = 'subscribers'::regclass AND c.contype = 'u'
+			   AND a.attname = 'identity_token_hash'`).Scan(&uniques); err != nil {
+			t.Errorf("%s: read the unique constraint: %v", leg, err)
+		} else if uniques != 1 {
+			t.Errorf("%s: %d unique constraints on subscribers.identity_token_hash, want 1", leg, uniques)
+		}
+	}
+
+	assertUp("at HEAD")
+
+	if err := db.MigrateTo(pool, version-1); err != nil {
+		t.Fatalf("migrate down to %d: %v", version-1, err)
+	}
+	if tableExists("identity_media") {
+		t.Errorf("identity_media survived migration %d's Down", version)
+	}
+	for _, c := range []string{"identity_token_hash", "identity_minted_at"} {
+		if columnExists("subscribers", c) {
+			t.Errorf("subscribers.%s survived migration %d's Down", c, version)
+		}
+	}
+	if !tableExists("subscribers") || !columnExists("subscribers", "source_short") {
+		t.Fatalf("migration %d's Down took more than its own: subscribers (or its 0085 columns) is gone", version)
+	}
+
+	if err := db.Migrate(pool); err != nil {
+		t.Fatalf("migrate back up to HEAD: %v", err)
+	}
+	assertUp("after re-apply")
+	t.Logf("migration %d Down/Up round-trip clean; schema restored to HEAD (not to a literal)", version)
+}
+
+func identityMigrationVersion(t *testing.T) int64 {
+	t.Helper()
+	entries, err := os.ReadDir(migrationsDir)
+	if err != nil {
+		t.Fatalf("read %s: %v", migrationsDir, err)
+	}
+	for _, e := range entries {
+		if !strings.HasSuffix(e.Name(), "_identity_codes.sql") {
+			continue
+		}
+		m := migrationNumRe.FindStringSubmatch(e.Name())
+		if m == nil {
+			t.Fatalf("migration %q does not start with a version number", e.Name())
+		}
+		v, err := strconv.ParseInt(m[1], 10, 64)
+		if err != nil {
+			t.Fatalf("parse version from %q: %v", e.Name(), err)
+		}
+		return v
+	}
+	t.Fatalf("no *_identity_codes.sql migration found in %s", migrationsDir)
+	return 0
+}
