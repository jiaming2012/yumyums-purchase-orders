+// fakePostgREST records what the projection sent and answers with `status`.
+type fakePostgREST struct {
+	mu     sync.Mutex
+	status int
+	hits   []recordedUpsert
+	srv    *httptest.Server
+}
+
+type recordedUpsert struct {
+	Method, Path, Prefer, APIKey, Auth string
+	Body                               []map[string]any
+}
+
+func newFakePostgREST(t *testing.T, status int) *fakePostgREST {
+	t.Helper()
+	f := &fakePostgREST{status: status}
+	f.srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, _ := io.ReadAll(r.Body)
+		var body []map[string]any
+		_ = json.Unmarshal(raw, &body)
+		f.mu.Lock()
+		f.hits = append(f.hits, recordedUpsert{
+			Method: r.Method, Path: r.URL.Path, Prefer: r.Header.Get("Prefer"),
+			APIKey: r.Header.Get("apikey"), Auth: r.Header.Get("Authorization"), Body: body,
+		})
+		f.mu.Unlock()
+		w.WriteHeader(f.status)
+	}))
+	t.Cleanup(f.srv.Close)
+	return f
+}
+
+func (f *fakePostgREST) config() ProjectionConfig {
+	return ProjectionConfig{RESTURL: f.srv.URL, ServiceKey: "test-service-key"}
+}
+
+func (f *fakePostgREST) recorded() []recordedUpsert {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]recordedUpsert(nil), f.hits...)
+}
