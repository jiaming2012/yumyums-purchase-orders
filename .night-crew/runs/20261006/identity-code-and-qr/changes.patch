+// The shipped reader was measured up to QR version 10. A campaign with a long
+// offer line must not push a customer's code past that: the label in the QR is
+// shortened, the code itself is not weakened.
+func TestIdentityCodeLongOfferTextStaysScannable(t *testing.T) {
+	pool := setupSubsTestDB(t)
+	long := "Buy any two combos and get a free large side of our signature honey-garlic wings plus a drink"
+	camp := seedFirstTouchCampaign(t, pool, mountedMux(testDeps(pool)), "K7MNPQ", long, 1250)
+	subID := seedSubscriber(t, pool, "K7MNPQ")
+
+	token := withIdentityRand(t, 44)
+	code := mintInTx(t, pool, subID)
+	png := storedPNG(t, pool, code.MediaID)
+
+	// Find the label the mint settled on: the longest prefix whose payload
+	// reproduces the stored PNG.
+	runes := []rune(long)
+	for n := len(runes); n >= 1; n-- {
+		label := string(runes[:n])
+		if n < len(runes) {
+			label = strings.TrimRight(label, " ") + "…"
+		}
+		payload := DefaultQRBaseURL + "/r/" + token +
+			descriptorFragment(t, label, camp.ID, camp.EndsAt.UTC().Format("2006-01-02"), 12.5)
+		want, version := encodeAsTheCardDoes(t, payload)
+		if !bytes.Equal(png, want) {
+			continue
+		}
+		if n == len(runes) {
+			t.Fatalf("the full %d-char offer text was encoded at version %d — expected it to be shortened", len(runes), version)
+		}
+		if version > 10 {
+			t.Fatalf("label shortened to %q but the symbol is still version %d", label, version)
+		}
+		t.Logf("label shortened to %d of %d chars (%q); payload %d chars, version %d", n, len(runes), label, len(payload), version)
+		return
+	}
+	t.Fatal("the stored PNG matches no prefix of the offer text — the label rule is not the one this test states")
+}
