+-- +goose Up
+BEGIN;
+
+-- ===========================================================================
+-- 0088 — one permanent identity code per customer (card E1
+-- `identity-code-and-qr`, roadmap Activity E, run 20261006).
+--
+-- A subscriber gets ONE code, minted once and never rotated by an import
+-- (internal/marketing/identity.go MintIdentityCode). Three things are stored:
+--
+--   subscribers.identity_token_hash  hex(sha256(token)) — what the truck's
+--                                    scanner computes on-device from the QR and
+--                                    what the arbiter's `codes` table is keyed
+--                                    by. UNIQUE: two customers can never share
+--                                    a code. NULL until minted.
+--   subscribers.identity_minted_at   when.
+--   identity_media                   the scannable PNG itself, served at the
+--                                    public GET /m/{id}.png.
+--
+-- 🛑 THE RAW TOKEN IS IN NO COLUMN. It exists only inside the PNG's QR symbol.
+-- The hash cannot be turned back into a code; the image can be scanned. That
+-- is why the image row hangs off the subscriber with ON DELETE CASCADE: a
+-- right-to-erasure delete of the subscriber (0086 made that one statement)
+-- takes the scannable image with it, and nothing else in HQ can re-create it.
+--
+-- identity_media.id is a random uuid and is the route's ONLY secret — the
+-- route is public because a customer's phone, and the carrier fetching an MMS
+-- attachment, hold no HQ session.
+-- ===========================================================================
+
+alter table subscribers
+  add column identity_token_hash text unique null,
+  add column identity_minted_at  timestamptz null;
+
+create table identity_media (
+  id            uuid primary key default gen_random_uuid(),
+  subscriber_id uuid not null references subscribers(id) on delete cascade,
+  png           bytea not null,
+  created_at    timestamptz not null default now()
+);
+
+-- The detail sheet and the mint's idempotent arm both read "this subscriber's
+-- image"; without the index that is a scan of every stored PNG row.
+create index identity_media_subscriber_idx on identity_media (subscriber_id);
+
+COMMIT;
+
+-- +goose Down
+BEGIN;
+-- Reverse order: the image table, then the two columns (the unique constraint
+-- goes with its column). 🛑 This DESTROYS every minted code: the hashes and the
+-- images are gone and a re-apply mints NEW tokens, so a QR already on a
+-- customer's phone stops resolving. Roll the image back with the schema, and
+-- only before codes have been sent.
+DROP TABLE IF EXISTS identity_media;
+ALTER TABLE subscribers
+  DROP COLUMN IF EXISTS identity_minted_at,
+  DROP COLUMN IF EXISTS identity_token_hash;
+COMMIT;
