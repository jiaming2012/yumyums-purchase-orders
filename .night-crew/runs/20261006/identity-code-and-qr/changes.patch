+package marketing
+
+// identity.go — card E1 (`identity-code-and-qr`, roadmap Activity E, run
+// 20261006). One permanent identity code per customer.
+//
+// What a customer holds is ONE QR image. Photographed at the truck:
+//
+//   - with no signal, on a tablet that has never synced this customer, the
+//     scanner shows the offer they signed up for — it is written INTO the QR;
+//   - with signal, the scanner asks the server about the code and shows the
+//     server's answer instead.
+//
+// This file mints the code, draws the image and serves it. It sends nothing:
+// delivering the image to the customer is card `mms-send-on-signup`.
+//
+// ═══════════════════════════════════════════════════════════════════════════
+// 🛑 THREE THINGS THAT LOOK IMPROVABLE AND ARE NOT
+//
+//  1. LOW ERROR CORRECTION, A 16-CHARACTER TOKEN, A DATE-ONLY EXPIRY. The
+//     shipped scanner reads a photo of the code, and what it can read is
+//     bounded by how DENSE the symbol is, not by how large the image is. The
+//     signed spike measured it: this encoding (QR version 9) reads; the same
+//     payload at Medium (version 11) does not, at any pixel size, and one
+//     larger copy decoded to a corrupted payload. "Upgrading" to Medium makes
+//     every customer's code unreadable. tests/marketing-identity.spec.js
+//     [IC-03] is the control. Low is acceptable because the image lives on a
+//     phone screen, never on a weathered sign.
+//
+//  2. THE RAW TOKEN IS STORED NOWHERE. It exists only inside the PNG's QR
+//     symbol. HQ keeps hex(sha256(token)) — what the scanner computes on-device
+//     and what the arbiter's `codes` table is keyed by. Nothing here logs the
+//     token, returns it, or writes it to a column.
+//
+//  3. NO FIRST-TOUCH CODE → NO OFFER. A signup that did not come through a
+//     campaign's QR gets a code that says who they are and nothing else: no
+//     `#o=` fragment, and no entitlement row is projected. Which campaign such
+//     a signup is entitled to is an OPERATOR decision (the card's PARK note);
+//     this file never guesses one.
+// ═══════════════════════════════════════════════════════════════════════════
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha1"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log/slog"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/jackc/pgx/v5"
+	qrcode "github.com/skip2/go-qrcode"
+)
+
+// identityAlphabet is the token alphabet: digits and lower-case letters with
+// 0, 1, i, l and o removed, so a token read aloud or retyped cannot be
+// mistaken. 31 symbols × 16 characters is a little over 79 bits.
+const identityAlphabet = "23456789abcdefghjkmnpqrstuvwxyz"
+
+// identityTokenLen is fixed by the signed encoding (see the file comment).
+const identityTokenLen = 16
+
+// identityPNGSize is the stored image's edge in pixels.
+const identityPNGSize = 512
+
+// identityMaxQRVersion is the densest symbol the shipped reader was MEASURED
+// to read from a photo (spike 01's variant table: versions 9 and 10 read,
+// version 11 did not). A payload that would encode above it has its embedded
+// label shortened — see buildIdentityQR.
+const identityMaxQRVersion = 10
+
+// defaultIdentityRand is the token's entropy source; identityRand is the
+// variable the mint reads, so a test can hand it a fixed stream and know the
+// token without it ever having been stored.
+var (
+	defaultIdentityRand io.Reader = rand.Reader
+	identityRand                  = defaultIdentityRand
+)
+
+// ErrSubscriberNotFound is returned by the mint for an id that names nobody.
+var ErrSubscriberNotFound = errors.New("marketing: subscriber not found")
+
+// IdentityCode is what a mint reports. It carries no token and no payload.
+type IdentityCode struct {
+	SubscriberID string
+	TokenHash    string
+	// MediaID is the identity_media row holding the PNG — GET /m/{MediaID}.png.
+	MediaID string
+	// CampaignID and ExpiresAt describe the first-touch campaign the code's
+	// entitlement comes from. Both are zero for an identity-only code.
+	CampaignID string
+	ExpiresAt  time.Time
+	// Minted is false when the subscriber already had a code and it was
+	// returned unchanged.
+	Minted bool
+}
+
+// identityDescriptor is the offer written into the QR. The four keys, and
+// their ORDER, are the ones the shipped reader's parseEmbeddedOffer reads
+// (marketing/scanner.js) — the descriptor contract is not this card's to
+// change.
+type identityDescriptor struct {
+	Label      string  `json:"label"`
+	CampaignID string  `json:"campaign_id"`
+	ExpiresAt  string  `json:"expires_at"`
+	FaceValue  float64 `json:"face_value"`
+}
+
+// newIdentityToken draws identityTokenLen characters from identityAlphabet.
+// Bytes at or above the largest multiple of 31 are discarded rather than
+// folded, so every symbol is equally likely.
+func newIdentityToken(r io.Reader) (string, error) {
+	const n = len(identityAlphabet)
+	limit := byte(256 - 256%n)
+	out := make([]byte, 0, identityTokenLen)
+	buf := make([]byte, 1)
+	for len(out) < identityTokenLen {
+		if _, err := io.ReadFull(r, buf); err != nil {
+			return "", fmt.Errorf("read entropy: %w", err)
+		}
+		if buf[0] >= limit {
+			continue
+		}
+		out = append(out, identityAlphabet[int(buf[0])%n])
+	}
+	return string(out), nil
+}
+
+func identityTokenHash(token string) string {
+	sum := sha256.Sum256([]byte(token))
+	return hex.EncodeToString(sum[:])
+}
+
+// identityPayload is the text the QR encodes: the URL wrapping the token, plus
+// — only when there is an offer — the descriptor as base64url JSON in the
+// FRAGMENT, so a customer who opens the URL on their own phone never sends the
+// descriptor to any server.
+func identityPayload(baseURL, token string, d *identityDescriptor) (string, error) {
+	payload := strings.TrimRight(baseURL, "/") + "/r/" + token
+	if d == nil {
+		return payload, nil
+	}
+	raw, err := json.Marshal(d)
+	if err != nil {
+		return "", fmt.Errorf("marshal descriptor: %w", err)
+	}
+	return payload + "#o=" + base64.RawURLEncoding.EncodeToString(raw), nil
+}
+
+// buildIdentityQR draws the PNG at the signed encoding.
+//
+// A campaign with a long offer line would otherwise push the symbol past the
+// densest version the shipped reader was measured to read. When that happens
+// the LABEL written into the QR is shortened, one character at a time, to the
+// longest prefix that fits, and ends in "…". Nothing else gives: the token,
+// the campaign id, the expiry and the correction level are untouched, and the
+// full offer text is still what the server answers with online. An ordinary
+// offer line ("Free side of wings", "$2 off any 6pc wings") is never touched.
+func buildIdentityQR(baseURL, token string, d *identityDescriptor) ([]byte, error) {
+	encode := func(desc *identityDescriptor) (*qrcode.QRCode, error) {
+		payload, err := identityPayload(baseURL, token, desc)
+		if err != nil {
+			return nil, err
+		}
+		return qrcode.New(payload, qrcode.Low)
+	}
+	q, err := encode(d)
+	if d != nil {
+		full := []rune(d.Label)
+		for n := len(full) - 1; n >= 1 && (err != nil || q.VersionNumber > identityMaxQRVersion); n-- {
+			short := *d
+			short.Label = strings.TrimRight(string(full[:n]), " ") + "…"
+			q, err = encode(&short)
+		}
+	}
+	if err != nil {
+		return nil, fmt.Errorf("encode identity qr: %w", err)
+	}
+	png, err := q.PNG(identityPNGSize)
+	if err != nil {
+		return nil, fmt.Errorf("render identity qr: %w", err)
+	}
+	return png, nil
+}
+
+// identityBaseURL resolves the host the QR encodes the way NewDeps does, for
+// callers that hold no Deps.
+func identityBaseURL() string {
+	if v := strings.TrimRight(os.Getenv(QRBaseURLEnv), "/"); v != "" {
+		return v
+	}
+	return DefaultQRBaseURL
+}
+
+// MintIdentityCode gives a subscriber their one permanent identity code.
+//
+// It is IDEMPOTENT: a subscriber who already has a code gets that code back,
+// unchanged, and Minted is false. The subscriber row is locked for the mint, so
+// two concurrent calls cannot both draw a token.
+//
+// The offer written into the QR is the subscriber's FIRST-TOUCH campaign
+// (source_short → qr_codes.campaign_id → campaigns_admin). With no first-touch
+// code the payload is the bare URL and CampaignID is empty.
+//
+// It writes inside the caller's transaction and reaches no network.
+func MintIdentityCode(ctx context.Context, tx pgx.Tx, subscriberID string) (IdentityCode, error) {
+	return mintIdentityCode(ctx, tx, subscriberID, identityBaseURL())
+}
+
+func mintIdentityCode(ctx context.Context, tx pgx.Tx, subscriberID, baseURL string) (IdentityCode, error) {
+	var (
+		existing   *string
+		campaignID *string
+		offerText  *string
+		faceCents  *int
+		endsAt     *time.Time
+	)
+	err := tx.QueryRow(ctx, `
+		SELECT s.identity_token_hash, c.id::text, c.offer_text, c.face_value_cents, c.ends_at
+		  FROM subscribers s
+		  LEFT JOIN qr_codes k ON k.short = s.source_short
+		  LEFT JOIN campaigns_admin c ON c.id = k.campaign_id
+		 WHERE s.id = $1
+		   FOR UPDATE OF s`, subscriberID).
+		Scan(&existing, &campaignID, &offerText, &faceCents, &endsAt)
+	if errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {
+		return IdentityCode{}, ErrSubscriberNotFound
+	}
+	if err != nil {
+		return IdentityCode{}, fmt.Errorf("load subscriber for mint: %w", err)
+	}
+
+	code := IdentityCode{SubscriberID: subscriberID}
+	var desc *identityDescriptor
+	if campaignID != nil {
+		code.CampaignID = *campaignID
+		code.ExpiresAt = *endsAt
+		desc = &identityDescriptor{
+			Label:      *offerText,
+			CampaignID: *campaignID,
+			// Date-only, in UTC: the reader parses a bare date as UTC midnight,
+			// so the offline display never outlives the campaign's real end.
+			ExpiresAt: endsAt.UTC().Format("2006-01-02"),
+			FaceValue: float64(*faceCents) / 100.0,
+		}
+	}
+
+	if existing != nil {
+		code.TokenHash = *existing
+		if err := tx.QueryRow(ctx, `
+			SELECT id::text FROM identity_media
+			 WHERE subscriber_id = $1 ORDER BY created_at DESC, id LIMIT 1`, subscriberID).
+			Scan(&code.MediaID); err != nil {
+			return IdentityCode{}, fmt.Errorf("load identity media: %w", err)
+		}
+		return code, nil
+	}
+
+	token, err := newIdentityToken(identityRand)
+	if err != nil {
+		return IdentityCode{}, err
+	}
+	png, err := buildIdentityQR(baseURL, token, desc)
+	if err != nil {
+		return IdentityCode{}, err
+	}
+	code.TokenHash = identityTokenHash(token)
+	if _, err := tx.Exec(ctx, `
+		UPDATE subscribers SET identity_token_hash = $2, identity_minted_at = now()
+		 WHERE id = $1`, subscriberID, code.TokenHash); err != nil {
+		return IdentityCode{}, fmt.Errorf("store identity hash: %w", err)
+	}
+	if err := tx.QueryRow(ctx, `
+		INSERT INTO identity_media (subscriber_id, png) VALUES ($1, $2)
+		RETURNING id::text`, subscriberID, png).Scan(&code.MediaID); err != nil {
+		return IdentityCode{}, fmt.Errorf("store identity media: %w", err)
+	}
+	code.Minted = true
+	return code, nil
+}
+
+// identityCodeNamespace is RFC 4122's URL namespace.
+var identityCodeNamespace = [16]byte{
+	0x6b, 0xa7, 0xb8, 0x11, 0x9d, 0xad, 0x11, 0xd1,
+	0x80, 0xb4, 0x00, 0xc0, 0x4f, 0xd4, 0x30, 0xc8,
+}
+
+// IdentityCodeID is the arbiter row's id for a subscriber's identity code: a
+// version-5 uuid over a URL naming the subscriber. It is derived, not drawn,
+// so projecting the same subscriber twice writes the same row.
+//
+// tests/marketing-identity.spec.js derives it the same way; change both or
+// neither. Changing it at all orphans every row already projected.
+func IdentityCodeID(subscriberID string) string {
+	h := sha1.New()
+	h.Write(identityCodeNamespace[:])
+	h.Write([]byte(DefaultQRBaseURL + "/identity-code/" + strings.ToLower(subscriberID)))
+	u := h.Sum(nil)[:16]
+	u[6] = (u[6] & 0x0f) | 0x50 // version 5
+	u[8] = (u[8] & 0x3f) | 0x80 // RFC 4122 variant
+	x := hex.EncodeToString(u)
+	return x[0:8] + "-" + x[8:12] + "-" + x[12:16] + "-" + x[16:20] + "-" + x[20:]
+}
+
+// WarningIdentityNotMinted is reported by an import when a new subscriber was
+// saved but their code could not be minted. The subscriber is kept.
+const WarningIdentityNotMinted = "identity_not_minted"
+
+// mintForNewSubscribers runs after an import's transaction has committed: one
+// short transaction per new subscriber, then — for a code that carries an
+// offer — the projection to the arbiter.
+//
+// Nothing here can undo the import or a mint. A projection that is
+// unconfigured or failing leaves the code minted and adds "not_projected" to
+// the returned warnings (decision 187's shape); after the first failure the
+// rest of this import's projections are skipped rather than each waiting out
+// a dead substrate inside one manager's request.
+func mintForNewSubscribers(ctx context.Context, d Deps, subscriberIDs []string) []string {
+	var notMinted, notProjected bool
+	projectionDown := !d.Projection.Configured()
+	for _, id := range subscriberIDs {
+		code, err := mintOne(ctx, d, id)
+		if err != nil {
+			slog.Error("marketing: identity code not minted; the subscriber is saved without one",
+				"error", err, "subscriber_id", id)
+			notMinted = true
+			continue
+		}
+		if code.CampaignID == "" {
+			continue // identity-only: there is no entitlement to project
+		}
+		if projectionDown {
+			notProjected = true
+			continue
+		}
+		if err := ProjectIdentityCode(ctx, d.Projection, IdentityProjectionRow{
+			ID:         IdentityCodeID(id),
+			TokenHash:  code.TokenHash,
+			CampaignID: code.CampaignID,
+			ExpiresAt:  code.ExpiresAt,
+		}); err != nil {
+			slog.Error("marketing: identity code projection failed; the code is minted but the arbiter does not know it",
+				"error", err, "subscriber_id", id)
+			notProjected = true
+			projectionDown = true
+		}
+	}
+	var warnings []string
+	if notProjected {
+		warnings = append(warnings, WarningNotProjected)
+	}
+	if notMinted {
+		warnings = append(warnings, WarningIdentityNotMinted)
+	}
+	return warnings
+}
+
+func mintOne(ctx context.Context, d Deps, subscriberID string) (IdentityCode, error) {
+	tx, err := d.Pool.Begin(ctx)
+	if err != nil {
+		return IdentityCode{}, err
+	}
+	defer func() { _ = tx.Rollback(ctx) }()
+	code, err := mintIdentityCode(ctx, tx, subscriberID, d.QRBaseURL)
+	if err != nil {
+		return IdentityCode{}, err
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return IdentityCode{}, err
+	}
+	return code, nil
+}
+
+// identityMediaPath is the public path of a stored identity image.
+func identityMediaPath(mediaID string) string {
+	return "/m/" + mediaID + ".png"
+}
+
+// IdentityMediaHandler serves GET and HEAD /m/{id}.png: a subscriber's
+// identity-code image.
+//
+// It is PUBLIC — mounted by MountPublic, outside every gate — because the two
+// things that fetch it hold no HQ session: the customer's phone, and the
+// carrier collecting an MMS attachment. The media id is a random uuid and is
+// the route's only secret, so an unknown id and a malformed id are the same
+// 404.
+//
+// Cache-Control is PRIVATE: the image identifies one person and must not sit
+// in a shared cache.
+func IdentityMediaHandler(d Deps) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		id := chi.URLParam(r, "id")
+		var png []byte
+		err := d.Pool.QueryRow(r.Context(),
+			`SELECT png FROM identity_media WHERE id = $1`, id).Scan(&png)
+		if errors.Is(err, pgx.ErrNoRows) || isBadUUID(err) {
+			writeError(w, http.StatusNotFound, "not_found")
+			return
+		}
+		if err != nil {
+			slog.Error("marketing: load identity media", "error", err)
+			writeError(w, http.StatusInternalServerError, "internal_error")
+			return
+		}
+		w.Header().Set("Content-Type", "image/png")
+		w.Header().Set("Cache-Control", "private, max-age=3600")
+		w.Header().Set("Content-Length", strconv.Itoa(len(png)))
+		w.WriteHeader(http.StatusOK)
+		if r.Method != http.MethodHead {
+			_, _ = w.Write(png)
+		}
+	}
+}
diff --git a/backend/internal/marketing/identity_test.go b/backend/internal/marketing/identity_test.go
new file mode 100644
index 0000000..3c10f55
--- /dev/null
+++ b/backend/internal/marketing/identity_test.go
@@ -0,0 +1,791 @@
+package marketing
+
+// identity_test.go — card E1 (`identity-code-and-qr`, roadmap Activity E).
+//
+// The five named gates, and three that ride with them:
+//
+//	TestMintIdentityCodeIsIdempotent                  one code per customer, for good
+//	TestMintIdentityCodeNoFirstTouchIsIdentityOnly    no campaign → no offer in the QR, nothing projected
+//	TestProjectIdentityCodeUpserts                    the arbiter row, and a failed projection keeps the mint
+//	TestMigration0088IdentityCodesDownAndUpRoundTrip  0088's Down, run
+//	(TestNothingInThisPackageSends is subscribers_test.go's, unedited)
+//
+//	TestIdentityMediaRouteIsPublicPNG                 GET/HEAD /m/{id}.png
+//	TestSubscriberDetailReportsIdentityCodeStatus     not_minted → minted → sent
+//	TestIdentityCodeLongOfferTextStaysScannable       a long offer never produces a denser symbol
+//
+// 🛑 No test here learns a token from the database — there is none there. The
+// token is fixed by handing the mint a known random stream (withIdentityRand),
+// and every claim about the QR is made by re-encoding the expected payload and
+// comparing it to the stored PNG byte for byte.
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+	qrcode "github.com/skip2/go-qrcode"
+	"github.com/yumyums/hq/internal/db"
+)
+
+// withIdentityRand swaps the mint's random source for a fixed stream and
+// returns the token that stream produces, so a test knows the token without it
+// ever having been stored.
+func withIdentityRand(t *testing.T, seed byte) string {
+	t.Helper()
+	stream := make([]byte, 256)
+	for i := range stream {
+		stream[i] = seed + byte(i*7)
+	}
+	token, err := newIdentityToken(bytes.NewReader(stream))
+	if err != nil {
+		t.Fatalf("newIdentityToken on the fixed stream: %v", err)
+	}
+	prev := identityRand
+	identityRand = bytes.NewReader(stream)
+	t.Cleanup(func() { identityRand = prev })
+	return token
+}
+
+func sha256Hex(s string) string {
+	sum := sha256.Sum256([]byte(s))
+	return hex.EncodeToString(sum[:])
+}
+
+// seedFirstTouchCampaign creates a campaign through the real route and
+// re-points its first code's short, returning the campaign.
+func seedFirstTouchCampaign(t *testing.T, pool *pgxpool.Pool, mux *chi.Mux, short, offerText string, cents int) campaignDTO {
+	t.Helper()
+	mgr := seedUser(t, pool, "manager")
+	created := createCampaign(t, mux, mgr, map[string]any{
+		"name": "Wing Wednesday " + randSuffix(t), "offer_text": offerText,
+		"face_value_cents": cents, "runs_days": 14,
+		"channels": []map[string]any{{"channel": "flyer"}},
+	})
+	if _, err := pool.Exec(context.Background(),
+		`UPDATE qr_codes SET short = $2 WHERE id = $1`, created.Codes[0].ID, short); err != nil {
+		t.Fatalf("re-point the code's short: %v", err)
+	}
+	return created.Campaign
+}
+
+// seedSubscriber inserts one subscriber directly; short "" means no first touch.
+func seedSubscriber(t *testing.T, pool *pgxpool.Pool, short string) string {
+	t.Helper()
+	var id string
+	if err := pool.QueryRow(context.Background(), `
+		INSERT INTO subscribers (display_name, email, source, source_short, joined_at)
+		VALUES ('Identity Test', $1, 'web_form', NULLIF($2,''), now())
+		RETURNING id::text`,
+		"ic-"+randSuffix(t)+"@test.invalid", short).Scan(&id); err != nil {
+		t.Fatalf("seedSubscriber: %v", err)
+	}
+	return id
+}
+
+// mintInTx runs MintIdentityCode in its own committed transaction.
+func mintInTx(t *testing.T, pool *pgxpool.Pool, subID string) IdentityCode {
+	t.Helper()
+	ctx := context.Background()
+	tx, err := pool.Begin(ctx)
+	if err != nil {
+		t.Fatalf("begin: %v", err)
+	}
+	defer func() { _ = tx.Rollback(ctx) }()
+	code, err := MintIdentityCode(ctx, tx, subID)
+	if err != nil {
+		t.Fatalf("MintIdentityCode: %v", err)
+	}
+	if err := tx.Commit(ctx); err != nil {
+		t.Fatalf("commit: %v", err)
+	}
+	return code
+}
+
+func storedPNG(t *testing.T, pool *pgxpool.Pool, mediaID string) []byte {
+	t.Helper()
+	var png []byte
+	if err := pool.QueryRow(context.Background(),
+		`SELECT png FROM identity_media WHERE id = $1`, mediaID).Scan(&png); err != nil {
+		t.Fatalf("read identity_media %s: %v", mediaID, err)
+	}
+	return png
+}
+
+// encodeAsTheCardDoes is the spec's encoding, restated independently of the
+// code under test: Low correction, 512 px.
+func encodeAsTheCardDoes(t *testing.T, payload string) (png []byte, version int) {
+	t.Helper()
+	q, err := qrcode.New(payload, qrcode.Low)
+	if err != nil {
+		t.Fatalf("encode %q: %v", payload, err)
+	}
+	png, err = q.PNG(512)
+	if err != nil {
+		t.Fatalf("png: %v", err)
+	}
+	return png, q.VersionNumber
+}
+
+func descriptorFragment(t *testing.T, label, campaignID, expires string, faceValue float64) string {
+	t.Helper()
+	// Key ORDER is part of the byte-for-byte comparison, so this is a struct
+	// and not a map.
+	raw, err := json.Marshal(struct {
+		Label      string  `json:"label"`
+		CampaignID string  `json:"campaign_id"`
+		ExpiresAt  string  `json:"expires_at"`
+		FaceValue  float64 `json:"face_value"`
+	}{label, campaignID, expires, faceValue})
+	if err != nil {
+		t.Fatalf("marshal descriptor: %v", err)
+	}
+	return "#o=" + base64.RawURLEncoding.EncodeToString(raw)
+}
+
+// A customer gets one code and keeps it: minting twice — and importing twice —
+// leaves the same hash, the same image and one image row.
+func TestMintIdentityCodeIsIdempotent(t *testing.T) {
+	pool := setupSubsTestDB(t)
+	ctx := context.Background()
+	d := testDeps(pool)
+	camp := seedFirstTouchCampaign(t, pool, mountedMux(d), "K7MNPQ", "Free side of wings", 200)
+	subID := seedSubscriber(t, pool, "K7MNPQ")
+
+	token := withIdentityRand(t, 3)
+	if len(token) != 16 {
+		t.Fatalf("token %q is %d chars, want 16", token, len(token))
+	}
+	for _, r := range token {
+		if !strings.ContainsRune("23456789abcdefghjkmnpqrstuvwxyz", r) {
+			t.Fatalf("token %q carries %q, which is outside the alphabet", token, r)
+		}
+	}
+
+	first := mintInTx(t, pool, subID)
+	if !first.Minted {
+		t.Error("first mint reported Minted=false")
+	}
+	if first.TokenHash != sha256Hex(token) {
+		t.Fatalf("token_hash = %s, want hex(sha256(token)) = %s", first.TokenHash, sha256Hex(token))
+	}
+	if first.CampaignID != camp.ID {
+		t.Errorf("CampaignID = %q, want the first-touch campaign %q", first.CampaignID, camp.ID)
+	}
+	if !first.ExpiresAt.Equal(camp.EndsAt) {
+		t.Errorf("ExpiresAt = %s, want the campaign's ends_at %s", first.ExpiresAt, camp.EndsAt)
+	}
+
+	var storedHash string
+	var mintedAt *time.Time
+	if err := pool.QueryRow(ctx,
+		`SELECT identity_token_hash, identity_minted_at FROM subscribers WHERE id = $1`, subID).
+		Scan(&storedHash, &mintedAt); err != nil {
+		t.Fatalf("read the subscriber: %v", err)
+	}
+	if storedHash != first.TokenHash || mintedAt == nil {
+		t.Fatalf("subscriber row holds hash %q / minted_at %v, want %q and a timestamp", storedHash, mintedAt, first.TokenHash)
+	}
+
+	// The stored image IS the spec's payload at the spec's encoding.
+	wantPayload := DefaultQRBaseURL + "/r/" + token +
+		descriptorFragment(t, "Free side of wings", camp.ID, camp.EndsAt.UTC().Format("2006-01-02"), 2)
+	wantPNG, version := encodeAsTheCardDoes(t, wantPayload)
+	png := storedPNG(t, pool, first.MediaID)
+	if !bytes.Equal(png, wantPNG) {
+		t.Fatalf("stored PNG is not qrcode.New(%q, Low).PNG(512)", wantPayload)
+	}
+	if version > 10 {
+		t.Errorf("the card's payload encodes at version %d; the shipped reader was measured to version 10", version)
+	}
+	t.Logf("payload %d chars, QR version %d at Low", len(wantPayload), version)
+
+	// 🛑 The raw token is in no row.
+	for _, q := range []string{
+		`SELECT count(*) FROM subscribers s WHERE to_jsonb(s)::text LIKE '%' || $1 || '%'`,
+		`SELECT count(*) FROM subscriber_events e WHERE to_jsonb(e)::text LIKE '%' || $1 || '%'`,
+	} {
+		if n := countRows(t, pool, q, token); n != 0 {
+			t.Errorf("the raw token appears in %d row(s): %s", n, q)
+		}
+	}
+
+	// Mint again with a DIFFERENT random stream: nothing may move.
+	withIdentityRand(t, 91)
+	second := mintInTx(t, pool, subID)
+	if second.Minted {
+		t.Error("second mint reported Minted=true — it must return the existing code")
+	}
+	if second.TokenHash != first.TokenHash || second.MediaID != first.MediaID {
+		t.Fatalf("second mint = hash %s / media %s, want the first's %s / %s",
+			second.TokenHash, second.MediaID, first.TokenHash, first.MediaID)
+	}
+	if second.CampaignID != first.CampaignID || !second.ExpiresAt.Equal(first.ExpiresAt) {
+		t.Errorf("second mint's campaign/expiry = %q/%s, want %q/%s",
+			second.CampaignID, second.ExpiresAt, first.CampaignID, first.ExpiresAt)
+	}
+	if n := countRows(t, pool, `SELECT count(*) FROM identity_media WHERE subscriber_id = $1`, subID); n != 1 {
+		t.Fatalf("identity_media rows = %d, want 1", n)
+	}
+	if !bytes.Equal(storedPNG(t, pool, first.MediaID), wantPNG) {
+		t.Fatal("the stored PNG changed on the second mint")
+	}
+
+	// And through the import: every NEW subscriber is minted, a re-import
+	// mints nobody and rotates nothing. The real random source goes back first:
+	// two subscribers minted from one fixed stream would collide on the unique
+	// hash, which is the constraint doing its job, not the behaviour under test.
+	identityRand = defaultIdentityRand
+	res, err := ImportSubscribers(ctx, d, ffImporter(t))
+	if err != nil {
+		t.Fatalf("first import: %v", err)
+	}
+	if res.Created != 4 {
+		t.Fatalf("first import created %d, want 4", res.Created)
+	}
+	before := identityHashes(t, pool)
+	if len(before) != 5 { // the four imported + the one seeded above
+		t.Fatalf("%d subscribers carry a code after the import, want 5: %v", len(before), before)
+	}
+	if _, err := ImportSubscribers(ctx, d, ffImporter(t)); err != nil {
+		t.Fatalf("second import: %v", err)
+	}
+	after := identityHashes(t, pool)
+	if len(after) != len(before) {
+		t.Fatalf("re-import changed the minted count: %d → %d", len(before), len(after))
+	}
+	for id, h := range before {
+		if after[id] != h {
+			t.Errorf("subscriber %s's code rotated on re-import: %s → %s", id, h, after[id])
+		}
+	}
+	if n := countRows(t, pool, `SELECT count(*) FROM identity_media`); n != 5 {
+		t.Errorf("identity_media rows = %d after two imports, want 5", n)
+	}
+}
+
+func identityHashes(t *testing.T, pool *pgxpool.Pool) map[string]string {
+	t.Helper()
+	rows, err := pool.Query(context.Background(),
+		`SELECT id::text, identity_token_hash FROM subscribers WHERE identity_token_hash IS NOT NULL`)
+	if err != nil {
+		t.Fatalf("read hashes: %v", err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var id, h string
+		if err := rows.Scan(&id, &h); err != nil {
+			t.Fatalf("scan: %v", err)
+		}
+		out[id] = h
+	}
+	return out
+}
