+// GET and HEAD /m/{id}.png: public, image/png, privately cached for an hour,
+// and 404 for anything that is not a stored image.
+func TestIdentityMediaRouteIsPublicPNG(t *testing.T) {
+	pool := setupSubsTestDB(t)
+	mux := mountedMux(testDeps(pool))
+	code := mintInTx(t, pool, seedSubscriber(t, pool, ""))
+	want := storedPNG(t, pool, code.MediaID)
+
+	// context.Background(): no user, no session — the route is public.
+	rec := do(t, mux, context.Background(), http.MethodGet, "/m/"+code.MediaID+".png", nil)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("GET = %d, want 200\nbody: %s", rec.Code, rec.Body.String())
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "image/png" {
+		t.Errorf("Content-Type = %q, want image/png", ct)
+	}
+	if cc := rec.Header().Get("Cache-Control"); cc != "private, max-age=3600" {
+		t.Errorf("Cache-Control = %q, want private, max-age=3600", cc)
+	}
+	if !bytes.Equal(rec.Body.Bytes(), want) {
+		t.Error("GET body is not the stored PNG")
+	}
+	if !bytes.HasPrefix(rec.Body.Bytes(), []byte("\x89PNG\r\n\x1a\n")) {
+		t.Error("GET body does not start with the PNG signature")
+	}
+
+	head := do(t, mux, context.Background(), http.MethodHead, "/m/"+code.MediaID+".png", nil)
+	if head.Code != http.StatusOK || head.Body.Len() != 0 {
+		t.Errorf("HEAD = %d with %d body bytes, want 200 and none", head.Code, head.Body.Len())
+	}
+	if cl := head.Header().Get("Content-Length"); cl != strconv.Itoa(len(want)) {
+		t.Errorf("HEAD Content-Length = %q, want %d", cl, len(want))
+	}
+
+	for _, id := range []string{"00000000-0000-4000-8000-000000000000", "not-a-uuid", code.MediaID + "x"} {
+		for _, method := range []string{http.MethodGet, http.MethodHead} {
+			if rec := do(t, mux, context.Background(), method, "/m/"+id+".png", nil); rec.Code != http.StatusNotFound {
+				t.Errorf("%s /m/%s.png = %d, want 404", method, id, rec.Code)
+			}
+		}
+	}
+}
