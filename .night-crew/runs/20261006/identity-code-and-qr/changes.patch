+// A signup with no first-touch code gets a code that says who they are and
+// nothing about an offer, and no entitlement row is written anywhere.
+func TestMintIdentityCodeNoFirstTouchIsIdentityOnly(t *testing.T) {
+	pool := setupSubsTestDB(t)
+	ctx := context.Background()
+	subID := seedSubscriber(t, pool, "")
+
+	token := withIdentityRand(t, 17)
+	code := mintInTx(t, pool, subID)
+	if code.CampaignID != "" || !code.ExpiresAt.IsZero() {
+		t.Fatalf("identity-only code carries campaign %q / expiry %s, want neither", code.CampaignID, code.ExpiresAt)
+	}
+	if code.TokenHash != sha256Hex(token) {
+		t.Fatalf("token_hash = %s, want %s", code.TokenHash, sha256Hex(token))
+	}
+	wantPayload := DefaultQRBaseURL + "/r/" + token
+	if strings.Contains(wantPayload, "#o=") {
+		t.Fatal("test bug: the expected identity-only payload carries a fragment")
+	}
+	wantPNG, version := encodeAsTheCardDoes(t, wantPayload)
+	if !bytes.Equal(storedPNG(t, pool, code.MediaID), wantPNG) {
+		t.Fatalf("stored PNG is not the bare %q — an identity-only code must carry no #o= fragment", wantPayload)
+	}
+	t.Logf("identity-only payload %d chars, QR version %d", len(wantPayload), version)
+
+	// Through the import, with a projection that WOULD answer: the fixture's
+	// one short (K7MNPQ) names no code here, so all four signups are
+	// identity-only — and the substrate must hear nothing.
+	identityRand = defaultIdentityRand
+	fake := newFakePostgREST(t, http.StatusCreated)
+	d := testDeps(pool)
+	d.Projection = fake.config()
+	res, err := ImportSubscribers(ctx, d, ffImporter(t))
+	if err != nil {
+		t.Fatalf("import: %v", err)
+	}
+	if res.Created != 4 {
+		t.Fatalf("import created %d, want 4", res.Created)
+	}
+	if n := countRows(t, pool,
+		`SELECT count(*) FROM subscribers WHERE identity_token_hash IS NOT NULL AND source_short IS NULL`); n != 5 {
+		t.Fatalf("%d identity-only subscribers minted, want 5 (four imported + one seeded)", n)
+	}
+	if hits := fake.recorded(); len(hits) != 0 {
+		t.Fatalf("the projection was called %d time(s) for identity-only codes, want 0: %+v", len(hits), hits)
+	}
+	if len(res.Warnings) != 0 {
+		t.Errorf("warnings = %v, want none — nothing was owed to the substrate", res.Warnings)
+	}
+
+	// Unconfigured projection, still nothing owed: no warning either.
+	if _, err := pool.Exec(ctx, `TRUNCATE subscriber_events, subscribers RESTART IDENTITY CASCADE`); err != nil {
+		t.Fatalf("truncate: %v", err)
+	}
+	res, err = ImportSubscribers(ctx, testDeps(pool), ffImporter(t))
+	if err != nil {
+		t.Fatalf("import (unconfigured): %v", err)
+	}
+	if len(res.Warnings) != 0 {
+		t.Errorf("warnings = %v with no campaign anywhere, want none", res.Warnings)
+	}
+}
