+// qrgen draws one QR PNG with the same library the server mints identity codes
+// with (go-qrcode), at a chosen error-correction level, and reports the QR
+// version it came out at.
+//
+// It is a TEST TOOL, not part of the server: tests/marketing-identity.spec.js
+// [IC-03] uses it to draw the negative control — an identity payload at Medium
+// correction, which the shipped scanner cannot read off a photo — and to check
+// that the server's own PNG is the Low/512 drawing of its payload. The server
+// image builds ./cmd/server only.
+//
+//	go run ./cmd/qrgen <payload> <out.png> <size-px> <L|M|Q|H>
+//
+// Prints one line: version=<n> modules=<n> bytes=<n> payload_len=<n> level=<x>
+// (modules excludes the 4-module quiet zone on each side).
+package main
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+
+	qrcode "github.com/skip2/go-qrcode"
+)
+
+func main() {
+	if len(os.Args) != 5 {
+		fmt.Fprintln(os.Stderr, "usage: qrgen <payload> <out.png> <size-px> <L|M|Q|H>")
+		os.Exit(2)
+	}
+	payload, out := os.Args[1], os.Args[2]
+	size, err := strconv.Atoi(os.Args[3])
+	if err != nil || size <= 0 {
+		fmt.Fprintln(os.Stderr, "bad size")
+		os.Exit(2)
+	}
+	level, ok := map[string]qrcode.RecoveryLevel{
+		"L": qrcode.Low, "M": qrcode.Medium, "Q": qrcode.High, "H": qrcode.Highest,
+	}[os.Args[4]]
+	if !ok {
+		fmt.Fprintln(os.Stderr, "bad level (want L, M, Q or H)")
+		os.Exit(2)
+	}
+	q, err := qrcode.New(payload, level)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "encode:", err)
+		os.Exit(1)
+	}
+	png, err := q.PNG(size)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "png:", err)
+		os.Exit(1)
+	}
+	if err := os.WriteFile(out, png, 0o644); err != nil {
+		fmt.Fprintln(os.Stderr, "write:", err)
+		os.Exit(1)
+	}
+	fmt.Printf("version=%d modules=%d bytes=%d payload_len=%d level=%s\n",
+		q.VersionNumber, len(q.Bitmap())-8, len(png), len(payload), os.Args[4])
+}
