+// density-probe — evidence script for card identity-code-and-qr (run 20261006). NOT part of the
+// suite: it was run from tests/ under a throwaway name and is kept beside its output as a record.
+//
+// Question: is "the shipped photo-scan decoder reads a Low/version-9 identity code and does not
+// read a Medium/version-11 one" a property of the ENCODING, or of the one symbol the spike drew?
+//
+// Method: N random 16-character tokens. For each, the card's payload (and variants of it) is
+// drawn by backend/cmd/qrgen — the server's own go-qrcode — and decoded in the shipped
+// marketing.html page by the vendored decoder (lib/html5-qrcode.min.js, the same
+// Html5Qrcode#scanFile the scanner's "Scan from photo" calls), a fresh instance per image on a
+// 640 px offscreen surface. A decode counts only if the text equals the payload.
+const { test } = require('@playwright/test');
+const { execFileSync } = require('child_process');
+const crypto = require('crypto');
+const path = require('path');
+const fs = require('fs');
+const ALPHA = '23456789abcdefghjkmnpqrstuvwxyz';
+const N = Number(process.env.PROBE_N || 60);
+function token() { let t = ''; while (t.length < 16) { const b = crypto.randomBytes(1)[0]; if (b < 248) t += ALPHA[b % 31]; } return t; }
+const b64 = (o) => Buffer.from(JSON.stringify(o)).toString('base64url');
+const BASE = 'https://hq.yumyums.kitchen/r/';
+const VARIANTS = [
+  { name: 'card: full descriptor, Low, 512px', level: 'L', size: 512, payload: (t, c) => `${BASE}${t}#o=${b64({ label: 'Free side of wings', campaign_id: c, expires_at: '2026-10-20', face_value: 2 })}` },
+  { name: 'control: full descriptor, MEDIUM, 512px', level: 'M', size: 512, payload: (t, c) => `${BASE}${t}#o=${b64({ label: 'Free side of wings', campaign_id: c, expires_at: '2026-10-20', face_value: 2 })}` },
+  { name: 'full descriptor, Low, 1024px', level: 'L', size: 1024, payload: (t, c) => `${BASE}${t}#o=${b64({ label: 'Free side of wings', campaign_id: c, expires_at: '2026-10-20', face_value: 2 })}` },
+  { name: 'full descriptor, Low, 488px (8px modules exactly)', level: 'L', size: 488, payload: (t, c) => `${BASE}${t}#o=${b64({ label: 'Free side of wings', campaign_id: c, expires_at: '2026-10-20', face_value: 2 })}` },
+  { name: 'descriptor WITHOUT campaign_id, Low, 512px', level: 'L', size: 512, payload: (t) => `${BASE}${t}#o=${b64({ label: 'Free side of wings', expires_at: '2026-10-20', face_value: 2 })}` },
+  { name: 'descriptor label only, Low, 512px', level: 'L', size: 512, payload: (t) => `${BASE}${t}#o=${b64({ label: 'Free side of wings' })}` },
+  { name: 'identity-only (no descriptor), Low, 512px', level: 'L', size: 512, payload: (t) => `${BASE}${t}` },
+];
+test('density probe', async ({ page }) => {
+  test.setTimeout(1500000);
+  const dir = fs.mkdtempSync('/tmp/e1-density-');
+  const bin = path.join(dir, 'qrgen');
+  execFileSync('go', ['build', '-o', bin, './cmd/qrgen'], { cwd: path.join(__dirname, '..', 'backend') });
+  const tokens = Array.from({ length: N }, token);
+  const camps = Array.from({ length: N }, () => crypto.randomUUID());
+  await page.goto('/login.html');
+  await page.fill('input[type="email"]', 'jamal@yumyums.kitchen');
+  await page.fill('input[type="password"]', 'test123');
+  await page.click('button.btn');
+  await page.waitForURL((u) => !u.pathname.includes('login'));
+  await page.goto('/marketing.html');
+  await page.waitForFunction(() => window.MarketingScan && window.MarketingScan.booted === true);
+  console.log(`PROBE N=${N} random tokens per variant; decoder = lib/html5-qrcode.min.js Html5Qrcode#scanFile in the shipped marketing.html, fresh instance per image, 640px surface`);
+  for (const v of VARIANTS) {
+    const items = tokens.map((t, i) => {
+      const payload = v.payload(t, camps[i]);
+      const out = path.join(dir, `p-${i}.png`);
+      const o = execFileSync(bin, [payload, out, String(v.size), v.level], { encoding: 'utf8' });
+      return { payload, data: fs.readFileSync(out).toString('base64'), version: Number(/version=(\d+)/.exec(o)[1]), modules: Number(/modules=(\d+)/.exec(o)[1]) };
+    });
+    await page.evaluate((qrOnly) => { window.__probeCfg = qrOnly ? { formatsToSupport: [Html5QrcodeSupportedFormats.QR_CODE], verbose: false } : null; }, !!process.env.PROBE_QR_ONLY);
+    const got = await page.evaluate(async (files) => {
+      const res = [];
+      for (let i = 0; i < files.length; i++) {
+        const h = document.createElement('div'); h.id = 'probe-' + i; h.style.cssText = 'position:absolute;left:-9999px;width:640px;height:640px;overflow:hidden'; document.body.appendChild(h);
+        const f = new File([Uint8Array.from(atob(files[i]), (c) => c.charCodeAt(0))], `p${i}.png`, { type: 'image/png' });
+        // eslint-disable-next-line no-undef
+        try { res.push(await new Html5Qrcode(h.id, window.__probeCfg || undefined).scanFile(f, false)); } catch (e) { res.push(null); }
+        h.remove();
+      }
+      return res;
+    }, items.map((x) => x.data));
+    if (process.env.PROBE_DUMP) got.forEach((t, i) => { if (t !== items[i].payload) console.log('PROBEFAIL ' + JSON.stringify({ v: v.name.slice(0, 12), token: tokens[i], got: t === null ? null : t.slice(29, 60) })); });
+    const marks = got.map((t, i) => (t === null ? 'x' : (t === items[i].payload ? '.' : 'W')));
+    const ok = marks.filter((m) => m === '.').length;
+    const versions = [...new Set(items.map((x) => `v${x.version}/${x.modules}mod`))].join(',');
+    const lens = [...new Set(items.map((x) => x.payload.length))].join(',');
+    console.log(`PROBE ${v.name.padEnd(52)} len=${lens.padEnd(4)} ${versions.padEnd(12)} read ${String(ok).padStart(3)}/${N} (${(100 * ok / N).toFixed(0)}%)  not-read ${marks.filter((m) => m === 'x').length}  WRONG-TEXT ${marks.filter((m) => m === 'W').length}  ${marks.join('')}`);
+  }
+});
