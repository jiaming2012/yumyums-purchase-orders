index 9916e6f..f03ad2e 100644
--- a/backend/internal/marketing/projection.go
+++ b/backend/internal/marketing/projection.go
@@ -124,6 +124,80 @@ func ProjectCampaign(ctx context.Context, cfg ProjectionConfig, row ProjectionRo
 	return nil
 }
 
+// IdentityProjectionRow is one customer's identity code as the arbiter holds
+// it: the four columns of Supabase public.codes HQ writes. redeemed_at,
+// redeemed_by, updated_at and _deleted are the substrate's own.
+type IdentityProjectionRow struct {
+	// ID is IdentityCodeID(subscriber id) — derived, so the same subscriber
+	// always lands on the same row.
+	ID         string
+	TokenHash  string
+	CampaignID string
+	// ExpiresAt is the first-touch campaign's ends_at. public.codes.expires_at
+	// is NOT NULL, which is one reason an identity-only code (no campaign) has
+	// no row to write.
+	ExpiresAt time.Time
+}
+
+// ProjectIdentityCode upserts one identity code into Supabase `codes` over
+// PostgREST as service_role, keyed by id, so a tablet with signal can ask the
+// server about a customer it has never synced and — once the replica pulls —
+// answer offline from its own copy.
+//
+// The shape is the one the signed spike ran against the local substrate
+// (.night-crew/spikes/activity-e-customer-delivery-one-identity-code-qr-image/
+// identity-code-and-qr/02-identity-code-row-projects-and-the-device-pull-sees-it.sh,
+// exit 0 three times): POST the row with `Prefer: resolution=merge-duplicates`;
+// a second identical POST leaves exactly one row.
+//
+// Like ProjectCampaign it is called AFTER the local transaction commits, and a
+// failure here is NEVER a rollback: the customer's code is minted either way
+// and the caller surfaces warnings:["not_projected"].
+//
+// 🛑 Identity-only codes are not projected — the caller never builds a row
+// without a campaign. `codes.campaign_id` references the projected campaign,
+// so a campaign that is itself "not on tablets yet" makes this fail loudly
+// (a non-2xx) rather than write an orphan.
+func ProjectIdentityCode(ctx context.Context, cfg ProjectionConfig, row IdentityProjectionRow) error {
+	if !cfg.Configured() {
+		return fmt.Errorf("projection not configured (%s and/or %s empty)", RESTURLEnv, ServiceKeyEnv)
+	}
+	if row.CampaignID == "" {
+		return fmt.Errorf("identity code projection: no campaign (identity-only codes are not projected)")
+	}
+	body, err := json.Marshal([]map[string]any{{
+		"id":          row.ID,
+		"token_hash":  row.TokenHash,
+		"campaign_id": row.CampaignID,
+		// Nano, not seconds: the row must expire exactly when the campaign does.
+		"expires_at": row.ExpiresAt.UTC().Format(time.RFC3339Nano),
+	}})
+	if err != nil {
+		return fmt.Errorf("marshal identity code row: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost,
+		strings.TrimRight(cfg.RESTURL, "/")+"/codes", bytes.NewReader(body))
+	if err != nil {
+		return fmt.Errorf("build identity code request: %w", err)
+	}
+	req.Header.Set("apikey", cfg.ServiceKey)
+	req.Header.Set("Authorization", "Bearer "+cfg.ServiceKey)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Prefer", "resolution=merge-duplicates")
+
+	resp, err := (&http.Client{Timeout: 15 * time.Second}).Do(req)
+	if err != nil {
+		return fmt.Errorf("identity code upsert: %w", err)
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		// Never echo the response body — PostgREST errors can carry row data.
+		return fmt.Errorf("identity code upsert: postgrest status %d", resp.StatusCode)
+	}
+	return nil
+}
