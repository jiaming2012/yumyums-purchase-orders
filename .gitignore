node_modules
test-results/
test-results-ui/
# Default home for state-enumeration screenshots. Deliberately NOT inside
# test-results/ (Playwright wipes outputDir at the start of EVERY run, which
# destroyed one card's Definition-of-Done evidence before it could be read back
# — G6 F3). Untracked here; a run that needs the PNGs as durable evidence
# points STATES_SHOT_DIR at its own logs/ tree and commits them there.
test-screenshots/
playwright-report/
.planning/
.claude/*
!.claude/skills/
*.map
.features-gen/
id_rsa
backend/bin/
backend/server
version.json

# Production secrets — .env.prod lives only in the prod clone, never committed
.env
.env.*

# Notion export source files (one-time import)
notion-export/

# ui-jury: rendered routes.yaml (built from routes.template.yaml) + secret env
/routes.yaml
/.ui-jury/.env
routes.yaml.previous
routes.yaml.*.bak
.ui-jury/maps/
.ui-jury/runs/

# Playwright MCP session artifacts
.playwright-mcp/
# NOTE: .night-crew/runs/ is deliberately TRACKED — run records (briefs, sign-offs,
# DECISIONS-NEEDED, handoffs, slates) are durable planning artifacts needed across
# machines (/nc-status globs runs/*/DECISIONS-NEEDED.md). Ignored until 2026-07-16,
# which orphaned the whole 2026-07-09 run record on one machine. Do not re-add.

# Stale PID files from test/investigation legs
*.pid

# Persistent sync data plane runtime — the relay's pidfile, log, and built binary
# (card sync-live-in-dev-substrate). Runtime state, never committed.
.night-crew/qa/spike-supabase/.persistent-dev/

# Operator roadmap-round renders — decision 52 (ledger T-22, FORK 2): disposable
# session artifacts, never run artifacts. Untracked so committedOnlyTransform keeps
# them out of the precache; committing one moved the count 31 -> 32 at triage 2026-08-02.
backlog-round.html

# Spike harness server logs (regenerated every spike run)
.night-crew/spikes/**/.hq-server.log*
